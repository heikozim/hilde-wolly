--
-- The files of these tests are made in the temporary directory, each with
-- a name of its own, and removed again.
import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.String (
    String,
    fromSpan,
    destroyString,
    length,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeString,
    finalize
);
import Standard.File (
    FileDescriptor,
    environmentValue,
    openRead,
    createNewFile,
    writeAll,
    closeFile,
    setFileMode,
    removeFileIfThere,
    createDirectory,
    removeDirectory
);
import Wolly.Secret (
    keyBytes,
    readKey,
    makeKey
);

module body Wolly.Secret.Test is
    -- name in the temporary directory, or in the working directory when the
    -- environment names none.
    function pathOf(name: Span[Nat8, Static]): String is
        var path: StringBuilder := makeStringBuilder();
        case environmentValue("TMPDIR") of
            when Some(value as dir: String) do
                writeString(&!path, asSpan(&dir));
                writeString(&!path, "/");
                destroyString(dir);
            when None do
                skip;
        end case;
        writeString(&!path, name);
        return finalize(path);
    end;

    -- A file at path with content and mode, made new.
    generic [P: Region]
    function plant(path: Span[Nat8, P], content: Span[Nat8, Static], mode: Nat32): Unit is
        let cleared: Bool := removeFileIfThere(path);
        case createNewFile(path, mode) of
            when Some(value as made: FileDescriptor) do
                var file: FileDescriptor := made;
                let written: Bool := writeAll(&!file, content);
                let closed: Bool := closeFile(file);
                assertTrue(written and closed, "a file of the test was written");
            when None do
                assertTrue(false, "a file of the test could not be made");
        end case;
        return nil;
    end;

    -- Sets the mode of the file at path through an open descriptor.
    generic [P: Region]
    function changeMode(path: Span[Nat8, P], mode: Nat32): Bool is
        case openRead(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let set: Bool := setFileMode(&!file, mode);
                let closed: Bool := closeFile(file);
                return set and closed;
            when None do
                return false;
        end case;
    end;

    function refused(found: Option[String], message: Span[Nat8, Static]): Unit is
        case found of
            when Some(value as key: String) do
                destroyString(key);
                assertTrue(false, message);
            when None do
                assertTrue(true, message);
        end case;
        return nil;
    end;

    function testMadeAndRead(): Unit is
        let path: String := pathOf("wolly-secret-made");
        let cleared: Bool := removeFileIfThere(asSpan(&path));
        assertTrue(makeKey(asSpan(&path)), "a new key is made");
        case readKey(asSpan(&path)) of
            when Some(value as key: String) do
                assertTrue(length(&key) = 64, "64 hexadecimal digits");
                assertTrue(length(&key) >= keyBytes(), "at least keyBytes");
                destroyString(key);
            when None do
                assertTrue(false, "the key just made is read");
        end case;
        assertFalse(makeKey(asSpan(&path)), "a key that is there is never replaced");
        let removed: Bool := removeFileIfThere(asSpan(&path));
        destroyString(path);
        return nil;
    end;

    function testRefused(): Unit is
        let loose: String := pathOf("wolly-secret-open");
        plant(asSpan(&loose), "0123456789abcdef0123456789abcdef", #o600);
        case readKey(asSpan(&loose)) of
            when Some(value as key: String) do
                destroyString(key);
                assertTrue(true, "the control: 32 bytes with mode 0600 are read");
            when None do
                assertTrue(false, "the control: 32 bytes with mode 0600 are read");
        end case;
        assertTrue(changeMode(asSpan(&loose), #o640), "the mode of the test file was changed");
        refused(readKey(asSpan(&loose)), "a key its group may read");
        assertTrue(changeMode(asSpan(&loose), #o604), "the mode was changed again");
        refused(readKey(asSpan(&loose)), "a key others may read");
        let removed: Bool := removeFileIfThere(asSpan(&loose));
        destroyString(loose);

        let short: String := pathOf("wolly-secret-short");
        plant(asSpan(&short), "0123456789abcdef0123456789abcde", #o600);
        refused(readKey(asSpan(&short)), "31 bytes");
        let removedShort: Bool := removeFileIfThere(asSpan(&short));
        destroyString(short);

        let missing: String := pathOf("wolly-secret-missing");
        let cleared: Bool := removeFileIfThere(asSpan(&missing));
        refused(readKey(asSpan(&missing)), "no file");
        destroyString(missing);

        let dir: String := pathOf("wolly-secret-dir");
        let made: Bool := createDirectory(asSpan(&dir));
        refused(readKey(asSpan(&dir)), "a directory");
        let gone: Bool := removeDirectory(asSpan(&dir));
        destroyString(dir);
        return nil;
    end;
end module body.
