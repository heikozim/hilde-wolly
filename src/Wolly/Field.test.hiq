import Standard.Testing (
    assertTrue,
    assertFalse
);
import Wolly.Field (
    letters,
    digits,
    onlyFrom,
    isEmail,
    isDate
);

module body Wolly.Field.Test is
    function testOnlyFrom(): Unit is
        assertTrue(onlyFrom("hello", letters(), 10), "letters");
        assertFalse(onlyFrom("hello1", letters(), 10), "a digit among letters");
        assertTrue(onlyFrom("hello1", "helo1", 10), "a set of one's own");
        assertFalse(onlyFrom("hello", letters(), 4), "five bytes, four allowed");
        assertTrue(onlyFrom("hell", letters(), 4), "four allowed");
        assertTrue(onlyFrom("", digits(), 0), "the empty value");
        assertFalse(onlyFrom("12 3", digits(), 10), "a space among digits");
        return nil;
    end;

    function testEmail(): Unit is
        assertTrue(isEmail("user@example.com"), "plain");
        assertTrue(isEmail("first.last+tag@mail.example.org"), "dots and a plus");
        assertTrue(isEmail("a@b.co"), "the shortest");
        assertFalse(isEmail("a@b.c"), "a last label of one letter, too short as a whole");
        assertFalse(isEmail("ab@cd.e"), "a last label of one letter, long enough as a whole");
        assertTrue(isEmail("ab@cd.ef"), "the control: two letters in the last label");
        assertFalse(isEmail("invalid"), "no @");
        assertFalse(isEmail("@example.com"), "no local part");
        assertFalse(isEmail("user@"), "no domain");
        assertFalse(isEmail("user@.com"), "an empty label");
        assertFalse(isEmail("user@com"), "one label");
        assertFalse(isEmail("a@b@example.com"), "two @");
        assertFalse(isEmail(".user@example.com"), "a dot first");
        assertFalse(isEmail("user.@example.com"), "a dot last");
        assertFalse(isEmail("us..er@example.com"), "two dots");
        assertFalse(isEmail("user@-example.com"), "a hyphen first in a label");
        assertFalse(isEmail("user@example-.com"), "a hyphen last in a label");
        assertFalse(isEmail("user@example.c0m"), "a digit in the last label");
        assertFalse(isEmail("us er@example.com"), "a space");
        assertFalse(isEmail("\"user\"@example.com"), "a quoted local part");
        assertFalse(isEmail("user@[10.0.0.1]"), "an IP literal");
        assertTrue(isEmail("user@my-host.example.com"), "a hyphen inside a label");
        return nil;
    end;

    function testDate(): Unit is
        assertTrue(isDate("2024-01-05"), "a date");
        assertTrue(isDate("2024-02-29"), "the 29th of February of a leap year");
        assertFalse(isDate("2023-02-29"), "not in a common year");
        assertFalse(isDate("1900-02-29"), "nor in 1900, divisible by 100");
        assertTrue(isDate("2000-02-29"), "but in 2000, divisible by 400");
        assertTrue(isDate("2024-04-30"), "the 30th of April");
        assertFalse(isDate("2024-04-31"), "no 31st of April");
        assertTrue(isDate("2024-12-31"), "the 31st of December");
        assertFalse(isDate("2024-13-01"), "month 13");
        assertFalse(isDate("2024-00-10"), "month 0");
        assertFalse(isDate("2024-01-00"), "day 0");
        assertFalse(isDate("0000-01-01"), "year 0");
        assertTrue(isDate("0001-01-01"), "year 1");
        assertFalse(isDate("2024-1-5"), "digits left out");
        assertFalse(isDate("2024/01/05"), "slashes");
        assertFalse(isDate("2024-01-05T00:00"), "a time after it");
        assertFalse(isDate("2024-0a-05"), "a letter");
        return nil;
    end;
end module body.
