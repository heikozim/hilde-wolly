--
-- Mode 2 as a property: random codewords of every length up to 300 and of
-- 4096 bytes, and the hard cases (only 0x00, only 0xFF, repeated patterns),
-- never more than three equal bases in a row, between 45 and 55 percent G
-- and C in every segment, decoded to the very bytes; and what one wrong
-- base costs, measured over every base of a stream.
import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    length,
    nth,
    storeNth,
    destroyFree
);
import Wolly.BuntiDna (
    segmentBytes,
    dnaBaseCount,
    dnaEncode,
    dnaDecode,
    longestRun,
    gcInRange
);

module body Wolly.BuntiDna.Test is
    function next(state: Nat32): Nat32 is
        return modularAdd(modularMultiply(state, (1664525 : Nat32)), (1013904223 : Nat32));
    end;

    function byteOf(state: Nat32): Nat8 is
        case toNat8(state / 16777216) of
            when Some(value as byte: Nat8) do
                return byte;
            when None do
                return 0;
        end case;
    end;

    function narrow(number: Index): Nat8 is
        case toNat8(number) of
            when Some(value as byte: Nat8) do
                return byte;
            when None do
                return 0;
        end case;
    end;

    -- count bytes of a kind: 0 random from seed, 1 only 0x00, 2 only 0xFF,
    -- 3 the pattern 0x00 0xFF, 4 the pattern 0x01 0x02 0x03, 5 the bytes
    -- counting up.
    function bytesOf(kind: Index, count: Index, seed: Nat32): Buffer[Nat8] is
        var out: Buffer[Nat8] := allocateEmpty();
        var state: Nat32 := seed;
        var i: Index := 0;
        while i < count do
            state := next(state);
            var byte: Nat8 := byteOf(state);
            if kind = 1 then
                byte := (0 : Nat8);
            end if;
            if kind = 2 then
                byte := (255 : Nat8);
            end if;
            if kind = 3 then
                byte := narrow((i - ((i / 2) * 2)) * 255);
            end if;
            if kind = 4 then
                byte := narrow((i - ((i / 3) * 3)) + 1);
            end if;
            if kind = 5 then
                byte := narrow(i - ((i / 256) * 256));
            end if;
            insertBack(&!out, byte);
            i := i + 1;
        end while;
        return out;
    end;

    generic [A: Region, B: Region]
    function same(a: &[Buffer[Nat8], A], b: &[Buffer[Nat8], B]): Bool is
        if length(a) /= length(b) then
            return false;
        end if;
        var i: Index := 0;
        while i < length(a) do
            if nth(a, i) /= nth(b, i) then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    -- The longest run of equal bases, counted here.
    generic [B: Region]
    function runOf(bases: &[Buffer[Nat8], B]): Index is
        var longest: Index := 0;
        var run: Index := 0;
        var i: Index := 0;
        while i < length(bases) do
            if (i > 0) and (nth(bases, i) = nth(bases, i - 1)) then
                run := run + 1;
            else
                run := (1 : Index);
            end if;
            if run > longest then
                longest := run;
            end if;
            i := i + 1;
        end while;
        return longest;
    end;

    -- Whether every segment of the bases of count codewords holds 45 to 55
    -- percent G and C.
    generic [B: Region]
    function everySegmentInRange(bases: &[Buffer[Nat8], B], count: Index): Bool is
        var at: Index := 0;
        var done: Index := 0;
        while done < count do
            var size: Index := count - done;
            if size > segmentBytes() then
                size := segmentBytes();
            end if;
            let stop: Index := (at + (size * 4)) + 12;
            var gc: Index := 0;
            var k: Index := at;
            while k < stop do
                let base: Nat8 := nth(bases, k);
                if (base = 1) or (base = 2) then
                    gc := gc + 1;
                end if;
                k := k + 1;
            end while;
            let n: Index := stop - at;
            if ((gc * 100) < (n * 45)) or ((gc * 100) > (n * 55)) then
                return false;
            end if;
            at := stop;
            done := done + size;
        end while;
        return true;
    end;

    -- Encodes count bytes of kind; whether all three properties hold.
    function holds(kind: Index, count: Index, seed: Nat32): Bool is
        let codewords: Buffer[Nat8] := bytesOf(kind, count, seed);
        var good: Bool := false;
        case dnaEncode(&codewords) of
            when Some(value as bases: Buffer[Nat8]) do
                let back: Buffer[Nat8] := dnaDecode(&bases, 0, count);
                good := (((length(&bases) = dnaBaseCount(count)) and (runOf(&bases) <= 3)) and everySegmentInRange(&bases, count)) and same(&back, &codewords);
                destroyFree(back);
                destroyFree(bases);
            when None do
                skip;
        end case;
        destroyFree(codewords);
        return good;
    end;

    function testRules(): Unit is
        assertTrue(segmentBytes() = 32, "32 bytes a segment");
        assertTrue(dnaBaseCount(0) = 0, "nothing");
        assertTrue(dnaBaseCount(1) = 16, "a byte: 4 bases and three seeds");
        assertTrue(dnaBaseCount(32) = 140, "a segment: 128 and 12");
        assertTrue(dnaBaseCount(33) = 156, "and one byte more");
        var runs: Buffer[Nat8] := allocateEmpty();
        insertBack(&!runs, (0 : Nat8));
        insertBack(&!runs, (0 : Nat8));
        insertBack(&!runs, (0 : Nat8));
        insertBack(&!runs, (1 : Nat8));
        insertBack(&!runs, (0 : Nat8));
        assertTrue(longestRun(&runs) = 3, "a run of three");
        insertBack(&!runs, (0 : Nat8));
        insertBack(&!runs, (0 : Nat8));
        insertBack(&!runs, (0 : Nat8));
        assertTrue(longestRun(&runs) = 4, "and of four");
        assertTrue(gcInRange(&runs, 2, 4), "A C: half");
        assertFalse(gcInRange(&runs, 0, 3), "A A A: none");
        destroyFree(runs);
        return nil;
    end;

    function testProperties(): Unit is
        var good: Index := 0;
        var cases: Index := 0;
        var state: Nat32 := 99;
        var kind: Index := 0;
        while kind <= 5 do
            var count: Index := 1;
            while count <= 300 do
                state := next(state);
                cases := cases + 1;
                if holds(kind, count, state) then
                    good := good + 1;
                end if;
                count := count + 1;
            end while;
            cases := cases + 1;
            if holds(kind, 4096, state) then
                good := good + 1;
            end if;
            kind := kind + 1;
        end while;
        print("mode 2 properties: ");
        print(good);
        print(" of ");
        printLn(cases);
        assertTrue((cases = 1806) and (good = cases), "every case keeps runs, GC and its bytes");
        return nil;
    end;

    -- Measured: each base of the stream of 100 random codewords changed to
    -- each of the three other bases; how many bytes come back wrong.
    function testOneWrongBase(): Unit is
        let codewords: Buffer[Nat8] := bytesOf(0, 100, 7);
        case dnaEncode(&codewords) of
            when Some(value as bases: Buffer[Nat8]) do
                var worst: Index := 0;
                var none: Index := 0;
                var one: Index := 0;
                var more: Index := 0;
                var i: Index := 0;
                while i < length(&bases) do
                    var other: Index := 1;
                    while other < 4 do
                        var changed: Buffer[Nat8] := allocateEmpty();
                        var k: Index := 0;
                        while k < length(&bases) do
                            insertBack(&!changed, nth(&bases, k));
                            k := k + 1;
                        end while;
                        case toIndex(nth(&bases, i)) of
                            when Some(value as base: Index) do
                                let flipped: Index := base + other;
                                storeNth(&!changed, i, narrow(flipped - ((flipped / 4) * 4)));
                            when None do
                                skip;
                        end case;
                        let back: Buffer[Nat8] := dnaDecode(&changed, 0, 100);
                        var wrong: Index := 0;
                        var j: Index := 0;
                        while j < 100 do
                            if nth(&back, j) /= nth(&codewords, j) then
                                wrong := wrong + 1;
                            end if;
                            j := j + 1;
                        end while;
                        if wrong = 0 then
                            none := none + 1;
                        else
                            if wrong = 1 then
                                one := one + 1;
                            else
                                more := more + 1;
                            end if;
                        end if;
                        if wrong > worst then
                            worst := wrong;
                        end if;
                        destroyFree(back);
                        destroyFree(changed);
                        other := other + 1;
                    end while;
                    i := i + 1;
                end while;
                print("mode 2, one wrong base: no wrong byte ");
                print(none);
                print(", one ");
                print(one);
                print(", more ");
                print(more);
                print(", worst ");
                printLn(worst);
                assertTrue(length(&bases) = 448, "100 codewords: 400 bases and 4 times 12");
                assertTrue(none = 144, "a wrong base of a seed copy costs nothing: 4 segments, 12 bases, 3 ways");
                assertTrue(one = 1200, "a wrong base of a byte costs that byte: 400 bases, 3 ways");
                assertTrue((more = 0) and (worst = 1), "never more than one byte");
                destroyFree(bases);
            when None do
                assertTrue(false, "100 codewords in mode 2");
        end case;
        destroyFree(codewords);
        return nil;
    end;
end module body.
