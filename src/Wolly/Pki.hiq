import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Text (
    bytesToHex
);
import Standard.X509 (
    PrivateKey,
    Certificate,
    EcP256,
    generateKey,
    privateKeyToPem,
    privateKeyFromPem,
    destroyPrivateKey,
    certificateFromPem,
    certificateToPem,
    fingerprintSha256,
    destroyCertificate,
    selfSigned,
    issue,
    verifyChain
);

module body Wolly.Pki is
    constant authority_max_days: Nat32 := 3650;
    constant machine_max_days: Nat32 := 825;

    function authorityDays(): Nat32 is
        return authority_max_days;
    end;

    function machineDays(): Nat32 is
        return machine_max_days;
    end;

    function newKey(): Option[String] is
        case generateKey(EcP256()) of
            when Some(value as key: PrivateKey) do
                let pem: Option[String] := privateKeyToPem(&key);
                destroyPrivateKey(key);
                return pem;
            when None do
                return None();
        end case;
    end;

    generic [K: Region, C: Region]
    function authorityCertificate(key_pem: Span[Nat8, K], common_name: Span[Nat8, C], days: Nat32): Option[String] is
        if days > authority_max_days then
            return None();
        end if;
        case privateKeyFromPem(key_pem) of
            when Some(value as key: PrivateKey) do
                case selfSigned(&key, common_name, "", days, true) of
                    when Some(value as cert: Certificate) do
                        let pem: Option[String] := certificateToPem(&cert);
                        destroyCertificate(cert);
                        destroyPrivateKey(key);
                        return pem;
                    when None do
                        destroyPrivateKey(key);
                        return None();
                end case;
            when None do
                return None();
        end case;
    end;

    generic [A: Region, K: Region, M: Region, C: Region, N: Region]
    function issueUnder(ca: &[Certificate, A], ca_key: &[PrivateKey, K], machine_key: &[PrivateKey, M],
        common_name: Span[Nat8, C], names: Span[Nat8, N], days: Nat32): Option[String] is
        case issue(ca, ca_key, machine_key, common_name, names, days, false) of
            when Some(value as cert: Certificate) do
                let pem: Option[String] := certificateToPem(&cert);
                destroyCertificate(cert);
                return pem;
            when None do
                return None();
        end case;
    end;

    generic [A: Region, K: Region, M: Region, C: Region, N: Region]
    function issueMachine(ca_pem: Span[Nat8, A], ca_key_pem: Span[Nat8, K], machine_key_pem: Span[Nat8, M],
        common_name: Span[Nat8, C], names: Span[Nat8, N], days: Nat32): Option[String] is
        if days > machine_max_days then
            return None();
        end if;
        case certificateFromPem(ca_pem) of
            when Some(value as ca: Certificate) do
                case privateKeyFromPem(ca_key_pem) of
                    when Some(value as ca_key: PrivateKey) do
                        case privateKeyFromPem(machine_key_pem) of
                            when Some(value as machine_key: PrivateKey) do
                                let pem: Option[String] := issueUnder(&ca, &ca_key, &machine_key, common_name, names, days);
                                destroyPrivateKey(machine_key);
                                destroyPrivateKey(ca_key);
                                destroyCertificate(ca);
                                return pem;
                            when None do
                                destroyPrivateKey(ca_key);
                                destroyCertificate(ca);
                                return None();
                        end case;
                    when None do
                        destroyCertificate(ca);
                        return None();
                end case;
            when None do
                return None();
        end case;
    end;

    generic [C: Region, A: Region, H: Region]
    function verifies(cert_pem: Span[Nat8, C], ca_pem: Span[Nat8, A], host: Span[Nat8, H], at: Int64): Bool is
        case verifyChain(cert_pem, ca_pem, host, at) of
            when Some(value as why: String) do
                destroyString(why);
                return false;
            when None do
                return true;
        end case;
    end;

    generic [C: Region]
    function fingerprint(cert_pem: Span[Nat8, C]): Option[String] is
        case certificateFromPem(cert_pem) of
            when Some(value as cert: Certificate) do
                let print: Option[String] := fingerprintSha256(&cert);
                destroyCertificate(cert);
                case print of
                    when Some(value as raw: String) do
                        let hex: String := bytesToHex(asSpan(&raw));
                        destroyString(raw);
                        return Some(value => hex);
                    when None do
                        return None();
                end case;
            when None do
                return None();
        end case;
    end;
end module body.
