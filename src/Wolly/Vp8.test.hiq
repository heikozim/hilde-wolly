--
-- The lossy WebPs here and the golden YUV planes their digests come from
-- are golang.org/x/image's testdata (Copyright 2009 The Go Authors,
-- BSD-3-Clause), written and decoded by libwebp; the RGB digests are those
-- of macOS's ImageIO decoding the same files.  The c- frames were written
-- by cwebp 1.6.0 from pictures made for the test (sharpness, simple filter,
-- one segment, quality 5 and 100, the skip flag), their planes and RGB
-- dwebp's (-yuv, -pam).
import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.String (
    String,
    destroyString,
    asSpan,
    length
);
import Standard.Text (
    hexToBytes,
    bytesToHex,
    startsWith,
    substring,
    equal
);
import Standard.Libcrypto (
    sha256
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Wolly.Vp8 (
    Vp8Picture,
    readVp8,
    vp8Width,
    vp8Height,
    vp8Pixels,
    vp8Luma,
    vp8Blue,
    vp8Red,
    destroyVp8
);

module body Wolly.Vp8.Test is
    constant bluePurplePinkLossyHex: Span[Nat8, Static] := "";
    constant video001LossyHex: Span[Nat8, Static] := "";
    constant bluePurplePinkLargeSimpleFilterLossyHex: Span[Nat8, Static] := "";
    constant bluePurplePinkLargeNormalFilterLossyHex: Span[Nat8, Static] := "";
    constant bluePurplePinkLargeNoFilterLossyHex: Span[Nat8, Static] := "";
    constant yellow_RoseLossyHex: Span[Nat8, Static] := "";
    constant cSharp7LossyHex: Span[Nat8, Static] := "";
    constant cSharp3LossyHex: Span[Nat8, Static] := "";
    constant cSimpleLossyHex: Span[Nat8, Static] := "";
    constant cSeg1LossyHex: Span[Nat8, Static] := "";
    constant cQ5LossyHex: Span[Nat8, Static] := "";
    constant cQ100LossyHex: Span[Nat8, Static] := "";
    constant cSkipLossyHex: Span[Nat8, Static] := "";
    constant cHardLossyHex: Span[Nat8, Static] := "";

    function bytesOf(hex: Span[Nat8, Static]): String is
        case hexToBytes(hex) of
            when Some(value as bytes: String) do
                return bytes;
            when None do
                assertTrue(false, "the fixture is hex");
                return bytesOf("00");
        end case;
    end;

    generic [P: Region]
    function digestIs(bytes: Span[Nat8, P], digest: Span[Nat8, Static]): Bool is
        case sha256(bytes) of
            when Some(value as sum: String) do
                let hex: String := bytesToHex(asSpan(&sum));
                let good: Bool := equal(asSpan(&hex), digest);
                if not good then
                    printLn(asSpan(&hex));
                end if;
                destroyString(hex);
                destroyString(sum);
                return good;
            when None do
                return false;
        end case;
    end;

    function wide(byte: Nat8): Index is
        case toIndex(byte) of
            when Some(value as n: Index) do
                return n;
            when None do
                return 0;
        end case;
    end;

    -- The payload of the first chunk of a plain WebP file (its VP8 chunk).
    generic [D: Region]
    function chunkOf(data: Span[Nat8, D]): Span[Nat8, D] is
        let size: Index := ((wide(data[16]) + (wide(data[17]) * 256)) + (wide(data[18]) * 65536)) + (wide(data[19]) * 16777216);
        return substring(data, 20, size + 20);
    end;

    -- What of the frame in the WebP in hex is right: 1 Y, 2 Cb, 4 Cr, 8
    -- RGB, 16 the size; 0 when it does not read.
    function rightOf(hex: Span[Nat8, Static], width: Index, height: Index, luma: Span[Nat8, Static],
                     blue: Span[Nat8, Static], red: Span[Nat8, Static], pixels: Span[Nat8, Static]): Index is
        let data: String := bytesOf(hex);
        var right: Index := 0;
        case readVp8(chunkOf(asSpan(&data)), 16000000) of
            when Right(right as picture: Vp8Picture) do
                if digestIs(vp8Luma(&picture), luma) then
                    right := right + 1;
                end if;
                if digestIs(vp8Blue(&picture), blue) then
                    right := right + 2;
                end if;
                if digestIs(vp8Red(&picture), red) then
                    right := right + 4;
                end if;
                if digestIs(vp8Pixels(&picture), pixels) then
                    right := right + 8;
                end if;
                if (vp8Width(&picture) = width) and (vp8Height(&picture) = height) then
                    right := right + 16;
                end if;
                destroyVp8(picture);
            when Left(left as code: Index) do
                printLn("refused with");
                printLn(code);
        end case;
        destroyString(data);
        return right;
    end;

    function testGolden(): Unit is
        let bluePurplePinkLossy: Index := rightOf(bluePurplePinkLossyHex, 150, 100, "25acbf06d9cf0735c676bd61b89f3c8a9f448b4d585d0e9d903858cdf69526b5",
                                   "56c65e832ff56006c0bc819d12df0cac597b511d68dc17fc1a3a366767bd3337",
                                   "1d5609435fa97170d83ed2cb37b43e67cc4e38c70dbb44b496d7453321f18499",
                                   "0a1e13a4ddbbe50ffb09dc9e8860d6336df0ab6a490a9a12b14dc5660c0ed396");
        assertTrue(bluePurplePinkLossy = 31, "blue-purple-pink.lossy.webp: Y, Cb and Cr as libwebp's, RGB as ImageIO's, 150 by 100");
        let video001Lossy: Index := rightOf(video001LossyHex, 150, 103, "5e5c720bcd9a402e8e8eaa86cb2cbc4b7432e9b72df79b86820fa5533192113a",
                                   "6ce3f2c3df6d848d261cf06e37ae9356943f0a7d07134f2c70a6508f95d701d3",
                                   "1a29db3b5318f4912b2f41a730614650ef54a461f5862d1381d9f618f9df2278",
                                   "fb9eca466d87a5becfcc8240581b1b2f656299c67988f68abb40993cde187442");
        assertTrue(video001Lossy = 31, "video-001.lossy.webp: Y, Cb and Cr as libwebp's, RGB as ImageIO's, 150 by 103");
        let bluePurplePinkLargeSimpleFilterLossy: Index := rightOf(bluePurplePinkLargeSimpleFilterLossyHex, 600, 400, "70a2c56614c3216dde496fe85c23cb7491138623e77718de0c75576a1eadc3a6",
                                   "04fb8368fe4672123d8e9cab56ed492e97c6cb1437c94c70ad76a0bc42e75a2d",
                                   "c536da23ce73e31f5445696cfbc572a2a2d825dbeac8e4e4e809f6962c15e81c",
                                   "5c73a0ffb687c8c37033755619aed39d6b1d3ba10dfc9b6ac455e5f368244a77");
        assertTrue(bluePurplePinkLargeSimpleFilterLossy = 31, "blue-purple-pink-large.simple-filter.lossy.webp: Y, Cb and Cr as libwebp's, RGB as ImageIO's, 600 by 400");
        let bluePurplePinkLargeNormalFilterLossy: Index := rightOf(bluePurplePinkLargeNormalFilterLossyHex, 600, 400, "8bb55772e78c3e654b7e966bae5d5411bf8277a57a30b0cbbfeac7d06fa8134c",
                                   "4a8ee99e5d7de31818650132829a268683b50a7c75b1f4b9bdad8b822cdf3355",
                                   "37430a7a4f43509823361c8df6dc5cad0d816eeb0dc193bcf4e425cbaaeb7215",
                                   "e3e3382e3d5bcfd50e3be8541bffe4c1fc6ad853db593ade8b2af2d418e2add9");
        assertTrue(bluePurplePinkLargeNormalFilterLossy = 31, "blue-purple-pink-large.normal-filter.lossy.webp: Y, Cb and Cr as libwebp's, RGB as ImageIO's, 600 by 400");
        let bluePurplePinkLargeNoFilterLossy: Index := rightOf(bluePurplePinkLargeNoFilterLossyHex, 600, 400, "0e7bd3917d2acdebef6acedf9a6a5d39e1e3a2dbce8539bae76101b59562167f",
                                   "04fb8368fe4672123d8e9cab56ed492e97c6cb1437c94c70ad76a0bc42e75a2d",
                                   "c536da23ce73e31f5445696cfbc572a2a2d825dbeac8e4e4e809f6962c15e81c",
                                   "761dcbfd437397cc6fa97f5492c098de51965e1ff6a927a047204e0a5466cabb");
        assertTrue(bluePurplePinkLargeNoFilterLossy = 31, "blue-purple-pink-large.no-filter.lossy.webp: Y, Cb and Cr as libwebp's, RGB as ImageIO's, 600 by 400");
        let yellow_RoseLossy: Index := rightOf(yellow_RoseLossyHex, 400, 301, "fe1583bd24e93c013d565018b91200c12c83302fbf5ec86e81d6615a7657e458",
                                   "6288b303adcedb2365efcd1dd0cfa0badc9a1add608202a6e6281f3198eef1d4",
                                   "a4bdc108dc1ea22359610a40cca98df7a5b82db36e5a0f6b3516453ca30a3a8d",
                                   "c0e71617265eb04b8f6d56d996c221ef9699197351d5b4ca2f58caa20959d92c");
        assertTrue(yellow_RoseLossy = 31, "yellow_rose.lossy.webp: Y, Cb and Cr as libwebp's, RGB as ImageIO's, 400 by 301");
        let cSharp7Lossy: Index := rightOf(cSharp7LossyHex, 37, 23, "70f7d3c298671a1f2b5b8415e1cef9ac46e73a79b888ef80f27420fa377dc307",
                                   "62a286324d84e94c348d9ece75910a5102453651dcfe05fa18dd1339925fb953",
                                   "3216dbeb7ea88e419054baec56352ca2d7426090e7d601a14739573fb7faedd5",
                                   "a518f762f557ba424142a3fff183ca06934ff37e25b572460afc37a254a296d5");
        assertTrue(cSharp7Lossy = 31, "c-sharp7.lossy.webp: Y, Cb and Cr as libwebp's, RGB as dwebp's, 37 by 23");
        let cSharp3Lossy: Index := rightOf(cSharp3LossyHex, 51, 45, "ff579dd8892b4ac9cc4eecc4e36664273fc5efc9d3cef5edb2c0830bf9e27d9c",
                                   "d0c3038b5b151bc0dd6d450ce220a7f9d26b2769900bc930c4ad5a08a6a0e6db",
                                   "981254aaa9dcc7048462ddebf25c2f522f19cc52cb2b25a7f34e76d36605f8eb",
                                   "5a6539256276b34506d938574737dfd0a0538ff384d4ddaece1ef8812b5fd3f1");
        assertTrue(cSharp3Lossy = 31, "c-sharp3.lossy.webp: Y, Cb and Cr as libwebp's, RGB as dwebp's, 51 by 45");
        let cSimpleLossy: Index := rightOf(cSimpleLossyHex, 51, 45, "43e8850ad27419409e9a235583562cf82c55022f52de60b2ea633469308bab71",
                                   "e5399aba999452ebab003da89171179d841358aa180d807c3c86cfff1dc8734b",
                                   "e1851fc92d69748d29a532a0d4cc6cf5259ca4874fbdbbf3245b201e8604e39a",
                                   "f717b48be2127a62b955fa7f729857a54c516b555ad84a8f209d85bf2ebd7a6e");
        assertTrue(cSimpleLossy = 31, "c-simple.lossy.webp: Y, Cb and Cr as libwebp's, RGB as dwebp's, 51 by 45");
        let cSeg1Lossy: Index := rightOf(cSeg1LossyHex, 64, 48, "ce421447da8a7b3c7e29d04331f45ce8c21577fff4c7700ca98d137f0ab15d8d",
                                   "d9c9353f8884b95140abee202a3bb740726a758406e68519ba1139640d961c62",
                                   "b89bff491ab6c730bdee6dd2586b152d4429ec3cde17540b22804a3787404f95",
                                   "f4e84cd06d4ec90ca0e026d65a77ec115ae5031e2573597cf2fb15e30ba3f7a8");
        assertTrue(cSeg1Lossy = 31, "c-seg1.lossy.webp: Y, Cb and Cr as libwebp's, RGB as dwebp's, 64 by 48");
        let cQ5Lossy: Index := rightOf(cQ5LossyHex, 51, 45, "71f43f3ea93521300c817de5ae0afd7a03aa2a2e093d551ff5d8dd5f72b32fab",
                                   "9861577fa3a9228abafdaf1a944967f7ba2fc954c5d902d92000f6718da5c707",
                                   "efde5294375d94d6f77d08f537ce00acab10f7073090a31803fab8a885e90bbd",
                                   "6c76a43a3520dbc441618a76b62d671098ff1c51591d6434e8c16f141424bb9c");
        assertTrue(cQ5Lossy = 31, "c-q5.lossy.webp: Y, Cb and Cr as libwebp's, RGB as dwebp's, 51 by 45");
        let cQ100Lossy: Index := rightOf(cQ100LossyHex, 37, 23, "41fde1e0b3c77558528ce29d87da86037d2d09606b1fabc801b36ec415b606a6",
                                   "9eec82ccb5b6e30911c6b89540ac299c96589b11e4a0ac2754aeee568ddc0956",
                                   "75f705e1b7c79be868164c563d4bfc4343b1f306ad916d59a707fd9cb9688097",
                                   "c1e6bf5d2bdd13b7d8d76e373949622670a493037a75e9971e001b0db23a1bf8");
        assertTrue(cQ100Lossy = 31, "c-q100.lossy.webp: Y, Cb and Cr as libwebp's, RGB as dwebp's, 37 by 23");
        -- cwebp -m 2 sets the skip flag of macroblocks without coefficients
        -- (the other fixtures are written with -m 4 or 6, which never set
        -- it), and at the q of each of its segments the Y2 AC factor is not
        -- the same with 156 / 100 as with 155 / 100.
        let cSkipLossy: Index := rightOf(cSkipLossyHex, 80, 64, "ee1832b28dca6bda7819e63dc38697152c63b1caaf8e7ae58d26b392a0b77635",
                                   "43b4892b22dd828ccb2442ffe1d827268c92e28229e0da112163304538927bac",
                                   "1920997152ecbd2cc6610deb44a98631eb41f6fd8dd2fa688487bab4043cdded",
                                   "19476d5715539d4a539279635e3c838df88e8ec00371915641a9db166cc41f81");
        assertTrue(cSkipLossy = 31, "c-skip.lossy.webp: Y, Cb and Cr as libwebp's, RGB as dwebp's, 80 by 64");
        -- Hard strokes at -q 100: the smallest quantiser, so the AC coefficients of the
        -- inverse DCT stay above 473, from which a product with the constant c1 (85627)
        -- differs from the one with 85626 by one; no other frame here had a coefficient
        -- that large where c1 is used.
        let cHardLossy: Index := rightOf(cHardLossyHex, 64, 48, "caa255186d4462dae9f8f217e2bf71369ec04a0ed6d03562488bdcaae1135430",
                                   "7f3e5e4e65eca4390e9242558012bc9bdad133d7ac9f6aed53fa156a2288f73b",
                                   "7f3e5e4e65eca4390e9242558012bc9bdad133d7ac9f6aed53fa156a2288f73b",
                                   "3e913d4159e2530f86019d6466f8ef6931c09f2471a45e3151887b960bfe185c");
        assertTrue(cHardLossy = 31, "c-hard.lossy.webp: Y, Cb and Cr as libwebp's, RGB as dwebp's, 64 by 48");
        return nil;
    end;

    -- 0 when the frame reads, else the code readVp8 answers.
    generic [D: Region]
    function codeOf(data: Span[Nat8, D], maxPixels: Index): Index is
        case readVp8(data, maxPixels) of
            when Right(right as picture: Vp8Picture) do
                destroyVp8(picture);
                return 0;
            when Left(left as code: Index) do
                return code;
        end case;
    end;

    -- The chunk of blue-purple-pink with the byte at at set to value, when
    -- it was was; else no bytes.
    function changed(at: Index, was: Nat8, value: Nat8): String is
        let data: String := bytesOf(bluePurplePinkLossyHex);
        var out: StringBuilder := makeStringBuilder();
        if byteAt(chunkOf(asSpan(&data)), at) = was then
            writeString(&!out, substring(chunkOf(asSpan(&data)), 0, at));
            writeByte(&!out, value);
            writeString(&!out, substring(chunkOf(asSpan(&data)), at + 1, spanLength(chunkOf(asSpan(&data)))));
        end if;
        destroyString(data);
        return finalize(out);
    end;

    generic [D: Region]
    function byteAt(data: Span[Nat8, D], at: Index): Nat8 is
        return data[at];
    end;

    function changedCode(at: Index, was: Nat8, value: Nat8, maxPixels: Index): Index is
        let bytes: String := changed(at, was, value);
        var code: Index := 99;
        if length(&bytes) > 0 then
            code := codeOf(asSpan(&bytes), maxPixels);
        end if;
        destroyString(bytes);
        return code;
    end;

    function testRefused(): Unit is
        let data: String := bytesOf(bluePurplePinkLossyHex);
        assertTrue(codeOf(chunkOf(asSpan(&data)), 150 * 100) = 0, "exactly maxPixels pixels are read");
        assertTrue(codeOf(chunkOf(asSpan(&data)), (150 * 100) - 1) = 3, "one pixel more than maxPixels");
        assertTrue(codeOf(substring(chunkOf(asSpan(&data)), 0, 9), 16000000) = 1, "nine bytes are no frame");
        assertTrue(codeOf(substring(chunkOf(asSpan(&data)), 0, 200), 16000000) = 1, "a frame cut in its first partition");
        destroyString(data);
        -- byte 0: key frame bit 0, version, show bit 16; bytes 3 to 5 the
        -- start code 9d 01 2a
        assertTrue(changedCode(3, 157, 158, 16000000) = 1, "a start code not 9d 01 2a is Broken");
        assertTrue(changedCode(6, 150, 0, 16000000) = 1, "a width of 0 (byte 6, 150 before) is Broken");
        return nil;
    end;

    -- No prefix and no inverted byte of the frame of blue-purple-pink makes
    -- the reader fail other than with a code; measured: 2428

    -- of 2430 prefixes refused, 1452 of 2430 inverted bytes read.  In 16
    -- parts, part k the offsets k, k + 16, k + 32 and so on, so that each
    -- stays under the 1800 s hilde test gives a test under valgrind (the
    -- whole took longer); the 16 together are every offset.
    constant robustParts: Index := 16;

    function robustPart(part: Index): Unit is
        let data: String := bytesOf(bluePurplePinkLossyHex);
        let size: Index := spanLength(chunkOf(asSpan(&data)));
        var wrong: Index := 0;
        var cut: Index := part;
        while cut < size do
            let refused: Bool := codeOf(substring(chunkOf(asSpan(&data)), 0, cut), 16000000) /= 0;
            let needed: Bool := cut < (size - 2);
            if refused /= needed then
                wrong := wrong + 1;
            end if;
            cut := cut + robustParts;
        end while;
        assertTrue(wrong = 0, "every prefix refused but the two that leave out bytes the decoder never needs");
        var read: Index := 0;
        var tried: Index := 0;
        var at: Index := part;
        while at < size do
            let was: Nat8 := byteAt(chunkOf(asSpan(&data)), at);
            if changedCode(at, was, bitwiseXor(was, (255 : Nat8)), 16000000) = 0 then
                read := read + 1;
            end if;
            tried := tried + 1;
            at := at + robustParts;
        end while;
        assertTrue(read < tried, "each byte inverted: some of this part refused");
        destroyString(data);
        return nil;
    end;

    -- The last byte is one the decoder never needs: inverted, the frame
    -- still reads, as there is no checksum.
    function testRobustReads(): Unit is
        let data: String := bytesOf(bluePurplePinkLossyHex);
        let size: Index := spanLength(chunkOf(asSpan(&data)));
        let was: Nat8 := byteAt(chunkOf(asSpan(&data)), size - 1);
        assertTrue(changedCode(size - 1, was, bitwiseXor(was, (255 : Nat8)), 16000000) = 0, "each byte inverted: no checksum, so a byte the decoder never needs reads");
        destroyString(data);
        return nil;
    end;

    function testRobust00(): Unit is
        robustPart(0);
        return nil;
    end;

    function testRobust01(): Unit is
        robustPart(1);
        return nil;
    end;
end module body.
