--
-- The tables of every module that keeps them, made in one database (SQLite in memory, or the test
-- server of PostgreSQL, see Wolly.TestDb): all are made, and on PostgreSQL none has a column of the
-- 32 bit type integer, which SQLite's INTEGER (64 bit) must not become there.
import Standard.Testing (
    assertTrue
);
import Standard.Database (
    Database,
    Writing,
    DbError,
    Cursor,
    noValues,
    start,
    advance,
    columnInt64,
    finish,
    closeDatabase
);
import Wolly.TestDb (
    openTestDatabase
);
import Wolly.Dialect (
    pick
);
import Wolly.Auth (
    AuthError,
    prepareAuth
);
import Wolly.Bearer (
    prepareTokens
);
import Wolly.Blob (
    prepareBlobs
);
import Wolly.Cache (
    prepareCache
);
import Wolly.Edges (
    prepareEdges
);
import Wolly.Entity (
    prepareEntities
);
import Wolly.FormGuard (
    prepareFormGuard
);
import Wolly.Limit (
    prepareLimits
);
import Wolly.LogTail (
    prepareTail
);
import Wolly.Metrics (
    prepareMetrics
);
import Wolly.Passkey (
    preparePasskeys
);
import Wolly.Rambo (
    prepareRambo
);
import Wolly.Role (
    prepareRoles
);
import Wolly.SoundSearch (
    prepareSounds
);
import Wolly.Totp (
    prepareTotp
);

module body Wolly.Schema.Test is
    function made(problem: Option[DbError], message: Span[Nat8, Static]): Unit is
        case problem of
            when Some(value as error: DbError) do
                assertTrue(false, message);
            when None do
                assertTrue(true, message);
        end case;
        return nil;
    end;

    -- The number the statement counts, -1 when it fails.
    generic [R: Region]
    function counted(db: &![Database[Writing], R], sql: Span[Nat8, Static]): Int64 is
        var cursor: Cursor := start(&~db, sql, noValues());
        var count: Int64 := 0;
        if advance(&!cursor) then
            count := columnInt64(&cursor, 0);
        end if;
        case finish(&~db, cursor) of
            when Some(value as error: DbError) do
                return 0 - 1;
            when None do
                return count;
        end case;
    end;

    generic [R: Region]
    function prepareAll(db: &![Database[Writing], R]): Unit is
        let prepare_cache_done: Option[DbError] := prepareCache(&~db);
        made(prepare_cache_done, "the cache");
        let prepare_limits_done: Option[DbError] := prepareLimits(&~db);
        made(prepare_limits_done, "the limits");
        let prepare_tokens_done: Option[DbError] := prepareTokens(&~db);
        made(prepare_tokens_done, "the tokens");
        let prepare_roles_done: Option[DbError] := prepareRoles(&~db);
        made(prepare_roles_done, "the roles");
        let prepare_form_guard_done: Option[DbError] := prepareFormGuard(&~db);
        made(prepare_form_guard_done, "the form guard");
        let prepare_totp_done: Option[DbError] := prepareTotp(&~db);
        made(prepare_totp_done, "the second factors");
        let prepare_sounds_done: Option[DbError] := prepareSounds(&~db);
        made(prepare_sounds_done, "the sounds");
        let prepare_tail_done: Option[DbError] := prepareTail(&~db);
        made(prepare_tail_done, "the tail of a log");
        let prepare_edges_done: Option[DbError] := prepareEdges(&~db);
        made(prepare_edges_done, "the edges");
        let prepare_metrics_done: Option[DbError] := prepareMetrics(&~db);
        made(prepare_metrics_done, "the metrics");
        let prepare_blobs_done: Option[DbError] := prepareBlobs(&~db);
        made(prepare_blobs_done, "the blobs");
        let prepare_rambo_done: Option[DbError] := prepareRambo(&~db);
        made(prepare_rambo_done, "the logins at the identity provider");
        let prepare_passkeys_done: Option[DbError] := preparePasskeys(&~db);
        made(prepare_passkeys_done, "the passkeys");
        let prepare_entities_done: Option[DbError] := prepareEntities(&~db);
        made(prepare_entities_done, "the entities");
        case prepareAuth(&~db) of
            when Left(left as error: AuthError) do
                assertTrue(false, "the users");
            when Right(right as done: Unit) do
                assertTrue(true, "the users");
        end case;
        return nil;
    end;

    function testTables(): Unit is
        case openTestDatabase() of
            when Right(right as opened: Database[Writing]) do
                var db: Database[Writing] := opened;
                prepareAll(&!db);
                let tables: Span[Nat8, Static] := pick(&db, "SELECT count(*) FROM sqlite_master WHERE type = 'table' AND name LIKE 'wolly\\_%' ESCAPE '\\'", "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'public' AND table_name LIKE 'wolly\\_%'");
                assertTrue(counted(&!db, tables) = 29, "the 29 tables of the modules");
                closeDatabase(db);
            when Left(left as error: DbError) do
                assertTrue(false, "no test database");
        end case;
        return nil;
    end;

    function testNoThirtyTwoBitColumn(): Unit is
        case openTestDatabase() of
            when Right(right as opened: Database[Writing]) do
                var db: Database[Writing] := opened;
                prepareAll(&!db);
                let narrow: Span[Nat8, Static] := pick(&db, "SELECT 0", "SELECT count(*) FROM information_schema.columns WHERE table_schema = 'public' AND data_type IN ('integer', 'smallint')");
                assertTrue(counted(&!db, narrow) = 0, "no column of 32 bits or less on PostgreSQL");
                closeDatabase(db);
            when Left(left as error: DbError) do
                assertTrue(false, "no test database");
        end case;
        return nil;
    end;
end module body.
