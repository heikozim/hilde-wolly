import Wolly.Response (
    Response,
    addNumberHeader
);

module body Wolly.Ban is
    function longestBanSeconds(): Int64 is
        return 86400;
    end;

    function withBan(response: Response, seconds: Int64): Response is
        var asked: Int64 := seconds;
        if asked > longestBanSeconds() then
            asked := longestBanSeconds();
        end if;
        return addNumberHeader(response, "X-Hiawatha-Ban", asked);
    end;
end module body.
