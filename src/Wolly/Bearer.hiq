--
-- SQL of its own over Standard.Database, as Wolly.Limit: every statement is a
-- constant, every value is bound, the table is strict.
import Standard.String (
    String,
    fromSpan,
    destroyString,
    asSpan,
    length
);
import Standard.Text (
    bytesToHex,
    substring,
    toLower,
    equal
);
import Standard.Database (
    Database,
    Writing,
    DbError,
    Cursor,
    noValues,
    withInt64,
    withText,
    start,
    execute,
    advance,
    columnText,
    finish
);
import Standard.Libcrypto (
    randomBytes,
    sha256
);
import Standard.FcgiServer (
    Request,
    requestParam
);
import Wolly.Dialect (
    pick
);
import Wolly.Response (
    Response,
    makeResponse,
    addHeader,
    finish as finishResponse
);

module body Wolly.Bearer is
    constant tokenBytes: Index := 32;
    constant makeTable: Span[Nat8, Static] := "CREATE TABLE IF NOT EXISTS wolly_tokens (digest TEXT PRIMARY KEY NOT NULL, name TEXT NOT NULL, made INTEGER NOT NULL) STRICT";
    constant makeTablePg: Span[Nat8, Static] := "CREATE TABLE IF NOT EXISTS wolly_tokens (digest TEXT PRIMARY KEY NOT NULL, name TEXT NOT NULL, made BIGINT NOT NULL)";
    constant addToken: Span[Nat8, Static] := "INSERT INTO wolly_tokens (digest, name, made) VALUES (?, ?, ?)";
    constant ownerOf: Span[Nat8, Static] := "SELECT name FROM wolly_tokens WHERE digest = ?";
    constant dropTokens: Span[Nat8, Static] := "DELETE FROM wolly_tokens WHERE name = ?";

    function tokenDigits(): Index is
        return 64;
    end;

    generic [R: Region]
    function prepareTokens(db: &![Database[Writing], R]): Option[DbError] is
        let table: Span[Nat8, Static] := pick(&db, makeTable, makeTablePg);
        case execute(&~db, table, noValues()) of
            when Right(right as made: Nat64) do
                return None();
            when Left(left as error: DbError) do
                return Some(value => error);
        end case;
    end;

    generic [N: Region]
    function isName(name: Span[Nat8, N]): Bool is
        if (spanLength(name) = 0) or (spanLength(name) > 64) then
            return false;
        end if;
        var i: Index := 0;
        while i < spanLength(name) do
            let byte: Nat8 := name[i];
            let letter: Bool := (byte >= 'a') and (byte <= 'z');
            let digit: Bool := (byte >= '0') and (byte <= '9');
            let mark: Bool := ((byte = '.') or (byte = '-')) or (byte = '_');
            if not ((letter or digit) or mark) then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    -- The SHA-256 of text in hex, None when libcrypto fails.
    generic [T: Region]
    function digestOf(text: Span[Nat8, T]): Option[String] is
        case sha256(text) of
            when Some(value as digest: String) do
                let hex: String := bytesToHex(asSpan(&digest));
                destroyString(digest);
                return Some(value => hex);
            when None do
                return None();
        end case;
    end;

    generic [R: Region, N: Region]
    function issueToken(db: &![Database[Writing], R], name: Span[Nat8, N], now: Int64): Either[DbError, Option[String]] is
        if not isName(name) then
            return Right(right => None());
        end if;
        case randomBytes(tokenBytes) of
            when Some(value as raw: String) do
                let token: String := bytesToHex(asSpan(&raw));
                destroyString(raw);
                case digestOf(asSpan(&token)) of
                    when Some(value as digest: String) do
                        let stored: Either[DbError, Nat64] := execute(&~db, addToken, withInt64(withText(withText(noValues(), asSpan(&digest)), name), now));
                        destroyString(digest);
                        case stored of
                            when Right(right as changed: Nat64) do
                                let given: Option[String] := Some(value => token);
                                return Right(right => given);
                            when Left(left as error: DbError) do
                                destroyString(token);
                                return Left(left => error);
                        end case;
                    when None do
                        destroyString(token);
                        return Right(right => None());
                end case;
            when None do
                return Right(right => None());
        end case;
    end;

    generic [M: Free, R: Region, T: Region]
    function tokenOwner(db: &![Database[M], R], token: Span[Nat8, T]): Either[DbError, Option[String]] is
        -- No check of the form: a token of another form has a digest that
        -- was never stored.
        case digestOf(token) of
            when Some(value as digest: String) do
                var cursor: Cursor := start(&~db, ownerOf, withText(noValues(), asSpan(&digest)));
                var owner: Option[String] := None();
                if advance(&!cursor) then
                    case owner of
                        when Some(value as earlier: String) do
                            destroyString(earlier);
                        when None do
                            skip;
                    end case;
                    owner := Some(value => fromSpan(columnText(&cursor, 0)));
                end if;
                destroyString(digest);
                case finish(&~db, cursor) of
                    when Some(value as error: DbError) do
                        case owner of
                            when Some(value as dropped: String) do
                                destroyString(dropped);
                            when None do
                                skip;
                        end case;
                        return Left(left => error);
                    when None do
                        return Right(right => owner);
                end case;
            when None do
                return Right(right => None());
        end case;
    end;

    generic [R: Region, N: Region]
    function revokeTokens(db: &![Database[Writing], R], name: Span[Nat8, N]): Either[DbError, Bool] is
        case execute(&~db, dropTokens, withText(noValues(), name)) of
            when Right(right as changed: Nat64) do
                let revoked: Bool := changed > 0;
                return Right(right => revoked);
            when Left(left as error: DbError) do
                return Left(left => error);
        end case;
    end;

    generic [R: Region]
    function bearerToken(request: &[Request, R]): Option[String] is
        case requestParam(request, "HTTP_AUTHORIZATION") of
            when Some(value as header: String) do
                let token: Option[String] := tokenIn(asSpan(&header));
                destroyString(header);
                return token;
            when None do
                return None();
        end case;
    end;

    -- The token of an Authorization header: Bearer in any case, one or
    -- more spaces, the token, which is not empty.
    generic [H: Region]
    function tokenIn(header: Span[Nat8, H]): Option[String] is
        let size: Index := spanLength(header);
        if size < 8 then
            return None();
        end if;
        let scheme: String := toLower(substring(header, 0, 6));
        let named: Bool := equal(asSpan(&scheme), "bearer");
        destroyString(scheme);
        if (not named) or (header[6] /= ' ') then
            return None();
        end if;
        var at: Index := 6;
        while (at < size) and (header[at] = ' ') do
            at := at + 1;
        end while;
        if at = size then
            return None();
        end if;
        return Some(value => fromSpan(substring(header, at, size)));
    end;

    function unauthorized(): String is
        let response: Response := addHeader(makeResponse(401, "text/plain; charset=utf-8"), "WWW-Authenticate", "Bearer");
        return finishResponse(response, "a bearer token is needed\n");
    end;
end module body.
