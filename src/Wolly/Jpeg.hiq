import Standard.String (
    String,
    destroyString,
    asSpan,
    length
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Buffer (
    Buffer,
    initialize,
    nth,
    storeNth,
    destroyFree
);

module body Wolly.Jpeg is
    constant sideMost: Index := 16000;
    -- One Huffman table in the buffer huff: defined at 0, the counts of
    -- the codes of 1 to 16 bits at 1 to 16, the values at 17 to 272, the
    -- least code of each length at 272 + l, the greatest plus one at
    -- 288 + l (0 for none), the index of its first value at 304 + l.  DC
    -- tables are 0 to 3, AC tables 4 to 7.
    constant tableSize: Index := 330;
    constant valuesAt: Index := 17;
    constant leastAt: Index := 272;
    constant mostAt: Index := 288;
    constant firstAt: Index := 304;
    -- The quantisation tables in the buffer quant: table t at t * 64 in
    -- zigzag order, whether it is defined at 256 + t.
    constant quantDefined: Index := 256;
    -- The frame in the buffer frame: whether it was seen, width, height,
    -- components, restart interval, the greatest horizontal and vertical
    -- sampling factor, whether it is progressive, where its SOF is, the
    -- EXIF orientation, the room of all coefficients; the scan at 16:
    -- its components, their indices, its first and last coefficient and
    -- the high and low bit; component c at 24 + c * 12: identifier,
    -- horizontal and vertical factor, quantisation table, DC and AC table
    -- of the scan, where its coefficients begin, its blocks across and
    -- down (whole units), the blocks across and down the picture covers.
    constant frameSize: Index := 64;
    constant intervalAt: Index := 4;
    constant progressiveAt: Index := 7;
    constant sofAt: Index := 8;
    constant orientationAt: Index := 9;
    constant coefficientsAt: Index := 10;
    constant scanAt: Index := 16;
    constant componentsAt: Index := 24;
    constant componentSize: Index := 12;
    -- For angles in sixteenths of a half turn.
    constant halfTurn: Index := 16;
    constant fullTurn: Index := 32;

    record JpegPicture: Linear is
        width: Index;
        height: Index;
        pixels: String;
        invariant (width >= 1) and (width <= 16000);
        invariant (height >= 1) and (height <= 16000);
        invariant length(&pixels) = ((width * height) * 3);
    end;

    -- Where the entropy-coded data is read: the next byte at at, the bits
    -- of byte not read yet (left of them), whether a read went past a
    -- marker or the end, and the blocks still at end of band in a
    -- progressive AC scan.
    record Bits: Free is
        at: Index;
        byte: Index;
        left: Index;
        overrun: Bool;
        run: Index;
    end;

    -- Where a scan ended: the next marker, or the code of failed.
    record ScanEnd: Free is
        at: Index;
        code: Index;
    end;

    function wide(byte: Nat8): Index is
        case toIndex(byte) of
            when Some(value as n: Index) do
                return n;
            when None do
                return 0;
        end case;
    end;

    function narrow(n: Index): Nat8 is
        case toNat8(n) of
            when Some(value as b: Nat8) do
                return b;
            when None do
                return 0;
        end case;
    end;

    function real(n: Index): Float64 is
        case toFloat64(n) of
            when Some(value as f: Float64) do
                return f;
            when None do
                return 0.0;
        end case;
    end;

    -- The sample of v: rounded, 0 below 0, 255 above 255.
    function level(v: Float64): Nat8 is
        if v <= 0.0 then
            return 0;
        end if;
        if v >= 255.0 then
            return 255;
        end if;
        case toIndex(v + 0.5) of
            when Some(value as n: Index) do
                return narrow(n);
            when None do
                return 0;
        end case;
    end;

    -- The big-endian 16 bits at at.
    generic [D: Region]
    function big(data: Span[Nat8, D], at: Index): Index is
        return (wide(data[at]) * 256) + wide(data[at + 1]);
    end;

    -- 2 to the n, n at most 16.
    function power(n: Index): Index is
        var p: Index := 1;
        var i: Index := 0;
        while i < n do
            p := p * 2;
            i := i + 1;
        end while;
        return p;
    end;

    -- The natural position of the k-th coefficient in zigzag order, at k:
    -- the diagonals of row plus column s, up and to the right when s is
    -- even, down and to the left when it is odd.
    function zigzag(): Buffer[Index] is
        var order: Buffer[Index] := initialize(64, (0 : Index));
        var k: Index := 0;
        var s: Index := 0;
        while s < 15 do
            var least: Index := 0;
            if s > 7 then
                least := s - 7;
            end if;
            var most: Index := s;
            if most > 7 then
                most := (7 : Index);
            end if;
            var i: Index := least;
            while i <= most do
                var row: Index := i;
                if bitwiseAnd(s, (1 : Index)) = 0 then
                    row := (least + most) - i;
                end if;
                storeNth(&!order, k, (row * 8) + (s - row));
                k := k + 1;
                i := i + 1;
            end while;
            s := s + 1;
        end while;
        return order;
    end;

    -- cos(k pi / 16) for k from 0 to 8.
    function eighth(k: Index): Float64 is
        if k = 0 then
            return 1.0;
        end if;
        if k = 1 then
            return 0.9807852804032304;
        end if;
        if k = 2 then
            return 0.9238795325112867;
        end if;
        if k = 3 then
            return 0.8314696123025452;
        end if;
        if k = 4 then
            return 0.7071067811865476;
        end if;
        if k = 5 then
            return 0.5555702330196022;
        end if;
        if k = 6 then
            return 0.3826834323650898;
        end if;
        if k = 7 then
            return 0.19509032201612825;
        end if;
        return 0.0;
    end;

    -- cos(m pi / 16) for any m.
    function cosine(m: Index): Float64 is
        var k: Index := m - ((m / fullTurn) * fullTurn);
        if k > halfTurn then
            k := fullTurn - k;
        end if;
        if k > 8 then
            let zero: Float64 := 0.0;
            return zero - eighth(halfTurn - k);
        end if;
        return eighth(k);
    end;

    -- The factors of the inverse DCT: at u * 8 + x, C(u) / 2 times
    -- cos((2x + 1) u pi / 16), C(0) the root of one half, else 1.
    function cosines(): Buffer[Float64] is
        let zero: Float64 := 0.0;
        var table: Buffer[Float64] := initialize(64, zero);
        var u: Index := 0;
        while u < 8 do
            var scale: Float64 := 0.5;
            if u = 0 then
                scale := 0.35355339059327373;
            end if;
            var x: Index := 0;
            while x < 8 do
                storeNth(&!table, (u * 8) + x, scale * cosine(((x * 2) + 1) * u));
                x := x + 1;
            end while;
            u := u + 1;
        end while;
        return table;
    end;

    -- DHT: the tables of the segment, with their codes as T.81 C.2 and
    -- F.2.2.3 make them; false when they do not fit or overflow.
    generic [D: Region, H: Region]
    function huffSegment(data: Span[Nat8, D], seg: Index, segLength: Index, huff: &![Buffer[Index], H]): Bool is
        let stop: Index := seg + segLength;
        var p: Index := seg;
        while p < stop do
            if (p + 17) > stop then
                return false;
            end if;
            let kind: Index := wide(data[p]) / 16;
            let which: Index := bitwiseAnd(wide(data[p]), (15 : Index));
            if (kind > 1) or (which > 3) then
                return false;
            end if;
            var total: Index := 0;
            var l: Index := 1;
            while l <= 16 do
                total := total + wide(data[p + l]);
                l := l + 1;
            end while;
            if (total > 256) or (((p + 17) + total) > stop) then
                return false;
            end if;
            let base: Index := ((kind * 4) + which) * tableSize;
            var i: Index := 0;
            while i < total do
                storeNth(&~huff, (base + valuesAt) + i, wide(data[(p + 17) + i]));
                i := i + 1;
            end while;
            var code: Index := 0;
            var k: Index := 0;
            l := (1 : Index);
            while l <= 16 do
                let n: Index := wide(data[p + l]);
                storeNth(&~huff, base + l, n);
                if n > 0 then
                    storeNth(&~huff, (base + firstAt) + l, k);
                    storeNth(&~huff, (base + leastAt) + l, code);
                    code := code + n;
                    k := k + n;
                    if code > power(l) then
                        return false;
                    end if;
                    storeNth(&~huff, (base + mostAt) + l, code);
                else
                    storeNth(&~huff, (base + mostAt) + l, (0 : Index));
                end if;
                code := code * 2;
                l := l + 1;
            end while;
            storeNth(&~huff, base, (1 : Index));
            p := (p + 17) + total;
        end while;
        return true;
    end;

    -- DQT: the tables of the segment, of 8 or 16 bits; false when they do
    -- not fit or hold a 0.
    generic [D: Region, Q: Region]
    function quantSegment(data: Span[Nat8, D], seg: Index, segLength: Index, quant: &![Buffer[Index], Q]): Bool is
        let stop: Index := seg + segLength;
        var p: Index := seg;
        while p < stop do
            let precision: Index := wide(data[p]) / 16;
            let which: Index := bitwiseAnd(wide(data[p]), (15 : Index));
            if (precision > 1) or (which > 3) then
                return false;
            end if;
            let need: Index := ((precision + 1) * 64) + 1;
            if (p + need) > stop then
                return false;
            end if;
            var k: Index := 0;
            while k < 64 do
                var q: Index := wide(data[(p + 1) + k]);
                if precision = 1 then
                    q := big(data, (p + 1) + (k * 2));
                end if;
                if q = 0 then
                    return false;
                end if;
                storeNth(&~quant, (which * 64) + k, q);
                k := k + 1;
            end while;
            storeNth(&~quant, quantDefined + which, (1 : Index));
            p := p + need;
        end while;
        return true;
    end;

    -- The next bit of the entropy-coded data; 0 and overrun past a marker
    -- or the end.
    generic [D: Region, B: Region]
    function nextBit(data: Span[Nat8, D], bits: &![Bits, B]): Index is
        if bits->left = 0 then
            let at: Index := bits->at;
            let size: Index := spanLength(data);
            if at >= size then
                bits->overrun := true;
                return 0;
            end if;
            let byte: Index := wide(data[at]);
            var next: Index := at + 1;
            if byte = 255 then
                if (at + 1) >= size then
                    bits->overrun := true;
                    return 0;
                end if;
                if data[at + 1] /= (0 : Nat8) then
                    bits->overrun := true;
                    return 0;
                end if;
                next := at + 2;
            end if;
            bits->at := next;
            bits->byte := byte;
            bits->left := (8 : Index);
        end if;
        let left: Index := (bits->left) - 1;
        bits->left := left;
        return bitwiseAnd((bits->byte) / power(left), (1 : Index));
    end;

    -- The next n bits, the first the most significant.
    generic [D: Region, B: Region]
    function receive(data: Span[Nat8, D], bits: &![Bits, B], n: Index): Index is
        var v: Index := 0;
        var i: Index := 0;
        while i < n do
            v := (v * 2) + nextBit(data, &~bits);
            i := i + 1;
        end while;
        return v;
    end;

    -- The value of the n bits v as T.81 F.2.2.1 extends them: below half
    -- of 2 to the n they are negative.
    function extend(v: Index, n: Index): Float64 is
        if v < power(n - 1) then
            return real(v) - real(power(n) - 1);
        end if;
        return real(v);
    end;

    -- The value of the next code of table t, as T.81 F.2.2.3 decodes it;
    -- 256 for a code of more than 16 bits.
    generic [D: Region, B: Region, H: Region]
    function decode(data: Span[Nat8, D], bits: &![Bits, B], huff: &[Buffer[Index], H], t: Index): Index is
        let base: Index := t * tableSize;
        var code: Index := nextBit(data, &~bits);
        var l: Index := 1;
        while (l <= 16) and ((nth(huff, (base + mostAt) + l) = 0) or (code >= nth(huff, (base + mostAt) + l))) do
            code := (code * 2) + nextBit(data, &~bits);
            l := l + 1;
        end while;
        if l > 16 then
            return 256;
        end if;
        let index: Index := (nth(huff, (base + firstAt) + l) + code) - nth(huff, (base + leastAt) + l);
        return nth(huff, (base + valuesAt) + index);
    end;

    -- The inverse DCT of the block in coefficients, written as samples to
    -- plane from at, stride samples a row: rows first, then columns.
    generic [C: Region, T: Region, W: Region, P: Region]
    function inverse(coefficients: &[Buffer[Float64], C], table: &[Buffer[Float64], T], work: &![Buffer[Float64], W],
                     plane: &![Buffer[Nat8], P], at: Index, stride: Index): Unit is
        var v: Index := 0;
        while v < 8 do
            var x: Index := 0;
            while x < 8 do
                var sum: Float64 := 0.0;
                var u: Index := 0;
                while u < 8 do
                    sum := sum + (nth(table, (u * 8) + x) * nth(coefficients, (v * 8) + u));
                    u := u + 1;
                end while;
                storeNth(&~work, (v * 8) + x, sum);
                x := x + 1;
            end while;
            v := v + 1;
        end while;
        var y: Index := 0;
        while y < 8 do
            var x: Index := 0;
            while x < 8 do
                var sum: Float64 := 128.0;
                var w: Index := 0;
                while w < 8 do
                    sum := sum + (nth(table, (w * 8) + y) * nth(&work, (w * 8) + x));
                    w := w + 1;
                end while;
                storeNth(&~plane, (at + (y * stride)) + x, level(sum));
                x := x + 1;
            end while;
            y := y + 1;
        end while;
        return nil;
    end;

    -- After a restart interval: the marker RST0 to RST7 at the next byte,
    -- skipped; false when it is not there.
    generic [D: Region, B: Region]
    function restart(data: Span[Nat8, D], bits: &![Bits, B]): Bool is
        let size: Index := spanLength(data);
        var at: Index := bits->at;
        while ((at + 2) < size) and ((data[at] = (255 : Nat8)) and (data[at + 1] = (255 : Nat8))) do
            at := at + 1;
        end while;
        if (at + 1) >= size then
            return false;
        end if;
        let marker: Index := wide(data[at + 1]);
        if (data[at] /= (255 : Nat8)) or ((marker < 208) or (marker > 215)) then
            return false;
        end if;
        bits->at := at + 2;
        bits->left := (0 : Index);
        return true;
    end;

    -- A failed read: 1 Broken, 2 Unsupported, 3 too large.
    function failed(code: Index): Either[JpegError, JpegPicture] is
        if code = 2 then
            return Left(left => Unsupported());
        end if;
        if code = 3 then
            return Left(left => JpegTooLarge());
        end if;
        return Left(left => JpegBroken());
    end;

    generic [D: Region]
    function readJpeg(data: Span[Nat8, D], maxPixels: Index): Either[JpegError, JpegPicture] is
        if spanLength(data) < 4 then
            return Left(left => NotJpeg());
        end if;
        if (data[0] /= (255 : Nat8)) or (data[1] /= (216 : Nat8)) then
            return Left(left => NotJpeg());
        end if;
        var frame: Buffer[Index] := initialize(frameSize, (0 : Index));
        storeNth(&!frame, orientationAt, (1 : Index));
        let code: Index := frameFirst(data, maxPixels, &!frame);
        if code /= 0 then
            destroyFree(frame);
            return failed(code);
        else
            var huff: Buffer[Index] := initialize(tableSize * 8, (0 : Index));
            var quant: Buffer[Index] := initialize(260, (0 : Index));
            let zero: Int16 := 0;
            var store: Buffer[Int16] := initialize(nth(&frame, coefficientsAt), zero);
            let result: Either[JpegError, JpegPicture] := segments(data, &!huff, &!quant, &!frame, &!store);
            destroyFree(huff);
            destroyFree(quant);
            destroyFree(frame);
            destroyFree(store);
            return result;
        end if;
    end;

    -- The segments before the frame, up to SOF: each length checked, the
    -- frame read; 0 when it was, else the code of failed.  The tables and
    -- the scans are read after, when the coefficients have their room.
    generic [D: Region, F: Region]
    function frameFirst(data: Span[Nat8, D], maxPixels: Index, frame: &![Buffer[Index], F]): Index is
        let size: Index := spanLength(data);
        var at: Index := 2;
        while at < size do
            if (data[at] /= (255 : Nat8)) or ((at + 1) >= size) then
                return 1;
            end if;
            let marker: Index := wide(data[at + 1]);
            if marker = 255 then
                at := at + 1;
            else
                if (marker = 1) or ((marker >= 208) and (marker <= 215)) then
                    at := at + 2;
                else
                    if ((marker = 216) or (marker = 217)) or ((at + 3) >= size) then
                        return 1;
                    end if;
                    let count: Index := big(data, at + 2);
                    if (count < 2) or (((at + 2) + count) > size) then
                        return 1;
                    end if;
                    if marker = 218 then
                        -- a scan before the frame
                        return 1;
                    end if;
                    if ((marker = 192) or (marker = 193)) or (marker = 194) then
                        storeNth(&~frame, sofAt, at);
                        if marker = 194 then
                            storeNth(&~frame, progressiveAt, (1 : Index));
                        end if;
                        return frameSegment(data, at + 4, count - 2, maxPixels, &~frame);
                    end if;
                    if ((marker >= 195) and (marker <= 207)) and (marker /= 196) then
                        -- lossless, hierarchical or arithmetic frames, DAC
                        return 2;
                    end if;
                    at := (at + 2) + count;
                end if;
            end if;
        end while;
        return 1;
    end;

    -- The segments after SOI: tables, restart interval, orientation, and
    -- each scan; at EOI, or at the end after a scan, the picture.
    generic [D: Region, H: Region, Q: Region, F: Region, S: Region]
    function segments(data: Span[Nat8, D], huff: &![Buffer[Index], H], quant: &![Buffer[Index], Q],
                      frame: &![Buffer[Index], F], store: &![Buffer[Int16], S]): Either[JpegError, JpegPicture] is
        let size: Index := spanLength(data);
        var scans: Index := 0;
        var at: Index := 2;
        while at < size do
            if (data[at] /= (255 : Nat8)) or ((at + 1) >= size) then
                return failed(1);
            end if;
            let marker: Index := wide(data[at + 1]);
            if marker = 255 then
                at := at + 1;
            else
                if (marker = 1) or ((marker >= 208) and (marker <= 215)) then
                    at := at + 2;
                else
                    if marker = 217 then
                        if scans = 0 then
                            return failed(1);
                        end if;
                        return finished(&huff, &quant, &frame, &store);
                    end if;
                    if (marker = 216) or ((at + 3) >= size) then
                        return failed(1);
                    end if;
                    let count: Index := big(data, at + 2);
                    if (count < 2) or (((at + 2) + count) > size) then
                        return failed(1);
                    end if;
                    let seg: Index := at + 4;
                    let segLength: Index := count - 2;
                    if (((marker = 192) or (marker = 193)) or (marker = 194)) and (at /= nth(&frame, sofAt)) then
                        -- a second frame
                        return failed(1);
                    end if;
                    if marker = 196 then
                        if not huffSegment(data, seg, segLength, &~huff) then
                            return failed(1);
                        end if;
                    end if;
                    if marker = 219 then
                        if not quantSegment(data, seg, segLength, &~quant) then
                            return failed(1);
                        end if;
                    end if;
                    if marker = 221 then
                        if segLength /= 2 then
                            return failed(1);
                        end if;
                        storeNth(&~frame, intervalAt, big(data, seg));
                    end if;
                    if marker = 225 then
                        let turn: Index := orientation(data, seg, segLength);
                        if turn /= 0 then
                            storeNth(&~frame, orientationAt, turn);
                        end if;
                    end if;
                    var next: Index := (at + 2) + count;
                    if marker = 218 then
                        let code: Index := scanHeader(data, seg, segLength, &huff, &~frame);
                        if code /= 0 then
                            return failed(code);
                        end if;
                        let ended: ScanEnd := scanData(data, next, &huff, &frame, &~store);
                        if ended.code /= 0 then
                            return failed(ended.code);
                        end if;
                        scans := scans + 1;
                        next := ended.at;
                    end if;
                    at := next;
                end if;
            end if;
        end while;
        if scans = 0 then
            return failed(1);
        end if;
        return finished(&huff, &quant, &frame, &store);
    end;

    -- SOF0, SOF1 or SOF2: 0 when read, else the code of failed; the room
    -- of each component's coefficients laid out.
    generic [D: Region, F: Region]
    function frameSegment(data: Span[Nat8, D], seg: Index, segLength: Index, maxPixels: Index,
                          frame: &![Buffer[Index], F]): Index is
        if segLength < 6 then
            return 1;
        end if;
        let precision: Index := wide(data[seg]);
        let height: Index := big(data, seg + 1);
        let width: Index := big(data, seg + 3);
        let count: Index := wide(data[seg + 5]);
        if precision /= 8 then
            return 2;
        end if;
        if count = 0 then
            return 1;
        end if;
        if (count /= 1) and (count /= 3) then
            return 2;
        end if;
        if segLength /= ((count * 3) + 6) then
            return 1;
        end if;
        if height = 0 then
            -- the height comes later in a DNL segment
            return 2;
        end if;
        if width = 0 then
            return 1;
        end if;
        if ((width > sideMost) or (height > sideMost)) or ((width * height) > maxPixels) then
            return 3;
        end if;
        var hMost: Index := 1;
        var vMost: Index := 1;
        var c: Index := 0;
        while c < count do
            let at: Index := (seg + 6) + (c * 3);
            let factors: Index := wide(data[at + 1]);
            var h: Index := factors / 16;
            var v: Index := bitwiseAnd(factors, (15 : Index));
            let table: Index := wide(data[at + 2]);
            if ((h < 1) or (v < 1)) or (table > 3) then
                return 1;
            end if;
            if (h > 2) or (v > 2) then
                return 2;
            end if;
            if count = 1 then
                -- one component is one block a unit, whatever its factors
                h := (1 : Index);
                v := (1 : Index);
            end if;
            if h > hMost then
                hMost := h;
            end if;
            if v > vMost then
                vMost := v;
            end if;
            let base: Index := componentsAt + (c * componentSize);
            storeNth(&~frame, base, wide(data[at]));
            storeNth(&~frame, base + 1, h);
            storeNth(&~frame, base + 2, v);
            storeNth(&~frame, base + 3, table);
            c := c + 1;
        end while;
        let unitsAcross: Index := ((width + (hMost * 8)) - 1) / (hMost * 8);
        let unitsDown: Index := ((height + (vMost * 8)) - 1) / (vMost * 8);
        var room: Index := 0;
        c := (0 : Index);
        while c < count do
            let base: Index := componentsAt + (c * componentSize);
            let h: Index := nth(&frame, base + 1);
            let v: Index := nth(&frame, base + 2);
            let columns: Index := ((width * h) + (hMost - 1)) / hMost;
            let rows: Index := ((height * v) + (vMost - 1)) / vMost;
            storeNth(&~frame, base + 6, room);
            storeNth(&~frame, base + 7, unitsAcross * h);
            storeNth(&~frame, base + 8, unitsDown * v);
            storeNth(&~frame, base + 9, (columns + 7) / 8);
            storeNth(&~frame, base + 10, (rows + 7) / 8);
            room := room + (((unitsAcross * h) * (unitsDown * v)) * 64);
            c := c + 1;
        end while;
        storeNth(&~frame, 0, (1 : Index));
        storeNth(&~frame, 1, width);
        storeNth(&~frame, 2, height);
        storeNth(&~frame, 3, count);
        storeNth(&~frame, 5, hMost);
        storeNth(&~frame, 6, vMost);
        storeNth(&~frame, coefficientsAt, room);
        return 0;
    end;

    -- The orientation of an APP1 segment of EXIF: tag 0112 of the first
    -- IFD, 1 to 8; 0 for any other segment (XMP) and for EXIF without a
    -- readable one.
    generic [D: Region]
    function orientation(data: Span[Nat8, D], seg: Index, segLength: Index): Index is
        if segLength < 14 then
            return 0;
        end if;
        let exif: Bool := ((data[seg] = 'E') and (data[seg + 1] = 'x')) and ((data[seg + 2] = 'i') and (data[seg + 3] = 'f'));
        if (not exif) or ((data[seg + 4] /= (0 : Nat8)) or (data[seg + 5] /= (0 : Nat8))) then
            return 0;
        end if;
        let tiff: Index := seg + 6;
        let stop: Index := seg + segLength;
        var little: Bool := false;
        if (data[tiff] = 'I') and (data[tiff + 1] = 'I') then
            little := true;
        else
            if (data[tiff] /= 'M') or (data[tiff + 1] /= 'M') then
                return 0;
            end if;
        end if;
        if tiffWord(data, tiff + 2, little) /= 42 then
            return 0;
        end if;
        let first: Index := tiffLong(data, tiff + 4, little);
        if (first > segLength) or (((tiff + first) + 2) > stop) then
            return 0;
        end if;
        let entries: Index := tiffWord(data, tiff + first, little);
        var i: Index := 0;
        while i < entries do
            let entry: Index := ((tiff + first) + 2) + (i * 12);
            if (entry + 12) > stop then
                return 0;
            end if;
            if (tiffWord(data, entry, little) = 274) and (tiffWord(data, entry + 2, little) = 3) then
                let value: Index := tiffWord(data, entry + 8, little);
                if (value >= 1) and (value <= 8) then
                    return value;
                end if;
                return 0;
            end if;
            i := i + 1;
        end while;
        return 0;
    end;

    generic [D: Region]
    function tiffWord(data: Span[Nat8, D], at: Index, little: Bool): Index is
        if little then
            return wide(data[at]) + (wide(data[at + 1]) * 256);
        end if;
        return (wide(data[at]) * 256) + wide(data[at + 1]);
    end;

    generic [D: Region]
    function tiffLong(data: Span[Nat8, D], at: Index, little: Bool): Index is
        if little then
            return tiffWord(data, at, true) + (tiffWord(data, at + 2, true) * 65536);
        end if;
        return (tiffWord(data, at, false) * 65536) + tiffWord(data, at + 2, false);
    end;

    -- SOS: the components of the scan and their tables, its band of
    -- coefficients and its bits; 0 when the scan is one this reader
    -- decodes, else the code of failed.
    generic [D: Region, H: Region, F: Region]
    function scanHeader(data: Span[Nat8, D], seg: Index, segLength: Index, huff: &[Buffer[Index], H],
                        frame: &![Buffer[Index], F]): Index is
        if segLength < 1 then
            return 1;
        end if;
        let count: Index := wide(data[seg]);
        if ((count < 1) or (count > nth(&frame, 3))) or (segLength /= ((count * 2) + 4)) then
            return 1;
        end if;
        let after: Index := (seg + 1) + (count * 2);
        let first: Index := wide(data[after]);
        let last: Index := wide(data[after + 1]);
        let high: Index := wide(data[after + 2]) / 16;
        let low: Index := bitwiseAnd(wide(data[after + 2]), (15 : Index));
        if nth(&frame, progressiveAt) = 0 then
            if ((first /= 0) or (last /= 63)) or ((high /= 0) or (low /= 0)) then
                return 1;
            end if;
        else
            if ((first > last) or (last > 63)) or (low > 13) then
                return 1;
            end if;
            if ((first = 0) and (last /= 0)) or ((first > 0) and (count /= 1)) then
                return 1;
            end if;
            if (high /= 0) and (high /= (low + 1)) then
                return 1;
            end if;
        end if;
        var i: Index := 0;
        while i < count do
            let id: Index := wide(data[(seg + 1) + (i * 2)]);
            let tables: Index := wide(data[(seg + 2) + (i * 2)]);
            let dc: Index := tables / 16;
            let ac: Index := bitwiseAnd(tables, (15 : Index));
            var c: Index := 0;
            var found: Index := 4;
            while c < nth(&frame, 3) do
                if nth(&frame, componentsAt + (c * componentSize)) = id then
                    found := c;
                end if;
                c := c + 1;
            end while;
            if ((found = 4) or (dc > 3)) or (ac > 3) then
                return 1;
            end if;
            let needsDc: Bool := (first = 0) and (high = 0);
            let needsAc: Bool := last > 0;
            if needsDc and (nth(huff, dc * tableSize) /= 1) then
                return 1;
            end if;
            if needsAc and (nth(huff, (ac + 4) * tableSize) /= 1) then
                return 1;
            end if;
            let base: Index := componentsAt + (found * componentSize);
            storeNth(&~frame, base + 4, dc);
            storeNth(&~frame, base + 5, ac);
            storeNth(&~frame, (scanAt + 1) + i, found);
            i := i + 1;
        end while;
        storeNth(&~frame, scanAt, count);
        storeNth(&~frame, scanAt + 4, first);
        storeNth(&~frame, scanAt + 5, last);
        storeNth(&~frame, scanAt + 6, high);
        storeNth(&~frame, scanAt + 7, low);
        return 0;
    end;

    -- The coefficient at index of the store, and a value put there, held to
    -- what 16 bits take (only broken data comes near).
    generic [S: Region]
    function coefficient(store: &[Buffer[Int16], S], index: Index): Float64 is
        case toFloat64(nth(store, index)) of
            when Some(value as f: Float64) do
                return f;
            when None do
                return 0.0;
        end case;
    end;

    generic [S: Region]
    function putCoefficient(store: &![Buffer[Int16], S], index: Index, value: Float64): Unit is
        var v: Float64 := value;
        if v > 32767.0 then
            v := 32767.0;
        end if;
        if v < -32768.0 then
            v := -32768.0;
        end if;
        case toInt16(v) of
            when Some(value as n: Int16) do
                storeNth(&~store, index, n);
            when None do
                skip;
        end case;
        return nil;
    end;

    -- 2 to the n as a Float64, n at most 13.
    function weight(n: Index): Float64 is
        return real(power(n));
    end;

    -- A block of a sequential scan: DC and AC as T.81 F.2.2 decodes them,
    -- at their natural place from at; false when the data is not what the
    -- tables say.
    generic [D: Region, B: Region, H: Region, F: Region, Z: Region, S: Region, P: Region]
    function sequentialBlock(data: Span[Nat8, D], bits: &![Bits, B], huff: &[Buffer[Index], H], frame: &[Buffer[Index], F],
                             order: &[Buffer[Index], Z], c: Index, at: Index, store: &![Buffer[Int16], S],
                             predictions: &![Buffer[Float64], P]): Bool is
        let base: Index := componentsAt + (c * componentSize);
        let size: Index := decode(data, &~bits, huff, nth(frame, base + 4));
        if size > 11 then
            return false;
        end if;
        var difference: Float64 := 0.0;
        if size > 0 then
            difference := extend(receive(data, &~bits, size), size);
        end if;
        let dc: Float64 := nth(&predictions, c) + difference;
        storeNth(&~predictions, c, dc);
        putCoefficient(&~store, at, dc);
        let ac: Index := nth(frame, base + 5) + 4;
        var k: Index := 1;
        var going: Bool := true;
        while going and (k < 64) do
            let rs: Index := decode(data, &~bits, huff, ac);
            if rs > 255 then
                return false;
            end if;
            let run: Index := rs / 16;
            let bitCount: Index := bitwiseAnd(rs, (15 : Index));
            if bitCount = 0 then
                if run = 15 then
                    k := k + 16;
                else
                    going := false;
                end if;
            else
                k := k + run;
                if (k > 63) or (bitCount > 10) then
                    return false;
                end if;
                putCoefficient(&~store, at + nth(order, k), extend(receive(data, &~bits, bitCount), bitCount));
                k := k + 1;
            end if;
        end while;
        return true;
    end;

    -- The DC coefficient of a progressive scan (T.81 G.1.2.1): the first
    -- scan the difference shifted by low, a refinement one bit.
    generic [D: Region, B: Region, H: Region, F: Region, S: Region, P: Region]
    function dcBlock(data: Span[Nat8, D], bits: &![Bits, B], huff: &[Buffer[Index], H], frame: &[Buffer[Index], F],
                     c: Index, at: Index, store: &![Buffer[Int16], S], predictions: &![Buffer[Float64], P]): Bool is
        let high: Index := nth(frame, scanAt + 6);
        let low: Index := nth(frame, scanAt + 7);
        if high = 0 then
            let base: Index := componentsAt + (c * componentSize);
            let size: Index := decode(data, &~bits, huff, nth(frame, base + 4));
            if size > 11 then
                return false;
            end if;
            var difference: Float64 := 0.0;
            if size > 0 then
                difference := extend(receive(data, &~bits, size), size);
            end if;
            let dc: Float64 := nth(&predictions, c) + difference;
            storeNth(&~predictions, c, dc);
            putCoefficient(&~store, at, dc * weight(low));
        else
            if nextBit(data, &~bits) = 1 then
                let old: Float64 := coefficient(&store, at);
                putCoefficient(&~store, at, old + weight(low));
            end if;
        end if;
        return true;
    end;

    -- The AC coefficients first..last of a first progressive scan (T.81
    -- G.1.2.2), with runs of blocks at end of band in bits->run.
    generic [D: Region, B: Region, H: Region, F: Region, Z: Region, S: Region]
    function acFirstBlock(data: Span[Nat8, D], bits: &![Bits, B], huff: &[Buffer[Index], H], frame: &[Buffer[Index], F],
                          order: &[Buffer[Index], Z], c: Index, at: Index, store: &![Buffer[Int16], S]): Bool is
        if bits->run > 0 then
            bits->run := (bits->run) - 1;
            return true;
        end if;
        let ac: Index := nth(frame, (componentsAt + (c * componentSize)) + 5) + 4;
        let last: Index := nth(frame, scanAt + 5);
        let low: Index := nth(frame, scanAt + 7);
        var k: Index := nth(frame, scanAt + 4);
        var going: Bool := true;
        while going and (k <= last) do
            let rs: Index := decode(data, &~bits, huff, ac);
            if rs > 255 then
                return false;
            end if;
            let run: Index := rs / 16;
            let bitCount: Index := bitwiseAnd(rs, (15 : Index));
            if bitCount = 0 then
                if run = 15 then
                    k := k + 16;
                else
                    -- end of band: this block and 2^run - 1 + bits more
                    var blocks: Index := power(run);
                    if run > 0 then
                        blocks := blocks + receive(data, &~bits, run);
                    end if;
                    bits->run := blocks - 1;
                    going := false;
                end if;
            else
                k := k + run;
                if (k > last) or (bitCount > 10) then
                    return false;
                end if;
                putCoefficient(&~store, at + nth(order, k), extend(receive(data, &~bits, bitCount), bitCount) * weight(low));
                k := k + 1;
            end if;
        end while;
        return true;
    end;

    -- A coefficient already not 0 in a refinement scan: one bit more of
    -- its magnitude, away from 0, when the bit says so.  Its bit low is 0
    -- before (the scans before gave the bits above it), so the test of
    -- libjpeg whether it is set already is left out.
    generic [D: Region, B: Region, S: Region]
    function refine(data: Span[Nat8, D], bits: &![Bits, B], store: &![Buffer[Int16], S], index: Index, low: Index): Unit is
        let v: Float64 := coefficient(&store, index);
        if nextBit(data, &~bits) = 1 then
            if v >= 0.0 then
                putCoefficient(&~store, index, v + weight(low));
            else
                putCoefficient(&~store, index, v - weight(low));
            end if;
        end if;
        return nil;
    end;

    -- The AC coefficients first..last of a refinement scan (T.81 G.1.2.3,
    -- as libjpeg's decode_mcu_AC_refine reads it).
    generic [D: Region, B: Region, H: Region, F: Region, Z: Region, S: Region]
    function acRefineBlock(data: Span[Nat8, D], bits: &![Bits, B], huff: &[Buffer[Index], H], frame: &[Buffer[Index], F],
                           order: &[Buffer[Index], Z], c: Index, at: Index, store: &![Buffer[Int16], S]): Bool is
        let ac: Index := nth(frame, (componentsAt + (c * componentSize)) + 5) + 4;
        let last: Index := nth(frame, scanAt + 5);
        let low: Index := nth(frame, scanAt + 7);
        var k: Index := nth(frame, scanAt + 4);
        if bits->run = 0 then
            var going: Bool := true;
            while going and (k <= last) do
                let rs: Index := decode(data, &~bits, huff, ac);
                if rs > 255 then
                    return false;
                end if;
                var run: Index := rs / 16;
                let bitCount: Index := bitwiseAnd(rs, (15 : Index));
                var value: Float64 := 0.0;
                var placing: Bool := false;
                var ending: Bool := false;
                if bitCount /= 0 then
                    if bitCount /= 1 then
                        return false;
                    end if;
                    placing := true;
                    if nextBit(data, &~bits) = 1 then
                        value := weight(low);
                    else
                        let zero: Float64 := 0.0;
                        value := zero - weight(low);
                    end if;
                else
                    if run /= 15 then
                        var blocks: Index := power(run);
                        if run > 0 then
                            blocks := blocks + receive(data, &~bits, run);
                        end if;
                        bits->run := blocks;
                        ending := true;
                        going := false;
                    end if;
                end if;
                if not ending then
                    -- skip run coefficients that are 0, refining the others
                    -- on the way; the new one goes at the next 0
                    var walking: Bool := true;
                    while walking and (k <= last) do
                        let index: Index := at + nth(order, k);
                        if nth(&store, index) /= (0 : Int16) then
                            refine(data, &~bits, &~store, index, low);
                            k := k + 1;
                        else
                            if run = 0 then
                                walking := false;
                            else
                                run := run - 1;
                                k := k + 1;
                            end if;
                        end if;
                    end while;
                    if placing then
                        if k > last then
                            return false;
                        end if;
                        putCoefficient(&~store, at + nth(order, k), value);
                    end if;
                    k := k + 1;
                end if;
            end while;
        end if;
        if bits->run > 0 then
            -- end of band: only the coefficients not 0 take a bit
            while k <= last do
                let index: Index := at + nth(order, k);
                if nth(&store, index) /= (0 : Int16) then
                    refine(data, &~bits, &~store, index, low);
                end if;
                k := k + 1;
            end while;
            bits->run := (bits->run) - 1;
        end if;
        return true;
    end;

    -- One block of the scan at block column bx and row by of component c.
    generic [D: Region, B: Region, H: Region, F: Region, Z: Region, S: Region, P: Region]
    function scanBlock(data: Span[Nat8, D], bits: &![Bits, B], huff: &[Buffer[Index], H], frame: &[Buffer[Index], F],
                       order: &[Buffer[Index], Z], c: Index, bx: Index, by: Index, store: &![Buffer[Int16], S],
                       predictions: &![Buffer[Float64], P]): Bool is
        let base: Index := componentsAt + (c * componentSize);
        let at: Index := nth(frame, base + 6) + (((by * nth(frame, base + 7)) + bx) * 64);
        if nth(frame, progressiveAt) = 0 then
            return sequentialBlock(data, &~bits, huff, frame, order, c, at, &~store, &~predictions);
        end if;
        if nth(frame, scanAt + 4) = 0 then
            return dcBlock(data, &~bits, huff, frame, c, at, &~store, &~predictions);
        end if;
        if nth(frame, scanAt + 6) = 0 then
            return acFirstBlock(data, &~bits, huff, frame, order, c, at, &~store);
        end if;
        return acRefineBlock(data, &~bits, huff, frame, order, c, at, &~store);
    end;

    -- The entropy-coded data of a scan from at: one component block by
    -- block over the blocks the picture covers, several unit by unit;
    -- where the next marker is, or the code of failed.
    generic [D: Region, H: Region, F: Region, S: Region]
    function scanData(data: Span[Nat8, D], at: Index, huff: &[Buffer[Index], H], frame: &[Buffer[Index], F],
                      store: &![Buffer[Int16], S]): ScanEnd is
        let count: Index := nth(frame, scanAt);
        let interval: Index := nth(frame, intervalAt);
        let hMost: Index := nth(frame, 5);
        let vMost: Index := nth(frame, 6);
        let only: Index := nth(frame, scanAt + 1);
        let onlyBase: Index := componentsAt + (only * componentSize);
        var unitsAcross: Index := ((nth(frame, 1) + (hMost * 8)) - 1) / (hMost * 8);
        var unitsDown: Index := ((nth(frame, 2) + (vMost * 8)) - 1) / (vMost * 8);
        if count = 1 then
            unitsAcross := nth(frame, onlyBase + 9);
            unitsDown := nth(frame, onlyBase + 10);
        end if;
        let zero: Float64 := 0.0;
        var predictions: Buffer[Float64] := initialize(3, zero);
        let order: Buffer[Index] := zigzag();
        var bits: Bits := Bits(at => at, byte => 0, left => 0, overrun => false, run => 0);
        let units: Index := unitsAcross * unitsDown;
        var unit: Index := 0;
        var broken: Bool := false;
        while (not broken) and (unit < units) do
            let unitY: Index := unit / unitsAcross;
            let unitX: Index := unit - (unitY * unitsAcross);
            if count = 1 then
                broken := not scanBlock(data, &!bits, huff, frame, &order, only, unitX, unitY, &~store, &!predictions);
            else
                var i: Index := 0;
                while (not broken) and (i < count) do
                    let c: Index := nth(frame, (scanAt + 1) + i);
                    let base: Index := componentsAt + (c * componentSize);
                    let h: Index := nth(frame, base + 1);
                    let v: Index := nth(frame, base + 2);
                    var by: Index := 0;
                    while (not broken) and (by < v) do
                        var bx: Index := 0;
                        while (not broken) and (bx < h) do
                            broken := not scanBlock(data, &!bits, huff, frame, &order, c, (unitX * h) + bx, (unitY * v) + by,
                                                    &~store, &!predictions);
                            bx := bx + 1;
                        end while;
                        by := by + 1;
                    end while;
                    i := i + 1;
                end while;
            end if;
            if bits.overrun then
                broken := true;
            end if;
            unit := unit + 1;
            if ((not broken) and (interval > 0)) and (unit < units) then
                if (unit - ((unit / interval) * interval)) = 0 then
                    if restart(data, &!bits) then
                        storeNth(&!predictions, 0, zero);
                        storeNth(&!predictions, 1, zero);
                        storeNth(&!predictions, 2, zero);
                        bits.run := (0 : Index);
                    else
                        broken := true;
                    end if;
                end if;
            end if;
        end while;
        destroyFree(predictions);
        destroyFree(order);
        if broken then
            return ScanEnd(at => 0, code => 1);
        end if;
        -- the next marker: FF and a byte neither 0 nor a restart
        let size: Index := spanLength(data);
        var next: Index := bits.at;
        var looking: Bool := true;
        while looking and ((next + 1) < size) do
            if data[next] = (255 : Nat8) then
                let m: Index := wide(data[next + 1]);
                if ((m /= 0) and (m /= 255)) and ((m < 208) or (m > 215)) then
                    looking := false;
                else
                    next := next + 1;
                end if;
            else
                next := next + 1;
            end if;
        end while;
        if looking then
            next := size;
        end if;
        return ScanEnd(at => next, code => 0);
    end;

    -- After the last scan: each block dequantised and transformed into the
    -- planes, the pixels painted and turned as the orientation says.
    generic [H: Region, Q: Region, F: Region, S: Region]
    function finished(huff: &[Buffer[Index], H], quant: &[Buffer[Index], Q], frame: &[Buffer[Index], F],
                      store: &[Buffer[Int16], S]): Either[JpegError, JpegPicture] is
        let width: Index := nth(frame, 1);
        let height: Index := nth(frame, 2);
        let count: Index := nth(frame, 3);
        var c: Index := 0;
        while c < count do
            if nth(quant, quantDefined + nth(frame, (componentsAt + (c * componentSize)) + 3)) /= 1 then
                return failed(1);
            end if;
            c := c + 1;
        end while;
        var places: Buffer[Index] := initialize(6, (0 : Index));
        var total: Index := 0;
        c := (0 : Index);
        while c < count do
            let base: Index := componentsAt + (c * componentSize);
            let stride: Index := nth(frame, base + 7) * 8;
            storeNth(&!places, c * 2, total);
            storeNth(&!places, (c * 2) + 1, stride);
            total := total + (stride * (nth(frame, base + 8) * 8));
            c := c + 1;
        end while;
        let zero: Float64 := 0.0;
        var planes: Buffer[Nat8] := initialize(total, (0 : Nat8));
        var coefficients: Buffer[Float64] := initialize(64, zero);
        var work: Buffer[Float64] := initialize(64, zero);
        let table: Buffer[Float64] := cosines();
        let order: Buffer[Index] := zigzag();
        c := (0 : Index);
        while c < count do
            let base: Index := componentsAt + (c * componentSize);
            let q: Index := nth(frame, base + 3) * 64;
            let across: Index := nth(frame, base + 7);
            let down: Index := nth(frame, base + 8);
            let stride: Index := nth(&places, (c * 2) + 1);
            var b: Index := 0;
            while b < (across * down) do
                let at: Index := nth(frame, base + 6) + (b * 64);
                var k: Index := 0;
                while k < 64 do
                    let natural: Index := nth(&order, k);
                    storeNth(&!coefficients, natural, coefficient(store, at + natural) * real(nth(quant, q + k)));
                    k := k + 1;
                end while;
                let by: Index := b / across;
                let bx: Index := b - (by * across);
                inverse(&coefficients, &table, &!work, &!planes, (nth(&places, c * 2) + ((by * 8) * stride)) + (bx * 8), stride);
                b := b + 1;
            end while;
            c := c + 1;
        end while;
        destroyFree(coefficients);
        destroyFree(work);
        destroyFree(table);
        destroyFree(order);
        let pixels: String := painted(&planes, &places, frame, width, height, count, nth(frame, 5), nth(frame, 6));
        destroyFree(planes);
        destroyFree(places);
        let turn: Index := nth(frame, orientationAt);
        if turn = 1 then
            let picture: JpegPicture := JpegPicture(width => width, height => height, pixels => pixels);
            return Right(right => picture);
        else
            let turned: String := oriented(asSpan(&pixels), width, height, turn);
            destroyString(pixels);
            if turn >= 5 then
                let picture: JpegPicture := JpegPicture(width => height, height => width, pixels => turned);
                return Right(right => picture);
            else
                let picture: JpegPicture := JpegPicture(width => width, height => height, pixels => turned);
                return Right(right => picture);
            end if;
        end if;
    end;

    -- The pixels of a picture of width by height turned as EXIF
    -- orientation turn (2 to 8) says: mirrored, turned by 180 degrees,
    -- transposed, turned by 90 degrees one way or the other.
    generic [P: Region]
    function oriented(pixels: Span[Nat8, P], width: Index, height: Index, turn: Index): String is
        var outWidth: Index := width;
        var outHeight: Index := height;
        if turn >= 5 then
            outWidth := height;
            outHeight := width;
        end if;
        var out: StringBuilder := makeStringBuilder();
        var oy: Index := 0;
        while oy < outHeight do
            var ox: Index := 0;
            while ox < outWidth do
                var sx: Index := ox;
                var sy: Index := oy;
                if turn = 2 then
                    sx := (width - 1) - ox;
                end if;
                if turn = 3 then
                    sx := (width - 1) - ox;
                    sy := (height - 1) - oy;
                end if;
                if turn = 4 then
                    sy := (height - 1) - oy;
                end if;
                if turn = 5 then
                    sx := oy;
                    sy := ox;
                end if;
                if turn = 6 then
                    sx := oy;
                    sy := (height - 1) - ox;
                end if;
                if turn = 7 then
                    sx := (width - 1) - oy;
                    sy := (height - 1) - ox;
                end if;
                if turn = 8 then
                    sx := (width - 1) - oy;
                    sy := ox;
                end if;
                let at: Index := ((sy * width) + sx) * 3;
                writeByte(&!out, pixels[at]);
                writeByte(&!out, pixels[at + 1]);
                writeByte(&!out, pixels[at + 2]);
                ox := ox + 1;
            end while;
            oy := oy + 1;
        end while;
        return finalize(out);
    end;

    -- The pixels of the planes: grey as red, green and blue alike, or
    -- YCbCr as JFIF converts it, chroma upsampled as libjpeg does.
    generic [P: Region, L: Region, F: Region]
    function painted(planes: &[Buffer[Nat8], P], places: &[Buffer[Index], L], frame: &[Buffer[Index], F], width: Index,
                     height: Index, count: Index, hMost: Index, vMost: Index): String is
        var out: StringBuilder := makeStringBuilder();
        if count = 1 then
            var y: Index := 0;
            while y < height do
                var x: Index := 0;
                while x < width do
                    let grey: Nat8 := nth(planes, (nth(places, 0) + (y * nth(places, 1))) + x);
                    writeByte(&!out, grey);
                    writeByte(&!out, grey);
                    writeByte(&!out, grey);
                    x := x + 1;
                end while;
                y := y + 1;
            end while;
        else
            let lumaPlane: Buffer[Nat8] := upsampled(planes, places, frame, 0, width, height, hMost, vMost);
            let bluePlane: Buffer[Nat8] := upsampled(planes, places, frame, 1, width, height, hMost, vMost);
            let redPlane: Buffer[Nat8] := upsampled(planes, places, frame, 2, width, height, hMost, vMost);
            var i: Index := 0;
            while i < (width * height) do
                let luma: Float64 := real(wide(nth(&lumaPlane, i)));
                let blue: Float64 := real(wide(nth(&bluePlane, i))) - 128.0;
                let red: Float64 := real(wide(nth(&redPlane, i))) - 128.0;
                writeByte(&!out, level(luma + (1.402 * red)));
                writeByte(&!out, level((luma - (0.344136 * blue)) - (0.714136 * red)));
                writeByte(&!out, level(luma + (1.772 * blue)));
                i := i + 1;
            end while;
            destroyFree(lumaPlane);
            destroyFree(bluePlane);
            destroyFree(redPlane);
        end if;
        return finalize(out);
    end;

    -- The sample of component c at column x and row y of its plane, both
    -- held to the samples the picture has (columns, rows), as libjpeg
    -- repeats the edge.
    generic [P: Region, L: Region]
    function sampleAt(planes: &[Buffer[Nat8], P], places: &[Buffer[Index], L], c: Index, x: Index, y: Index, columns: Index,
                rows: Index): Index is
        var cx: Index := x;
        if cx >= columns then
            cx := columns - 1;
        end if;
        var cy: Index := y;
        if cy >= rows then
            cy := rows - 1;
        end if;
        return wide(nth(planes, (nth(places, c * 2) + (cy * nth(places, (c * 2) + 1))) + cx));
    end;

    -- Three times the sample of component c at column x of row y and once
    -- the one of the row next to it (above for an even output row, below
    -- for an odd one): libjpeg's column sum.
    generic [P: Region, L: Region]
    function columnSum(planes: &[Buffer[Nat8], P], places: &[Buffer[Index], L], c: Index, x: Index, y: Index,
                       outRow: Index, columns: Index, rows: Index): Index is
        var other: Index := y + 1;
        if bitwiseAnd(outRow, (1 : Index)) = 0 then
            if y > 0 then
                other := y - 1;
            else
                other := (0 : Index);
            end if;
        end if;
        return (sampleAt(planes, places, c, x, y, columns, rows) * 3) + sampleAt(planes, places, c, x, other, columns, rows);
    end;

    -- Component c at the full width and height: as it is when its factors
    -- are the greatest, else with libjpeg's fancy upsampling, a triangle
    -- filter (h2v2, h2v1 and, as libjpeg-turbo has it, h1v2).
    generic [P: Region, L: Region, F: Region]
    function upsampled(planes: &[Buffer[Nat8], P], places: &[Buffer[Index], L], frame: &[Buffer[Index], F], c: Index,
                       width: Index, height: Index, hMost: Index, vMost: Index): Buffer[Nat8] is
        let base: Index := componentsAt + (c * componentSize);
        let h: Index := nth(frame, base + 1);
        let v: Index := nth(frame, base + 2);
        let wide2: Bool := h < hMost;
        let high2: Bool := v < vMost;
        let columns: Index := ((width * h) + (hMost - 1)) / hMost;
        let rows: Index := ((height * v) + (vMost - 1)) / vMost;
        var out: Buffer[Nat8] := initialize(width * height, (0 : Nat8));
        var y: Index := 0;
        while y < height do
            var sy: Index := y;
            if high2 then
                sy := y / 2;
            end if;
            var x: Index := 0;
            while x < width do
                var value: Index := 0;
                if wide2 and high2 then
                    let i: Index := x / 2;
                    let here: Index := columnSum(planes, places, c, i, sy, y, columns, rows);
                    if bitwiseAnd(x, (1 : Index)) = 0 then
                        if i = 0 then
                            value := ((here * 4) + 8) / 16;
                        else
                            value := (((here * 3) + columnSum(planes, places, c, i - 1, sy, y, columns, rows)) + 8) / 16;
                        end if;
                    else
                        if (i + 1) >= columns then
                            value := ((here * 4) + 7) / 16;
                        else
                            value := (((here * 3) + columnSum(planes, places, c, i + 1, sy, y, columns, rows)) + 7) / 16;
                        end if;
                    end if;
                end if;
                if wide2 and (not high2) then
                    let i: Index := x / 2;
                    let here: Index := sampleAt(planes, places, c, i, sy, columns, rows);
                    if bitwiseAnd(x, (1 : Index)) = 0 then
                        if i = 0 then
                            value := here;
                        else
                            value := (((here * 3) + sampleAt(planes, places, c, i - 1, sy, columns, rows)) + 1) / 4;
                        end if;
                    else
                        if (i + 1) >= columns then
                            value := here;
                        else
                            value := (((here * 3) + sampleAt(planes, places, c, i + 1, sy, columns, rows)) + 2) / 4;
                        end if;
                    end if;
                end if;
                if (not wide2) and high2 then
                    var bias: Index := 2;
                    if bitwiseAnd(y, (1 : Index)) = 0 then
                        bias := (1 : Index);
                    end if;
                    value := (columnSum(planes, places, c, x, sy, y, columns, rows) + bias) / 4;
                end if;
                if (not wide2) and (not high2) then
                    value := sampleAt(planes, places, c, x, sy, columns, rows);
                end if;
                storeNth(&!out, (y * width) + x, narrow(value));
                x := x + 1;
            end while;
            y := y + 1;
        end while;
        return out;
    end;

    generic [P: Region]
    function jpegWidth(picture: &[JpegPicture, P]): Index is
        return picture->width;
    end;

    generic [P: Region]
    function jpegHeight(picture: &[JpegPicture, P]): Index is
        return picture->height;
    end;

    generic [P: Region]
    function jpegPixels(picture: &[JpegPicture, P]): Span[Nat8, P] is
        return asSpan(&(picture->pixels));
    end;

    function destroyJpeg(picture: JpegPicture): Unit is
        let { width as w: Index, height as h: Index, pixels as p: String } := picture;
        destroyString(p);
        return nil;
    end;
end module body.
