import Standard.String (
    String,
    destroyString,
    length,
    asSpan
);
import Standard.Text (
    bytesToHex
);
import Standard.Libcrypto (
    randomBytes
);
import Standard.File (
    FileDescriptor,
    FileStatus,
    kind_regular,
    sameKind,
    openRead,
    createNewFile,
    statusOfOpen,
    readAll,
    writeAll,
    syncFile,
    closeFile
);

module body Wolly.Secret is
    constant largest_key: Nat64 := 4096;
    constant new_key_bytes: Index := 32;
    constant group_and_others: Nat32 := #o077;
    constant no_bits: Nat32 := 0;

    function keyBytes(): Index is
        return 32;
    end;

    -- Whether the file a key is read from is fit for one: regular, closed
    -- to group and others, and of a size a key may have.
    function fitForKey(status: FileStatus): Bool is
        let closed: Bool := bitwiseAnd(status.mode, group_and_others) = no_bits;
        let smallest: Nat64 := 32;
        let sized: Bool := (status.size >= smallest) and (status.size <= largest_key);
        return (sameKind(status.kind, kind_regular) and closed) and sized;
    end;

    generic [P: Region]
    function readKey(path: Span[Nat8, P]): Option[String] is
        case openRead(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                var fit: Bool := false;
                case statusOfOpen(&file) of
                    when Some(value as status: FileStatus) do
                        fit := fitForKey(status);
                    when None do
                        skip;
                end case;
                if not fit then
                    let closed: Bool := closeFile(file);
                    return None();
                else
                    let content: Option[String] := readAll(&!file);
                    let closed: Bool := closeFile(file);
                    return content;
                end if;
            when None do
                return None();
        end case;
    end;

    generic [P: Region]
    function makeKey(path: Span[Nat8, P]): Bool is
        case randomBytes(new_key_bytes) of
            when Some(value as raw: String) do
                let key: String := bytesToHex(asSpan(&raw));
                destroyString(raw);
                case createNewFile(path, #o600) of
                    when Some(value as made: FileDescriptor) do
                        var file: FileDescriptor := made;
                        let written: Bool := writeAll(&!file, asSpan(&key));
                        let synced: Bool := syncFile(&!file);
                        let closed: Bool := closeFile(file);
                        destroyString(key);
                        return (written and synced) and closed;
                    when None do
                        destroyString(key);
                        return false;
                end case;
            when None do
                return false;
        end case;
    end;
end module body.
