{% extends "templates/view/same/login/templates/base.jinja" %}
{% block title %}Wolly{% endblock %}
{% block content %}
<p>hello, {{ name }}</p>
<form method="post" action="/logout">
<input type="hidden" name="csrf" value="{{ csrf }}">
<button>Log out</button>
</form>
{% endblock %}
