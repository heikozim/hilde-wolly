    String,
    makeEmpty,
    fromLiteral,
    fromSpan,
    asSpan,
    destroyString
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyFree,
    destroyEmpty,
    length,
    lengthMut,
    nth,
    nthMut,
    nthRef,
    storeNth,
    insertBack,
    removeLast,
    removeFirst
);
import Standard.Text (
    equal,
    parseInt
);
import Standard.File (
    FileDescriptor,
    FileStatus,
    FileLookup,
    FileMissing,
    FileUnreadable,
    FileFound,
    openRead,
    readExactly,
    statusOfOpen,
    kindRegular,
    closeFile,
    statusOf,
    kindOf,
    kindSymlink,
    sameKind
);
import Standard.Template (
    displayIndex
);
import Wolly.ViewContext (
    Writer,
    HtmlWriter,
    ScriptWriter,
    ScriptAttributeWriter,
    Context,
    textContext,
    advanceContext,
    sameContext,
    copyContext,
    destroyContext,
    isHtmlText,
    writerOf,
    describeContext,
    afterScriptValue
);

module body Wolly.ViewCompile is
    ---
    --- Limits and operations
    ---

    function mostTemplateBytes(): Index is
        return 1048576;
    end;

    function mostFiles(): Index is
        return 64;
    end;

    function mostNesting(): Index is
        return 64;
    end;

    function mostDepth(): Index is
        return 16;
    end;

    function mostSteps(): Index is
        return 200000;
    end;

    function mostBindings(): Index is
        return 256;
    end;

    function mostTextBytes(): Index is
        return 16777216;
    end;

    constant stepText: Nat8 := 1;
    constant stepOut: Nat8 := 2;
    constant stepJump: Nat8 := 3;
    constant stepUnless: Nat8 := 4;
    constant stepBind: Nat8 := 5;
    constant stepRelease: Nat8 := 6;
    constant stepForEnter: Nat8 := 7;
    constant stepForItem: Nat8 := 8;
    constant stepForCount: Nat8 := 9;
    constant stepForStep: Nat8 := 10;
    constant stepForRestart: Nat8 := 11;
    constant stepIfEmpty: Nat8 := 12;
    constant stepCaptureBegin: Nat8 := 13;
    constant stepCaptureEnd: Nat8 := 14;

    constant bindReference: Index := 0;
    constant bindNumber: Index := 1;
    constant bindText: Index := 2;
    constant bindMarkup: Index := 3;

    constant exprText: Nat8 := 1;
    constant exprInteger: Nat8 := 2;
    constant exprBool: Nat8 := 3;
    constant exprData: Nat8 := 4;
    constant exprSlot: Nat8 := 5;
    constant exprLoop: Nat8 := 6;
    constant exprCycle: Nat8 := 7;
    constant exprNot: Nat8 := 8;
    constant exprAnd: Nat8 := 9;
    constant exprOr: Nat8 := 10;
    constant exprTextEquals: Nat8 := 11;
    constant exprCompare: Nat8 := 12;
    constant exprIsNone: Nat8 := 13;
    constant exprIn: Nat8 := 14;
    constant exprConcat: Nat8 := 15;
    constant exprArith: Nat8 := 16;
    constant exprFloorDivide: Nat8 := 17;
    constant exprModulo: Nat8 := 18;
    constant exprCond: Nat8 := 19;
    constant exprFilter: Nat8 := 20;
    constant exprJoin: Nat8 := 21;
    constant exprLength: Nat8 := 22;
    constant exprCall: Nat8 := 23;
    constant exprScriptValue: Nat8 := 24;
    constant exprTranslate: Nat8 := 25;
    constant exprTruth: Nat8 := 26;

    ---
    --- Template names
    ---

    function isNameByteOfFile(b: Nat8): Bool is
        return ((b >= 'a') and (b <= 'z')) or ((b >= 'A') and (b <= 'Z')) or ((b >= '0') and (b <= '9'))
            or (b = '.') or (b = '-') or (b = '_') or (b = '/');
    end;

    generic [N: Region]
    function isTemplateName(name: Span[Nat8, N]): Bool is
        let n: Index := spanLength(name);
        if (n = 0) or (n > 1024) then
            return false;
        end if;
        if (name[0] = '/') or (name[n - 1] = '/') or (name[0] = '.') then
            return false;
        end if;
        var i: Index := 0;
        while i < n do
            let b: Nat8 := name[i];
            if not isNameByteOfFile(b) then
                return false;
            end if;
            if b = '/' then
                if (name[i + 1] = '/') or (name[i + 1] = '.') then
                    return false;
                end if;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    ---
    --- The syntax: nodes and expressions in arenas, numbered from 1 (0 is
    --- none), their names and texts in names, their children in lists.
    ---

    -- The kinds of a node.
    constant nodeText: Nat8 := 1;
    constant nodeOut: Nat8 := 2;
    constant nodeIf: Nat8 := 3;
    constant nodeBranch: Nat8 := 4;
    constant nodeFor: Nat8 := 5;
    constant nodeSet: Nat8 := 6;
    constant nodeSetBlock: Nat8 := 7;
    constant nodeWith: Nat8 := 8;
    constant nodeFilterBlock: Nat8 := 9;
    constant nodeFilterSpec: Nat8 := 10;
    constant nodeCallBlock: Nat8 := 11;
    constant nodeImportAs: Nat8 := 12;
    constant nodeBlock: Nat8 := 13;
    constant nodeExtends: Nat8 := 14;
    constant nodeInclude: Nat8 := 15;
    constant nodeMacro: Nat8 := 16;
    constant nodeParam: Nat8 := 17;
    constant nodeFromImport: Nat8 := 18;
    constant nodeScope: Nat8 := 19;
    constant nodeIncluded: Nat8 := 20;
    constant nodeCatalog: Nat8 := 21;

    -- The operations of a parsed expression.
    constant syntaxPath: Nat8 := 1;
    constant syntaxString: Nat8 := 2;
    constant syntaxInteger: Nat8 := 3;
    constant syntaxBool: Nat8 := 4;
    constant syntaxNone: Nat8 := 5;
    constant syntaxFilter: Nat8 := 6;
    constant syntaxNot: Nat8 := 7;
    constant syntaxAnd: Nat8 := 8;
    constant syntaxOr: Nat8 := 9;
    constant syntaxCompare: Nat8 := 10;
    constant syntaxTest: Nat8 := 11;
    constant syntaxCall: Nat8 := 12;
    constant syntaxConcat: Nat8 := 13;
    constant syntaxArith: Nat8 := 14;
    constant syntaxIn: Nat8 := 15;
    constant syntaxCond: Nat8 := 16;
    constant syntaxTrans: Nat8 := 17;

    -- Comparisons and arithmetic, by code.
    constant compareEqual: Index := 0;
    constant compareNotEqual: Index := 1;
    constant compareLess: Index := 2;
    constant compareLessOrEqual: Index := 3;
    constant compareGreater: Index := 4;
    constant compareGreaterOrEqual: Index := 5;
    constant arithAdd: Index := 0;
    constant arithSubtract: Index := 1;
    constant arithMultiply: Index := 2;
    constant arithFloorDivide: Index := 3;
    constant arithModulo: Index := 4;

    -- The filters a value takes, by code.
    constant filterUpper: Index := 0;
    constant filterLower: Index := 1;
    constant filterTrim: Index := 2;
    constant filterCapitalize: Index := 3;
    constant filterTitle: Index := 4;
    constant filterReplace: Index := 5;
    constant filterTruncate: Index := 6;
    constant filterCenter: Index := 7;

    -- A node.  The meaning of a to c and of the three lists depends on the
    -- kind; flag is scoped for a block, negated and the like elsewhere.
    record SyntaxNode: Free is
        kind: Nat8;
        a: Index;
        b: Index;
        c: Index;
        list1: Index;
        count1: Index;
        list2: Index;
        count2: Index;
        list3: Index;
        count3: Index;
        flag: Bool;
        file: Index;
        line: Index;
    end;

    record SyntaxExpr: Free is
        op: Nat8;
        a: Index;
        b: Index;
        c: Index;
        list: Index;
        count: Index;
        flag: Bool;
        file: Index;
        line: Index;
    end;

    -- A piece of a template's source: text, a value or a tag, by bytes.
    constant chunkText: Nat8 := 1;
    constant chunkValue: Nat8 := 2;
    constant chunkTag: Nat8 := 3;

    record Chunk: Free is
        kind: Nat8;
        start: Index;
        size: Index;
        line: Index;
        column: Index;
    end;

    -- A token of a tag: a name, a string, a whole number or an operator,
    -- its text in names.
    constant tokenName: Nat8 := 1;
    constant tokenString: Nat8 := 2;
    constant tokenInteger: Nat8 := 3;
    constant tokenOperator: Nat8 := 4;

    record Token: Free is
        kind: Nat8;
        text: Index;
    end;

    -- A macro: its key (the name, or space.name), parameters (a list of
    -- nodeParam), body, where it was defined, whether it was imported and
    -- the name of its import (0 when none).
    record Macro: Free is
        key: Index;
        params: Index;
        paramCount: Index;
        content: Index;
        bodyCount: Index;
        node: Index;
        imported: Bool;
        space: Index;
    end;

    -- The definitions of one block name from the templates below the one
    -- being expanded: a list of nodeBlock nodes, the most derived first.
    record Override: Free is
        name: Index;
        defs: Index;
        count: Index;
    end;

    record Syntax: Linear is
        names: Buffer[String];
        nodes: Buffer[SyntaxNode];
        exprs: Buffer[SyntaxExpr];
        lists: Buffer[Index];
        chunks: Buffer[Chunk];
        chunkAt: Index;
        tokens: Buffer[Token];
        tokenAt: Index;
        tagLine: Index;
        tagFile: Index;
        nesting: Index;
        textBytes: Index;
        directories: Buffer[String];
        fileNames: Buffer[String];
        fileTrees: Buffer[Index];
        fileTreeCounts: Buffer[Index];
        paths: Buffer[String];
        macros: Buffer[Macro];
        usedBlocks: Buffer[Index];
        definedNames: Buffer[Index];
        definedNodes: Buffer[Index];
        spaceNames: Buffer[Index];
        spaceFiles: Buffer[Index];
        overrides: Buffer[Override];
        trimBlocks: Bool;
        lstripBlocks: Bool;
        failed: Bool;
        failures: Buffer[String];
        -- What the generator makes: the program and the names it binds.
        steps: Buffer[Step];
        programExprs: Buffer[Expr];
        programLists: Buffer[Index];
        texts: Buffer[String];
        bindings: Buffer[Binding];
        loopLinks: Buffer[Link];
        callingLinks: Buffer[Link];
        callers: Buffer[Caller];
        slots: Index;
        loops: Index;
        functionNames: Buffer[String];
        catalogNames: Buffer[String];
    end;

    -- What a name the template binds stands for: a reference into the
    -- data, a number, a text or a block's HTML in a slot, or a literal put
    -- where the name stands (the expression literal).  depth: how many
    -- loops were open where it was bound; a block that is not scoped sees
    -- only the names bound outside every loop.  parent: the binding made
    -- before it.
    constant bindLiteral: Index := 4;

    record Binding: Free is
        name: Index;
        slot: Index;
        kind: Index;
        literal: Index;
        depth: Index;
        parent: Index;
    end;

    -- A link of a chain: the loops open, the macros being expanded.
    record Link: Free is
        value: Index;
        parent: Index;
    end;

    -- What the generator knows where it stands; the chains are numbers
    -- into their arenas, 0 for empty.  seesData: false inside a macro
    -- brought in by an import.  space: the import name of the macro being
    -- expanded.  caller: what caller() stands for.  inBranch: inside a
    -- branch of an if, where a set is refused.  catalog: the catalog's
    -- number plus one.
    record Env: Free is
        vars: Index;
        loops: Index;
        loopDepth: Index;
        calling: Index;
        callDepth: Index;
        seesData: Bool;
        space: Index;
        caller: Index;
        inBranch: Bool;
        catalog: Index;
    end;

    record Caller: Free is
        content: Index;
        count: Index;
        env: Env;
    end;

    ---
    --- The slots of the syntax, one borrow each
    ---

    generic [R: Region]
    function bindingsCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->bindings));
    end;

    generic [R: Region]
    function bindingsItem(s: &![Syntax, R], at: Index): Binding is
        return nthMut(&!(s->bindings), at);
    end;

    generic [R: Region]
    function bindingsPush(s: &![Syntax, R], item: Binding): Unit is
        insertBack(&!(s->bindings), item);
        return nil;
    end;

    generic [R: Region]
    function callersCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->callers));
    end;

    generic [R: Region]
    function callersItem(s: &![Syntax, R], at: Index): Caller is
        return nthMut(&!(s->callers), at);
    end;

    generic [R: Region]
    function callersPush(s: &![Syntax, R], item: Caller): Unit is
        insertBack(&!(s->callers), item);
        return nil;
    end;

    generic [R: Region]
    function callingLinksCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->callingLinks));
    end;

    generic [R: Region]
    function callingLinksItem(s: &![Syntax, R], at: Index): Link is
        return nthMut(&!(s->callingLinks), at);
    end;

    generic [R: Region]
    function callingLinksPush(s: &![Syntax, R], item: Link): Unit is
        insertBack(&!(s->callingLinks), item);
        return nil;
    end;

    generic [R: Region]
    function catalogNamesCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->catalogNames));
    end;

    generic [R: Region, T: Region]
    function catalogNamesEquals(s: &![Syntax, R], at: Index, text: Span[Nat8, T]): Bool is
        return equal(asSpan(nthRef(&(s->catalogNames), at)), text);
    end;

    generic [R: Region]
    function chunksCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->chunks));
    end;

    generic [R: Region]
    function chunksItem(s: &![Syntax, R], at: Index): Chunk is
        return nthMut(&!(s->chunks), at);
    end;

    generic [R: Region]
    function chunksPop(s: &![Syntax, R]): Chunk is
        return removeLast(&!(s->chunks));
    end;

    generic [R: Region]
    function definedNamesCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->definedNames));
    end;

    generic [R: Region]
    function definedNamesItem(s: &![Syntax, R], at: Index): Index is
        return nthMut(&!(s->definedNames), at);
    end;

    generic [R: Region]
    function definedNamesPush(s: &![Syntax, R], item: Index): Unit is
        insertBack(&!(s->definedNames), item);
        return nil;
    end;

    generic [R: Region]
    function definedNodesItem(s: &![Syntax, R], at: Index): Index is
        return nthMut(&!(s->definedNodes), at);
    end;

    generic [R: Region]
    function definedNodesPush(s: &![Syntax, R], item: Index): Unit is
        insertBack(&!(s->definedNodes), item);
        return nil;
    end;

    generic [R: Region]
    function directoriesCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->directories));
    end;

    generic [R: Region]
    function exprsCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->exprs));
    end;

    generic [R: Region]
    function exprsItem(s: &![Syntax, R], at: Index): SyntaxExpr is
        return nthMut(&!(s->exprs), at);
    end;

    generic [R: Region]
    function exprsPush(s: &![Syntax, R], item: SyntaxExpr): Unit is
        insertBack(&!(s->exprs), item);
        return nil;
    end;

    generic [R: Region]
    function failuresPush(s: &![Syntax, R], item: String): Unit is
        insertBack(&!(s->failures), item);
        return nil;
    end;

    generic [R: Region]
    function fileNamesCopy(s: &![Syntax, R], at: Index): String is
        return fromSpan(asSpan(nthRef(&(s->fileNames), at)));
    end;

    generic [R: Region]
    function fileNamesCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->fileNames));
    end;

    generic [R: Region, T: Region]
    function fileNamesEquals(s: &![Syntax, R], at: Index, text: Span[Nat8, T]): Bool is
        return equal(asSpan(nthRef(&(s->fileNames), at)), text);
    end;

    generic [R: Region]
    function fileNamesPush(s: &![Syntax, R], item: String): Unit is
        insertBack(&!(s->fileNames), item);
        return nil;
    end;

    generic [R: Region]
    function fileTreeCountsItem(s: &![Syntax, R], at: Index): Index is
        return nthMut(&!(s->fileTreeCounts), at);
    end;

    generic [R: Region]
    function fileTreeCountsPush(s: &![Syntax, R], item: Index): Unit is
        insertBack(&!(s->fileTreeCounts), item);
        return nil;
    end;

    generic [R: Region]
    function fileTreeCountsStore(s: &![Syntax, R], at: Index, item: Index): Unit is
        storeNth(&!(s->fileTreeCounts), at, item);
        return nil;
    end;

    generic [R: Region]
    function fileTreesItem(s: &![Syntax, R], at: Index): Index is
        return nthMut(&!(s->fileTrees), at);
    end;

    generic [R: Region]
    function fileTreesPush(s: &![Syntax, R], item: Index): Unit is
        insertBack(&!(s->fileTrees), item);
        return nil;
    end;

    generic [R: Region]
    function fileTreesStore(s: &![Syntax, R], at: Index, item: Index): Unit is
        storeNth(&!(s->fileTrees), at, item);
        return nil;
    end;

    generic [R: Region]
    function functionNamesCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->functionNames));
    end;

    generic [R: Region, T: Region]
    function functionNamesEquals(s: &![Syntax, R], at: Index, text: Span[Nat8, T]): Bool is
        return equal(asSpan(nthRef(&(s->functionNames), at)), text);
    end;

    generic [R: Region]
    function listsCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->lists));
    end;

    generic [R: Region]
    function listsItem(s: &![Syntax, R], at: Index): Index is
        return nthMut(&!(s->lists), at);
    end;

    generic [R: Region]
    function listsPush(s: &![Syntax, R], item: Index): Unit is
        insertBack(&!(s->lists), item);
        return nil;
    end;

    generic [R: Region]
    function loopLinksCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->loopLinks));
    end;

    generic [R: Region]
    function loopLinksItem(s: &![Syntax, R], at: Index): Link is
        return nthMut(&!(s->loopLinks), at);
    end;

    generic [R: Region]
    function loopLinksPush(s: &![Syntax, R], item: Link): Unit is
        insertBack(&!(s->loopLinks), item);
        return nil;
    end;

    generic [R: Region]
    function macrosCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->macros));
    end;

    generic [R: Region]
    function macrosItem(s: &![Syntax, R], at: Index): Macro is
        return nthMut(&!(s->macros), at);
    end;

    generic [R: Region]
    function macrosPush(s: &![Syntax, R], item: Macro): Unit is
        insertBack(&!(s->macros), item);
        return nil;
    end;

    generic [R: Region]
    function macrosStore(s: &![Syntax, R], at: Index, item: Macro): Unit is
        storeNth(&!(s->macros), at, item);
        return nil;
    end;

    generic [R: Region]
    function namesCopy(s: &![Syntax, R], at: Index): String is
        return fromSpan(asSpan(nthRef(&(s->names), at)));
    end;

    generic [R: Region]
    function namesCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->names));
    end;

    generic [R: Region, T: Region]
    function namesEquals(s: &![Syntax, R], at: Index, text: Span[Nat8, T]): Bool is
        return equal(asSpan(nthRef(&(s->names), at)), text);
    end;

    generic [R: Region]
    function namesPush(s: &![Syntax, R], item: String): Unit is
        insertBack(&!(s->names), item);
        return nil;
    end;

    generic [R: Region]
    function nodesCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->nodes));
    end;

    generic [R: Region]
    function nodesItem(s: &![Syntax, R], at: Index): SyntaxNode is
        return nthMut(&!(s->nodes), at);
    end;

    generic [R: Region]
    function nodesPush(s: &![Syntax, R], item: SyntaxNode): Unit is
        insertBack(&!(s->nodes), item);
        return nil;
    end;

    generic [R: Region]
    function overridesCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->overrides));
    end;

    generic [R: Region]
    function overridesItem(s: &![Syntax, R], at: Index): Override is
        return nthMut(&!(s->overrides), at);
    end;

    generic [R: Region]
    function overridesPush(s: &![Syntax, R], item: Override): Unit is
        insertBack(&!(s->overrides), item);
        return nil;
    end;

    generic [R: Region]
    function pathsPush(s: &![Syntax, R], item: String): Unit is
        insertBack(&!(s->paths), item);
        return nil;
    end;

    generic [R: Region]
    function programExprsCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->programExprs));
    end;

    generic [R: Region]
    function programExprsPush(s: &![Syntax, R], item: Expr): Unit is
        insertBack(&!(s->programExprs), item);
        return nil;
    end;

    generic [R: Region]
    function programListsCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->programLists));
    end;

    generic [R: Region]
    function programListsPush(s: &![Syntax, R], item: Index): Unit is
        insertBack(&!(s->programLists), item);
        return nil;
    end;

    generic [R: Region]
    function spaceFilesItem(s: &![Syntax, R], at: Index): Index is
        return nthMut(&!(s->spaceFiles), at);
    end;

    generic [R: Region]
    function spaceFilesPush(s: &![Syntax, R], item: Index): Unit is
        insertBack(&!(s->spaceFiles), item);
        return nil;
    end;

    generic [R: Region]
    function spaceNamesCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->spaceNames));
    end;

    generic [R: Region]
    function spaceNamesItem(s: &![Syntax, R], at: Index): Index is
        return nthMut(&!(s->spaceNames), at);
    end;

    generic [R: Region]
    function spaceNamesPush(s: &![Syntax, R], item: Index): Unit is
        insertBack(&!(s->spaceNames), item);
        return nil;
    end;

    generic [R: Region]
    function stepsCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->steps));
    end;

    generic [R: Region]
    function stepsItem(s: &![Syntax, R], at: Index): Step is
        return nthMut(&!(s->steps), at);
    end;

    generic [R: Region]
    function stepsPush(s: &![Syntax, R], item: Step): Unit is
        insertBack(&!(s->steps), item);
        return nil;
    end;

    generic [R: Region]
    function stepsStore(s: &![Syntax, R], at: Index, item: Step): Unit is
        storeNth(&!(s->steps), at, item);
        return nil;
    end;

    generic [R: Region]
    function textsCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->texts));
    end;

    generic [R: Region]
    function textsPush(s: &![Syntax, R], item: String): Unit is
        insertBack(&!(s->texts), item);
        return nil;
    end;

    generic [R: Region]
    function tokensCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->tokens));
    end;

    generic [R: Region]
    function tokensItem(s: &![Syntax, R], at: Index): Token is
        return nthMut(&!(s->tokens), at);
    end;

    generic [R: Region]
    function tokensPop(s: &![Syntax, R]): Token is
        return removeLast(&!(s->tokens));
    end;

    generic [R: Region]
    function tokensPush(s: &![Syntax, R], item: Token): Unit is
        insertBack(&!(s->tokens), item);
        return nil;
    end;

    generic [R: Region]
    function usedBlocksCount(s: &![Syntax, R]): Index is
        return lengthMut(&!(s->usedBlocks));
    end;

    generic [R: Region]
    function usedBlocksItem(s: &![Syntax, R], at: Index): Index is
        return nthMut(&!(s->usedBlocks), at);
    end;

    generic [R: Region]
    function usedBlocksPush(s: &![Syntax, R], item: Index): Unit is
        insertBack(&!(s->usedBlocks), item);
        return nil;
    end;

    ---
    --- Building the syntax, through a write reference: each use of a slot
    --- is a function of its own that the callers hand a reborrow.
    ---

    generic [R: Region]
    function hasFailed(s: &![Syntax, R]): Bool is
        return s->failed;
    end;

    generic [R: Region]
    function fileNameCopy(s: &![Syntax, R], file: Index): String is
        if file < fileNamesCount(&~s) then
            return fileNamesCopy(&~s, file);
        end if;
        return fromLiteral("?");
    end;

    -- The first failure is kept: what follows it is often its echo.
    generic [R: Region]
    function failText(s: &![Syntax, R], code: Span[Nat8, Static], file: Index, line: Index, message: String): Unit is
        if s->failed then
            destroyString(message);
            return nil;
        end if;
        var out: StringBuilder := makeStringBuilder();
        -- A failure of the template the caller named has no place in a
        -- file: no "name:line: " then, the message quotes the name.
        if file < fileNamesCount(&~s) then
            let name: String := fileNameCopy(&~s, file);
            writeString(&!out, asSpan(&name));
            destroyString(name);
            writeByte(&!out, ':');
            let digits: String := displayIndex(line);
            writeString(&!out, asSpan(&digits));
            destroyString(digits);
            writeString(&!out, ": ");
        end if;
        writeString(&!out, code);
        writeString(&!out, ": ");
        writeString(&!out, asSpan(&message));
        destroyString(message);
        pushFailure(&~s, finalize(out));
        s->failed := true;
        return nil;
    end;

    generic [R: Region]
    function pushFailure(s: &![Syntax, R], text: String): Unit is
        failuresPush(&~s, text);
        return nil;
    end;

    generic [R: Region]
    function fail(s: &![Syntax, R], code: Span[Nat8, Static], file: Index, line: Index, message: Span[Nat8, Static]): Unit is
        failText(&~s, code, file, line, fromSpan(message));
        return nil;
    end;

    -- 0 and 1 as an Index, for an assignment to a slot, where a literal
    -- does not take the slot's type.
    function indexOf0(): Index is
        return 0;
    end;

    function indexOf1(): Index is
        return 1;
    end;

    -- A message of four parts.
    generic [A: Region, B: Region, C: Region, D: Region]
    function joinedFour(first: Span[Nat8, A], second: Span[Nat8, B], third: Span[Nat8, C], fourth: Span[Nat8, D]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, first);
        writeString(&!out, second);
        writeString(&!out, third);
        writeString(&!out, fourth);
        return finalize(out);
    end;

    -- A message of up to three parts.
    generic [A: Region, B: Region, C: Region]
    function joined(first: Span[Nat8, A], second: Span[Nat8, B], third: Span[Nat8, C]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, first);
        writeString(&!out, second);
        writeString(&!out, third);
        return finalize(out);
    end;

    generic [R: Region]
    function nameCount(s: &![Syntax, R]): Index is
        return namesCount(&~s);
    end;

    generic [R: Region]
    function pushName(s: &![Syntax, R], text: String): Unit is
        namesPush(&~s, text);
        return nil;
    end;

    -- Keeps text among the names and gives its number.
    generic [R: Region]
    function addName(s: &![Syntax, R], text: String): Index is
        let at: Index := nameCount(&~s);
        pushName(&~s, text);
        return at;
    end;

    generic [R: Region]
    function nameCopy(s: &![Syntax, R], at: Index): String is
        return namesCopy(&~s, at);
    end;

    generic [R: Region, T: Region]
    function nameIs(s: &![Syntax, R], at: Index, text: Span[Nat8, T]): Bool is
        return namesEquals(&~s, at, text);
    end;

    generic [R: Region]
    function sameNames(s: &![Syntax, R], left: Index, right: Index): Bool is
        let text: String := nameCopy(&~s, right);
        let same: Bool := nameIs(&~s, left, asSpan(&text));
        destroyString(text);
        return same;
    end;

    generic [R: Region]
    function nodeCount(s: &![Syntax, R]): Index is
        return nodesCount(&~s);
    end;

    generic [R: Region]
    function pushNode(s: &![Syntax, R], node: SyntaxNode): Unit is
        nodesPush(&~s, node);
        return nil;
    end;

    generic [R: Region]
    function addNode(s: &![Syntax, R], node: SyntaxNode): Index is
        let at: Index := nodeCount(&~s);
        pushNode(&~s, node);
        return at;
    end;

    generic [R: Region]
    function nodeOf(s: &![Syntax, R], at: Index): SyntaxNode is
        return nodesItem(&~s, at);
    end;

    generic [R: Region]
    function exprCountOf(s: &![Syntax, R]): Index is
        return exprsCount(&~s);
    end;

    generic [R: Region]
    function pushExpr(s: &![Syntax, R], e: SyntaxExpr): Unit is
        exprsPush(&~s, e);
        return nil;
    end;

    generic [R: Region]
    function addExpr(s: &![Syntax, R], e: SyntaxExpr): Index is
        let at: Index := exprCountOf(&~s);
        pushExpr(&~s, e);
        return at;
    end;

    generic [R: Region]
    function exprOf(s: &![Syntax, R], at: Index): SyntaxExpr is
        return exprsItem(&~s, at);
    end;

    generic [R: Region]
    function listLength(s: &![Syntax, R]): Index is
        return listsCount(&~s);
    end;

    generic [R: Region]
    function pushListItem(s: &![Syntax, R], item: Index): Unit is
        listsPush(&~s, item);
        return nil;
    end;

    generic [R: Region]
    function listItem(s: &![Syntax, R], at: Index): Index is
        return listsItem(&~s, at);
    end;

    -- The items, copied to the end of lists: the start of the copy.
    generic [R: Region, B: Region]
    function addList(s: &![Syntax, R], items: &[Buffer[Index], B]): Index is
        let start: Index := listLength(&~s);
        var i: Index := 0;
        while i < length(items) do
            pushListItem(&~s, nth(items, i));
            i := i + 1;
        end while;
        return start;
    end;

    function blankNode(kind: Nat8, file: Index, line: Index): SyntaxNode is
        let zero: Index := 0;
        return SyntaxNode(kind => kind, a => zero, b => zero, c => zero, list1 => zero, count1 => zero,
            list2 => zero, count2 => zero, list3 => zero, count3 => zero, flag => false, file => file, line => line);
    end;

    function blankExpr(op: Nat8, file: Index, line: Index): SyntaxExpr is
        let zero: Index := 0;
        return SyntaxExpr(op => op, a => zero, b => zero, c => zero, list => zero, count => zero, flag => false,
            file => file, line => line);
    end;

    ---
    --- 1. The lexer
    ---

    function isSpace(c: Nat8): Bool is
        return (c = ' ') or (c = 9) or (c = 10) or (c = 13) or (c = 11) or (c = 12);
    end;

    function isNameStart(c: Nat8): Bool is
        return ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z')) or (c = '_');
    end;

    function isNameChar(c: Nat8): Bool is
        return isNameStart(c) or ((c >= '0') and (c <= '9'));
    end;

    generic [S: Region, W: Region]
    function startsAt(source: Span[Nat8, S], at: Index, finish: Index, word: Span[Nat8, W]): Bool is
        let n: Index := spanLength(word);
        if (at + n) > finish then
            return false;
        end if;
        return equal(spanPart(source, at, n), word);
    end;

    -- Where an offset is: its line and column, counted on from the last
    -- one asked, since the lexer asks in order.
    record Where: Free is
        offset: Index;
        line: Index;
        lineStart: Index;
    end;

    generic [S: Region]
    function whereAt(source: Span[Nat8, S], before: Where, offset: Index): Where is
        var at: Where := before;
        if offset < at.offset then
            at := Where(offset => 0, line => 1, lineStart => 0);
        end if;
        var i: Index := at.offset;
        var line: Index := at.line;
        var lineStart: Index := at.lineStart;
        while i < offset do
            if source[i] = 10 then
                line := line + 1;
                lineStart := i + 1;
            end if;
            i := i + 1;
        end while;
        return Where(offset => offset, line => line, lineStart => lineStart);
    end;

    -- What went wrong in the lexer: a code of 0 is nothing.
    record LexFault: Free is
        code: Nat8;
        line: Index;
        closer: Nat8;
    end;

    generic [R: Region]
    function chunkCount(chunks: &![Buffer[Chunk], R]): Index is
        return lengthMut(chunks);
    end;

    -- Text from start to finish as a chunk, its leading white space dropped
    -- when stripNext is set.
    generic [S: Region, C: Region]
    function addText(source: Span[Nat8, S], chunks: &![Buffer[Chunk], C], start: Index, finish: Index,
        stripNext: Bool, at: Where): Unit is
        var first: Index := start;
        if stripNext then
            while (first < finish) and isSpace(source[first]) do
                first := first + 1;
            end while;
        end if;
        if first < finish then
            insertBack(&~chunks, Chunk(kind => chunkText, start => first, size => finish - first, line => at.line,
                column => start - at.lineStart));
        end if;
        return nil;
    end;

    -- A - after an opening delimiter: the text before loses its trailing
    -- white space.
    generic [S: Region, C: Region]
    function stripPrevious(source: Span[Nat8, S], chunks: &![Buffer[Chunk], C]): Unit is
        let n: Index := chunkCount(&~chunks);
        if n = 0 then
            return nil;
        end if;
        var last: Chunk := nthMut(&~chunks, n - 1);
        if last.kind /= chunkText then
            return nil;
        end if;
        var size: Index := last.size;
        while (size > 0) and isSpace(source[(last.start + size) - 1]) do
            size := size - 1;
        end while;
        if size = 0 then
            let dropped: Chunk := removeLast(&~chunks);
        else
            last.size := size;
            storeNth(&~chunks, n - 1, last);
        end if;
        return nil;
    end;

    -- lstrip_blocks: the text before a block tag loses the spaces and tabs
    -- after its last newline, when nothing else stands there.
    generic [S: Region, C: Region]
    function stripLineStart(source: Span[Nat8, S], chunks: &![Buffer[Chunk], C]): Unit is
        let n: Index := chunkCount(&~chunks);
        if n = 0 then
            return nil;
        end if;
        var last: Chunk := nthMut(&~chunks, n - 1);
        if last.kind /= chunkText then
            return nil;
        end if;
        var k: Index := last.size;
        while (k > 0) and ((source[(last.start + k) - 1] = ' ') or (source[(last.start + k) - 1] = 9)) do
            k := k - 1;
        end while;
        let atLineStart: Bool := (k = 0) and (last.column = 0);
        let followsNewline: Bool := (k > 0) and (source[(last.start + k) - 1] = 10);
        if atLineStart or followsNewline then
            if k = 0 then
                let dropped: Chunk := removeLast(&~chunks);
            else
                last.size := k;
                storeNth(&~chunks, n - 1, last);
            end if;
        end if;
        return nil;
    end;

    -- The offset of the closing delimiter of a tag whose body starts at
    -- from, strings skipped; finish when there is none.
    generic [S: Region]
    function findClose(source: Span[Nat8, S], begin: Index, finish: Index, kind: Nat8): Index is
        var i: Index := begin;        while i < finish do
            let c: Nat8 := source[i];
            if (c = 39) or (c = '"') then
                i := i + 1;
                while (i < finish) and (source[i] /= c) do
                    if source[i] = 92 then
                        i := i + 1;
                    end if;
                    i := i + 1;
                end while;
                i := i + 1;
            else if (c = kind) and ((i + 1) < finish) and (source[i + 1] = '}') then
                return i;
            else
                i := i + 1;
            end if;
        end while;
        return finish;
    end;

    -- Skips one newline after a block tag, for trim_blocks.
    generic [S: Region]
    function afterNewline(source: Span[Nat8, S], at: Index, finish: Index): Index is
        if (at < finish) and (source[at] = 10) then
            return at + 1;
        end if;
        if ((at + 1) < finish) and (source[at] = 13) and (source[at + 1] = 10) then
            return at + 2;
        end if;
        return at;
    end;

    generic [S: Region]
    function trimmedIsRaw(source: Span[Nat8, S], start: Index, finish: Index): Bool is
        var a: Index := start;
        var b: Index := finish;
        while (a < b) and isSpace(source[a]) do
            a := a + 1;
        end while;
        while (b > a) and isSpace(source[b - 1]) do
            b := b - 1;
        end while;
        return equal(spanPart(source, a, b - a), "raw");
    end;

    -- The source split into chunks, as Hilde's compiler splits it.  Jinja2
    -- drops one newline at the end of a template, and so does this.
    generic [S: Region, C: Region]
    function lex(source: Span[Nat8, S], trimBlocks: Bool, lstripBlocks: Bool, chunks: &![Buffer[Chunk], C]): LexFault is
        var n: Index := spanLength(source);
        if (n > 0) and (source[n - 1] = 10) then
            n := n - 1;
        end if;
        var where: Where := Where(offset => 0, line => 1, lineStart => 0);
        var stripNext: Bool := false;
        var i: Index := 0;
        var textStart: Index := 0;
        while i < n do
            let isTag: Bool := ((i + 1) < n) and (source[i] = '{')
                and ((source[i + 1] = '{') or (source[i + 1] = '%') or (source[i + 1] = '#'));
            if isTag then
                let kind: Nat8 := source[i + 1];
                let tagOffset: Index := i;
                where := whereAt(source, where, textStart);
                addText(source, &~chunks, textStart, tagOffset, stripNext, where);
                stripNext := false;
                where := whereAt(source, where, tagOffset);
                let opened: Index := where.line;
                var bodyStart: Index := tagOffset + 2;
                if (bodyStart < n) and (source[bodyStart] = '-') then
                    stripPrevious(source, &~chunks);
                    bodyStart := bodyStart + 1;
                else if (bodyStart < n) and (source[bodyStart] = '+') then
                    bodyStart := bodyStart + 1;
                else if lstripBlocks and (kind /= '{') then
                    stripLineStart(source, &~chunks);
                end if;
                var closeKind: Nat8 := '}';
                if kind = '%' then
                    closeKind := '%';
                else if kind = '#' then
                    closeKind := '#';
                end if;
                var close: Index := n;
                if kind = '#' then
                    var j: Index := bodyStart;
                    while (j < n) and (not startsAt(source, j, n, "#}")) do
                        j := j + 1;
                    end while;
                    if j >= n then
                        return LexFault(code => 6, line => opened, closer => '#');
                    end if;
                    close := j;
                else
                    close := findClose(source, bodyStart, n, closeKind);
                    if close >= n then
                        return LexFault(code => 5, line => opened, closer => closeKind);
                    end if;
                end if;
                var bodyEnd: Index := close;
                var stripAfter: Bool := false;
                var keepNewline: Bool := false;
                if (close > bodyStart) and (source[close - 1] = '-') then
                    bodyEnd := close - 1;
                    stripAfter := true;
                else if (close > bodyStart) and (source[close - 1] = '+') then
                    bodyEnd := close - 1;
                    keepNewline := true;
                end if;
                i := close + 2;
                if trimBlocks and (kind /= '{') and (not keepNewline) and (not stripAfter) then
                    i := afterNewline(source, i, n);
                end if;
                textStart := i;
                stripNext := stripAfter;
                if kind = '{' then
                    insertBack(&~chunks, Chunk(kind => chunkValue, start => bodyStart, size => bodyEnd - bodyStart,
                        line => opened, column => 0));
                else if kind = '%' then
                    if trimmedIsRaw(source, bodyStart, bodyEnd) then
                        -- Everything up to {% endraw %} is text, as it stands.
                        var j: Index := i;
                        var found: Bool := false;
                        while not found do
                            if j >= n then
                                return LexFault(code => 7, line => opened, closer => 0);
                            else if startsAt(source, j, n, "{%") then
                                var k: Index := j + 2;
                                let lstripRaw: Bool := (k < n) and (source[k] = '-');
                                if lstripRaw then
                                    k := k + 1;
                                end if;
                                while (k < n) and isSpace(source[k]) do
                                    k := k + 1;
                                end while;
                                if startsAt(source, k, n, "endraw") then
                                    found := true;
                                    var m: Index := k + 6;
                                    while (m < n) and isSpace(source[m]) do
                                        m := m + 1;
                                    end while;
                                    let stripAfterRaw: Bool := (m < n) and (source[m] = '-');
                                    if stripAfterRaw then
                                        m := m + 1;
                                    end if;
                                    if not startsAt(source, m, n, "%}") then
                                        return LexFault(code => 8, line => opened, closer => 0);
                                    end if;
                                    var rawStart: Index := i;
                                    var rawEnd: Index := j;
                                    if stripNext then
                                        while (rawStart < rawEnd) and isSpace(source[rawStart]) do
                                            rawStart := rawStart + 1;
                                        end while;
                                    end if;
                                    if lstripRaw then
                                        while (rawEnd > rawStart) and isSpace(source[rawEnd - 1]) do
                                            rawEnd := rawEnd - 1;
                                        end while;
                                    end if;
                                    let plusAfter: Bool := ((j + 2) < n) and (source[j + 2] = '+');
                                    if lstripBlocks and (not lstripRaw) and (not plusAfter) then
                                        var e: Index := rawEnd;
                                        while (e > rawStart) and ((source[e - 1] = ' ') or (source[e - 1] = 9)) do
                                            e := e - 1;
                                        end while;
                                        if (e > rawStart) and (source[e - 1] = 10) then
                                            rawEnd := e;
                                        end if;
                                    end if;
                                    if rawStart < rawEnd then
                                        where := whereAt(source, where, i);
                                        insertBack(&~chunks, Chunk(kind => chunkText, start => rawStart,
                                            size => rawEnd - rawStart, line => where.line, column => i - where.lineStart));
                                    end if;
                                    stripNext := stripAfterRaw;
                                    i := m + 2;
                                    if trimBlocks and (not stripAfterRaw) then
                                        i := afterNewline(source, i, n);
                                    end if;
                                    textStart := i;
                                else
                                    j := j + 2;
                                end if;
                            else
                                j := j + 1;
                            end if;
                        end while;
                    else
                        insertBack(&~chunks, Chunk(kind => chunkTag, start => bodyStart, size => bodyEnd - bodyStart,
                            line => opened, column => 0));
                    end if;
                end if;
            else
                i := i + 1;
            end if;
        end while;
        where := whereAt(source, where, textStart);
        addText(source, &~chunks, textStart, n, stripNext, where);
        return LexFault(code => 0, line => 0, closer => 0);
    end;

    ---
    --- 2. The parser: the tokens of one tag
    ---

    generic [R: Region]
    function clearTokens(s: &![Syntax, R]): Unit is
        while tokensCount(&~s) > 0 do
            let dropped: Token := tokensPop(&~s);
        end while;
        let zero: Index := 0;
        s->tokenAt := zero;
        return nil;
    end;

    generic [R: Region]
    function pushToken(s: &![Syntax, R], kind: Nat8, text: String): Unit is
        let at: Index := addName(&~s, text);
        tokensPush(&~s, Token(kind => kind, text => at));
        return nil;
    end;

    generic [R: Region]
    function tagFail(s: &![Syntax, R], code: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        let file: Index := s->tagFile;
        let line: Index := s->tagLine;
        fail(&~s, code, file, line, message);
        return nil;
    end;

    generic [R: Region]
    function tagFailText(s: &![Syntax, R], code: Span[Nat8, Static], message: String): Unit is
        let file: Index := s->tagFile;
        let line: Index := s->tagLine;
        failText(&~s, code, file, line, message);
        return nil;
    end;

    function isOperatorByte(c: Nat8): Bool is
        return (c = '.') or (c = '|') or (c = '(') or (c = ')') or (c = ',') or (c = '<') or (c = '>') or (c = '=')
            or (c = '+') or (c = '-') or (c = '*') or (c = '/') or (c = '~') or (c = '%') or (c = '[') or (c = ']')
            or (c = '{') or (c = '}') or (c = ':');
    end;

    -- The tokens of what stands between the delimiters of a tag.
    generic [R: Region, T: Region]
    function tokenize(s: &![Syntax, R], text: Span[Nat8, T]): Unit is
        clearTokens(&~s);
        let n: Index := spanLength(text);
        var i: Index := 0;
        while (i < n) and (not hasFailed(&~s)) do
            let c: Nat8 := text[i];
            if isSpace(c) then
                i := i + 1;
            else if isNameStart(c) then
                var j: Index := i;
                while (j < n) and isNameChar(text[j]) do
                    j := j + 1;
                end while;
                pushToken(&~s, tokenName, fromSpan(spanPart(text, i, j - i)));
                i := j;
            else if (c >= '0') and (c <= '9') then
                var j: Index := i;
                while (j < n) and (text[j] >= '0') and (text[j] <= '9') do
                    j := j + 1;
                end while;
                if (j < n) and ((text[j] = '.') or (text[j] = '_') or isNameStart(text[j])) then
                    tagFail(&~s, "H7009", "only whole decimal numbers are supported");
                end if;
                pushToken(&~s, tokenInteger, fromSpan(spanPart(text, i, j - i)));
                i := j;
            else if (c = 39) or (c = '"') then
                var out: StringBuilder := makeStringBuilder();
                var j: Index := i + 1;
                while (j < n) and (text[j] /= c) do
                    if text[j] = 92 then
                        if (j + 1) >= n then
                            tagFail(&~s, "H7005", "a string in this tag ends in a backslash");
                            j := n;
                        else
                            let e: Nat8 := text[j + 1];
                            if e = 'n' then
                                writeByte(&!out, 10);
                            else if e = 't' then
                                writeByte(&!out, 9);
                            else if e = 'r' then
                                writeByte(&!out, 13);
                            else if (e = 92) or (e = 39) or (e = '"') then
                                writeByte(&!out, e);
                            else
                                var m: StringBuilder := makeStringBuilder();
                                writeString(&!m, "the escape ");
                                writeByte(&!m, 92);
                                writeByte(&!m, e);
                                writeString(&!m, " in a string is not supported");
                                tagFailText(&~s, "H7011", finalize(m));
                            end if;
                            j := j + 2;
                        end if;
                    else
                        writeByte(&!out, text[j]);
                        j := j + 1;
                    end if;
                end while;
                if j >= n then
                    tagFail(&~s, "H7005", "a string in this tag is never closed");
                end if;
                pushToken(&~s, tokenString, finalize(out));
                i := j + 1;
            else
                var two: Bool := false;
                if (i + 1) < n then
                    let d: Nat8 := text[i + 1];
                    two := ((c = '=') and (d = '=')) or ((c = '!') and (d = '=')) or ((c = '<') and (d = '='))
                        or ((c = '>') and (d = '=')) or ((c = '/') and (d = '/')) or ((c = '*') and (d = '*'));
                end if;
                if two then
                    pushToken(&~s, tokenOperator, fromSpan(spanPart(text, i, 2)));
                    i := i + 2;
                else if isOperatorByte(c) then
                    pushToken(&~s, tokenOperator, fromSpan(spanPart(text, i, 1)));
                    i := i + 1;
                else
                    var m: StringBuilder := makeStringBuilder();
                    writeString(&!m, "the character ");
                    writeByte(&!m, c);
                    writeString(&!m, " cannot stand here");
                    tagFailText(&~s, "H7013", finalize(m));
                    i := n;
                end if;
            end if;
        end while;
        return nil;
    end;

    generic [R: Region]
    function tokensLeft(s: &![Syntax, R]): Bool is
        let at: Index := s->tokenAt;
        return at < tokensCount(&~s);
    end;

    -- The token at the cursor and offset further on; a token of kind 0 past
    -- the end.
    generic [R: Region]
    function tokenAhead(s: &![Syntax, R], offset: Index): Token is
        let at: Index := s->tokenAt + offset;
        if at < tokensCount(&~s) then
            return tokensItem(&~s, at);
        end if;
        return Token(kind => 0, text => 0);
    end;

    generic [R: Region, T: Region]
    function isTokenAhead(s: &![Syntax, R], offset: Index, kind: Nat8, text: Span[Nat8, T]): Bool is
        let t: Token := tokenAhead(&~s, offset);
        if t.kind /= kind then
            return false;
        end if;
        return nameIs(&~s, t.text, text);
    end;

    generic [R: Region, T: Region]
    function isOp(s: &![Syntax, R], text: Span[Nat8, T]): Bool is
        return isTokenAhead(&~s, 0, tokenOperator, text);
    end;

    generic [R: Region, T: Region]
    function isWord(s: &![Syntax, R], text: Span[Nat8, T]): Bool is
        return isTokenAhead(&~s, 0, tokenName, text);
    end;

    -- The conditions of the parser's loops: a token at the cursor, and
    -- nothing failed yet.  Each asks the syntax once a statement.
    generic [R: Region, T: Region]
    function wordAndGoing(s: &![Syntax, R], text: Span[Nat8, T]): Bool is
        if hasFailed(&~s) then
            return false;
        end if;
        return isWord(&~s, text);
    end;

    generic [R: Region, T: Region]
    function opAndGoing(s: &![Syntax, R], text: Span[Nat8, T]): Bool is
        if hasFailed(&~s) then
            return false;
        end if;
        return isOp(&~s, text);
    end;

    -- No ) at the cursor, and nothing failed yet.
    generic [R: Region]
    function openAndGoing(s: &![Syntax, R]): Bool is
        if hasFailed(&~s) then
            return false;
        end if;
        return not isOp(&~s, ")");
    end;

    generic [R: Region]
    function tokensAndGoing(s: &![Syntax, R]): Bool is
        if hasFailed(&~s) then
            return false;
        end if;
        return tokensLeft(&~s);
    end;

    -- Whether the name numbered at is one of two texts.
    generic [R: Region, A: Region, B: Region]
    function nameIsEither(s: &![Syntax, R], at: Index, first: Span[Nat8, A], second: Span[Nat8, B]): Bool is
        if nameIs(&~s, at, first) then
            return true;
        end if;
        return nameIs(&~s, at, second);
    end;

    -- The code of loop.attr (loopAttribute's), 7 when x is no loop.attr.
    generic [R: Region]
    function loopCodeOf(s: &![Syntax, R], x: SyntaxExpr): Index is
        if not isLoopPath(&~s, x) then
            return 7;
        end if;
        let attr: Index := listItem(&~s, x.list + 1);
        return loopAttribute(&~s, attr);
    end;

    generic [R: Region]
    function advance(s: &![Syntax, R]): Unit is
        if tokensLeft(&~s) then
            s->tokenAt := s->tokenAt + 1;
        end if;
        return nil;
    end;

    generic [R: Region]
    function expectOp(s: &![Syntax, R], op: Span[Nat8, Static]): Unit is
        if isOp(&~s, op) then
            advance(&~s);
        else
            tagFailText(&~s, "H7014", joined("expected ", op, ""));
        end if;
        return nil;
    end;

    -- The name at the cursor, taken; 0 and a failure when there is none.
    generic [R: Region]
    function expectName(s: &![Syntax, R]): Index is
        let t: Token := tokenAhead(&~s, 0);
        if t.kind = tokenName then
            advance(&~s);
            return t.text;
        end if;
        tagFail(&~s, "H7015", "expected a name");
        return 0;
    end;

    generic [R: Region]
    function newExpr(s: &![Syntax, R], op: Nat8): SyntaxExpr is
        return blankExpr(op, s->tagFile, s->tagLine);
    end;

    generic [R: Region]
    function binaryExpr(s: &![Syntax, R], op: Nat8, left: Index, right: Index): Index is
        var e: SyntaxExpr := newExpr(&~s, op);
        e.a := left;
        e.b := right;
        return addExpr(&~s, e);
    end;

    -- Deeper than mostNesting brackets, nots, tags and operators of a chain:
    -- a failure.
    generic [R: Region]
    function enter(s: &![Syntax, R]): Bool is
        s->nesting := s->nesting + 1;
        if s->nesting > mostNesting() then
            tagFail(&~s, "V0001", "tags, brackets, nots and the operators of a chain are nested more than 64 deep");
            return false;
        end if;
        return true;
    end;

    generic [R: Region]
    function leave(s: &![Syntax, R]): Unit is
        if s->nesting > 0 then
            s->nesting := s->nesting - 1;
        end if;
        return nil;
    end;

    -- leave count times: the end of a chain, each operand of which made the
    -- tree of its expression one deeper and was counted as a bracket is.
    generic [R: Region]
    function leaveTimes(s: &![Syntax, R], count: Index): Unit is
        var i: Index := 0;
        while i < count do
            leave(&~s);
            i := i + 1;
        end while;
        return nil;
    end;

    -- The levels, loosest first, as Jinja2 documents them: the inline if,
    -- or, and, not, the comparisons with in and is, ~, + and -, *, // and
    -- %, the minus sign of a number, the filters, and what a filter
    -- applies to.
    generic [R: Region]
    function parseExpr(s: &![Syntax, R]): Index is
        if not enter(&~s) then
            return 0;
        end if;
        let e: Index := parseOr(&~s);
        var result: Index := e;
        if isWord(&~s, "if") then
            advance(&~s);
            let cond: Index := parseOr(&~s);
            var otherwise: Index := 0;
            if isWord(&~s, "else") then
                advance(&~s);
                otherwise := parseExpr(&~s);
            end if;
            var made: SyntaxExpr := newExpr(&~s, syntaxCond);
            made.a := e;
            made.b := cond;
            made.c := otherwise;
            made.flag := otherwise /= 0;
            result := addExpr(&~s, made);
        end if;
        leave(&~s);
        return result;
    end;

    generic [R: Region]
    function parseOr(s: &![Syntax, R]): Index is
        var left: Index := parseAnd(&~s);
        var depth: Index := 0;
        while wordAndGoing(&~s, "or") do
            advance(&~s);
            if not enter(&~s) then
                return left;
            end if;
            depth := depth + 1;
            let right: Index := parseAnd(&~s);
            left := binaryExpr(&~s, syntaxOr, left, right);
        end while;
        leaveTimes(&~s, depth);
        return left;
    end;

    generic [R: Region]
    function parseAnd(s: &![Syntax, R]): Index is
        var left: Index := parseNot(&~s);
        var depth: Index := 0;
        while wordAndGoing(&~s, "and") do
            advance(&~s);
            if not enter(&~s) then
                return left;
            end if;
            depth := depth + 1;
            let right: Index := parseNot(&~s);
            left := binaryExpr(&~s, syntaxAnd, left, right);
        end while;
        leaveTimes(&~s, depth);
        return left;
    end;

    generic [R: Region]
    function parseNot(s: &![Syntax, R]): Index is
        if isWord(&~s, "not") then
            if not enter(&~s) then
                return 0;
            end if;
            advance(&~s);
            let inner: Index := parseNot(&~s);
            leave(&~s);
            return binaryExpr(&~s, syntaxNot, inner, 0);
        end if;
        return parseCompare(&~s);
    end;

    -- The code of a comparison operator at the cursor, 6 when there is none.
    generic [R: Region]
    function comparisonAhead(s: &![Syntax, R]): Index is
        if isOp(&~s, "==") then
            return compareEqual;
        else if isOp(&~s, "!=") then
            return compareNotEqual;
        else if isOp(&~s, "<") then
            return compareLess;
        else if isOp(&~s, "<=") then
            return compareLessOrEqual;
        else if isOp(&~s, ">") then
            return compareGreater;
        else if isOp(&~s, ">=") then
            return compareGreaterOrEqual;
        end if;
        return 6;
    end;

    generic [R: Region]
    function parseCompare(s: &![Syntax, R]): Index is
        let left: Index := parseConcat(&~s);
        let op: Index := comparisonAhead(&~s);
        if op < 6 then
            advance(&~s);
            let right: Index := parseConcat(&~s);
            var e: SyntaxExpr := newExpr(&~s, syntaxCompare);
            e.a := left;
            e.b := right;
            e.c := op;
            return addExpr(&~s, e);
        end if;
        if isWord(&~s, "is") then
            advance(&~s);
            let negated: Bool := isWord(&~s, "not");
            if negated then
                advance(&~s);
            end if;
            let test: Index := expectName(&~s);
            var e: SyntaxExpr := newExpr(&~s, syntaxTest);
            e.a := left;
            e.b := test;
            e.flag := negated;
            return addExpr(&~s, e);
        end if;
        if isWord(&~s, "in") then
            advance(&~s);
            let haystack: Index := parseConcat(&~s);
            var e: SyntaxExpr := newExpr(&~s, syntaxIn);
            e.a := left;
            e.b := haystack;
            return addExpr(&~s, e);
        end if;
        let notAhead: Bool := isWord(&~s, "not");
        let inAhead: Bool := isTokenAhead(&~s, 1, tokenName, "in");
        if notAhead and inAhead then
            advance(&~s);
            advance(&~s);
            let haystack: Index := parseConcat(&~s);
            var e: SyntaxExpr := newExpr(&~s, syntaxIn);
            e.a := left;
            e.b := haystack;
            e.flag := true;
            return addExpr(&~s, e);
        end if;
        return left;
    end;

    generic [R: Region]
    function parseConcat(s: &![Syntax, R]): Index is
        var left: Index := parseAdditive(&~s);
        var depth: Index := 0;
        while opAndGoing(&~s, "~") do
            advance(&~s);
            if not enter(&~s) then
                return left;
            end if;
            depth := depth + 1;
            let right: Index := parseAdditive(&~s);
            left := binaryExpr(&~s, syntaxConcat, left, right);
        end while;
        leaveTimes(&~s, depth);
        return left;
    end;

    generic [R: Region]
    function arithExpr(s: &![Syntax, R], op: Index, left: Index, right: Index): Index is
        var e: SyntaxExpr := newExpr(&~s, syntaxArith);
        e.a := left;
        e.b := right;
        e.c := op;
        return addExpr(&~s, e);
    end;

    generic [R: Region]
    function parseAdditive(s: &![Syntax, R]): Index is
        var left: Index := parseMultiplicative(&~s);
        var depth: Index := 0;
        var going: Bool := true;
        while going and (not hasFailed(&~s)) do
            let plus: Bool := isOp(&~s, "+");
            let minus: Bool := isOp(&~s, "-");
            if plus or minus then
                if not enter(&~s) then
                    return left;
                end if;
                depth := depth + 1;
            end if;
            if isOp(&~s, "+") then
                advance(&~s);
                let right: Index := parseMultiplicative(&~s);
                left := arithExpr(&~s, arithAdd, left, right);
            else if isOp(&~s, "-") then
                advance(&~s);
                let right: Index := parseMultiplicative(&~s);
                left := arithExpr(&~s, arithSubtract, left, right);
            else
                going := false;
            end if;
        end while;
        leaveTimes(&~s, depth);
        return left;
    end;

    generic [R: Region]
    function parseMultiplicative(s: &![Syntax, R]): Index is
        var left: Index := parseUnary(&~s);
        var depth: Index := 0;
        var going: Bool := true;
        while going and (not hasFailed(&~s)) do
            let times: Bool := isOp(&~s, "*");
            let divided: Bool := isOp(&~s, "//");
            let modulo: Bool := isOp(&~s, "%");
            if times or divided or modulo then
                if not enter(&~s) then
                    return left;
                end if;
                depth := depth + 1;
            end if;
            if isOp(&~s, "*") then
                advance(&~s);
                let right: Index := parseUnary(&~s);
                left := arithExpr(&~s, arithMultiply, left, right);
            else if isOp(&~s, "//") then
                advance(&~s);
                let right: Index := parseUnary(&~s);
                left := arithExpr(&~s, arithFloorDivide, left, right);
            else if isOp(&~s, "%") then
                advance(&~s);
                let right: Index := parseUnary(&~s);
                left := arithExpr(&~s, arithModulo, left, right);
            else if isOp(&~s, "/") then
                tagFail(&~s, "H7016",
                    "the operator / divides into a fraction, and @template has no fractions; // divides into a whole number");
                going := false;
            else
                going := false;
            end if;
        end while;
        leaveTimes(&~s, depth);
        return left;
    end;

    generic [R: Region]
    function parseUnary(s: &![Syntax, R]): Index is
        var e: Index := 0;
        if isOp(&~s, "-") then
            let next: Token := tokenAhead(&~s, 1);
            if next.kind = tokenInteger then
                advance(&~s);
                advance(&~s);
                let digits: String := nameCopy(&~s, next.text);
                let negative: Index := addName(&~s, joined("-", asSpan(&digits), ""));
                destroyString(digits);
                var made: SyntaxExpr := newExpr(&~s, syntaxInteger);
                made.a := negative;
                e := addExpr(&~s, made);
            else
                tagFail(&~s, "H7024", "a minus sign stands before a number only; write 0 - x to subtract from zero");
            end if;
        else
            e := parseFiltered(&~s);
        end if;
        if isOp(&~s, "**") then
            tagFail(&~s, "H7016",
                "the operator ** is not supported: a power leaves every integer type after a few steps");
        end if;
        return e;
    end;

    -- The arguments in brackets after a filter: the cursor stands on (.
    generic [R: Region, B: Region]
    function parseArguments(s: &![Syntax, R], items: &![Buffer[Index], B]): Unit is
        advance(&~s);
        while openAndGoing(&~s) do
            insertBack(&~items, parseExpr(&~s));
            if isOp(&~s, ",") then
                advance(&~s);
            else if not isOp(&~s, ")") then
                tagFail(&~s, "H7019", "expected , or )");
            end if;
        end while;
        advance(&~s);
        return nil;
    end;

    generic [R: Region]
    function parseFiltered(s: &![Syntax, R]): Index is
        var e: Index := parsePrimary(&~s);
        var depth: Index := 0;
        while opAndGoing(&~s, "|") do
            advance(&~s);
            if not enter(&~s) then
                return e;
            end if;
            depth := depth + 1;
            let name: Index := expectName(&~s);
            var args: Buffer[Index] := allocateEmpty();
            if isOp(&~s, "(") then
                parseArguments(&~s, &!args);
            end if;
            var made: SyntaxExpr := newExpr(&~s, syntaxFilter);
            made.a := e;
            made.b := name;
            made.count := length(&args);
            made.list := addList(&~s, &args);
            destroyFree(args);
            e := addExpr(&~s, made);
        end while;
        leaveTimes(&~s, depth);
        return e;
    end;

    generic [R: Region]
    function parsePrimary(s: &![Syntax, R]): Index is
        let t: Token := tokenAhead(&~s, 0);
        if t.kind = tokenString then
            advance(&~s);
            var made: SyntaxExpr := newExpr(&~s, syntaxString);
            made.a := t.text;
            return addExpr(&~s, made);
        end if;
        if t.kind = tokenInteger then
            advance(&~s);
            var made: SyntaxExpr := newExpr(&~s, syntaxInteger);
            made.a := t.text;
            return addExpr(&~s, made);
        end if;
        if t.kind = tokenName then
            if nameIsEither(&~s, t.text, "true", "True") then
                advance(&~s);
                var made: SyntaxExpr := newExpr(&~s, syntaxBool);
                made.flag := true;
                return addExpr(&~s, made);
            end if;
            if nameIsEither(&~s, t.text, "false", "False") then
                advance(&~s);
                let held1: SyntaxExpr := newExpr(&~s, syntaxBool);
                return addExpr(&~s, held1);
            end if;
            if nameIsEither(&~s, t.text, "none", "None") then
                advance(&~s);
                let held2: SyntaxExpr := newExpr(&~s, syntaxNone);
                return addExpr(&~s, held2);
            end if;
            return parsePath(&~s);
        end if;
        if isOp(&~s, "(") then
            if not enter(&~s) then
                return 0;
            end if;
            advance(&~s);
            let e: Index := parseExpr(&~s);
            expectOp(&~s, ")");
            leave(&~s);
            return e;
        end if;
        if t.kind = tokenOperator then
            let op: String := nameCopy(&~s, t.text);
            tagFailText(&~s, "H7025", joined("unexpected ", asSpan(&op), ""));
            destroyString(op);
            return 0;
        end if;
        tagFail(&~s, "H7026", "an expression is missing");
        return 0;
    end;

    -- A name and what follows it: .name and ["name"] as a path, then ( as
    -- a call.
    generic [R: Region]
    function parsePath(s: &![Syntax, R]): Index is
        var path: Buffer[Index] := allocateEmpty();
        insertBack(&!path, expectName(&~s));
        var going: Bool := true;
        while going and (not hasFailed(&~s)) do
            if isOp(&~s, ".") then
                advance(&~s);
                insertBack(&!path, expectName(&~s));
            else if isOp(&~s, "[") then
                let key: Token := tokenAhead(&~s, 1);
                if (key.kind = tokenString) and isTokenAhead(&~s, 2, tokenOperator, "]") then
                    advance(&~s);
                    advance(&~s);
                    advance(&~s);
                    insertBack(&!path, key.text);
                else
                    tagFail(&~s, "H7023",
                        "[ ] takes a name in quotes, as in a[\"b\"]: an index into a list fails when the page is rendered if the list is shorter, which a compiled template cannot allow");
                    going := false;
                end if;
            else
                going := false;
            end if;
        end while;
        if isOp(&~s, "(") then
            return parseCall(&~s, path);
        end if;
        var made: SyntaxExpr := newExpr(&~s, syntaxPath);
        made.count := length(&path);
        made.list := addList(&~s, &path);
        destroyFree(path);
        return addExpr(&~s, made);
    end;

    -- A call of the path: the cursor stands on (.
    generic [R: Region]
    function parseCall(s: &![Syntax, R], path: Buffer[Index]): Index is
        let parts: Index := length(&path);
        let first: Index := nth(&path, 0);
        if (parts = 1) and nameIs(&~s, first, "_") then
            destroyFree(path);
            return parseTranslation(&~s);
        end if;
        let dotted: String := dottedName(&~s, &path);
        destroyFree(path);
        if parts > 2 then
            tagFailText(&~s, "H7022", joined("calling ", asSpan(&dotted),
                " is not supported; a macro is called by its name, or by the name an {% import %} gave and its own"));
            destroyString(dotted);
            return 0;
        end if;
        let name: Index := addName(&~s, dotted);
        advance(&~s);
        var args: Buffer[Index] := allocateEmpty();
        while openAndGoing(&~s) do
            let ahead: Token := tokenAhead(&~s, 0);
            if (ahead.kind = tokenName) and isTokenAhead(&~s, 1, tokenOperator, "=") then
                tagFail(&~s, "H7020", "keyword arguments are not supported");
            end if;
            insertBack(&!args, parseExpr(&~s));
            if isOp(&~s, ",") then
                advance(&~s);
            else if not isOp(&~s, ")") then
                tagFail(&~s, "H7021", "expected , or )");
            end if;
        end while;
        advance(&~s);
        var made: SyntaxExpr := newExpr(&~s, syntaxCall);
        made.b := name;
        made.count := length(&args);
        made.list := addList(&~s, &args);
        destroyFree(args);
        return addExpr(&~s, made);
    end;

    generic [R: Region, B: Region]
    function dottedName(s: &![Syntax, R], path: &[Buffer[Index], B]): String is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < length(path) do
            if i > 0 then
                writeByte(&!out, '.');
            end if;
            let part: String := nameCopy(&~s, nth(path, i));
            writeString(&!out, asSpan(&part));
            destroyString(part);
            i := i + 1;
        end while;
        return finalize(out);
    end;

    -- _("Key", name=value, ...): the one call that takes named arguments,
    -- as jinja2.ext.i18n's does.  The cursor stands on (.  The list holds
    -- pairs: a name, then its expression.
    generic [R: Region]
    function parseTranslation(s: &![Syntax, R]): Index is
        advance(&~s);
        let key: Token := tokenAhead(&~s, 0);
        if key.kind /= tokenString then
            tagFail(&~s, "H7115", "_( ) takes the key first, as a string literal, as in _(\"Greeting\")");
            return 0;
        end if;
        advance(&~s);
        var pairs: Buffer[Index] := allocateEmpty();
        while opAndGoing(&~s, ",") do
            advance(&~s);
            let name: Token := tokenAhead(&~s, 0);
            if (name.kind = tokenName) and isTokenAhead(&~s, 1, tokenOperator, "=") then
                advance(&~s);
                advance(&~s);
                if pairNamed(&~s, &pairs, name.text) then
                    let given: String := nameCopy(&~s, name.text);
                    tagFailText(&~s, "H7116", joined("_( ) is given ", asSpan(&given), " twice"));
                    destroyString(given);
                end if;
                insertBack(&!pairs, name.text);
                insertBack(&!pairs, parseExpr(&~s));
            else
                tagFail(&~s, "H7125", "after the key, _( ) takes its arguments as name=value");
            end if;
        end while;
        expectOp(&~s, ")");
        var made: SyntaxExpr := newExpr(&~s, syntaxTrans);
        made.b := key.text;
        made.count := length(&pairs) / 2;
        made.list := addList(&~s, &pairs);
        destroyFree(pairs);
        return addExpr(&~s, made);
    end;

    -- Whether the pairs name already.
    generic [R: Region, B: Region]
    function pairNamed(s: &![Syntax, R], pairs: &[Buffer[Index], B], name: Index): Bool is
        var i: Index := 0;
        while i < length(pairs) do
            if sameNames(&~s, nth(pairs, i), name) then
                return true;
            end if;
            i := i + 2;
        end while;
        return false;
    end;

    -- One whole expression, as {{ }} holds it.
    generic [R: Region, T: Region]
    function parseWhole(s: &![Syntax, R], text: Span[Nat8, T]): Index is
        tokenize(&~s, text);
        if hasFailed(&~s) then
            return 0;
        end if;
        let e: Index := parseExpr(&~s);
        if tokensLeft(&~s) then
            tagFail(&~s, "H7027", "unexpected text after the expression");
        end if;
        return e;
    end;

    ---
    --- 2b. The parser: the tree of a template
    ---

    -- The keywords that end a list of nodes, by code.
    constant stopNone: Nat8 := 0;
    constant stopIf: Nat8 := 1;
    constant stopEndIf: Nat8 := 2;
    constant stopFor: Nat8 := 3;
    constant stopEndFor: Nat8 := 4;
    constant stopEndSet: Nat8 := 5;
    constant stopEndWith: Nat8 := 6;
    constant stopTrans: Nat8 := 7;
    constant stopEndTrans: Nat8 := 8;
    constant stopEndFilter: Nat8 := 9;
    constant stopEndCall: Nat8 := 10;
    constant stopEndBlock: Nat8 := 11;
    constant stopEndMacro: Nat8 := 12;

    generic [K: Region]
    function isStop(stop: Nat8, keyword: Span[Nat8, K]): Bool is
        if stop = stopIf then
            return equal(keyword, "elif") or equal(keyword, "else") or equal(keyword, "endif");
        else if stop = stopEndIf then
            return equal(keyword, "endif");
        else if stop = stopFor then
            return equal(keyword, "else") or equal(keyword, "endfor");
        else if stop = stopEndFor then
            return equal(keyword, "endfor");
        else if stop = stopEndSet then
            return equal(keyword, "endset");
        else if stop = stopEndWith then
            return equal(keyword, "endwith");
        else if stop = stopTrans then
            return equal(keyword, "pluralize") or equal(keyword, "endtrans");
        else if stop = stopEndTrans then
            return equal(keyword, "endtrans");
        else if stop = stopEndFilter then
            return equal(keyword, "endfilter");
        else if stop = stopEndCall then
            return equal(keyword, "endcall");
        else if stop = stopEndBlock then
            return equal(keyword, "endblock");
        else if stop = stopEndMacro then
            return equal(keyword, "endmacro");
        end if;
        return false;
    end;

    -- The end of a list of nodes: the nodes, and the keyword that ended it
    -- (0 at the end of the template) with its argument and line.
    record Ending: Free is
        list: Index;
        count: Index;
        keyword: Index;
        argument: Index;
        line: Index;
    end;

    generic [R: Region]
    function chunkTotal(s: &![Syntax, R]): Index is
        return chunksCount(&~s);
    end;

    generic [R: Region]
    function chunkOf(s: &![Syntax, R], at: Index): Chunk is
        return chunksItem(&~s, at);
    end;

    generic [R: Region]
    function setTag(s: &![Syntax, R], file: Index, line: Index): Unit is
        s->tagFile := file;
        s->tagLine := line;
        return nil;
    end;

    -- A tag's body split into its keyword and the rest, both trimmed; the
    -- keyword 0 and a failure when the tag begins with none.
    record Keyword: Free is
        word: Index;
        argument: Index;
    end;

    generic [R: Region, T: Region]
    function blockKeyword(s: &![Syntax, R], content: Span[Nat8, T]): Keyword is
        var a: Index := 0;
        var b: Index := spanLength(content);
        while (a < b) and isSpace(content[a]) do
            a := a + 1;
        end while;
        while (b > a) and isSpace(content[b - 1]) do
            b := b - 1;
        end while;
        var i: Index := a;
        while (i < b) and isNameChar(content[i]) do
            i := i + 1;
        end while;
        if i = a then
            tagFail(&~s, "H7028", "a {% %} tag must begin with a keyword");
            return Keyword(word => 0, argument => 0);
        end if;
        var r: Index := i;
        while (r < b) and isSpace(content[r]) do
            r := r + 1;
        end while;
        let word: Index := addName(&~s, fromSpan(spanPart(content, a, i - a)));
        let argument: Index := addName(&~s, fromSpan(spanPart(content, r, b - r)));
        return Keyword(word => word, argument => argument);
    end;

    -- {% kw %} with the keyword's text, for a message.
    generic [R: Region]
    function tagText(s: &![Syntax, R], before: Span[Nat8, Static], word: Index, after: Span[Nat8, Static]): String is
        let text: String := nameCopy(&~s, word);
        let made: String := joined(before, asSpan(&text), after);
        destroyString(text);
        return made;
    end;

    generic [R: Region, S: Region]
    function parseNodes(s: &![Syntax, R], source: Span[Nat8, S], file: Index, stop: Nat8): Ending is
        var nodes: Buffer[Index] := allocateEmpty();
        var ending: Ending := Ending(list => 0, count => 0, keyword => 0, argument => 0, line => 0);
        if not enter(&~s) then
            destroyFree(nodes);
            return ending;
        end if;
        var done: Bool := false;
        while (not done) and (not hasFailed(&~s)) do
            let at: Index := s->chunkAt;
            if at >= chunkTotal(&~s) then
                done := true;
            else
                let chunk: Chunk := chunkOf(&~s, at);
                s->chunkAt := at + 1;
                let content: Span[Nat8, S] := spanPart(source, chunk.start, chunk.size);
                setTag(&~s, file, chunk.line);
                if chunk.kind = chunkText then
                    var node: SyntaxNode := blankNode(nodeText, file, chunk.line);
                    node.a := addName(&~s, fromSpan(content));
                    insertBack(&!nodes, addNode(&~s, node));
                else if chunk.kind = chunkValue then
                    var node: SyntaxNode := blankNode(nodeOut, file, chunk.line);
                    node.a := parseWhole(&~s, content);
                    insertBack(&!nodes, addNode(&~s, node));
                else
                    let kw: Keyword := blockKeyword(&~s, content);
                    if kw.word /= 0 then
                        let word: String := nameCopy(&~s, kw.word);
                        if isStop(stop, asSpan(&word)) then
                            ending.keyword := kw.word;
                            ending.argument := kw.argument;
                            ending.line := chunk.line;
                            done := true;
                        else
                            let made: Index := parseTag(&~s, source, file, chunk.line, asSpan(&word), kw);
                            if made /= 0 then
                                insertBack(&!nodes, made);
                            end if;
                        end if;
                        destroyString(word);
                    end if;
                end if;
            end if;
        end while;
        leave(&~s);
        ending.count := length(&nodes);
        ending.list := addList(&~s, &nodes);
        destroyFree(nodes);
        return ending;
    end;

    -- The node of one tag that is no ending: 0 when it makes none.
    generic [R: Region, S: Region, W: Region]
    function parseTag(s: &![Syntax, R], source: Span[Nat8, S], file: Index, line: Index, word: Span[Nat8, W],
        kw: Keyword): Index is
        let argument: String := nameCopy(&~s, kw.argument);
        var made: Index := 0;
        if equal(word, "if") then
            let cond: Index := parseWhole(&~s, asSpan(&argument));
            made := parseIf(&~s, source, file, line, cond);
        else if equal(word, "for") then
            made := parseFor(&~s, source, file, line, asSpan(&argument));
        else if equal(word, "block") then
            made := parseBlock(&~s, source, file, line, asSpan(&argument));
        else if equal(word, "macro") then
            made := parseMacro(&~s, source, file, line, asSpan(&argument));
        else if equal(word, "extends") or equal(word, "include") then
            let target: Index := onlyString(&~s, kw.word, asSpan(&argument));
            var node: SyntaxNode := blankNode(nodeInclude, file, line);
            if equal(word, "extends") then
                node.kind := nodeExtends;
            end if;
            node.a := target;
            made := addNode(&~s, node);
        else if equal(word, "from") then
            made := parseFrom(&~s, file, line, asSpan(&argument));
        else if equal(word, "import") then
            made := parseImport(&~s, file, line, asSpan(&argument));
        else if equal(word, "set") then
            made := parseSet(&~s, source, file, line, asSpan(&argument));
        else if equal(word, "with") then
            made := parseWith(&~s, source, file, line, asSpan(&argument));
        else if equal(word, "filter") then
            made := parseFilterBlock(&~s, source, file, line, asSpan(&argument));
        else if equal(word, "call") then
            made := parseCallBlock(&~s, source, file, line, asSpan(&argument));
        else if equal(word, "catalog") then
            tokenize(&~s, asSpan(&argument));
            let t: Token := tokenAhead(&~s, 0);
            if (t.kind = tokenName) and (tokensCount(&~s) = 1) then
                var node: SyntaxNode := blankNode(nodeCatalog, file, line);
                node.a := t.text;
                made := addNode(&~s, node);
            else
                tagFail(&~s, "H7117",
                    "{% catalog %} takes the name of a function of no arguments that gives the catalog, as in {% catalog messages %}");
            end if;
        else if equal(word, "trans") then
            made := parseTrans(&~s, source, file, line, asSpan(&argument));
        else if equal(word, "autoescape") then
            tagFail(&~s, "H7033",
                "{% autoescape %} is refused: escaping cannot be switched off for a stretch of template -- write |safe on the one value that is meant to go out unescaped, where a grep finds it");
        else if equal(word, "elif") or equal(word, "else") or equal(word, "endif") or equal(word, "endfor")
            or equal(word, "endblock") or equal(word, "endmacro") or equal(word, "endset") or equal(word, "endwith")
            or equal(word, "endfilter") or equal(word, "endcall") or equal(word, "pluralize")
            or equal(word, "endtrans") then
            let held3: String := tagText(&~s, "{% ", kw.word, " %} without the tag it belongs to");
            tagFailText(&~s, "H7034", held3);
        else
            let held4: String := tagText(&~s, "{% ", kw.word, " %} is not supported");
            tagFailText(&~s, "H7029", held4);
        end if;
        destroyString(argument);
        return made;
    end;

    -- The one string literal a tag takes: extends "x", include "x".  A name
    -- in its place would be a template chosen at run time.
    generic [R: Region, T: Region]
    function onlyString(s: &![Syntax, R], keyword: Index, argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        let t: Token := tokenAhead(&~s, 0);
        if t.kind = tokenString then
            if tokensCount(&~s) = 1 then
                return t.text;
            end if;
            let held5: String := tagText(&~s, "{% ", keyword, " %} takes the template's name and nothing after it");
            tagFailText(&~s, "H7030", held5);
            return 0;
        end if;
        let held6: String := tagText(&~s, "{% ", keyword,
            " %} takes a string literal: a template chosen when the page is rendered cannot be compiled");
        tagFailText(&~s, "H7031", held6);
        return 0;
    end;

    generic [R: Region, S: Region]
    function parseIf(s: &![Syntax, R], source: Span[Nat8, S], file: Index, line: Index, first: Index): Index is
        var branches: Buffer[Index] := allocateEmpty();
        var cond: Index := first;
        var condLine: Index := line;
        var elseList: Index := 0;
        var elseCount: Index := 0;
        var finished: Bool := false;
        while (not finished) and (not hasFailed(&~s)) do
            let ending: Ending := parseNodes(&~s, source, file, stopIf);
            var branch: SyntaxNode := blankNode(nodeBranch, file, condLine);
            branch.a := cond;
            branch.list1 := ending.list;
            branch.count1 := ending.count;
            insertBack(&!branches, addNode(&~s, branch));
            if ending.keyword = 0 then
                if not hasFailed(&~s) then
                    fail(&~s, "H7036", file, line, "{% if %} without {% endif %}");
                end if;
                finished := true;
            else if nameIs(&~s, ending.keyword, "elif") then
                setTag(&~s, file, ending.line);
                let text: String := nameCopy(&~s, ending.argument);
                cond := parseWhole(&~s, asSpan(&text));
                destroyString(text);
                condLine := ending.line;
            else if nameIs(&~s, ending.keyword, "else") then
                let rest: Ending := parseNodes(&~s, source, file, stopEndIf);
                if rest.keyword = 0 then
                    if not hasFailed(&~s) then
                        fail(&~s, "H7035", file, ending.line, "{% else %} without {% endif %}");
                    end if;
                end if;
                elseList := rest.list;
                elseCount := rest.count;
                finished := true;
            else
                finished := true;
            end if;
        end while;
        var node: SyntaxNode := blankNode(nodeIf, file, line);
        node.count1 := length(&branches);
        node.list1 := addList(&~s, &branches);
        destroyFree(branches);
        node.list2 := elseList;
        node.count2 := elseCount;
        return addNode(&~s, node);
    end;

    generic [R: Region, S: Region, T: Region]
    function parseFor(s: &![Syntax, R], source: Span[Nat8, S], file: Index, line: Index, argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        var names: Buffer[Index] := allocateEmpty();
        insertBack(&!names, expectName(&~s));
        while opAndGoing(&~s, ",") do
            advance(&~s);
            insertBack(&!names, expectName(&~s));
        end while;
        if length(&names) > 3 then
            fail(&~s, "H7037", file, line,
                "{% for %} takes one name, or two or three that unpack a Pair or a Triple of Standard.Tuples");
        end if;
        if isWord(&~s, "in") then
            advance(&~s);
        else
            fail(&~s, "H7038", file, line, "expected `in' in {% for %}");
        end if;
        let sequence: Index := parseOr(&~s);
        var cond: Index := 0;
        if isWord(&~s, "if") then
            advance(&~s);
            cond := parseOr(&~s);
        end if;
        if tokensLeft(&~s) then
            fail(&~s, "H7039", file, line, "after {% for ... in ... %} only `if' and a condition may follow");
        end if;
        var node: SyntaxNode := blankNode(nodeFor, file, line);
        node.a := sequence;
        node.b := cond;
        node.count1 := length(&names);
        node.list1 := addList(&~s, &names);
        destroyFree(names);
        let content: Ending := parseNodes(&~s, source, file, stopFor);
        node.list2 := content.list;
        node.count2 := content.count;
        if content.keyword = 0 then
            if not hasFailed(&~s) then
                fail(&~s, "H7041", file, line, "{% for %} without {% endfor %}");
            end if;
        else if nameIs(&~s, content.keyword, "else") then
            let empty: Ending := parseNodes(&~s, source, file, stopEndFor);
            if empty.keyword = 0 then
                if not hasFailed(&~s) then
                    fail(&~s, "H7040", file, content.line, "{% else %} without {% endfor %}");
                end if;
            end if;
            node.list3 := empty.list;
            node.count3 := empty.count;
        end if;
        return addNode(&~s, node);
    end;

    -- {% tag %} without {% closer %}.
    generic [R: Region]
    function withoutEnd(s: &![Syntax, R], file: Index, line: Index, tag: String, closer: Span[Nat8, Static]): Unit is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "{% ");
        writeString(&!out, asSpan(&tag));
        writeString(&!out, " %} without {% ");
        writeString(&!out, closer);
        writeString(&!out, " %}");
        destroyString(tag);
        failText(&~s, "H7100", file, line, finalize(out));
        return nil;
    end;

    -- {% tag %} takes rule.
    generic [R: Region]
    function tagForm(s: &![Syntax, R], file: Index, line: Index, tag: Span[Nat8, Static], rule: Span[Nat8, Static]): Unit is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "{% ");
        writeString(&!out, tag);
        writeString(&!out, " %} takes ");
        writeString(&!out, rule);
        failText(&~s, "H7101", file, line, finalize(out));
        return nil;
    end;

    generic [R: Region, S: Region, T: Region]
    function parseSet(s: &![Syntax, R], source: Span[Nat8, S], file: Index, line: Index, argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        let name: Index := expectName(&~s);
        if not tokensLeft(&~s) then
            let content: Ending := parseNodes(&~s, source, file, stopEndSet);
            if (content.keyword = 0) and (not hasFailed(&~s)) then
                let text: String := nameCopy(&~s, name);
                withoutEnd(&~s, file, line, joined("set ", asSpan(&text), ""), "endset");
                destroyString(text);
            end if;
            var node: SyntaxNode := blankNode(nodeSetBlock, file, line);
            node.a := name;
            node.list1 := content.list;
            node.count1 := content.count;
            return addNode(&~s, node);
        end if;
        if isOp(&~s, "=") then
            advance(&~s);
            let e: Index := parseExpr(&~s);
            if tokensLeft(&~s) then
                tagForm(&~s, file, line, "set", "one name, = and one value");
            end if;
            var node: SyntaxNode := blankNode(nodeSet, file, line);
            node.a := name;
            node.b := e;
            return addNode(&~s, node);
        end if;
        tagForm(&~s, file, line, "set", "one name, = and one value");
        return 0;
    end;

    generic [R: Region, S: Region, T: Region]
    function parseWith(s: &![Syntax, R], source: Span[Nat8, S], file: Index, line: Index, argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        var pairs: Buffer[Index] := allocateEmpty();
        while tokensAndGoing(&~s) do
            let name: Index := expectName(&~s);
            expectOp(&~s, "=");
            insertBack(&!pairs, name);
            insertBack(&!pairs, parseExpr(&~s));
            if isOp(&~s, ",") then
                advance(&~s);
            else if tokensLeft(&~s) then
                tagForm(&~s, file, line, "with", "names, each with = and a value, separated by commas");
            end if;
        end while;
        let content: Ending := parseNodes(&~s, source, file, stopEndWith);
        if (content.keyword = 0) and (not hasFailed(&~s)) then
            withoutEnd(&~s, file, line, fromLiteral("with"), "endwith");
        end if;
        var node: SyntaxNode := blankNode(nodeWith, file, line);
        node.count1 := length(&pairs) / 2;
        node.list1 := addList(&~s, &pairs);
        destroyFree(pairs);
        node.list2 := content.list;
        node.count2 := content.count;
        return addNode(&~s, node);
    end;

    -- The key a {% trans %} block's text names: one name, white space
    -- around it allowed.  0 and a failure when it is none.
    generic [R: Region]
    function transKey(s: &![Syntax, R], file: Index, line: Index, list: Index, count: Index): Index is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < count do
            let held7: Index := listItem(&~s, list + i);
            let node: SyntaxNode := nodeOf(&~s, held7);
            if node.kind = nodeText then
                let text: String := nameCopy(&~s, node.a);
                writeString(&!out, asSpan(&text));
                destroyString(text);
            else
                writeByte(&!out, 1);
            end if;
            i := i + 1;
        end while;
        let whole: String := finalize(out);
        var a: Index := 0;
        var b: Index := spanLength(asSpan(&whole));
        while (a < b) and isSpace(byteAt(&whole, a)) do
            a := a + 1;
        end while;
        while (b > a) and isSpace(byteAt(&whole, b - 1)) do
            b := b - 1;
        end while;
        var isKey: Bool := (b > a) and isNameStart(byteAt(&whole, a)) and (byteAt(&whole, a) /= '_');
        var k: Index := a;
        while k < b do
            if not isNameChar(byteAt(&whole, k)) then
                isKey := false;
            end if;
            k := k + 1;
        end while;
        if not isKey then
            destroyString(whole);
            fail(&~s, "H7118", file, line,
                "the text of a {% trans %} block is its key, one name such as Greeting; the texts of the languages stand in the catalog");
            return 0;
        end if;
        let key: Index := addName(&~s, fromSpan(spanPart(asSpan(&whole), a, b - a)));
        destroyString(whole);
        return key;
    end;

    generic [Q: Region]
    function byteAt(text: &[String, Q], at: Index): Nat8 is
        let bytes: Span[Nat8, Q] := asSpan(text);
        return bytes[at];
    end;

    -- {% trans a = value %}Key{% pluralize %}{% endtrans %}: the same as
    -- _("Key", a=value) in {{ }}.
    generic [R: Region, S: Region, T: Region]
    function parseTrans(s: &![Syntax, R], source: Span[Nat8, S], file: Index, line: Index, argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        var pairs: Buffer[Index] := allocateEmpty();
        var hasCount: Bool := false;
        while tokensAndGoing(&~s) do
            let name: Index := expectName(&~s);
            expectOp(&~s, "=");
            if pairNamed(&~s, &pairs, name) then
                let given: String := nameCopy(&~s, name);
                failText(&~s, "H7126", file, line, joined("{% trans %} is given ", asSpan(&given), " twice"));
                destroyString(given);
            end if;
            if nameIs(&~s, name, "count") then
                hasCount := true;
            end if;
            insertBack(&!pairs, name);
            insertBack(&!pairs, parseExpr(&~s));
            if isOp(&~s, ",") then
                advance(&~s);
            else if tokensLeft(&~s) then
                tagForm(&~s, file, line, "trans", "names, each with = and a value, separated by commas");
            end if;
        end while;
        let content: Ending := parseNodes(&~s, source, file, stopTrans);
        let key: Index := transKey(&~s, file, line, content.list, content.count);
        if content.keyword = 0 then
            if not hasFailed(&~s) then
                withoutEnd(&~s, file, line, fromLiteral("trans"), "endtrans");
            end if;
        else if nameIs(&~s, content.keyword, "pluralize") then
            if not hasCount then
                fail(&~s, "H7119", file, content.line, "{% pluralize %} needs count=... in its {% trans %}: the count chooses the form");
            end if;
            let rest: Ending := parseNodes(&~s, source, file, stopEndTrans);
            if rest.keyword = 0 then
                if not hasFailed(&~s) then
                    withoutEnd(&~s, file, line, fromLiteral("trans"), "endtrans");
                end if;
            end if;
            var i: Index := 0;
            while i < rest.count do
                let held8: Index := listItem(&~s, rest.list + i);
                let node: SyntaxNode := nodeOf(&~s, held8);
                if (node.kind /= nodeText) or (not blankText(&~s, node.a)) then
                    fail(&~s, "H7120", file, content.line,
                        "between {% pluralize %} and {% endtrans %} nothing may stand: the plural forms are in the catalog");
                end if;
                i := i + 1;
            end while;
        end if;
        var e: SyntaxExpr := blankExpr(syntaxTrans, file, line);
        e.b := key;
        e.count := length(&pairs) / 2;
        e.list := addList(&~s, &pairs);
        destroyFree(pairs);
        var node: SyntaxNode := blankNode(nodeOut, file, line);
        node.a := addExpr(&~s, e);
        return addNode(&~s, node);
    end;

    -- Whether the text named is white space only.
    generic [R: Region]
    function blankText(s: &![Syntax, R], at: Index): Bool is
        let text: String := nameCopy(&~s, at);
        var blank: Bool := true;
        var i: Index := 0;
        while i < spanLength(asSpan(&text)) do
            if not isSpace(byteAt(&text, i)) then
                blank := false;
            end if;
            i := i + 1;
        end while;
        destroyString(text);
        return blank;
    end;

    generic [R: Region, S: Region, T: Region]
    function parseFilterBlock(s: &![Syntax, R], source: Span[Nat8, S], file: Index, line: Index,
        argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        var specs: Buffer[Index] := allocateEmpty();
        var going: Bool := true;
        while going and (not hasFailed(&~s)) do
            let name: Index := expectName(&~s);
            var args: Buffer[Index] := allocateEmpty();
            if isOp(&~s, "(") then
                parseArguments(&~s, &!args);
            end if;
            var spec: SyntaxNode := blankNode(nodeFilterSpec, file, line);
            spec.a := name;
            spec.count1 := length(&args);
            spec.list1 := addList(&~s, &args);
            destroyFree(args);
            insertBack(&!specs, addNode(&~s, spec));
            if isOp(&~s, "|") then
                advance(&~s);
            else
                going := false;
            end if;
        end while;
        if tokensLeft(&~s) then
            tagForm(&~s, file, line, "filter", "filters separated by |, and nothing else");
        end if;
        let content: Ending := parseNodes(&~s, source, file, stopEndFilter);
        if (content.keyword = 0) and (not hasFailed(&~s)) then
            withoutEnd(&~s, file, line, fromLiteral("filter"), "endfilter");
        end if;
        var node: SyntaxNode := blankNode(nodeFilterBlock, file, line);
        node.count1 := length(&specs);
        node.list1 := addList(&~s, &specs);
        destroyFree(specs);
        node.list2 := content.list;
        node.count2 := content.count;
        return addNode(&~s, node);
    end;

    generic [R: Region, S: Region, T: Region]
    function parseCallBlock(s: &![Syntax, R], source: Span[Nat8, S], file: Index, line: Index,
        argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        if isOp(&~s, "(") then
            tagForm(&~s, file, line, "call",
                "one macro call, and caller() takes no parameters: {% call(x) m() %} is not supported");
            return 0;
        end if;
        let e: Index := parseExpr(&~s);
        if tokensLeft(&~s) then
            tagForm(&~s, file, line, "call", "one macro call");
        end if;
        let content: Ending := parseNodes(&~s, source, file, stopEndCall);
        if (content.keyword = 0) and (not hasFailed(&~s)) then
            withoutEnd(&~s, file, line, fromLiteral("call"), "endcall");
        end if;
        let called: SyntaxExpr := exprOf(&~s, e);
        if (e = 0) or (called.op /= syntaxCall) then
            tagForm(&~s, file, line, "call", "one macro call");
            return 0;
        end if;
        var node: SyntaxNode := blankNode(nodeCallBlock, file, line);
        node.a := called.b;
        node.list1 := called.list;
        node.count1 := called.count;
        node.list2 := content.list;
        node.count2 := content.count;
        return addNode(&~s, node);
    end;

    generic [R: Region, T: Region]
    function parseImport(s: &![Syntax, R], file: Index, line: Index, argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        let count: Index := tokensCount(&~s);
        let target: Token := tokenAhead(&~s, 0);
        let hasAs: Bool := isTokenAhead(&~s, 1, tokenName, "as");
        let name: Token := tokenAhead(&~s, 2);
        let shaped: Bool := (target.kind = tokenString) and hasAs and (name.kind = tokenName);
        if shaped and (count = 3) then
            var node: SyntaxNode := blankNode(nodeImportAs, file, line);
            node.a := target.text;
            node.b := name.text;
            return addNode(&~s, node);
        end if;
        let held9: Bool := isTokenAhead(&~s, 3, tokenName, "with");
        let held10: Bool := isTokenAhead(&~s, 3, tokenName, "without");
        let context: Bool := (held9 or held10)
            and isTokenAhead(&~s, 4, tokenName, "context");
        if shaped and (count = 5) and context then
            fail(&~s, "H7032", file, line,
                "{% import %} takes no `with context': an imported macro does not see the template's data, as in Jinja2 without it");
            return 0;
        end if;
        fail(&~s, "H7032", file, line,
            "{% import %} takes a string literal, `as' and a name: {% import \"file\" as name %}");
        return 0;
    end;

    generic [R: Region, S: Region, T: Region]
    function parseBlock(s: &![Syntax, R], source: Span[Nat8, S], file: Index, line: Index, argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        let count: Index := tokensCount(&~s);
        let first: Token := tokenAhead(&~s, 0);
        var scoped: Bool := false;
        if first.kind /= tokenName then
            fail(&~s, "H7043", file, line, "{% block %} takes a name, and `scoped' after it");
            return 0;
        end if;
        let requiredSecond: Bool := isTokenAhead(&~s, 1, tokenName, "required");
        let scopedSecond: Bool := isTokenAhead(&~s, 1, tokenName, "scoped");
        let requiredLast: Bool := isTokenAhead(&~s, 2, tokenName, "required");
        let requiredThird: Bool := scopedSecond and requiredLast;
        if requiredSecond or requiredThird then
            fail(&~s, "H7042", file, line, "a `required' block is not supported");
            return 0;
        end if;
        if (count = 2) and isTokenAhead(&~s, 1, tokenName, "scoped") then
            scoped := true;
        else if count /= 1 then
            fail(&~s, "H7043", file, line, "{% block %} takes a name, and `scoped' after it");
            return 0;
        end if;
        let content: Ending := parseNodes(&~s, source, file, stopEndBlock);
        if content.keyword = 0 then
            if not hasFailed(&~s) then
                let held11: String := tagText(&~s, "{% block ", first.text, " %} without {% endblock %}");
                failText(&~s, "H7044", file, line, held11);
            end if;
        else
            let closing: String := nameCopy(&~s, content.argument);
            if (spanLength(asSpan(&closing)) > 0) and (not nameIs(&~s, first.text, asSpan(&closing))) then
                let name: String := nameCopy(&~s, first.text);
                var out: StringBuilder := makeStringBuilder();
                writeString(&!out, "{% endblock ");
                writeString(&!out, asSpan(&closing));
                writeString(&!out, " %} closes {% block ");
                writeString(&!out, asSpan(&name));
                writeString(&!out, " %}");
                destroyString(name);
                failText(&~s, "H7045", file, content.line, finalize(out));
            end if;
            destroyString(closing);
        end if;
        var node: SyntaxNode := blankNode(nodeBlock, file, line);
        node.a := first.text;
        node.flag := scoped;
        node.list1 := content.list;
        node.count1 := content.count;
        return addNode(&~s, node);
    end;

    generic [R: Region, S: Region, T: Region]
    function parseMacro(s: &![Syntax, R], source: Span[Nat8, S], file: Index, line: Index, argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        let name: Index := expectName(&~s);
        expectOp(&~s, "(");
        var params: Buffer[Index] := allocateEmpty();
        while openAndGoing(&~s) do
            let param: Index := expectName(&~s);
            var default: Index := 0;
            if isOp(&~s, "=") then
                advance(&~s);
                default := parsePrimary(&~s);
                let given: SyntaxExpr := exprOf(&~s, default);
                let literal: Bool := (given.op = syntaxString) or (given.op = syntaxInteger) or (given.op = syntaxBool);
                if (default = 0) or (not literal) then
                    fail(&~s, "H7046", file, line, "a macro parameter's default is a literal");
                end if;
            end if;
            var p: SyntaxNode := blankNode(nodeParam, file, line);
            p.a := param;
            p.b := default;
            insertBack(&!params, addNode(&~s, p));
            if isOp(&~s, ",") then
                advance(&~s);
            else if not isOp(&~s, ")") then
                fail(&~s, "H7047", file, line, "expected , or ) in the macro's parameters");
            end if;
        end while;
        advance(&~s);
        if tokensLeft(&~s) then
            fail(&~s, "H7048", file, line, "unexpected text after the macro's parameters");
        end if;
        let content: Ending := parseNodes(&~s, source, file, stopEndMacro);
        if (content.keyword = 0) and (not hasFailed(&~s)) then
            let held12: String := tagText(&~s, "{% macro ", name, " %} without {% endmacro %}");
            failText(&~s, "H7049", file, line, held12);
        end if;
        var node: SyntaxNode := blankNode(nodeMacro, file, line);
        node.a := name;
        node.count1 := length(&params);
        node.list1 := addList(&~s, &params);
        destroyFree(params);
        node.list2 := content.list;
        node.count2 := content.count;
        return addNode(&~s, node);
    end;

    generic [R: Region, T: Region]
    function parseFrom(s: &![Syntax, R], file: Index, line: Index, argument: Span[Nat8, T]): Index is
        tokenize(&~s, argument);
        let count: Index := tokensCount(&~s);
        let target: Token := tokenAhead(&~s, 0);
        if (target.kind /= tokenString) or (not isTokenAhead(&~s, 1, tokenName, "import")) then
            fail(&~s, "H7052", file, line, "{% from %} takes a string literal and `import'");
            return 0;
        end if;
        var names: Buffer[Index] := allocateEmpty();
        var at: Index := 2;
        var good: Bool := count > 2;
        var going: Bool := good;
        while going do
            let t: Token := tokenAhead(&~s, at);
            if t.kind /= tokenName then
                good := false;
                going := false;
            else if isTokenAhead(&~s, at + 1, tokenName, "as") then
                destroyFree(names);
                fail(&~s, "H7050", file, line, "`as' in {% from ... import %} is not supported");
                return 0;
            else
                insertBack(&!names, t.text);
                if (at + 1) = count then
                    going := false;
                else if isTokenAhead(&~s, at + 1, tokenOperator, ",") and ((at + 2) < count) then
                    at := at + 2;
                else
                    good := false;
                    going := false;
                end if;
            end if;
        end while;
        if not good then
            destroyFree(names);
            fail(&~s, "H7051", file, line,
                "{% from \"file\" import a, b %} names the macros to import, and nothing else");
            return 0;
        end if;
        var node: SyntaxNode := blankNode(nodeFromImport, file, line);
        node.a := target.text;
        node.count1 := length(&names);
        node.list1 := addList(&~s, &names);
        destroyFree(names);
        return addNode(&~s, node);
    end;

    ---
    --- Files
    ---

    -- The file number of name, a file not read yet: fileCountOf when there
    -- is none.
    generic [R: Region, N: Region]
    function loadedFile(s: &![Syntax, R], name: Span[Nat8, N]): Index is
        let total: Index := fileNamesCount(&~s);
        var i: Index := 0;
        while i < total do
            if fileNamesEquals(&~s, i, name) then
                return i;
            end if;
            i := i + 1;
        end while;
        return total;
    end;

    generic [R: Region]
    function directoryCount(s: &![Syntax, R]): Index is
        return directoriesCount(&~s);
    end;

    -- directory, a slash and name.
    generic [R: Region, N: Region]
    function joinedPath(s: &![Syntax, R], directory: Index, name: Span[Nat8, N]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, asSpan(nthRef(&(s->directories), directory)));
        writeByte(&!out, '/');
        writeString(&!out, name);
        return finalize(out);
    end;

    generic [R: Region]
    function addFile(s: &![Syntax, R], name: String, path: String): Index is
        let at: Index := fileNamesCount(&~s);
        fileNamesPush(&~s, name);
        pathsPush(&~s, path);
        fileTreesPush(&~s, 0);
        fileTreeCountsPush(&~s, 0);
        return at;
    end;

    generic [R: Region]
    function setTree(s: &![Syntax, R], file: Index, list: Index, count: Index): Unit is
        fileTreesStore(&~s, file, list);
        fileTreeCountsStore(&~s, file, count);
        return nil;
    end;

    generic [R: Region]
    function treeOf(s: &![Syntax, R], file: Index): Index is
        return fileTreesItem(&~s, file);
    end;

    generic [R: Region]
    function treeCountOf(s: &![Syntax, R], file: Index): Index is
        return fileTreeCountsItem(&~s, file);
    end;

    -- "name": rest, as a message.
    generic [N: Region]
    function quoted(name: Span[Nat8, N], rest: Span[Nat8, Static]): String is
        return joinedFour("\"", name, "\"", rest);
    end;

    generic [R: Region]
    function clearChunks(s: &![Syntax, R]): Unit is
        while chunksCount(&~s) > 0 do
            let dropped: Chunk := chunksPop(&~s);
        end while;
        let zero: Index := 0;
        s->chunkAt := zero;
        return nil;
    end;

    -- The text of a file, at most mostTemplateBytes; None when it cannot
    -- be read or is too large, with a failure.
    -- The text of the template at path.  found is what statusOf saw there
    -- before, a regular file and no link: the file opened must be that one
    -- (the same device and inode) and still have one name, so that a file
    -- put in its place, a link among them, or a hard link made meanwhile is
    -- refused; exactly its size is read, at most
    -- mostTemplateBytes, however the file grows meanwhile.  None with the
    -- failure when it cannot be read so.
    generic [R: Region, P: Region, N: Region]
    function readTemplate(s: &![Syntax, R], path: Span[Nat8, P], name: Span[Nat8, N], file: Index, line: Index,
        found: FileStatus): Option[String] is
        case openRead(path) of
            when Some(value as descriptor: FileDescriptor) do
                var open: FileDescriptor := descriptor;
                var changed: Bool := true;
                var large: Bool := false;
                var count: Index := 0;
                case statusOfOpen(&open) of
                    when Some(value as now: FileStatus) do
                        changed := (now.device /= found.device) or (now.inode /= found.inode)
                            or (not sameKind(now.kind, kindRegular)) or (now.links > 1);
                        large := now.size > 1048576;
                        case toIndex(now.size) of
                            when Some(value as size: Index) do
                                count := size;
                            when None do
                                large := true;
                        end case;
                    when None do
                        skip;
                end case;
                if changed or large then
                    let shut: Bool := closeFile(open);
                    if changed then
                        failText(&~s, "V0004", file, line, quoted(name, ": the file changed while it was opened"));
                    else
                        failText(&~s, "V0005", file, line, quoted(name, " is larger than 1 MiB, the most a template may be"));
                    end if;
                    return None();
                end if;
                let read: Option[String] := readExactly(&!open, count);
                let closed: Bool := closeFile(open);
                case read of
                    when Some(value as text: String) do
                        return Some(value => text);
                    when None do
                        failText(&~s, "H7004", file, line, quoted(name, ": cannot read it"));
                        return None();
                end case;
            when None do
                failText(&~s, "H7004", file, line, quoted(name, ": cannot read it"));
                return None();
        end case;
    end;

    -- Whether the first count bytes of name, below the directory d, are a
    -- symbolic link, asked with kindOf.
    generic [R: Region, N: Region]
    function prefixIsLink(s: &![Syntax, R], d: Index, name: Span[Nat8, N], count: Index): Bool is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, asSpan(nthRef(&(s->directories), d)));
        writeByte(&!out, '/');
        var i: Index := 0;
        while i < count do
            writeByte(&!out, name[i]);
            i := i + 1;
        end while;
        let path: String := finalize(out);
        let link: Bool := sameKind(kindOf(asSpan(&path)), kindSymlink);
        destroyString(path);
        return link;
    end;

    -- Whether a part of name below the directory d is a symbolic link: every
    -- prefix of name that ends at a slash, and the whole name.  The directory
    -- itself is the application's to choose and is not asked.  The answer
    -- can be out of date by the time the file is opened.
    generic [R: Region, N: Region]
    function linkBelow(s: &![Syntax, R], d: Index, name: Span[Nat8, N]): Bool is
        let count: Index := spanLength(name);
        var i: Index := 0;
        while i < count do
            if name[i] = '/' then
                if prefixIsLink(&~s, d, name, i) then
                    return true;
                end if;
            end if;
            i := i + 1;
        end while;
        return prefixIsLink(&~s, d, name, count);
    end;

    -- The file number of the template name, read and parsed when it is not
    -- yet; mostFiles when it fails.  file and line are where it is asked
    -- for.
    generic [R: Region, N: Region]
    function load(s: &![Syntax, R], file: Index, line: Index, name: Span[Nat8, N]): Index is
        let known: Index := loadedFile(&~s, name);
        if known < fileNamesCount(&~s) then
            return known;
        end if;
        if spanLength(name) = 0 then
            fail(&~s, "H7001", file, line, "the template name is empty");
            return mostFiles();
        end if;
        if name[0] = '/' then
            failText(&~s, "H7002", file, line,
                quoted(name, ": the path is absolute, and a template may only be read from its directories"));
            return mostFiles();
        end if;
        if leavesDirectory(name) then
            failText(&~s, "H7003", file, line,
                quoted(name, ": the path leaves the directory of the templates, which is not allowed"));
            return mostFiles();
        end if;
        if not isTemplateName(name) then
            failText(&~s, "V0002", file, line, quoted(name,
                ": a template name holds a to z, A to Z, 0 to 9, dot, hyphen, underscore and slash, and no segment that is empty or begins with a dot"));
            return mostFiles();
        end if;
        if fileNamesCount(&~s) >= mostFiles() then
            fail(&~s, "V0003", file, line, "a template is made of more than 64 files");
            return mostFiles();
        end if;
        var d: Index := 0;
        while d < directoryCount(&~s) do
            let path: String := joinedPath(&~s, d, name);
            case statusOf(asSpan(&path)) of
                when FileFound(status as found: FileStatus) do
                    if linkBelow(&~s, d, name) then
                        destroyString(path);
                        failText(&~s, "V0004", file, line, quoted(name, ": a part of its path is a symbolic link"));
                        return mostFiles();
                    end if;
                    if not sameKind(found.kind, kindRegular) then
                        destroyString(path);
                        failText(&~s, "V0012", file, line, quoted(name, " is no regular file"));
                        return mostFiles();
                    end if;
                    if found.links > 1 then
                        destroyString(path);
                        failText(&~s, "V0004", file, line, quoted(name, " has more than one hard link, a second name could write it"));
                        return mostFiles();
                    end if;
                    if found.size > 1048576 then
                        destroyString(path);
                        failText(&~s, "V0005", file, line, quoted(name, " is larger than 1 MiB, the most a template may be"));
                        return mostFiles();
                    end if;
                    case readTemplate(&~s, asSpan(&path), name, file, line, found) of
                        when Some(value as text: String) do
                            let made: Index := addFile(&~s, fromSpan(name), path);
                            parseFile(&~s, asSpan(&text), made);
                            destroyString(text);
                            return made;
                        when None do
                            destroyString(path);
                            return mostFiles();
                    end case;
                when FileMissing do
                    destroyString(path);
                when FileUnreadable do
                    destroyString(path);
            end case;
            d := d + 1;
        end while;
        failText(&~s, "H7004", file, line, quoted(name, ": cannot read it: no directory of the templates holds it"));
        return mostFiles();
    end;

    -- Whether a segment of name is ..
    generic [N: Region]
    function leavesDirectory(name: Span[Nat8, N]): Bool is
        let n: Index := spanLength(name);
        var start: Index := 0;
        var i: Index := 0;
        while i <= n do
            if (i = n) or (name[i] = '/') then
                if ((i - start) = 2) and (name[start] = '.') and (name[start + 1] = '.') then
                    return true;
                end if;
                start := i + 1;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    -- The text of a file split and parsed, its tree kept for its number.
    generic [R: Region, S: Region]
    function parseFile(s: &![Syntax, R], source: Span[Nat8, S], file: Index): Unit is
        clearChunks(&~s);
        let fault: LexFault := lexInto(&~s, source);
        if fault.code /= 0 then
            if fault.code = 5 then
                var closer: Span[Nat8, Static] := "}}";
                if fault.closer = '%' then
                    closer := "%}";
                end if;
                failText(&~s, "H7005", file, fault.line, joined("this tag is never closed with ", closer, ""));
            else if fault.code = 6 then
                fail(&~s, "H7006", file, fault.line, "this comment is never closed with #}");
            else if fault.code = 7 then
                fail(&~s, "H7007", file, fault.line, "this {% raw %} is never closed with {% endraw %}");
            else
                fail(&~s, "H7008", file, fault.line, "{% endraw %} is not closed with %}");
            end if;
            return nil;
        end if;
        let zero: Index := 0;
        s->nesting := zero;
        let ending: Ending := parseNodes(&~s, source, file, stopNone);
        setTree(&~s, file, ending.list, ending.count);
        return nil;
    end;

    generic [R: Region, S: Region]
    function lexInto(s: &![Syntax, R], source: Span[Nat8, S]): LexFault is
        let trim: Bool := s->trimBlocks;
        let lstrip: Bool := s->lstripBlocks;
        return lex(source, trim, lstrip, &!(s->chunks));
    end;

    ---
    --- 2c. Inheritance, include and macros, resolved before anything is
    --- generated: one tree with no extends, block, include or macro
    --- definition left in it.
    ---

    generic [R: Region]
    function stackHolds(s: &![Syntax, R], stack: &[Buffer[Index], R], name: Index): Bool is
        var i: Index := 0;
        while i < length(stack) do
            if sameNames(&~s, nth(stack, i), name) then
                return true;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    generic [R: Region]
    function macroCount(s: &![Syntax, R]): Index is
        return macrosCount(&~s);
    end;

    generic [R: Region]
    function macroOf(s: &![Syntax, R], at: Index): Macro is
        return macrosItem(&~s, at);
    end;

    generic [R: Region]
    function storeMacro(s: &![Syntax, R], at: Index, macro: Macro): Unit is
        macrosStore(&~s, at, macro);
        return nil;
    end;

    generic [R: Region]
    function pushMacro(s: &![Syntax, R], macro: Macro): Unit is
        macrosPush(&~s, macro);
        return nil;
    end;

    -- The macro whose key is the name numbered key: macroCount when none.
    generic [R: Region, K: Region]
    function macroKeyed(s: &![Syntax, R], key: Span[Nat8, K]): Index is
        let total: Index := macroCount(&~s);
        var i: Index := 0;
        while i < total do
            let m: Macro := macroOf(&~s, i);
            if nameIs(&~s, m.key, key) then
                return i;
            end if;
            i := i + 1;
        end while;
        return total;
    end;

    -- Whether a macro's key begins with space and a dot.
    generic [R: Region, P: Region]
    function spaceTaken(s: &![Syntax, R], space: Span[Nat8, P]): Bool is
        let total: Index := macroCount(&~s);
        var i: Index := 0;
        while i < total do
            let m: Macro := macroOf(&~s, i);
            let key: String := nameCopy(&~s, m.key);
            let n: Index := spanLength(space);
            let keyBytes: Index := spanLength(asSpan(&key));
            var hit: Bool := false;
            if keyBytes > n then
                hit := equal(spanPart(asSpan(&key), 0, n), space) and (byteAt(&key, n) = '.');
            end if;
            destroyString(key);
            if hit then
                return true;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    generic [R: Region]
    function spaceKnown(s: &![Syntax, R], space: Index, file: Index): Bool is
        let total: Index := spaceNamesCount(&~s);
        var i: Index := 0;
        while i < total do
            let named: Index := spaceNamesItem(&~s, i);
            let filed: Index := spaceFilesItem(&~s, i);
            let sameSpace: Bool := sameNames(&~s, named, space);
            let sameFile: Bool := sameNames(&~s, filed, file);
            if sameSpace and sameFile then
                return true;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    generic [R: Region]
    function addSpace(s: &![Syntax, R], space: Index, file: Index): Unit is
        spaceNamesPush(&~s, space);
        spaceFilesPush(&~s, file);
        return nil;
    end;

    -- The key of a macro: its name, or space.name.
    generic [R: Region]
    function macroKey(s: &![Syntax, R], space: Index, name: Index): Index is
        if space = 0 then
            return name;
        end if;
        let a: String := nameCopy(&~s, space);
        let b: String := nameCopy(&~s, name);
        let key: Index := addName(&~s, joined(asSpan(&a), ".", asSpan(&b)));
        destroyString(a);
        destroyString(b);
        return key;
    end;

    -- "file" imports from itself.
    generic [R: Region]
    function importsItself(s: &![Syntax, R], node: SyntaxNode): Unit is
        let name: String := nameCopy(&~s, node.a);
        failText(&~s, "H7055", node.file, node.line, quoted(asSpan(&name), " imports from itself"));
        destroyString(name);
        return nil;
    end;

    -- Macro definitions at the top level of a template, and the ones a
    -- from ... import names, go into the table.  A name defined twice with
    -- two bodies is refused.
    generic [R: Region, B: Region]
    function collectMacros(s: &![Syntax, R], stack: &![Buffer[Index], B], imported: Bool, space: Index, list: Index,
        count: Index): Unit is
        var i: Index := 0;
        while (i < count) and (not hasFailed(&~s)) do
            let at: Index := listItem(&~s, list + i);
            let node: SyntaxNode := nodeOf(&~s, at);
            if node.kind = nodeMacro then
                let key: Index := macroKey(&~s, space, node.a);
                let keyText: String := nameCopy(&~s, key);
                let found: Index := macroKeyed(&~s, asSpan(&keyText));
                if found < macroCount(&~s) then
                    let m: Macro := macroOf(&~s, found);
                    if m.node /= at then
                        failText(&~s, "H7054", node.file, node.line, joined("the macro ", asSpan(&keyText), " is defined twice"));
                    end if;
                else
                    pushMacro(&~s, Macro(key => key, params => node.list1, paramCount => node.count1, content => node.list2,
                        bodyCount => node.count2, node => at, imported => imported, space => space));
                end if;
                destroyString(keyText);
            else if node.kind = nodeFromImport then
                if stackHoldsMut(&~s, &~stack, node.a) then
                    importsItself(&~s, node);
                else
                    let target: String := nameCopy(&~s, node.a);
                    let loaded: Index := load(&~s, node.file, node.line, asSpan(&target));
                    destroyString(target);
                    if loaded < mostFiles() then
                        insertBack(&~stack, node.a);
                        let held13: Index := treeOf(&~s, loaded);
                        let held14: Index := treeCountOf(&~s, loaded);
                        collectMacros(&~s, &~stack, true, 0, held13, held14);
                        let popped: Index := removeLast(&~stack);
                        var k: Index := 0;
                        while (k < node.count1) and (not hasFailed(&~s)) do
                            let wanted: Index := listItem(&~s, node.list1 + k);
                            let wantedText: String := nameCopy(&~s, wanted);
                            let known: Index := macroKeyed(&~s, asSpan(&wantedText));
                            if known >= macroCount(&~s) then
                                let fileText: String := nameCopy(&~s, node.a);
                                failText(&~s, "H7056", node.file, node.line,
                                    joinedFour("\"", asSpan(&fileText), "\" has no macro ", asSpan(&wantedText)));
                                destroyString(fileText);
                            end if;
                            destroyString(wantedText);
                            k := k + 1;
                        end while;
                    end if;
                end if;
            else if node.kind = nodeImportAs then
                if stackHoldsMut(&~s, &~stack, node.a) then
                    importsItself(&~s, node);
                else
                    let spaceText: String := nameCopy(&~s, node.b);
                    let taken: Bool := spaceTaken(&~s, asSpan(&spaceText));
                    if taken and (not spaceKnown(&~s, node.b, node.a)) then
                        failText(&~s, "H7102", node.file, node.line,
                            joined("the name ", asSpan(&spaceText), " is given to two imports"));
                    end if;
                    destroyString(spaceText);
                    addSpace(&~s, node.b, node.a);
                    let target: String := nameCopy(&~s, node.a);
                    let loaded: Index := load(&~s, node.file, node.line, asSpan(&target));
                    destroyString(target);
                    if loaded < mostFiles() then
                        insertBack(&~stack, node.a);
                        let held15: Index := treeOf(&~s, loaded);
                        let held16: Index := treeCountOf(&~s, loaded);
                        collectMacros(&~s, &~stack, true, node.b, held15, held16);
                        let popped: Index := removeLast(&~stack);
                    end if;
                end if;
            end if;
            i := i + 1;
        end while;
        return nil;
    end;

    generic [R: Region, B: Region]
    function stackHoldsMut(s: &![Syntax, R], stack: &![Buffer[Index], B], name: Index): Bool is
        var i: Index := 0;
        while i < lengthMut(&~stack) do
            if sameNames(&~s, nthMut(&~stack, i), name) then
                return true;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    -- Every block in the list, nested ones too, into names and nodes.
    generic [R: Region, B: Region]
    function collectBlocks(s: &![Syntax, R], list: Index, count: Index, found: &![Buffer[Index], B]): Unit is
        var i: Index := 0;
        while i < count do
            let at: Index := listItem(&~s, list + i);
            let node: SyntaxNode := nodeOf(&~s, at);
            if node.kind = nodeBlock then
                insertBack(&~found, at);
                collectBlocks(&~s, node.list1, node.count1, &~found);
            else if node.kind = nodeIf then
                var k: Index := 0;
                while k < node.count1 do
                    let held17: Index := listItem(&~s, node.list1 + k);
                    let branch: SyntaxNode := nodeOf(&~s, held17);
                    collectBlocks(&~s, branch.list1, branch.count1, &~found);
                    k := k + 1;
                end while;
                collectBlocks(&~s, node.list2, node.count2, &~found);
            else if node.kind = nodeFor then
                collectBlocks(&~s, node.list2, node.count2, &~found);
                collectBlocks(&~s, node.list3, node.count3, &~found);
            else if node.kind = nodeSetBlock then
                collectBlocks(&~s, node.list1, node.count1, &~found);
            else if (node.kind = nodeWith) or (node.kind = nodeFilterBlock) or (node.kind = nodeCallBlock) then
                collectBlocks(&~s, node.list2, node.count2, &~found);
            end if;
            i := i + 1;
        end while;
        return nil;
    end;

    generic [R: Region]
    function overrideCount(s: &![Syntax, R]): Index is
        return overridesCount(&~s);
    end;

    generic [R: Region]
    function overrideOf(s: &![Syntax, R], at: Index): Override is
        return overridesItem(&~s, at);
    end;

    generic [R: Region]
    function pushOverride(s: &![Syntax, R], o: Override): Unit is
        overridesPush(&~s, o);
        return nil;
    end;

    -- The definitions of the block named name in the overrides from start,
    -- count of them: its entry, overrideCount when none.
    generic [R: Region]
    function overrideNamed(s: &![Syntax, R], start: Index, count: Index, name: Index): Index is
        var i: Index := 0;
        while i < count do
            let o: Override := overrideOf(&~s, start + i);
            if sameNames(&~s, o.name, name) then
                return start + i;
            end if;
            i := i + 1;
        end while;
        return overrideCount(&~s);
    end;

    -- The text after extends checked: what Jinja2 drops is refused.
    generic [R: Region]
    function checkAfterExtends(s: &![Syntax, R], list: Index, count: Index, extendsLine: Index, extendsFile: Index): Unit is
        var i: Index := 0;
        while (i < count) and (not hasFailed(&~s)) do
            let held18: Index := listItem(&~s, list + i);
            let node: SyntaxNode := nodeOf(&~s, held18);
            let k: Nat8 := node.kind;
            if k = nodeExtends then
                fail(&~s, "H7058", node.file, node.line, "a template extends one other template, once");
            else if k = nodeText then
                if not blankText(&~s, node.a) then
                    fail(&~s, "H7059", node.file, node.line,
                        "text after {% extends %} and outside a block is dropped by Jinja2; here it is refused");
                end if;
            else if k = nodeOut then
                fail(&~s, "H7060", node.file, node.line,
                    "a value after {% extends %} and outside a block is dropped by Jinja2; here it is refused");
            else if (k = nodeIf) or (k = nodeFor) then
                fail(&~s, "H7061", extendsFile, extendsLine,
                    "an if or a for after {% extends %} and outside a block is dropped by Jinja2; here it is refused");
            else if (k = nodeSet) or (k = nodeSetBlock) then
                fail(&~s, "H7103", node.file, node.line,
                    "a {% set %} after {% extends %} and outside a block is refused: whether a block sees it depends on the order in which Jinja2 runs the two templates");
            else if (k = nodeWith) or (k = nodeFilterBlock) or (k = nodeCallBlock) then
                fail(&~s, "H7061", node.file, node.line,
                    "a with, a filter or a call after {% extends %} and outside a block is dropped by Jinja2; here it is refused");
            else if k = nodeInclude then
                fail(&~s, "H7062", node.file, node.line,
                    "an include after {% extends %} and outside a block is dropped by Jinja2; here it is refused");
            else if k = nodeCatalog then
                fail(&~s, "H7128", node.file, node.line,
                    "{% catalog %} after {% extends %} stands in the template that is extended or in a block, where the text it serves is");
            end if;
            i := i + 1;
        end while;
        return nil;
    end;

    -- "a" -> "b" -> "c": the stack from its bottom, then name.
    generic [R: Region, B: Region]
    function stackText(s: &![Syntax, R], stack: &![Buffer[Index], B], name: Index): String is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < lengthMut(&~stack) do
            let part: String := nameCopy(&~s, nthMut(&~stack, i));
            writeString(&!out, asSpan(&part));
            destroyString(part);
            writeString(&!out, " -> ");
            i := i + 1;
        end while;
        let last: String := nameCopy(&~s, name);
        writeString(&!out, asSpan(&last));
        destroyString(last);
        return finalize(out);
    end;

    -- A list made of one node.
    generic [R: Region]
    function single(s: &![Syntax, R], node: Index): Index is
        let start: Index := listLength(&~s);
        pushListItem(&~s, node);
        return start;
    end;

    -- Two lists, one after the other, as a new list.
    generic [R: Region]
    function concatLists(s: &![Syntax, R], a: Index, aCount: Index, b: Index, bCount: Index): Index is
        var items: Buffer[Index] := allocateEmpty();
        var i: Index := 0;
        while i < aCount do
            insertBack(&!items, listItem(&~s, a + i));
            i := i + 1;
        end while;
        i := 0;
        while i < bCount do
            insertBack(&!items, listItem(&~s, b + i));
            i := i + 1;
        end while;
        let start: Index := addList(&~s, &items);
        destroyFree(items);
        return start;
    end;

    -- The template name, its inheritance resolved: a list of nodes, its
    -- count in expandedCount.  overrides: the blocks of the templates below,
    -- from start, count of them.  parent: the layout a page is rendered in,
    -- 0 when none; it stands for an {% extends %} at the page's head.
    record Expanded: Free is
        list: Index;
        count: Index;
    end;

    generic [R: Region, B: Region]
    function expandTemplate(s: &![Syntax, R], stack: &![Buffer[Index], B], file: Index, line: Index, name: Index,
        overrideStart: Index, overrideCountIn: Index, parent: Index): Expanded is
        let nothing: Expanded := Expanded(list => 0, count => 0);
        if hasFailed(&~s) then
            return nothing;
        end if;
        if stackHoldsMut(&~s, &~stack, name) then
            let chain: String := stackText(&~s, &~stack, name);
            let named: String := nameCopy(&~s, name);
            failText(&~s, "H7057", file, line, joinedFour("\"", asSpan(&named), "\" includes or extends itself: ", asSpan(&chain)));
            destroyString(named);
            destroyString(chain);
            return nothing;
        end if;
        if lengthMut(&~stack) >= mostDepth() then
            fail(&~s, "V0006", file, line, "templates extend or include one another more than 16 deep");
            return nothing;
        end if;
        let nameText: String := nameCopy(&~s, name);
        let loaded: Index := load(&~s, file, line, asSpan(&nameText));
        destroyString(nameText);
        if loaded >= mostFiles() then
            return nothing;
        end if;
        insertBack(&~stack, name);
        let tree: Index := treeOf(&~s, loaded);
        let treeCount: Index := treeCountOf(&~s, loaded);
        collectMacros(&~s, &~stack, false, 0, tree, treeCount);
        -- The first extends splits the template; a layout given by the
        -- caller stands before the first node.
        var split: Index := treeCount;
        var parentName: Index := 0;
        var extendsLine: Index := line;
        if parent /= 0 then
            split := 0;
            parentName := parent;
        else
            var i: Index := 0;
            while i < treeCount do
                let held19: Index := listItem(&~s, tree + i);
                let node: SyntaxNode := nodeOf(&~s, held19);
                if (split = treeCount) and (node.kind = nodeExtends) then
                    split := i;
                    parentName := node.a;
                    extendsLine := node.line;
                end if;
                i := i + 1;
            end while;
        end if;
        var result: Expanded := nothing;
        if parentName /= 0 then
            var after: Index := split;
            if parent = 0 then
                after := split + 1;
            end if;
            let afterList: Index := tree + after;
            let afterCount: Index := treeCount - after;
            checkAfterExtends(&~s, afterList, afterCount, extendsLine, loaded);
            var defs: Buffer[Index] := allocateEmpty();
            collectBlocks(&~s, afterList, afterCount, &!defs);
            var d: Index := 0;
            while d < length(&defs) do
                let block: Index := nth(&defs, d);
                let blockNode: SyntaxNode := nodeOf(&~s, block);
                definedNamesPush(&~s, blockNode.a);
                definedNodesPush(&~s, block);
                d := d + 1;
            end while;
            let mergedStart: Index := mergeOverrides(&~s, overrideStart, overrideCountIn, &defs);
            let mergedCount: Index := overrideCount(&~s) - mergedStart;
            destroyFree(defs);
            let before: Expanded := expandNodes(&~s, &~stack, overrideStart, overrideCountIn, 0, 0, tree, split);
            let above: Expanded := expandTemplate(&~s, &~stack, loaded, extendsLine, parentName, mergedStart,
                mergedCount, 0);
            result := Expanded(list => concatLists(&~s, before.list, before.count, above.list, above.count),
                count => before.count + above.count);
        else
            result := expandNodes(&~s, &~stack, overrideStart, overrideCountIn, 0, 0, tree, treeCount);
        end if;
        let popped: Index := removeLast(&~stack);
        return result;
    end;

    -- The overrides from below and the blocks of this template, merged
    -- into a new set at the end of the overrides: for each name, the
    -- definitions from below first, then this template's.  The start of
    -- the new set.
    generic [R: Region, B: Region]
    function mergeOverrides(s: &![Syntax, R], start: Index, count: Index, defs: &[Buffer[Index], B]): Index is
        var names: Buffer[Index] := allocateEmpty();
        var i: Index := 0;
        while i < count do
            let o: Override := overrideOf(&~s, start + i);
            if not listedName(&~s, &names, o.name) then
                insertBack(&!names, o.name);
            end if;
            i := i + 1;
        end while;
        i := 0;
        while i < length(defs) do
            let block: SyntaxNode := nodeOf(&~s, nth(defs, i));
            if not listedName(&~s, &names, block.a) then
                insertBack(&!names, block.a);
            end if;
            i := i + 1;
        end while;
        var entries: Buffer[Override] := allocateEmpty();
        var n: Index := 0;
        while n < length(&names) do
            let name: Index := nth(&names, n);
            var items: Buffer[Index] := allocateEmpty();
            let deeper: Index := overrideNamed(&~s, start, count, name);
            if deeper < overrideCount(&~s) then
                let o: Override := overrideOf(&~s, deeper);
                var k: Index := 0;
                while k < o.count do
                    insertBack(&!items, listItem(&~s, o.defs + k));
                    k := k + 1;
                end while;
            end if;
            var k: Index := 0;
            while k < length(defs) do
                let block: SyntaxNode := nodeOf(&~s, nth(defs, k));
                if sameNames(&~s, block.a, name) then
                    insertBack(&!items, nth(defs, k));
                end if;
                k := k + 1;
            end while;
            let listStart: Index := addList(&~s, &items);
            insertBack(&!entries, Override(name => name, defs => listStart, count => length(&items)));
            destroyFree(items);
            n := n + 1;
        end while;
        let merged: Index := overrideCount(&~s);
        var e: Index := 0;
        while e < length(&entries) do
            pushOverride(&~s, nth(&entries, e));
            e := e + 1;
        end while;
        destroyFree(entries);
        destroyFree(names);
        return merged;
    end;

    generic [R: Region, B: Region]
    function listedName(s: &![Syntax, R], names: &[Buffer[Index], B], name: Index): Bool is
        var i: Index := 0;
        while i < length(names) do
            if sameNames(&~s, nth(names, i), name) then
                return true;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    -- The nodes of a list resolved.  supers: the chain of block
    -- definitions above the block being expanded, what super() stands for.
    generic [R: Region, B: Region]
    function expandNodes(s: &![Syntax, R], stack: &![Buffer[Index], B], overrideStart: Index, overrideCountIn: Index,
        supers: Index, superCount: Index, list: Index, count: Index): Expanded is
        var items: Buffer[Index] := allocateEmpty();
        var i: Index := 0;
        while (i < count) and (not hasFailed(&~s)) do
            let at: Index := listItem(&~s, list + i);
            let made: Expanded := expandNode(&~s, &~stack, overrideStart, overrideCountIn, supers, superCount, at);
            var k: Index := 0;
            while k < made.count do
                insertBack(&!items, listItem(&~s, made.list + k));
                k := k + 1;
            end while;
            i := i + 1;
        end while;
        let start: Index := addList(&~s, &items);
        let total: Index := length(&items);
        destroyFree(items);
        return Expanded(list => start, count => total);
    end;

    generic [R: Region, B: Region]
    function expandNode(s: &![Syntax, R], stack: &![Buffer[Index], B], overrideStart: Index, overrideCountIn: Index,
        supers: Index, superCount: Index, at: Index): Expanded is
        let node: SyntaxNode := nodeOf(&~s, at);
        let k: Nat8 := node.kind;
        let none: Expanded := Expanded(list => 0, count => 0);
        if k = nodeBlock then
            usedBlocksPush(&~s, node.a);
            var chain: Buffer[Index] := allocateEmpty();
            let deeper: Index := overrideNamed(&~s, overrideStart, overrideCountIn, node.a);
            if deeper < overrideCount(&~s) then
                let o: Override := overrideOf(&~s, deeper);
                var j: Index := 0;
                while j < o.count do
                    insertBack(&!chain, listItem(&~s, o.defs + j));
                    j := j + 1;
                end while;
            end if;
            insertBack(&!chain, at);
            let chainStart: Index := addList(&~s, &chain);
            let chainCount: Index := length(&chain);
            destroyFree(chain);
            let scope: Index := expandChain(&~s, &~stack, overrideStart, overrideCountIn, chainStart, chainCount, node.flag);
            return Expanded(list => single(&~s, scope), count => 1);
        end if;
        if k = nodeOut then
            let e: SyntaxExpr := exprOf(&~s, node.a);
            if (node.a /= 0) and (e.op = syntaxCall) and nameIs(&~s, e.b, "super") then
                if e.count /= 0 then
                    fail(&~s, "H7064", node.file, node.line, "super() takes no arguments");
                    return none;
                end if;
                if superCount = 0 then
                    fail(&~s, "H7063", node.file, node.line, "super() in a block that no template above this one has");
                    return none;
                end if;
                let scope: Index := expandChain(&~s, &~stack, overrideStart, overrideCountIn, supers, superCount, true);
                return Expanded(list => single(&~s, scope), count => 1);
            end if;
            return Expanded(list => single(&~s, at), count => 1);
        end if;
        if k = nodeInclude then
            let included: Expanded := expandTemplate(&~s, &~stack, node.file, node.line, node.a, 0, 0, 0);
            var made: SyntaxNode := blankNode(nodeIncluded, node.file, node.line);
            made.list1 := included.list;
            made.count1 := included.count;
            let held20: Index := addNode(&~s, made);
            return Expanded(list => single(&~s, held20), count => 1);
        end if;
        if k = nodeIf then
            var branches: Buffer[Index] := allocateEmpty();
            var j: Index := 0;
            while j < node.count1 do
                let branchAt: Index := listItem(&~s, node.list1 + j);
                var branch: SyntaxNode := nodeOf(&~s, branchAt);
                let content: Expanded := expandNodes(&~s, &~stack, overrideStart, overrideCountIn, supers, superCount,
                    branch.list1, branch.count1);
                branch.list1 := content.list;
                branch.count1 := content.count;
                insertBack(&!branches, addNode(&~s, branch));
                j := j + 1;
            end while;
            var made: SyntaxNode := node;
            made.count1 := length(&branches);
            made.list1 := addList(&~s, &branches);
            destroyFree(branches);
            let other: Expanded := expandNodes(&~s, &~stack, overrideStart, overrideCountIn, supers, superCount,
                node.list2, node.count2);
            made.list2 := other.list;
            made.count2 := other.count;
            let held21: Index := addNode(&~s, made);
            return Expanded(list => single(&~s, held21), count => 1);
        end if;
        if k = nodeFor then
            var made: SyntaxNode := node;
            let content: Expanded := expandNodes(&~s, &~stack, overrideStart, overrideCountIn, supers, superCount,
                node.list2, node.count2);
            let empty: Expanded := expandNodes(&~s, &~stack, overrideStart, overrideCountIn, supers, superCount,
                node.list3, node.count3);
            made.list2 := content.list;
            made.count2 := content.count;
            made.list3 := empty.list;
            made.count3 := empty.count;
            let held22: Index := addNode(&~s, made);
            return Expanded(list => single(&~s, held22), count => 1);
        end if;
        if k = nodeSetBlock then
            var made: SyntaxNode := node;
            let content: Expanded := expandNodes(&~s, &~stack, overrideStart, overrideCountIn, supers, superCount,
                node.list1, node.count1);
            made.list1 := content.list;
            made.count1 := content.count;
            let held23: Index := addNode(&~s, made);
            return Expanded(list => single(&~s, held23), count => 1);
        end if;
        if (k = nodeWith) or (k = nodeFilterBlock) or (k = nodeCallBlock) then
            var made: SyntaxNode := node;
            let content: Expanded := expandNodes(&~s, &~stack, overrideStart, overrideCountIn, supers, superCount,
                node.list2, node.count2);
            made.list2 := content.list;
            made.count2 := content.count;
            let held24: Index := addNode(&~s, made);
            return Expanded(list => single(&~s, held24), count => 1);
        end if;
        if (k = nodeMacro) or (k = nodeFromImport) or (k = nodeImportAs) then
            return none;
        end if;
        if k = nodeExtends then
            fail(&~s, "H7065", node.file, node.line, "{% extends %} stands at the top level of a template, once");
            return none;
        end if;
        return Expanded(list => single(&~s, at), count => 1);
    end;

    -- The winning definition of a block, with super() in it standing for
    -- the rest of the chain.  Whether the result sees the loop variables
    -- around it is decided where it is placed: scoped there.
    generic [R: Region, B: Region]
    function expandChain(s: &![Syntax, R], stack: &![Buffer[Index], B], overrideStart: Index, overrideCountIn: Index,
        chain: Index, chainCount: Index, scoped: Bool): Index is
        var made: SyntaxNode := blankNode(nodeScope, 0, 0);
        made.flag := scoped;
        if chainCount > 0 then
            let held25: Index := listItem(&~s, chain);
            let winner: SyntaxNode := nodeOf(&~s, held25);
            made.file := winner.file;
            made.line := winner.line;
            let content: Expanded := expandNodes(&~s, &~stack, overrideStart, overrideCountIn, chain + 1, chainCount - 1,
                winner.list1, winner.count1);
            made.list1 := content.list;
            made.count1 := content.count;
        end if;
        return addNode(&~s, made);
    end;

    -- The whole template resolved: its tree, the macros' bodies resolved
    -- too, and every block defined below checked to be used.
    generic [R: Region]
    function resolveAll(s: &![Syntax, R], name: Index, layout: Index): Expanded is
        var stack: Buffer[Index] := allocateEmpty();
        let held26: Index := overrideCount(&~s);
        let nodes: Expanded := expandTemplate(&~s, &!stack, 0, 0, name, held26, 0, layout);
        let total: Index := macroCount(&~s);
        var i: Index := 0;
        while (i < total) and (not hasFailed(&~s)) do
            var m: Macro := macroOf(&~s, i);
            let held27: Index := overrideCount(&~s);
            let content: Expanded := expandNodes(&~s, &!stack, held27, 0, 0, 0, m.content, m.bodyCount);
            m.content := content.list;
            m.bodyCount := content.count;
            storeMacro(&~s, i, m);
            i := i + 1;
        end while;
        destroyFree(stack);
        let defined: Index := definedNamesCount(&~s);
        var d: Index := 0;
        while (d < defined) and (not hasFailed(&~s)) do
            let blockName: Index := definedNamesItem(&~s, d);
            let blockNode: Index := definedNodesItem(&~s, d);
            if not usedBlock(&~s, blockName) then
                let node: SyntaxNode := nodeOf(&~s, blockNode);
                let held28: String := tagText(&~s, "the block ", blockName,
                    " is defined here, and no template this one extends has a block of that name; Jinja2 drops it without a word, and here it is refused");
                failText(&~s, "H7066", node.file, node.line, held28);
            end if;
            d := d + 1;
        end while;
        return nodes;
    end;

    generic [R: Region]
    function usedBlock(s: &![Syntax, R], name: Index): Bool is
        let total: Index := usedBlocksCount(&~s);
        var i: Index := 0;
        while i < total do
            let used: Index := usedBlocksItem(&~s, i);
            if sameNames(&~s, used, name) then
                return true;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    ---
    --- 3. The generator: the tree walked with the place in the HTML
    ---

    generic [R: Region]
    function stepTotal(s: &![Syntax, R]): Index is
        return stepsCount(&~s);
    end;

    function makeStep(op: Nat8, a: Index, b: Index, c: Index, file: Index, line: Index): Step is
        let zero: Index := 0;
        return Step(op => op, a => a, b => b, c => c, d => zero, writer => HtmlWriter(), raw => false,
            inText => false, file => file, line => line);
    end;

    -- The step added; its number.  More than mostSteps steps fail.
    generic [R: Region]
    function emit(s: &![Syntax, R], step: Step): Index is
        let at: Index := stepTotal(&~s);
        if at >= mostSteps() then
            fail(&~s, "V0009", step.file, step.line, "the template makes more than 200000 steps, its macros expanded");
            return at;
        end if;
        stepsPush(&~s, step);
        return at;
    end;

    generic [R: Region]
    function stepOfProgram(s: &![Syntax, R], at: Index): Step is
        return stepsItem(&~s, at);
    end;

    generic [R: Region]
    function storeStep(s: &![Syntax, R], at: Index, step: Step): Unit is
        if at < stepTotal(&~s) then
            stepsStore(&~s, at, step);
        end if;
        return nil;
    end;

    -- Sets the target b of the step at to the next step.
    generic [R: Region]
    function patchB(s: &![Syntax, R], at: Index): Unit is
        if at < stepTotal(&~s) then
            var step: Step := stepOfProgram(&~s, at);
            step.b := stepTotal(&~s);
            storeStep(&~s, at, step);
        end if;
        return nil;
    end;

    generic [R: Region]
    function patchA(s: &![Syntax, R], at: Index): Unit is
        if at < stepTotal(&~s) then
            var step: Step := stepOfProgram(&~s, at);
            step.a := stepTotal(&~s);
            storeStep(&~s, at, step);
        end if;
        return nil;
    end;

    generic [R: Region]
    function programExprCount(s: &![Syntax, R]): Index is
        return programExprsCount(&~s);
    end;

    generic [R: Region]
    function addProgramExpr(s: &![Syntax, R], e: Expr): Index is
        let at: Index := programExprCount(&~s);
        programExprsPush(&~s, e);
        return at;
    end;

    function makeExpr(op: Nat8, a: Index, b: Index, c: Index, number: Int64, file: Index, line: Index): Expr is
        return Expr(op => op, a => a, b => b, c => c, number => number, file => file, line => line);
    end;

    generic [R: Region]
    function programListLength(s: &![Syntax, R]): Index is
        return programListsCount(&~s);
    end;

    generic [R: Region]
    function pushProgramItem(s: &![Syntax, R], item: Index): Unit is
        programListsPush(&~s, item);
        return nil;
    end;

    generic [R: Region]
    function keepText(s: &![Syntax, R], text: String): Index is
        let at: Index := textsCount(&~s);
        textsPush(&~s, text);
        return at;
    end;

    -- A name of the syntax kept among the program's texts.
    generic [R: Region]
    function keepName(s: &![Syntax, R], name: Index): Index is
        let held29: String := nameCopy(&~s, name);
        return keepText(&~s, held29);
    end;

    generic [R: Region]
    function textExpr(s: &![Syntax, R], text: String, file: Index, line: Index): Index is
        let at: Index := keepText(&~s, text);
        return addProgramExpr(&~s, makeExpr(exprText, at, 0, 0, 0, file, line));
    end;

    ---
    --- The chains of the environment
    ---

    generic [R: Region]
    function bindingOf(s: &![Syntax, R], at: Index): Binding is
        return bindingsItem(&~s, at);
    end;

    generic [R: Region]
    function addBinding(s: &![Syntax, R], binding: Binding): Index is
        let at: Index := bindingsCount(&~s);
        bindingsPush(&~s, binding);
        return at;
    end;

    generic [R: Region]
    function linkOf(s: &![Syntax, R], loops: Bool, at: Index): Link is
        if loops then
            return loopLinksItem(&~s, at);
        end if;
        return callingLinksItem(&~s, at);
    end;

    generic [R: Region]
    function addLink(s: &![Syntax, R], loops: Bool, link: Link): Index is
        if loops then
            let at: Index := loopLinksCount(&~s);
            loopLinksPush(&~s, link);
            return at;
        end if;
        let at: Index := callingLinksCount(&~s);
        callingLinksPush(&~s, link);
        return at;
    end;

    generic [R: Region]
    function callerOf(s: &![Syntax, R], at: Index): Caller is
        return callersItem(&~s, at);
    end;

    generic [R: Region]
    function addCaller(s: &![Syntax, R], caller: Caller): Index is
        let at: Index := callersCount(&~s);
        callersPush(&~s, caller);
        return at;
    end;

    generic [R: Region]
    function newSlot(s: &![Syntax, R]): Index is
        let at: Index := s->slots;
        s->slots := at + 1;
        return at;
    end;

    generic [R: Region]
    function newLoop(s: &![Syntax, R]): Index is
        let at: Index := s->loops;
        s->loops := at + 1;
        return at;
    end;

    -- The binding of name visible in env: 0 when none.
    generic [R: Region]
    function lookup(s: &![Syntax, R], env: Env, name: Index): Index is
        var at: Index := env.vars;
        while at /= 0 do
            let b: Binding := bindingOf(&~s, at);
            if sameNames(&~s, b.name, name) then
                return at;
            end if;
            at := b.parent;
        end while;
        return 0;
    end;

    -- The name bound in env; more than mostBindings names visible at one
    -- place is a failure, so that lookup walks at most that many.
    generic [R: Region]
    function bindName(s: &![Syntax, R], env: Env, name: Index, slot: Index, kind: Index, literal: Index, file: Index,
        line: Index): Env is
        var count: Index := 0;
        var visible: Index := env.vars;
        while (visible /= 0) and (count < mostBindings()) do
            let b: Binding := bindingOf(&~s, visible);
            visible := b.parent;
            count := count + 1;
        end while;
        if count >= mostBindings() then
            fail(&~s, "V0011", file, line, "more than 256 names are bound where this stands");
            return env;
        end if;
        var depth: Index := env.loopDepth;
        if kind = bindLiteral then
            depth := 0;
        end if;
        let at: Index := addBinding(&~s, Binding(name => name, slot => slot, kind => kind, literal => literal,
            depth => depth, parent => env.vars));
        var made: Env := env;
        made.vars := at;
        return made;
    end;

    -- The bindings of env made outside every loop, in their order.
    generic [R: Region]
    function outsideLoops(s: &![Syntax, R], env: Env): Index is
        var kept: Buffer[Index] := allocateEmpty();
        var at: Index := env.vars;
        while at /= 0 do
            let b: Binding := bindingOf(&~s, at);
            if b.depth = 0 then
                insertBack(&!kept, at);
            end if;
            at := b.parent;
        end while;
        var head: Index := 0;
        var k: Index := length(&kept);
        while k > 0 do
            k := k - 1;
            var b: Binding := bindingOf(&~s, nth(&kept, k));
            b.parent := head;
            head := addBinding(&~s, b);
        end while;
        destroyFree(kept);
        return head;
    end;

    -- The innermost loop of env, or a failure.
    generic [R: Region]
    function innermostLoop(s: &![Syntax, R], env: Env, file: Index, line: Index): Index is
        if env.loops = 0 then
            fail(&~s, "H7071", file, line, "`loop' only exists inside a {% for %}");
            return 0;
        end if;
        let link: Link := linkOf(&~s, true, env.loops);
        return link.value;
    end;

    ---
    --- Expressions
    ---

    -- The literal of a name a set, a with or a macro argument bound to
    -- one, put where the name stands, everywhere in e: what Hilde's
    -- compiler does by substitution.
    generic [R: Region]
    function substitute(s: &![Syntax, R], env: Env, e: Index): Index is
        if (e = 0) or hasFailed(&~s) then
            return e;
        end if;
        let x: SyntaxExpr := exprOf(&~s, e);
        if x.op = syntaxPath then
            let first: Index := listItem(&~s, x.list);
            let bound: Index := lookup(&~s, env, first);
            if bound /= 0 then
                let b: Binding := bindingOf(&~s, bound);
                if b.kind = bindLiteral then
                    if x.count = 1 then
                        return b.literal;
                    end if;
                    let held30: String := tagText(&~s, "the parameter ", first,
                        " is a literal here, and a literal has no fields");
                    failText(&~s, "H7088", x.file, x.line, held30);
                end if;
            end if;
            return e;
        end if;
        if (x.op = syntaxString) or (x.op = syntaxInteger) or (x.op = syntaxBool) or (x.op = syntaxNone) then
            return e;
        end if;
        var made: SyntaxExpr := x;
        made.a := substitute(&~s, env, x.a);
        if (x.op = syntaxAnd) or (x.op = syntaxOr) or (x.op = syntaxCompare) or (x.op = syntaxConcat)
            or (x.op = syntaxArith) or (x.op = syntaxIn) or (x.op = syntaxCond) then
            made.b := substitute(&~s, env, x.b);
        end if;
        if x.op = syntaxCond then
            made.c := substitute(&~s, env, x.c);
        end if;
        if (x.op = syntaxFilter) or (x.op = syntaxCall) then
            made.list := substituteList(&~s, env, x.list, x.count, 1);
        end if;
        if x.op = syntaxTrans then
            made.list := substituteList(&~s, env, x.list, x.count, 2);
        end if;
        return addExpr(&~s, made);
    end;

    -- The expressions of a list substituted into a new list; stride 2 for
    -- pairs of a name and an expression.
    generic [R: Region]
    function substituteList(s: &![Syntax, R], env: Env, list: Index, count: Index, stride: Index): Index is
        var items: Buffer[Index] := allocateEmpty();
        var i: Index := 0;
        while i < (count * stride) do
            if (stride = 2) and (rem(i, 2) = 0) then
                insertBack(&!items, listItem(&~s, list + i));
            else
                let held31: Index := listItem(&~s, list + i);
                insertBack(&!items, substitute(&~s, env, held31));
            end if;
            i := i + 1;
        end while;
        let start: Index := addList(&~s, &items);
        destroyFree(items);
        return start;
    end;

    -- The value of a whole number of the template: OCaml's int, which is
    -- what Hilde's compiler reads it as, holds 63 bits.
    generic [R: Region]
    function literalInt(s: &![Syntax, R], x: SyntaxExpr): Int64 is
        let digits: String := nameCopy(&~s, x.a);
        var number: Int64 := 0;
        var good: Bool := false;
        case parseInt(asSpan(&digits)) of
            when Some(value as v: Int64) do
                number := v;
                good := (v <= 4611686018427387903) and (v >= -4611686018427387904);
            when None do
                skip;
        end case;
        destroyString(digits);
        if not good then
            fail(&~s, "H7072", x.file, x.line, "this number is too large");
            return 0;
        end if;
        return number;
    end;

    -- Python's integer division and remainder, which round towards minus
    -- infinity.
    function floorDivide(a: Int64, b: Int64): Int64 is
        let q: Int64 := a / b;
        let r: Int64 := a - (q * b);
        if (r /= 0) and ((r < 0) /= (b < 0)) then
            return q - 1;
        end if;
        return q;
    end;

    function floorModulo(a: Int64, b: Int64): Int64 is
        let r: Int64 := a - ((a / b) * b);
        if (r /= 0) and ((r < 0) /= (b < 0)) then
            return r + b;
        end if;
        return r;
    end;

    -- op divides rest, as a message.
    generic [R: Region]
    function badDivisor(s: &![Syntax, R], x: SyntaxExpr, rest: Span[Nat8, Static]): Unit is
        var op: Span[Nat8, Static] := "//";
        if x.c = arithModulo then
            op := "%";
        end if;
        failText(&~s, "H7105", x.file, x.line, joined(op, " divides ", rest));
        return nil;
    end;

    -- The arithmetic of numbers written in the template alone, computed
    -- now: Some with the value, None when a name takes part.
    generic [R: Region]
    function fold(s: &![Syntax, R], e: Index): Option[Int64] is
        if e = 0 then
            return None();
        end if;
        let x: SyntaxExpr := exprOf(&~s, e);
        if x.op = syntaxInteger then
            return Some(value => literalInt(&~s, x));
        end if;
        if x.op /= syntaxArith then
            return None();
        end if;
        case fold(&~s, x.a) of
            when Some(value as left: Int64) do
                case fold(&~s, x.b) of
                    when Some(value as right: Int64) do
                        if x.c = arithAdd then
                            return Some(value => left + right);
                        else if x.c = arithSubtract then
                            return Some(value => left - right);
                        else if x.c = arithMultiply then
                            return Some(value => left * right);
                        end if;
                        if right = 0 then
                            badDivisor(&~s, x, "by zero");
                            return Some(value => 0);
                        end if;
                        if x.c = arithFloorDivide then
                            return Some(value => floorDivide(left, right));
                        end if;
                        return Some(value => floorModulo(left, right));
                    when None do
                        return None();
                end case;
            when None do
                return None();
        end case;
    end;

    -- loop.attr names a number: index 0, index0 1, length 2, revindex 3,
    -- revindex0 4; first 5 and last 6 are truth values.  7 when attr is
    -- none of them.
    generic [R: Region]
    function loopAttribute(s: &![Syntax, R], attr: Index): Index is
        if nameIs(&~s, attr, "index") then
            return 0;
        else if nameIs(&~s, attr, "index0") then
            return 1;
        else if nameIs(&~s, attr, "length") then
            return 2;
        else if nameIs(&~s, attr, "revindex") then
            return 3;
        else if nameIs(&~s, attr, "revindex0") then
            return 4;
        else if nameIs(&~s, attr, "first") then
            return 5;
        else if nameIs(&~s, attr, "last") then
            return 6;
        end if;
        return 7;
    end;

    -- Whether e is loop.something; attribute gives the something.
    generic [R: Region]
    function isLoopPath(s: &![Syntax, R], x: SyntaxExpr): Bool is
        if (x.op /= syntaxPath) or (x.count /= 2) then
            return false;
        end if;
        let held32: Index := listItem(&~s, x.list);
        return nameIs(&~s, held32, "loop");
    end;

    generic [R: Region]
    function loopNumberAttribute(s: &![Syntax, R], x: SyntaxExpr): Bool is
        if not isLoopPath(&~s, x) then
            return false;
        end if;
        let held33: Index := listItem(&~s, x.list + 1);
        return loopAttribute(&~s, held33) < 5;
    end;

    -- A number the loop knows.
    generic [R: Region]
    function loopNumber(s: &![Syntax, R], env: Env, x: SyntaxExpr): Index is
        let attr: Index := listItem(&~s, x.list + 1);
        let loop: Index := innermostLoop(&~s, env, x.file, x.line);
        let code: Index := loopAttribute(&~s, attr);
        if code >= 5 then
            let held34: String := tagText(&~s, "loop.", attr, " is not a number");
            failText(&~s, "H7080", x.file, x.line, held34);
        end if;
        return addProgramExpr(&~s, makeExpr(exprLoop, loop, code, 0, 0, x.file, x.line));
    end;

    -- Whether e is a call of a function the application gave, not of a
    -- macro: the one addition to the dialect.
    generic [R: Region]
    function functionIndex(s: &![Syntax, R], env: Env, x: SyntaxExpr): Index is
        let none: Index := functionNamesCount(&~s);
        if x.op /= syntaxCall then
            return none;
        end if;
        let name: String := nameCopy(&~s, x.b);
        let macro: Index := macroFor(&~s, env, asSpan(&name));
        if macro < macroCount(&~s) then
            destroyString(name);
            return none;
        end if;
        var i: Index := 0;
        while i < none do
            if functionNamesEquals(&~s, i, asSpan(&name)) then
                destroyString(name);
                return i;
            end if;
            i := i + 1;
        end while;
        destroyString(name);
        return none;
    end;

    generic [R: Region]
    function isFunctionCall(s: &![Syntax, R], env: Env, e: Index): Bool is
        if e = 0 then
            return false;
        end if;
        let x: SyntaxExpr := exprOf(&~s, e);
        let index: Index := functionIndex(&~s, env, x);
        return index < functionNamesCount(&~s);
    end;

    -- A name of the data, or a call of a function: what stands where the
    -- dialect takes a name.
    generic [R: Region]
    function isNameLike(s: &![Syntax, R], env: Env, e: Index): Bool is
        if e = 0 then
            return false;
        end if;
        let x: SyntaxExpr := exprOf(&~s, e);
        return (x.op = syntaxPath) or isFunctionCall(&~s, env, e);
    end;

    -- The call of a function with its arguments as values.
    generic [R: Region]
    function callExpr(s: &![Syntax, R], env: Env, x: SyntaxExpr): Index is
        let index: Index := functionIndex(&~s, env, x);
        var args: Buffer[Index] := allocateEmpty();
        var i: Index := 0;
        while i < x.count do
            let argument: Index := listItem(&~s, x.list + i);
            let compiled: ValueExpr := valueOfExpr(&~s, env, argument);
            insertBack(&!args, compiled.expr);
            i := i + 1;
        end while;
        let start: Index := programListLength(&~s);
        var k: Index := 0;
        while k < length(&args) do
            pushProgramItem(&~s, nth(&args, k));
            k := k + 1;
        end while;
        destroyFree(args);
        return addProgramExpr(&~s, makeExpr(exprCall, index, start, x.count, 0, x.file, x.line));
    end;

    -- The reference a name or a path stands for: a binding, or the data.
    generic [R: Region]
    function refOfPath(s: &![Syntax, R], env: Env, x: SyntaxExpr): Index is
        if x.op = syntaxCall then
            return callExpr(&~s, env, x);
        end if;
        let first: Index := listItem(&~s, x.list);
        if nameIs(&~s, first, "loop") then
            fail(&~s, "H7069", x.file, x.line,
                "`loop' can only be asked for loop.index, loop.index0, loop.revindex, loop.revindex0, loop.length, loop.first, loop.last and loop.cycle(...), inside a {% for %}");
            return 0;
        end if;
        let rest: Index := programListLength(&~s);
        var i: Index := 1;
        while i < x.count do
            let held35: Index := listItem(&~s, x.list + i);
            let held36: Index := keepName(&~s, held35);
            pushProgramItem(&~s, held36);
            i := i + 1;
        end while;
        let bound: Index := lookup(&~s, env, first);
        if bound /= 0 then
            let b: Binding := bindingOf(&~s, bound);
            if (b.kind /= bindReference) and (x.count > 1) then
                let held37: String := tagText(&~s, "", first,
                    " is a value that a {% set %} or a {% with %} computed, and a computed value has no fields");
                failText(&~s, "H7104", x.file, x.line, held37);
                return 0;
            end if;
            return addProgramExpr(&~s, makeExpr(exprSlot, b.slot, rest, x.count - 1, 0, x.file, x.line));
        end if;
        let firstText: String := nameCopy(&~s, first);
        let importName: Bool := spaceTaken(&~s, asSpan(&firstText));
        destroyString(firstText);
        if importName then
            let held38: String := tagText(&~s, "the name ", first,
                " is an import's: it stands for the macros of a file, and a macro is called, not printed");
            failText(&~s, "H7102", x.file, x.line, held38);
            return 0;
        end if;
        if not env.seesData then
            let held39: String := tagText(&~s, "", first,
                ": a macro brought in with {% from ... import %} or {% import %} does not see the template's data, as in Jinja2 -- pass it as an argument");
            failText(&~s, "H7070", x.file, x.line, held39);
            return 0;
        end if;
        let all: Index := programListLength(&~s);
        let held40: Index := keepName(&~s, first);
        pushProgramItem(&~s, held40);
        var j: Index := 1;
        while j < x.count do
            let held41: Index := listItem(&~s, x.list + j);
            let held42: Index := keepName(&~s, held41);
            pushProgramItem(&~s, held42);
            j := j + 1;
        end while;
        return addProgramExpr(&~s, makeExpr(exprData, all, x.count, 0, 0, x.file, x.line));
    end;

    function isNumericOp(op: Nat8): Bool is
        return (op = syntaxArith) or (op = syntaxInteger);
    end;

    generic [R: Region]
    function isNumeric(s: &![Syntax, R], e: Index): Bool is
        if e = 0 then
            return false;
        end if;
        let x: SyntaxExpr := exprOf(&~s, e);
        return isNumericOp(x.op) or loopNumberAttribute(&~s, x);
    end;

    -- A number: an expression whose value is a whole number.
    generic [R: Region]
    function numeric(s: &![Syntax, R], env: Env, e: Index): Index is
        let x: SyntaxExpr := exprOf(&~s, e);
        case fold(&~s, e) of
            when Some(value as v: Int64) do
                return addProgramExpr(&~s, makeExpr(exprInteger, 0, 0, 0, v, x.file, x.line));
            when None do
                skip;
        end case;
        if isLoopPath(&~s, x) then
            return loopNumber(&~s, env, x);
        end if;
        if (x.op = syntaxPath) or isFunctionCall(&~s, env, e) then
            return refOfPath(&~s, env, x);
        end if;
        if x.op = syntaxArith then
            let left: Index := numeric(&~s, env, x.a);
            if x.c <= arithMultiply then
                let right: Index := numeric(&~s, env, x.b);
                return addProgramExpr(&~s, makeExpr(exprArith, left, right, x.c, 0, x.file, x.line));
            end if;
            var divisor: Int64 := 0;
            case fold(&~s, x.b) of
                when Some(value as d: Int64) do
                    divisor := d;
                    if d = 0 then
                        badDivisor(&~s, x, "by zero");
                    end if;
                when None do
                    badDivisor(&~s, x,
                        "by a number written in the template only: a divisor from the data could be zero, and a division by zero stops the programme");
            end case;
            var op: Nat8 := exprFloorDivide;
            if x.c = arithModulo then
                op := exprModulo;
            end if;
            return addProgramExpr(&~s, makeExpr(op, left, 0, 0, divisor, x.file, x.line));
        end if;
        fail(&~s, "H7106", x.file, x.line,
            "this is not a number: + - * // % take numbers, names of the data and the numbers of loop");
        return 0;
    end;

    -- A value to print, and whether it goes out as it is (|safe, or a set
    -- block's text).
    record ValueExpr: Free is
        expr: Index;
        safe: Bool;
    end;

    generic [R: Region]
    function isMarkupName(s: &![Syntax, R], env: Env, x: SyntaxExpr): Bool is
        if (x.op /= syntaxPath) or (x.count /= 1) then
            return false;
        end if;
        let held43: Index := listItem(&~s, x.list);
        let bound: Index := lookup(&~s, env, held43);
        if bound = 0 then
            return false;
        end if;
        let b: Binding := bindingOf(&~s, bound);
        return b.kind = bindMarkup;
    end;

    generic [R: Region]
    function filterCode(s: &![Syntax, R], name: Index): Index is
        if nameIs(&~s, name, "upper") then
            return filterUpper;
        else if nameIs(&~s, name, "lower") then
            return filterLower;
        else if nameIs(&~s, name, "trim") then
            return filterTrim;
        else if nameIs(&~s, name, "capitalize") then
            return filterCapitalize;
        else if nameIs(&~s, name, "title") then
            return filterTitle;
        else if nameIs(&~s, name, "replace") then
            return filterReplace;
        else if nameIs(&~s, name, "truncate") then
            return filterTruncate;
        else if nameIs(&~s, name, "center") then
            return filterCenter;
        end if;
        return 8;
    end;

    generic [R: Region]
    function argumentOf(s: &![Syntax, R], x: SyntaxExpr, at: Index): SyntaxExpr is
        let held44: Index := listItem(&~s, x.list + at);
        return exprOf(&~s, held44);
    end;

    -- The code points of text, as Python counts them.
    generic [T: Region]
    function codePoints(text: Span[Nat8, T]): Index is
        var points: Index := 0;
        var i: Index := 0;
        while i < spanLength(text) do
            let b: Nat8 := text[i];
            if (b < 128) or (b >= 192) then
                points := points + 1;
            end if;
            i := i + 1;
        end while;
        return points;
    end;

    -- The filters replace, truncate and center with their literal
    -- arguments checked, applied to base.  0 and a failure when the
    -- arguments are not of the filter's form.
    generic [R: Region]
    function filterWithArguments(s: &![Syntax, R], x: SyntaxExpr, code: Index, base: Index): Index is
        let n: Index := x.count;
        if code = filterReplace then
            if (n = 2) or (n = 3) then
                let old: SyntaxExpr := argumentOf(&~s, x, 0);
                let new: SyntaxExpr := argumentOf(&~s, x, 1);
                if (old.op = syntaxString) and nameIs(&~s, old.a, "") then
                    fail(&~s, "H7108", x.file, x.line, "|replace takes a text to replace that is not empty");
                    return 0;
                end if;
                if (old.op = syntaxString) and (new.op = syntaxString) then
                    var limit: Int64 := -1;
                    var good: Bool := n = 2;
                    if n = 3 then
                        let count: SyntaxExpr := argumentOf(&~s, x, 2);
                        if count.op = syntaxInteger then
                            limit := literalInt(&~s, count);
                            good := limit >= 0;
                        end if;
                    end if;
                    if good then
                        let start: Index := programListLength(&~s);
                        let held45: Index := keepName(&~s, old.a);
                        pushProgramItem(&~s, held45);
                        let held46: Index := keepName(&~s, new.a);
                        pushProgramItem(&~s, held46);
                        return addProgramExpr(&~s, makeExpr(exprFilter, base, start, code, limit, x.file, x.line));
                    end if;
                end if;
            end if;
            fail(&~s, "H7108", x.file, x.line, "|replace takes two strings in quotes, and a count of at least 0 after them");
            return 0;
        end if;
        if code = filterTruncate then
            var length: Int64 := 255;
            var kill: Bool := false;
            var ending: Index := 0;
            var leeway: Int64 := 5;
            var good: Bool := true;
            if n >= 1 then
                let a: SyntaxExpr := argumentOf(&~s, x, 0);
                good := a.op = syntaxInteger;
                if good then
                    length := literalInt(&~s, a);
                end if;
            end if;
            if good and (n >= 2) then
                let b: SyntaxExpr := argumentOf(&~s, x, 1);
                good := b.op = syntaxBool;
                kill := b.flag;
            end if;
            if good and (n >= 3) then
                let c: SyntaxExpr := argumentOf(&~s, x, 2);
                good := c.op = syntaxString;
                ending := c.a;
            end if;
            if good and (n >= 4) then
                let d: SyntaxExpr := argumentOf(&~s, x, 3);
                good := d.op = syntaxInteger;
                if good then
                    leeway := literalInt(&~s, d);
                end if;
            end if;
            if (not good) or (n > 4) then
                fail(&~s, "H7108", x.file, x.line,
                    "|truncate takes a length, then true or false, a text in quotes and a leeway, each a literal");
                return 0;
            end if;
            var endingText: String := fromLiteral("...");
            if ending /= 0 then
                destroyString(endingText);
                endingText := nameCopy(&~s, ending);
            end if;
            let points: Index := codePoints(asSpan(&endingText));
            var pointsAsInt: Int64 := 0;
            case toInt64(points) of
                when Some(value as p: Int64) do
                    pointsAsInt := p;
                when None do
                    skip;
            end case;
            if (length < pointsAsInt) or (leeway < 0) then
                destroyString(endingText);
                fail(&~s, "H7108", x.file, x.line,
                    "|truncate takes a length at least as long as its ending, and a leeway of at least 0");
                return 0;
            end if;
            let start: Index := programListLength(&~s);
            let held47: Index := keepText(&~s, endingText);
            pushProgramItem(&~s, held47);
            var killCode: Index := 0;
            if kill then
                killCode := 1;
            end if;
            pushProgramItem(&~s, killCode);
            var leewayIndex: Index := 0;
            case toIndex(leeway) of
                when Some(value as l: Index) do
                    leewayIndex := l;
                when None do
                    skip;
            end case;
            pushProgramItem(&~s, leewayIndex);
            return addProgramExpr(&~s, makeExpr(exprFilter, base, start, code, length, x.file, x.line));
        end if;
        -- center
        var width: Int64 := 80;
        if n = 1 then
            let w: SyntaxExpr := argumentOf(&~s, x, 0);
            if w.op = syntaxInteger then
                width := literalInt(&~s, w);
            else
                width := -1;
            end if;
        end if;
        if (n > 1) or (width < 0) then
            fail(&~s, "H7108", x.file, x.line, "|center takes a width of at least 0, as a literal");
            return 0;
        end if;
        return addProgramExpr(&~s, makeExpr(exprFilter, base, 0, code, width, x.file, x.line));
    end;

    generic [R: Region]
    function valueOfExpr(s: &![Syntax, R], env: Env, e: Index): ValueExpr is
        let nothing: ValueExpr := ValueExpr(expr => 0, safe => false);
        if (e = 0) or hasFailed(&~s) then
            return nothing;
        end if;
        let x: SyntaxExpr := exprOf(&~s, e);
        let op: Nat8 := x.op;
        if isLoopPath(&~s, x) then
            let attr: Index := listItem(&~s, x.list + 1);
            let code: Index := loopAttribute(&~s, attr);
            if code = 7 then
                let held48: String := tagText(&~s, "loop.", attr, " cannot be printed");
                failText(&~s, "H7073", x.file, x.line, held48);
                return nothing;
            end if;
            let loop: Index := innermostLoop(&~s, env, x.file, x.line);
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprLoop, loop, code, 0, 0, x.file, x.line)),
                safe => false);
        end if;
        if op = syntaxPath then
            let markup: Bool := isMarkupName(&~s, env, x);
            return ValueExpr(expr => refOfPath(&~s, env, x), safe => markup);
        end if;
        if op = syntaxString then
            let held49: String := nameCopy(&~s, x.a);
            return ValueExpr(expr => textExpr(&~s, held49, x.file, x.line), safe => false);
        end if;
        if op = syntaxInteger then
            let v: Int64 := literalInt(&~s, x);
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprInteger, 0, 0, 0, v, x.file, x.line)),
                safe => false);
        end if;
        if op = syntaxBool then
            var truth: Int64 := 0;
            if x.flag then
                truth := 1;
            end if;
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprBool, 0, 0, 0, truth, x.file, x.line)),
                safe => false);
        end if;
        if op = syntaxArith then
            return ValueExpr(expr => numeric(&~s, env, e), safe => false);
        end if;
        if op = syntaxConcat then
            let left: ValueExpr := valueOfExpr(&~s, env, x.a);
            let right: ValueExpr := valueOfExpr(&~s, env, x.b);
            if left.safe or right.safe then
                fail(&~s, "H7107", x.file, x.line,
                    "~ joins texts that are escaped when printed; a |safe value or a {% set %} block's text cannot be joined to them -- print it on its own");
                return nothing;
            end if;
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprConcat, left.expr, right.expr, 0, 0, x.file,
                x.line)), safe => false);
        end if;
        if op = syntaxCond then
            let chosen: ValueExpr := valueOfExpr(&~s, env, x.a);
            var other: ValueExpr := ValueExpr(expr => 0, safe => chosen.safe);
            if x.flag then
                other := valueOfExpr(&~s, env, x.c);
            end if;
            if chosen.safe /= other.safe then
                fail(&~s, "H7017", x.file, x.line, "an inline if prints its two values the same way: both |safe, or neither");
                return nothing;
            end if;
            let cond: Index := condition(&~s, env, x.b);
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprCond, cond, chosen.expr, other.expr, 0, x.file,
                x.line)), safe => chosen.safe);
        end if;
        if op = syntaxFilter then
            return filtered(&~s, env, x);
        end if;
        if op = syntaxNone then
            fail(&~s, "H7077", x.file, x.line, "none cannot be printed: an Option is printed by asking `is not none' first");
            return nothing;
        end if;
        if (op = syntaxNot) or (op = syntaxAnd) or (op = syntaxOr) or (op = syntaxCompare) or (op = syntaxTest)
            or (op = syntaxIn) then
            return ValueExpr(expr => condition(&~s, env, e), safe => false);
        end if;
        if op = syntaxCall then
            if nameIs(&~s, x.b, "loop.cycle") then
                return ValueExpr(expr => cycle(&~s, env, x), safe => false);
            end if;
            if isFunctionCall(&~s, env, e) then
                return ValueExpr(expr => callExpr(&~s, env, x), safe => false);
            end if;
            fail(&~s, "H7079", x.file, x.line, "a macro call stands alone in {{ }}, without filters");
            return nothing;
        end if;
        fail(&~s, "H7124", x.file, x.line, "a translation stands alone in {{ }} or a {% trans %} block, without filters and without ~");
        return nothing;
    end;

    generic [R: Region]
    function filtered(s: &![Syntax, R], env: Env, x: SyntaxExpr): ValueExpr is
        let nothing: ValueExpr := ValueExpr(expr => 0, safe => false);
        let inner: SyntaxExpr := exprOf(&~s, x.a);
        if nameIs(&~s, x.b, "safe") and (x.count = 0) then
            let v: ValueExpr := valueOfExpr(&~s, env, x.a);
            return ValueExpr(expr => v.expr, safe => true);
        end if;
        if nameIsEither(&~s, x.b, "e", "escape") and (x.count = 0) then
            return valueOfExpr(&~s, env, x.a);
        end if;
        let code: Index := filterCode(&~s, x.b);
        if (code <= filterTitle) and (x.count = 0) then
            let v: ValueExpr := valueOfExpr(&~s, env, x.a);
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprFilter, v.expr, 0, code, 0, x.file, x.line)),
                safe => v.safe);
        end if;
        if (code >= filterReplace) and (code <= filterCenter) then
            let v: ValueExpr := valueOfExpr(&~s, env, x.a);
            return ValueExpr(expr => filterWithArguments(&~s, x, code, v.expr), safe => v.safe);
        end if;
        if nameIs(&~s, x.b, "join") then
            if not isNameLike(&~s, env, x.a) then
                fail(&~s, "H7108", x.file, x.line, "|join takes a name of the data to join, and nothing else");
                return nothing;
            end if;
            var separator: String := makeEmpty();
            if x.count = 1 then
                let sep: SyntaxExpr := argumentOf(&~s, x, 0);
                if sep.op = syntaxString then
                    destroyString(separator);
                    separator := nameCopy(&~s, sep.a);
                else
                    destroyString(separator);
                    fail(&~s, "H7108", x.file, x.line, "|join takes a separator in quotes, or none");
                    return nothing;
                end if;
            else if x.count > 1 then
                destroyString(separator);
                fail(&~s, "H7108", x.file, x.line, "|join takes a separator in quotes, or none");
                return nothing;
            end if;
            let sequence: Index := refOfPath(&~s, env, inner);
            let sepText: Index := keepText(&~s, separator);
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprJoin, sequence, sepText, 0, 0, x.file, x.line)),
                safe => false);
        end if;
        if nameIsEither(&~s, x.b, "length", "count") and (x.count = 0) then
            if not isNameLike(&~s, env, x.a) then
                fail(&~s, "H7075", x.file, x.line, "|length is supported on a name of the data only");
                return nothing;
            end if;
            let sized: Index := refOfPath(&~s, env, inner);
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprLength, sized, 0, 0, 0, x.file, x.line)),
                safe => false);
        end if;
        let held50: String := tagText(&~s, "the filter |", x.b, " is not supported");
        failText(&~s, "H7076", x.file, x.line, held50);
        return nothing;
    end;

    generic [R: Region]
    function cycle(s: &![Syntax, R], env: Env, x: SyntaxExpr): Index is
        let loop: Index := innermostLoop(&~s, env, x.file, x.line);
        if x.count = 0 then
            fail(&~s, "H7108", x.file, x.line, "loop.cycle takes at least one text");
            return 0;
        end if;
        let start: Index := programListLength(&~s);
        var texts: Buffer[Index] := allocateEmpty();
        var i: Index := 0;
        while i < x.count do
            let a: SyntaxExpr := argumentOf(&~s, x, i);
            if a.op /= syntaxString then
                fail(&~s, "H7108", a.file, a.line, "loop.cycle takes texts in quotes");
            else
                insertBack(&!texts, keepName(&~s, a.a));
            end if;
            i := i + 1;
        end while;
        let listStart: Index := programListLength(&~s);
        var k: Index := 0;
        while k < length(&texts) do
            pushProgramItem(&~s, nth(&texts, k));
            k := k + 1;
        end while;
        let n: Index := length(&texts);
        destroyFree(texts);
        return addProgramExpr(&~s, makeExpr(exprCycle, loop, listStart, n, 0, x.file, x.line));
    end;

    function mirrored(op: Index): Index is
        if op = compareLess then
            return compareGreater;
        else if op = compareGreater then
            return compareLess;
        else if op = compareLessOrEqual then
            return compareGreaterOrEqual;
        else if op = compareGreaterOrEqual then
            return compareLessOrEqual;
        end if;
        return op;
    end;

    generic [R: Region]
    function compareExpr(s: &![Syntax, R], op: Index, left: Index, right: Index, x: SyntaxExpr): Index is
        return addProgramExpr(&~s, makeExpr(exprCompare, left, right, op, 0, x.file, x.line));
    end;

    -- A condition: an expression whose value is a truth value.
    generic [R: Region]
    function condition(s: &![Syntax, R], env: Env, e: Index): Index is
        if (e = 0) or hasFailed(&~s) then
            return 0;
        end if;
        let x: SyntaxExpr := exprOf(&~s, e);
        let op: Nat8 := x.op;
        let loopCode: Index := loopCodeOf(&~s, x);
        if (loopCode >= 5) and (loopCode <= 6) then
            let loop: Index := innermostLoop(&~s, env, x.file, x.line);
            return addProgramExpr(&~s, makeExpr(exprLoop, loop, loopCode, 0, 0, x.file, x.line));
        end if;
        if (op = syntaxPath) or isFunctionCall(&~s, env, e) then
            let reference: Index := refOfPath(&~s, env, x);
            return addProgramExpr(&~s, makeExpr(exprTruth, reference, 0, 0, 0, x.file, x.line));
        end if;
        if op = syntaxBool then
            var truth: Int64 := 0;
            if x.flag then
                truth := 1;
            end if;
            return addProgramExpr(&~s, makeExpr(exprBool, 0, 0, 0, truth, x.file, x.line));
        end if;
        if op = syntaxNot then
            let inner: Index := condition(&~s, env, x.a);
            return addProgramExpr(&~s, makeExpr(exprNot, inner, 0, 0, 0, x.file, x.line));
        end if;
        if (op = syntaxAnd) or (op = syntaxOr) then
            let left: Index := condition(&~s, env, x.a);
            let right: Index := condition(&~s, env, x.b);
            var made: Nat8 := exprAnd;
            if op = syntaxOr then
                made := exprOr;
            end if;
            return addProgramExpr(&~s, makeExpr(made, left, right, 0, 0, x.file, x.line));
        end if;
        if op = syntaxTest then
            let isNone: Bool := nameIs(&~s, x.b, "none");
            if isNone and isNameLike(&~s, env, x.a) then
                let held53: SyntaxExpr := exprOf(&~s, x.a);
                let reference: Index := refOfPath(&~s, env, held53);
                var negated: Int64 := 0;
                if x.flag then
                    negated := 1;
                end if;
                return addProgramExpr(&~s, makeExpr(exprIsNone, reference, 0, 0, negated, x.file, x.line));
            end if;
            if nameIsEither(&~s, x.b, "defined", "undefined") then
                fail(&~s, "H7082", x.file, x.line,
                    "`is defined' cannot be asked: the template is compiled against one data type, so every name is known when the programme is compiled, and a name that does not exist is a compile error already");
                return 0;
            end if;
            if nameIs(&~s, x.b, "none") then
                fail(&~s, "H7083", x.file, x.line, "`is none' is supported on a name of the data only");
                return 0;
            end if;
            let held54: String := tagText(&~s, "the test `is ", x.b, "' is not supported");
            failText(&~s, "H7084", x.file, x.line, held54);
            return 0;
        end if;
        if op = syntaxIn then
            if not isNameLike(&~s, env, x.b) then
                let other: SyntaxExpr := exprOf(&~s, x.b);
                fail(&~s, "H7018", other.file, other.line,
                    "`in' asks a name of the data: a string for a part of it, or a buffer for an element");
                return 0;
            end if;
            let needle: SyntaxExpr := exprOf(&~s, x.a);
            var text: Index := 0;
            if needle.op = syntaxString then
                let held55: String := nameCopy(&~s, needle.a);
                text := textExpr(&~s, held55, needle.file, needle.line);
            else if (needle.op = syntaxPath) or isFunctionCall(&~s, env, x.a) then
                text := refOfPath(&~s, env, needle);
            else
                fail(&~s, "H7018", needle.file, needle.line, "`in' asks for a text in quotes or a name of a string");
                return 0;
            end if;
            let held56: SyntaxExpr := exprOf(&~s, x.b);
            let haystack: Index := refOfPath(&~s, env, held56);
            var negated: Int64 := 0;
            if x.flag then
                negated := 1;
            end if;
            return addProgramExpr(&~s, makeExpr(exprIn, text, haystack, 0, negated, x.file, x.line));
        end if;
        if op = syntaxCompare then
            return comparison(&~s, env, x);
        end if;
        if op = syntaxCond then
            fail(&~s, "H7017", x.file, x.line, "an inline if cannot stand in a condition; write an {% if %} with and and or");
            return 0;
        end if;
        fail(&~s, "H7087", x.file, x.line, "this cannot be used as a condition");
        return 0;
    end;

    generic [R: Region]
    function comparison(s: &![Syntax, R], env: Env, x: SyntaxExpr): Index is
        let left: SyntaxExpr := exprOf(&~s, x.a);
        let right: SyntaxExpr := exprOf(&~s, x.b);
        let op: Index := x.c;
        if isLoopPath(&~s, left) and (right.op = syntaxInteger) then
            let number: Index := loopNumber(&~s, env, left);
            let literal: Index := numeric(&~s, env, x.b);
            return compareExpr(&~s, op, number, literal, x);
        end if;
        if (left.op = syntaxInteger) and isLoopPath(&~s, right) then
            let number: Index := loopNumber(&~s, env, right);
            let literal: Index := numeric(&~s, env, x.a);
            return compareExpr(&~s, mirrored(op), number, literal, x);
        end if;
        let leftName: Bool := isNameLike(&~s, env, x.a);
        let rightName: Bool := isNameLike(&~s, env, x.b);
        if leftName and (right.op = syntaxString) then
            return textComparison(&~s, env, op, left, right, x);
        end if;
        if (left.op = syntaxString) and rightName then
            return textComparison(&~s, env, op, right, left, x);
        end if;
        if leftName and (right.op = syntaxInteger) then
            let reference: Index := refOfPath(&~s, env, left);
            let literal: Index := numeric(&~s, env, x.b);
            return compareExpr(&~s, op, reference, literal, x);
        end if;
        if (left.op = syntaxInteger) and rightName then
            let reference: Index := refOfPath(&~s, env, right);
            let literal: Index := numeric(&~s, env, x.a);
            return compareExpr(&~s, mirrored(op), reference, literal, x);
        end if;
        let leftNumber: Bool := isNumeric(&~s, x.a);
        let rightNumber: Bool := isNumeric(&~s, x.b);
        if (leftNumber and (rightNumber or rightName)) or (rightNumber and leftName) then
            let a: Index := numeric(&~s, env, x.a);
            let b: Index := numeric(&~s, env, x.b);
            return compareExpr(&~s, op, a, b, x);
        end if;
        fail(&~s, "H7086", x.file, x.line, "only a name compared with a literal, or with a computed number, is supported");
        return 0;
    end;

    generic [R: Region]
    function textComparison(s: &![Syntax, R], env: Env, op: Index, name: SyntaxExpr, literal: SyntaxExpr,
        x: SyntaxExpr): Index is
        if (op /= compareEqual) and (op /= compareNotEqual) then
            fail(&~s, "H7085", name.file, name.line, "a string can only be compared with == and !=");
            return 0;
        end if;
        let reference: Index := refOfPath(&~s, env, name);
        let text: Index := keepName(&~s, literal.a);
        var negated: Int64 := 0;
        if op = compareNotEqual then
            negated := 1;
        end if;
        return addProgramExpr(&~s, makeExpr(exprTextEquals, reference, text, 0, negated, x.file, x.line));
    end;

    -- How a value where a JavaScript expression goes is written: mode 0
    -- by its kind (a text quoted, a number or truth value bare), 1 a
    -- number bare, 2 the text quoted.
    generic [R: Region]
    function scriptValue(s: &![Syntax, R], env: Env, e: Index): ValueExpr is
        let x: SyntaxExpr := exprOf(&~s, e);
        if (x.op = syntaxFilter) and nameIs(&~s, x.b, "safe") and (x.count = 0) then
            let v: ValueExpr := valueOfExpr(&~s, env, x.a);
            return ValueExpr(expr => v.expr, safe => true);
        end if;
        if isLoopPath(&~s, x) then
            let held57: Index := listItem(&~s, x.list + 1);
            let code: Index := loopAttribute(&~s, held57);
            if (code = 5) or (code = 6) then
                let cond: Index := condition(&~s, env, e);
                let yes: Index := textExpr(&~s, fromLiteral(" true "), x.file, x.line);
                let no: Index := textExpr(&~s, fromLiteral(" false "), x.file, x.line);
                return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprCond, cond, yes, no, 0, x.file, x.line)),
                    safe => false);
            end if;
            let number: Index := loopNumber(&~s, env, x);
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprScriptValue, number, 0, 0, 1, x.file, x.line)),
                safe => false);
        end if;
        if (x.op = syntaxPath) or isFunctionCall(&~s, env, e) then
            let reference: Index := refOfPath(&~s, env, x);
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprScriptValue, reference, 0, 0, 0, x.file, x.line)),
                safe => false);
        end if;
        if x.op = syntaxInteger then
            let v: Int64 := literalInt(&~s, x);
            let number: Index := addProgramExpr(&~s, makeExpr(exprInteger, 0, 0, 0, v, x.file, x.line));
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprScriptValue, number, 0, 0, 1, x.file, x.line)),
                safe => false);
        end if;
        if x.op = syntaxBool then
            if x.flag then
                return ValueExpr(expr => textExpr(&~s, fromLiteral(" true "), x.file, x.line), safe => false);
            end if;
            return ValueExpr(expr => textExpr(&~s, fromLiteral(" false "), x.file, x.line), safe => false);
        end if;
        if x.op = syntaxArith then
            let number: Index := numeric(&~s, env, e);
            return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprScriptValue, number, 0, 0, 1, x.file, x.line)),
                safe => false);
        end if;
        let v: ValueExpr := valueOfExpr(&~s, env, e);
        return ValueExpr(expr => addProgramExpr(&~s, makeExpr(exprScriptValue, v.expr, 0, 0, 2, x.file, x.line)),
            safe => false);
    end;

    ---
    --- Statements
    ---

    -- A bind of name to the expression e: the steps before, and the
    -- environment after.  A literal is no step: it stands where the name
    -- does.  releases gets the slot of a computed text, given back at the
    -- end of the scope.
    generic [R: Region, B: Region]
    function bind(s: &![Syntax, R], env: Env, valuesEnv: Env, name: Index, e: Index, file: Index, line: Index,
        releases: &![Buffer[Index], B]): Env is
        let sub: Index := substitute(&~s, valuesEnv, e);
        let x: SyntaxExpr := exprOf(&~s, sub);
        if (x.op = syntaxString) or (x.op = syntaxInteger) or (x.op = syntaxBool) then
            return bindName(&~s, env, name, 0, bindLiteral, sub, file, line);
        end if;
        let slot: Index := newSlot(&~s);
        var kind: Index := bindText;
        var expr: Index := 0;
        -- loop.cycle and loop.changed are no paths to bind; asked only of a
        -- path of loop, whose second part is there.
        var loopFlag: Bool := false;
        if isLoopPath(&~s, x) then
            let attribute: Index := listItem(&~s, x.list + 1);
            loopFlag := loopAttribute(&~s, attribute) >= 5;
        end if;
        if (x.op = syntaxPath) and (not isNumeric(&~s, sub)) and (not loopFlag) then
            kind := bindReference;
            expr := refOfPath(&~s, valuesEnv, x);
        else if isNumeric(&~s, sub) then
            kind := bindNumber;
            expr := numeric(&~s, valuesEnv, sub);
        else
            let v: ValueExpr := valueOfExpr(&~s, valuesEnv, sub);
            expr := v.expr;
            if v.safe then
                kind := bindMarkup;
            end if;
            insertBack(&~releases, slot);
        end if;
        var step: Step := makeStep(stepBind, slot, expr, kind, file, line);
        let at: Index := emit(&~s, step);
        return bindName(&~s, env, name, slot, kind, 0, file, line);
    end;

    -- The text a body writes, kept in a slot of its own: the body starts
    -- in HTML text and must end there.  The slot.
    generic [R: Region]
    function capture(s: &![Syntax, R], env: Env, list: Index, count: Index, file: Index, line: Index): Index is
        let begin: Index := emit(&~s, makeStep(stepCaptureBegin, 0, 0, 0, file, line));
        var inner: Env := env;
        inner.inBranch := false;
        let ended: Context := generateList(&~s, inner, textContext(), list, count);
        if not isHtmlText(&ended) then
            let place: String := describeContext(&ended);
            failText(&~s, "H7111", file, line, joined(
                "a {% set %} or {% filter %} block stands in HTML text and ends there; this one ends in ",
                asSpan(&place), ""));
            destroyString(place);
        end if;
        destroyContext(ended);
        let slot: Index := newSlot(&~s);
        let finish: Index := emit(&~s, makeStep(stepCaptureEnd, slot, 0, 0, file, line));
        return slot;
    end;

    generic [R: Region]
    function generateList(s: &![Syntax, R], env: Env, context: Context, list: Index, count: Index): Context is
        var place: Context := context;
        var here: Env := env;
        var releases: Buffer[Index] := allocateEmpty();
        var i: Index := 0;
        while (i < count) and (not hasFailed(&~s)) do
            let at: Index := listItem(&~s, list + i);
            let node: SyntaxNode := nodeOf(&~s, at);
            if (node.kind = nodeSet) or (node.kind = nodeSetBlock) then
                if here.inBranch then
                    let name: String := nameCopy(&~s, node.a);
                    var out: StringBuilder := makeStringBuilder();
                    writeString(&!out, "{% set ");
                    writeString(&!out, asSpan(&name));
                    writeString(&!out,
                        " %} inside an {% if %} is refused: in Jinja2 the name is still there after the {% endif %} when the branch ran, and missing when it did not, which a compiled template cannot follow; set it before the {% if %}, or use {% with %}");
                    destroyString(name);
                    failText(&~s, "H7110", node.file, node.line, finalize(out));
                else if node.kind = nodeSet then
                    here := bind(&~s, here, here, node.a, node.b, node.file, node.line, &!releases);
                else
                    let slot: Index := capture(&~s, here, node.list1, node.count1, node.file, node.line);
                    here := bindName(&~s, here, node.a, slot, bindMarkup, 0, node.file, node.line);
                    insertBack(&!releases, slot);
                end if;
            else if node.kind = nodeCatalog then
                if here.catalog /= 0 then
                    fail(&~s, "H7121", node.file, node.line, "a template names its catalog once, with one {% catalog %}");
                else
                    let found: Index := catalogIndex(&~s, node.a);
                    if found >= catalogNamesCount(&~s) then
                        let held60: String := tagText(&~s, "there is no catalog named ", node.a,
                            ": the application gives the catalogs a template may name");
                        failText(&~s, "V0007", node.file, node.line, held60);
                    else
                        here.catalog := found + 1;
                    end if;
                end if;
            else
                place := generateNode(&~s, here, place, at);
            end if;
            i := i + 1;
        end while;
        var k: Index := length(&releases);
        while k > 0 do
            k := k - 1;
            let released: Index := emit(&~s, makeStep(stepRelease, nth(&releases, k), 0, 0, 0, 0));
        end while;
        destroyFree(releases);
        return place;
    end;

    generic [R: Region]
    function catalogIndex(s: &![Syntax, R], name: Index): Index is
        let total: Index := catalogNamesCount(&~s);
        let text: String := nameCopy(&~s, name);
        var i: Index := 0;
        while i < total do
            if catalogNamesEquals(&~s, i, asSpan(&text)) then
                destroyString(text);
                return i;
            end if;
            i := i + 1;
        end while;
        destroyString(text);
        return total;
    end;

    -- The writer of the place, or a failure: no escaping makes a value
    -- safe there.
    generic [R: Region, C: Region]
    function writerHere(s: &![Syntax, R], context: &[Context, C], file: Index, line: Index): Option[Writer] is
        case writerOf(context) of
            when Some(value as writer: Writer) do
                return Some(value => writer);
            when None do
                let place: String := describeContext(context);
                failText(&~s, "H7067", file, line, joined("a value cannot stand in ", asSpan(&place),
                    ": there is no escaping that makes that safe"));
                destroyString(place);
                return None();
        end case;
    end;

    function isScriptWriter(writer: Writer): Bool is
        case writer of
            when ScriptWriter do
                return true;
            when ScriptAttributeWriter do
                return true;
            when HtmlWriter do
                return false;
            when UrlWriter do
                return false;
            when UrlPathWriter do
                return false;
            when UrlQueryWriter do
                return false;
            when JsStringWriter do
                return false;
            when JsStringAttributeWriter do
                return false;
            when CssValueWriter do
                return false;
            when CssValueAttributeWriter do
                return false;
            when CssStringWriter do
                return false;
            when CssStringAttributeWriter do
                return false;
        end case;
    end;

    -- A value written at the place: escaped by the place's writer, or as it
    -- is when it is |safe.
    generic [R: Region]
    function output(s: &![Syntax, R], env: Env, context: Context, e: Index, file: Index, line: Index): Context is
        let sub: Index := substitute(&~s, env, e);
        case writerHere(&~s, &context, file, line) of
            when Some(value as writer: Writer) do
                let x: SyntaxExpr := exprOf(&~s, sub);
                if isMarkupName(&~s, env, x) and (not isHtmlText(&context)) then
                    let place: String := describeContext(&context);
                    failText(&~s, "H7113", file, line, joined(
                        "the text of a {% set %} block is HTML, escaped already, and is printed in HTML text only, not in ",
                        asSpan(&place), ""));
                    destroyString(place);
                    return context;
                end if;
                if isScriptWriter(writer) then
                    let v: ValueExpr := scriptValue(&~s, env, sub);
                    var step: Step := makeStep(stepOut, v.expr, 0, 0, file, line);
                    step.writer := writer;
                    step.raw := v.safe;
                    let at: Index := emit(&~s, step);
                    return afterScriptValue(context);
                end if;
                let v: ValueExpr := valueOfExpr(&~s, env, sub);
                var step: Step := makeStep(stepOut, v.expr, 0, 0, file, line);
                step.writer := writer;
                step.raw := v.safe;
                step.inText := isHtmlText(&context);
                let at: Index := emit(&~s, step);
                return context;
            when None do
                return context;
        end case;
    end;

    generic [R: Region]
    function generateNode(s: &![Syntax, R], env: Env, context: Context, at: Index): Context is
        let node: SyntaxNode := nodeOf(&~s, at);
        let k: Nat8 := node.kind;
        if k = nodeText then
            let text: String := nameCopy(&~s, node.a);
            s->textBytes := s->textBytes + spanLength(asSpan(&text));
            if s->textBytes > mostTextBytes() then
                destroyString(text);
                fail(&~s, "V0013", node.file, node.line,
                    "the text of the template comes to more than 16 MiB, its macros and includes expanded");
                return context;
            end if;
            let after: Context := advanceContext(context, asSpan(&text));
            let kept: Index := keepText(&~s, text);
            let step: Index := emit(&~s, makeStep(stepText, kept, 0, 0, node.file, node.line));
            return after;
        end if;
        if k = nodeOut then
            let x: SyntaxExpr := exprOf(&~s, node.a);
            if (node.a /= 0) and (x.op = syntaxCall) then
                if nameIs(&~s, x.b, "caller") then
                    if x.count /= 0 then
                        fail(&~s, "H7112", node.file, node.line, "caller() takes no arguments");
                        return context;
                    end if;
                    if env.caller = 0 then
                        fail(&~s, "H7112", node.file, node.line, "caller() stands in a macro that a {% call %} block calls");
                        return context;
                    end if;
                    let c: Caller := callerOf(&~s, env.caller);
                    return generateList(&~s, c.env, context, c.content, c.count);
                end if;
                if not nameIs(&~s, x.b, "loop.cycle") then
                    return expandMacro(&~s, env, context, node.a, 0, 0, false, node.file, node.line);
                end if;
            end if;
            if (node.a /= 0) and (x.op = syntaxTrans) then
                return translation(&~s, env, context, x);
            end if;
            return output(&~s, env, context, node.a, node.file, node.line);
        end if;
        if k = nodeCallBlock then
            -- The call's expression is rebuilt from the node: name and
            -- arguments.
            var call: SyntaxExpr := blankExpr(syntaxCall, node.file, node.line);
            call.b := node.a;
            call.list := node.list1;
            call.count := node.count1;
            let e: Index := addExpr(&~s, call);
            return expandMacro(&~s, env, context, e, node.list2, node.count2, true, node.file, node.line);
        end if;
        if k = nodeScope then
            var inner: Env := env;
            if not node.flag then
                inner.vars := outsideLoops(&~s, env);
                inner.loops := indexOf0();
                inner.loopDepth := indexOf0();
            end if;
            inner.inBranch := false;
            return generateList(&~s, inner, context, node.list1, node.count1);
        end if;
        if k = nodeIncluded then
            var inner: Env := env;
            inner.loops := indexOf0();
            inner.inBranch := false;
            return generateList(&~s, inner, context, node.list1, node.count1);
        end if;
        if k = nodeWith then
            return generateWith(&~s, env, context, node);
        end if;
        if k = nodeFilterBlock then
            return generateFilterBlock(&~s, env, context, node);
        end if;
        if k = nodeIf then
            return generateIf(&~s, env, context, node);
        end if;
        if k = nodeFor then
            return generateFor(&~s, env, context, node);
        end if;
        fail(&~s, "V0010", node.file, node.line, "an unresolved tag reached the generator");
        return context;
    end;

    -- Every value is taken where the with stands; the names are seen in
    -- its body only.
    generic [R: Region]
    function generateWith(s: &![Syntax, R], env: Env, context: Context, node: SyntaxNode): Context is
        var inner: Env := env;
        var releases: Buffer[Index] := allocateEmpty();
        var i: Index := 0;
        while i < node.count1 do
            let name: Index := listItem(&~s, node.list1 + (2 * i));
            let e: Index := listItem(&~s, node.list1 + (2 * i) + 1);
            inner := bind(&~s, inner, env, name, e, node.file, node.line, &!releases);
            i := i + 1;
        end while;
        inner.inBranch := false;
        let after: Context := generateList(&~s, inner, context, node.list2, node.count2);
        var k: Index := length(&releases);
        while k > 0 do
            k := k - 1;
            let released: Index := emit(&~s, makeStep(stepRelease, nth(&releases, k), 0, 0, node.file, node.line));
        end while;
        destroyFree(releases);
        return after;
    end;

    -- The filters a {% filter %} block applies to what it wrote, escaped
    -- already: those that need no escaping undone.
    generic [R: Region]
    function generateFilterBlock(s: &![Syntax, R], env: Env, context: Context, node: SyntaxNode): Context is
        if not isHtmlText(&context) then
            let place: String := describeContext(&context);
            failText(&~s, "H7111", node.file, node.line, joined(
                "a {% set %} or {% filter %} block stands in HTML text and ends there; this one stands in ",
                asSpan(&place), ""));
            destroyString(place);
            return context;
        end if;
        let slot: Index := capture(&~s, env, node.list2, node.count2, node.file, node.line);
        let rest: Index := programListLength(&~s);
        var v: Index := addProgramExpr(&~s, makeExpr(exprSlot, slot, rest, 0, 0, node.file, node.line));
        var i: Index := 0;
        while i < node.count1 do
            let held61: Index := listItem(&~s, node.list1 + i);
            let spec: SyntaxNode := nodeOf(&~s, held61);
            let plainE: Bool := nameIsEither(&~s, spec.a, "e", "escape");
            let plainSafe: Bool := nameIs(&~s, spec.a, "safe");
            let plain: Bool := plainE or plainSafe;
            let code: Index := filterCode(&~s, spec.a);
            if plain and (spec.count1 = 0) then
                skip;
            else if (code <= filterTitle) and (spec.count1 = 0) then
                v := addProgramExpr(&~s, makeExpr(exprFilter, v, 0, code, 0, node.file, node.line));
            else if (code >= filterReplace) and (code <= filterCenter) then
                var standIn: SyntaxExpr := blankExpr(syntaxFilter, node.file, node.line);
                standIn.b := spec.a;
                standIn.list := spec.list1;
                standIn.count := spec.count1;
                v := filterWithArguments(&~s, standIn, code, v);
            else
                let held62: String := tagText(&~s, "the filter |", spec.a,
                    " cannot stand in {% filter %}: it applies to a value, not to written text");
                failText(&~s, "H7109", node.file, node.line, held62);
            end if;
            i := i + 1;
        end while;
        var step: Step := makeStep(stepOut, v, 0, 0, node.file, node.line);
        step.raw := true;
        step.inText := true;
        let at: Index := emit(&~s, step);
        let released: Index := emit(&~s, makeStep(stepRelease, slot, 0, 0, node.file, node.line));
        return context;
    end;

    generic [R: Region]
    function generateIf(s: &![Syntax, R], env: Env, context: Context, node: SyntaxNode): Context is
        var branchEnv: Env := env;
        branchEnv.inBranch := true;
        var jumps: Buffer[Index] := allocateEmpty();
        var first: Option[Context] := None();
        var i: Index := 0;
        while i < node.count1 do
            let held63: Index := listItem(&~s, node.list1 + i);
            let branch: SyntaxNode := nodeOf(&~s, held63);
            let held64: Index := substitute(&~s, branchEnv, branch.a);
            let cond: Index := condition(&~s, branchEnv, held64);
            let unless: Index := emit(&~s, makeStep(stepUnless, cond, 0, 0, branch.file, branch.line));
            let ended: Context := generateList(&~s, branchEnv, copyContext(&context), branch.list1, branch.count1);
            insertBack(&!jumps, emit(&~s, makeStep(stepJump, 0, 0, 0, branch.file, branch.line)));
            patchB(&~s, unless);
            first := keepFirst(&~s, first, ended, node);
            i := i + 1;
        end while;
        let ended: Context := generateList(&~s, branchEnv, copyContext(&context), node.list2, node.count2);
        first := keepFirst(&~s, first, ended, node);
        var j: Index := 0;
        while j < length(&jumps) do
            patchA(&~s, nth(&jumps, j));
            j := j + 1;
        end while;
        destroyFree(jumps);
        case first of
            when Some(value as kept: Context) do
                destroyContext(context);
                return kept;
            when None do
                return context;
        end case;
    end;

    -- The first place a branch ended in, and every later one compared
    -- with it.
    generic [R: Region]
    function keepFirst(s: &![Syntax, R], first: Option[Context], ended: Context, node: SyntaxNode): Option[Context] is
        case first of
            when Some(value as kept: Context) do
                if not sameContext(&kept, &ended) then
                    let a: String := describeContext(&kept);
                    let b: String := describeContext(&ended);
                    var out: StringBuilder := makeStringBuilder();
                    writeString(&!out, "the branches of this {% if %} end in different places in the HTML: ");
                    writeString(&!out, asSpan(&a));
                    writeString(&!out, " and ");
                    writeString(&!out, asSpan(&b));
                    destroyString(a);
                    destroyString(b);
                    let held65: Index := listItem(&~s, node.list1);
                    let branch: SyntaxNode := nodeOf(&~s, held65);
                    failText(&~s, "H7095", branch.file, branch.line, finalize(out));
                end if;
                destroyContext(ended);
                return Some(value => kept);
            when None do
                return Some(value => ended);
        end case;
    end;

    -- The names of a for bound to slots, one for each name.
    generic [R: Region]
    function forNames(s: &![Syntax, R], env: Env, node: SyntaxNode, slots: Index): Env is
        var made: Env := env;
        made.loopDepth := env.loopDepth + 1;
        var i: Index := 0;
        while i < node.count1 do
            let held66: Index := listItem(&~s, node.list1 + i);
            made := bindName(&~s, made, held66, slots + i, bindReference, 0, node.file, node.line);
            i := i + 1;
        end while;
        made.loopDepth := env.loopDepth;
        return made;
    end;

    generic [R: Region]
    function generateFor(s: &![Syntax, R], env: Env, context: Context, node: SyntaxNode): Context is
        let sequence: Index := substitute(&~s, env, node.a);
        if not isNameLike(&~s, env, sequence) then
            fail(&~s, "H7096", node.file, node.line, "{% for %} walks over a name of the data only");
            return context;
        end if;
        let held67: SyntaxExpr := exprOf(&~s, sequence);
        let seq: Index := refOfPath(&~s, env, held67);
        let loop: Index := newLoop(&~s);
        let slots: Index := s->slots;
        var n: Index := 0;
        while n < node.count1 do
            let slot: Index := newSlot(&~s);
            n := n + 1;
        end while;
        let slotList: Index := programListLength(&~s);
        var m: Index := 0;
        while m < node.count1 do
            pushProgramItem(&~s, slots + m);
            m := m + 1;
        end while;
        -- The names, seen in the condition and the body; the body also sees
        -- the loop.
        let named: Env := forNames(&~s, env, node, slots);
        var content: Env := named;
        content.loopDepth := env.loopDepth + 1;
        content.loops := addLink(&~s, true, Link(value => loop, parent => env.loops));
        content.inBranch := false;
        var condEnv: Env := named;
        condEnv.inBranch := false;
        let conditional: Bool := node.b /= 0;
        var cond: Index := 0;
        if conditional then
            let held68: Index := substitute(&~s, condEnv, node.b);
            cond := condition(&~s, condEnv, held68);
        end if;
        var flag: Index := 0;
        if conditional then
            flag := 1;
        end if;
        let entered: Index := emit(&~s, makeStep(stepForEnter, loop, seq, flag, node.file, node.line));
        if conditional then
            -- Jinja2 counts only the elements the condition lets through:
            -- they are counted first, then walked.
            let countAt: Index := stepTotal(&~s);
            var item: Step := makeStep(stepForItem, loop, 0, slotList, node.file, node.line);
            item.d := node.count1;
            let itemAt: Index := emit(&~s, item);
            let skipAt: Index := emit(&~s, makeStep(stepUnless, cond, 0, 0, node.file, node.line));
            let counted: Index := emit(&~s, makeStep(stepForCount, loop, 0, 0, node.file, node.line));
            patchB(&~s, skipAt);
            let stepped: Index := emit(&~s, makeStep(stepForStep, loop, countAt, 0, node.file, node.line));
            patchB(&~s, itemAt);
            let restarted: Index := emit(&~s, makeStep(stepForRestart, loop, 0, 0, node.file, node.line));
        end if;
        var emptyAt: Index := 0;
        let hasEmpty: Bool := node.count3 > 0;
        if hasEmpty then
            emptyAt := emit(&~s, makeStep(stepIfEmpty, loop, 0, 0, node.file, node.line));
        end if;
        let walkAt: Index := stepTotal(&~s);
        var walkItem: Step := makeStep(stepForItem, loop, 0, slotList, node.file, node.line);
        walkItem.d := node.count1;
        let walkItemAt: Index := emit(&~s, walkItem);
        var walkSkip: Index := 0;
        if conditional then
            walkSkip := emit(&~s, makeStep(stepUnless, cond, 0, 0, node.file, node.line));
        end if;
        let ended: Context := generateList(&~s, content, copyContext(&context), node.list2, node.count2);
        if not sameContext(&ended, &context) then
            let a: String := describeContext(&context);
            let b: String := describeContext(&ended);
            var out: StringBuilder := makeStringBuilder();
            writeString(&!out, "the body of this {% for %} ends in a different place in the HTML than it begins: ");
            writeString(&!out, asSpan(&a));
            writeString(&!out, " and ");
            writeString(&!out, asSpan(&b));
            destroyString(a);
            destroyString(b);
            failText(&~s, "H7097", node.file, node.line, finalize(out));
        end if;
        destroyContext(ended);
        var forward: Step := makeStep(stepForStep, loop, walkAt, 1, node.file, node.line);
        let forwardAt: Index := emit(&~s, forward);
        if conditional then
            patchB(&~s, walkSkip);
            let skipped: Index := emit(&~s, makeStep(stepForStep, loop, walkAt, 0, node.file, node.line));
        end if;
        patchB(&~s, walkItemAt);
        if hasEmpty then
            let over: Index := emit(&~s, makeStep(stepJump, 0, 0, 0, node.file, node.line));
            patchB(&~s, emptyAt);
            let emptyEnded: Context := generateList(&~s, env, copyContext(&context), node.list3, node.count3);
            if not sameContext(&emptyEnded, &context) then
                fail(&~s, "H7098", node.file, node.line,
                    "the {% else %} of this {% for %} ends in a different place in the HTML than it begins");
            end if;
            destroyContext(emptyEnded);
            patchA(&~s, over);
        end if;
        return context;
    end;

    -- The macro a call names, looked for in the import of the macro being
    -- expanded first: macroCount when there is none.
    generic [R: Region, N: Region]
    function macroFor(s: &![Syntax, R], env: Env, name: Span[Nat8, N]): Index is
        var dotted: Bool := false;
        var i: Index := 0;
        while i < spanLength(name) do
            if name[i] = '.' then
                dotted := true;
            end if;
            i := i + 1;
        end while;
        if (env.space /= 0) and (not dotted) then
            let space: String := nameCopy(&~s, env.space);
            let key: String := joined(asSpan(&space), ".", name);
            destroyString(space);
            let found: Index := macroKeyed(&~s, asSpan(&key));
            destroyString(key);
            if found < macroCount(&~s) then
                return found;
            end if;
        end if;
        return macroKeyed(&~s, name);
    end;

    -- Whether key is among the macros being expanded.
    generic [R: Region]
    function calling(s: &![Syntax, R], env: Env, key: Index): Bool is
        var at: Index := env.calling;
        while at /= 0 do
            let link: Link := linkOf(&~s, false, at);
            if sameNames(&~s, link.value, key) then
                return true;
            end if;
            at := link.parent;
        end while;
        return false;
    end;

    -- a -> b -> key: the macros being expanded, the outermost first.
    generic [R: Region]
    function callingText(s: &![Syntax, R], env: Env, key: Index): String is
        var keys: Buffer[Index] := allocateEmpty();
        var at: Index := env.calling;
        while at /= 0 do
            let link: Link := linkOf(&~s, false, at);
            insertBack(&!keys, link.value);
            at := link.parent;
        end while;
        var out: StringBuilder := makeStringBuilder();
        var k: Index := length(&keys);
        while k > 0 do
            k := k - 1;
            let part: String := nameCopy(&~s, nth(&keys, k));
            writeString(&!out, asSpan(&part));
            destroyString(part);
            writeString(&!out, " -> ");
        end while;
        destroyFree(keys);
        let last: String := nameCopy(&~s, key);
        writeString(&!out, asSpan(&last));
        destroyString(last);
        return finalize(out);
    end;

    -- A macro expanded where it is called: its parameters bound to the
    -- arguments (a name as a reference, a literal put where the parameter
    -- stands), its body generated with the template's data and (not the)
    -- caller's loop variables, as in Jinja2.  A name that is no macro but
    -- a function the application gave is written as a value.
    generic [R: Region]
    function expandMacro(s: &![Syntax, R], env: Env, context: Context, e: Index, callerBody: Index,
        callerCount: Index, isCallBlock: Bool, file: Index, line: Index): Context is
        let x: SyntaxExpr := exprOf(&~s, e);
        let name: String := nameCopy(&~s, x.b);
        let found: Index := macroFor(&~s, env, asSpan(&name));
        if found >= macroCount(&~s) then
            var dotted: Bool := false;
            var i: Index := 0;
            while i < spanLength(asSpan(&name)) do
                if byteAt(&name, i) = '.' then
                    dotted := true;
                end if;
                i := i + 1;
            end while;
            if dotted then
                failText(&~s, "H7022", file, line, joined("calling ", asSpan(&name),
                    ": there is no such macro; the part before the dot is not a name an {% import ... as %} gave, or the file has no macro of that name"));
                destroyString(name);
                return context;
            end if;
            if (not isCallBlock) and isFunctionCall(&~s, env, e) then
                destroyString(name);
                return output(&~s, env, context, e, file, line);
            end if;
            failText(&~s, "H7089", file, line, joined("there is no macro ", asSpan(&name), ""));
            destroyString(name);
            return context;
        end if;
        destroyString(name);
        let m: Macro := macroOf(&~s, found);
        if calling(&~s, env, m.key) then
            let chain: String := callingText(&~s, env, m.key);
            let keyText: String := nameCopy(&~s, m.key);
            var out: StringBuilder := makeStringBuilder();
            writeString(&!out, "the macro ");
            writeString(&!out, asSpan(&keyText));
            writeString(&!out, " calls itself: ");
            writeString(&!out, asSpan(&chain));
            writeString(&!out, "; a template is expanded when the programme is compiled, and a recursion would not end");
            destroyString(chain);
            destroyString(keyText);
            failText(&~s, "H7090", file, line, finalize(out));
            return context;
        end if;
        if env.callDepth >= mostDepth() then
            fail(&~s, "V0008", file, line, "macros call one another more than 16 deep");
            return context;
        end if;
        if x.count > m.paramCount then
            let keyText: String := nameCopy(&~s, m.key);
            let total: String := displayIndex(m.paramCount);
            var out: StringBuilder := makeStringBuilder();
            writeString(&!out, "the macro ");
            writeString(&!out, asSpan(&keyText));
            writeString(&!out, " takes ");
            writeString(&!out, asSpan(&total));
            writeString(&!out, " arguments");
            destroyString(keyText);
            destroyString(total);
            failText(&~s, "H7091", file, line, finalize(out));
            return context;
        end if;
        var macroEnv: Env := Env(vars => 0, loops => 0, loopDepth => 1, calling => 0, callDepth => env.callDepth + 1,
            seesData => env.seesData and (not m.imported), space => m.space, caller => 0, inBranch => false,
            catalog => env.catalog);
        var k: Index := 0;
        while k < m.paramCount do
            let held69: Index := listItem(&~s, m.params + k);
            let param: SyntaxNode := nodeOf(&~s, held69);
            var argument: Index := param.b;
            if k < x.count then
                let held70: Index := listItem(&~s, x.list + k);
                argument := substitute(&~s, env, held70);
            end if;
            if argument = 0 then
                let keyText: String := nameCopy(&~s, m.key);
                let paramText: String := nameCopy(&~s, param.a);
                var out: StringBuilder := makeStringBuilder();
                writeString(&!out, "the macro ");
                writeString(&!out, asSpan(&keyText));
                writeString(&!out, " needs a value for ");
                writeString(&!out, asSpan(&paramText));
                destroyString(keyText);
                destroyString(paramText);
                failText(&~s, "H7092", file, line, finalize(out));
                return context;
            end if;
            let a: SyntaxExpr := exprOf(&~s, argument);
            if a.op = syntaxPath then
                let slot: Index := newSlot(&~s);
                let reference: Index := refOfPath(&~s, env, a);
                let bound: Index := emit(&~s, makeStep(stepBind, slot, reference, bindReference, file, line));
                macroEnv := bindName(&~s, macroEnv, param.a, slot, bindReference, 0, file, line);
            else if (a.op = syntaxString) or (a.op = syntaxInteger) or (a.op = syntaxBool) then
                macroEnv := bindName(&~s, macroEnv, param.a, 0, bindLiteral, argument, file, line);
            else
                fail(&~s, "H7093", a.file, a.line, "a macro argument is a name or a literal");
                return context;
            end if;
            k := k + 1;
        end while;
        macroEnv.loopDepth := indexOf0();
        macroEnv.calling := addLink(&~s, false, Link(value => m.key, parent => env.calling));
        if isCallBlock then
            macroEnv.caller := addCaller(&~s, Caller(content => callerBody, count => callerCount, env => env));
        end if;
        return generateList(&~s, macroEnv, context, m.content, m.bodyCount);
    end;

    -- A translation: the catalog of the template asked for the key in the
    -- language of the data's lang, with the arguments by name and the
    -- count, and the text written with the escaping of its place.
    generic [R: Region]
    function translation(s: &![Syntax, R], env: Env, context: Context, x: SyntaxExpr): Context is
        if env.catalog = 0 then
            fail(&~s, "H7122", x.file, x.line, "a translation needs the template's catalog: {% catalog name %} before it");
            return context;
        end if;
        case writerHere(&~s, &context, x.file, x.line) of
            when Some(value as writer: Writer) do
                if isScriptWriter(writer) then
                    let place: String := describeContext(&context);
                    failText(&~s, "H7123", x.file, x.line, joined("a translation is text for HTML and cannot stand in ",
                        asSpan(&place), ""));
                    destroyString(place);
                    return context;
                end if;
                var count: Index := 0;
                var values: Buffer[Index] := allocateEmpty();
                var i: Index := 0;
                while i < x.count do
                    let name: Index := listItem(&~s, x.list + (2 * i));
                    let held71: Index := listItem(&~s, x.list + (2 * i) + 1);
                    let e: Index := substitute(&~s, env, held71);
                    let v: ValueExpr := valueOfExpr(&~s, env, e);
                    insertBack(&!values, keepName(&~s, name));
                    insertBack(&!values, v.expr);
                    if nameIs(&~s, name, "count") then
                        count := numeric(&~s, env, e) + 1;
                    end if;
                    i := i + 1;
                end while;
                var langPath: SyntaxExpr := blankExpr(syntaxPath, x.file, x.line);
                let held72: Index := addName(&~s, fromLiteral("lang"));
                langPath.list := single(&~s, held72);
                langPath.count := indexOf1();
                let lang: Index := refOfPath(&~s, env, langPath);
                let start: Index := programListLength(&~s);
                let held73: Index := keepName(&~s, x.b);
                pushProgramItem(&~s, held73);
                pushProgramItem(&~s, lang);
                pushProgramItem(&~s, count);
                var k: Index := 0;
                while k < length(&values) do
                    pushProgramItem(&~s, nth(&values, k));
                    k := k + 1;
                end while;
                destroyFree(values);
                let made: Index := addProgramExpr(&~s, makeExpr(exprTranslate, env.catalog - 1, start, x.count, 0,
                    x.file, x.line));
                var step: Step := makeStep(stepOut, made, 0, 0, x.file, x.line);
                step.writer := writer;
                step.inText := isHtmlText(&context);
                let at: Index := emit(&~s, step);
                return context;
            when None do
                return context;
        end case;
    end;

    ---
    --- The program
    ---

    record Program: Linear is
        steps: Buffer[Step];
        exprs: Buffer[Expr];
        lists: Buffer[Index];
        texts: Buffer[String];
        fileNames: Buffer[String];
        paths: Buffer[String];
        slots: Index;
        loops: Index;
        invariant length(&steps) <= 200000;
        invariant length(&fileNames) <= 64;
        invariant length(&paths) <= 64;
    end;

    function destroyStrings(strings: Buffer[String]): Unit is
        var rest: Buffer[String] := strings;
        while length(&rest) > 0 do
            destroyString(removeLast(&!rest));
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    generic [B: Region]
    function copyStrings(strings: &[Buffer[String], B]): Buffer[String] is
        var out: Buffer[String] := allocateEmpty();
        var i: Index := 0;
        while i < length(strings) do
            insertBack(&!out, fromSpan(asSpan(nthRef(strings, i))));
            i := i + 1;
        end while;
        return out;
    end;

    function destroyProgram(program: Program): Unit is
        let { steps: Buffer[Step], exprs: Buffer[Expr], lists: Buffer[Index], texts: Buffer[String],
            fileNames: Buffer[String], paths: Buffer[String], slots: Index, loops: Index } := program;
        destroyFree(steps);
        destroyFree(exprs);
        destroyFree(lists);
        destroyStrings(texts);
        destroyStrings(fileNames);
        destroyStrings(paths);
        return nil;
    end;

    generic [D: Region, F: Region, C: Region]
    function makeSyntax(directories: &[Buffer[String], D], functions: &[Buffer[String], F],
        catalogs: &[Buffer[String], C], trimBlocks: Bool, lstripBlocks: Bool): Syntax is
        var names: Buffer[String] := allocateEmpty();
        insertBack(&!names, makeEmpty());
        var nodes: Buffer[SyntaxNode] := allocateEmpty();
        insertBack(&!nodes, blankNode(0, 0, 0));
        var exprs: Buffer[SyntaxExpr] := allocateEmpty();
        insertBack(&!exprs, blankExpr(0, 0, 0));
        var bindings: Buffer[Binding] := allocateEmpty();
        insertBack(&!bindings, Binding(name => 0, slot => 0, kind => 0, literal => 0, depth => 0, parent => 0));
        var loopLinks: Buffer[Link] := allocateEmpty();
        insertBack(&!loopLinks, Link(value => 0, parent => 0));
        var callingLinks: Buffer[Link] := allocateEmpty();
        insertBack(&!callingLinks, Link(value => 0, parent => 0));
        let none: Env := Env(vars => 0, loops => 0, loopDepth => 0, calling => 0, callDepth => 0, seesData => true,
            space => 0, caller => 0, inBranch => false, catalog => 0);
        var callers: Buffer[Caller] := allocateEmpty();
        insertBack(&!callers, Caller(content => 0, count => 0, env => none));
        var programExprs: Buffer[Expr] := allocateEmpty();
        insertBack(&!programExprs, makeExpr(0, 0, 0, 0, 0, 0, 0));
        return Syntax(names => names, nodes => nodes, exprs => exprs, lists => allocateEmpty(),
            chunks => allocateEmpty(), chunkAt => 0, tokens => allocateEmpty(), tokenAt => 0, tagLine => 0,
            tagFile => 0, nesting => 0, textBytes => 0, directories => copyStrings(directories), fileNames => allocateEmpty(),
            fileTrees => allocateEmpty(), fileTreeCounts => allocateEmpty(), paths => allocateEmpty(),
            macros => allocateEmpty(), usedBlocks => allocateEmpty(), definedNames => allocateEmpty(),
            definedNodes => allocateEmpty(), spaceNames => allocateEmpty(), spaceFiles => allocateEmpty(),
            overrides => allocateEmpty(), trimBlocks => trimBlocks, lstripBlocks => lstripBlocks, failed => false,
            failures => allocateEmpty(), steps => allocateEmpty(), programExprs => programExprs,
            programLists => allocateEmpty(), texts => allocateEmpty(), bindings => bindings, loopLinks => loopLinks,
            callingLinks => callingLinks, callers => callers, slots => 0, loops => 0,
            functionNames => copyStrings(functions), catalogNames => copyStrings(catalogs));
    end;

    -- The syntax given back: the program when nothing failed, the first
    -- failure when something did.
    function finishSyntax(syntax: Syntax): Either[String, Program] is
        let { names: Buffer[String], nodes: Buffer[SyntaxNode], exprs: Buffer[SyntaxExpr], lists: Buffer[Index],
            chunks: Buffer[Chunk], chunkAt: Index, tokens: Buffer[Token], tokenAt: Index, tagLine: Index,
            tagFile: Index, nesting: Index, textBytes: Index, directories: Buffer[String], fileNames: Buffer[String],
            fileTrees: Buffer[Index], fileTreeCounts: Buffer[Index], paths: Buffer[String], macros: Buffer[Macro],
            usedBlocks: Buffer[Index], definedNames: Buffer[Index], definedNodes: Buffer[Index],
            spaceNames: Buffer[Index], spaceFiles: Buffer[Index], overrides: Buffer[Override], trimBlocks: Bool,
            lstripBlocks: Bool, failed: Bool, failures: Buffer[String], steps: Buffer[Step],
            programExprs: Buffer[Expr], programLists: Buffer[Index], texts: Buffer[String],
            bindings: Buffer[Binding], loopLinks: Buffer[Link], callingLinks: Buffer[Link], callers: Buffer[Caller],
            slots: Index, loops: Index, functionNames: Buffer[String], catalogNames: Buffer[String] } := syntax;
        destroyStrings(names);
        destroyFree(nodes);
        destroyFree(exprs);
        destroyFree(lists);
        destroyFree(chunks);
        destroyFree(tokens);
        destroyStrings(directories);
        destroyFree(fileTrees);
        destroyFree(fileTreeCounts);
        destroyFree(macros);
        destroyFree(usedBlocks);
        destroyFree(definedNames);
        destroyFree(definedNodes);
        destroyFree(spaceNames);
        destroyFree(spaceFiles);
        destroyFree(overrides);
        destroyFree(bindings);
        destroyFree(loopLinks);
        destroyFree(callingLinks);
        destroyFree(callers);
        destroyStrings(functionNames);
        destroyStrings(catalogNames);
        if failed then
            var rest: Buffer[String] := failures;
            var first: String := makeEmpty();
            if length(&rest) > 0 then
                destroyString(first);
                first := removeFirstString(&!rest);
            end if;
            destroyStrings(rest);
            destroyFree(steps);
            destroyFree(programExprs);
            destroyFree(programLists);
            destroyStrings(texts);
            destroyStrings(fileNames);
            destroyStrings(paths);
            return Left(left => first);
        end if;
        destroyStrings(failures);
        return Right(right => Program(steps => steps, exprs => programExprs, lists => programLists, texts => texts,
            fileNames => fileNames, paths => paths, slots => slots, loops => loops));
    end;

    generic [B: Region]
    function removeFirstString(strings: &![Buffer[String], B]): String is
        return removeFirst(strings);
    end;

    generic [D: Region, F: Region, C: Region, N: Region, L: Region]
    function compileView(directories: &[Buffer[String], D], functions: &[Buffer[String], F],
        catalogs: &[Buffer[String], C], name: Span[Nat8, N], layout: Span[Nat8, L], trimBlocks: Bool,
        lstripBlocks: Bool): Either[String, Program] is
        var syntax: Syntax := makeSyntax(directories, functions, catalogs, trimBlocks, lstripBlocks);
        let entry: Index := addName(&!syntax, fromSpan(name));
        var parent: Index := 0;
        if spanLength(layout) > 0 then
            parent := addName(&!syntax, fromSpan(layout));
        end if;
        let tree: Expanded := resolveAll(&!syntax, entry, parent);
        if not hasFailed(&!syntax) then
            let none: Env := Env(vars => 0, loops => 0, loopDepth => 0, calling => 0, callDepth => 0, seesData => true,
                space => 0, caller => 0, inBranch => false, catalog => 0);
            let ended: Context := generateList(&!syntax, none, textContext(), tree.list, tree.count);
            destroyContext(ended);
        end if;
        return finishSyntax(syntax);
    end;

    generic [R: Region]
    function stepCount(program: &[Program, R]): Index is
        return length(&(program->steps));
    end;

    generic [R: Region]
    function stepAt(program: &[Program, R], at: Index): Step is
        return nth(&(program->steps), at);
    end;

    generic [R: Region]
    function exprCount(program: &[Program, R]): Index is
        return length(&(program->exprs));
    end;

    generic [R: Region]
    function exprAt(program: &[Program, R], at: Index): Expr is
        return nth(&(program->exprs), at);
    end;

    generic [R: Region]
    function listCount(program: &[Program, R]): Index is
        return length(&(program->lists));
    end;

    generic [R: Region]
    function listAt(program: &[Program, R], at: Index): Index is
        return nth(&(program->lists), at);
    end;

    generic [R: Region]
    function textCount(program: &[Program, R]): Index is
        return length(&(program->texts));
    end;

    generic [R: Region]
    function textAt(program: &[Program, R], at: Index): Span[Nat8, R] is
        return asSpan(nthRef(&(program->texts), at));
    end;

    generic [R: Region]
    function slotCount(program: &[Program, R]): Index is
        return program->slots;
    end;

    generic [R: Region]
    function loopCount(program: &[Program, R]): Index is
        return program->loops;
    end;

    generic [R: Region]
    function fileCount(program: &[Program, R]): Index is
        return length(&(program->fileNames));
    end;

    generic [R: Region]
    function fileName(program: &[Program, R], at: Index): Span[Nat8, R] is
        return asSpan(nthRef(&(program->fileNames), at));
    end;

    generic [R: Region]
    function pathCount(program: &[Program, R]): Index is
        return length(&(program->paths));
    end;

    generic [R: Region]
    function pathAt(program: &[Program, R], at: Index): Span[Nat8, R] is
        return asSpan(nthRef(&(program->paths), at));
    end;
end module body.
