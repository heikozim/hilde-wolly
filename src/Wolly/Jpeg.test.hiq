--
-- Part of Wolly, a web framework in Hilde.
--
-- SPDX-FileCopyrightText: 2026 Heiko Zimmermann
-- SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
--
-- The JPEGs here were written by macOS's ImageIO (sips) from pictures made
-- for the test, and decoded by ImageIO again to BMP; each Pixels constant is
-- ImageIO's pixels, red, green and blue row by row from the top.  smooth75
-- is 4:2:0 with a restart every 4 units, smooth100 4:4:4, odd75 37 by 23
-- (units cut at the right and the bottom) with sharp edges, grey75 one
-- component with an ICC profile in APP2.  prog75 and progOdd are the same
-- pictures written progressive (ten scans: DC and AC, first and
-- refinement), orient3, orient5 and orient6 odd75 with that EXIF
-- orientation, and ImageIO turns the pixels as it says.
import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.String (
    String,
    destroyString,
    asSpan,
    length
);
import Standard.Text (
    hexToBytes,
    substring
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Wolly.Jpeg (
    JpegError,
    NotJpeg,
    JpegTooLarge,
    Unsupported,
    JpegBroken,
    JpegPicture,
    readJpeg,
    jpegWidth,
    jpegHeight,
    jpegPixels,
    destroyJpeg
);

module body Wolly.Jpeg.Test is
    constant smooth75Hex: Span[Nat8, Static] := "";
    constant smooth75Pixels: Span[Nat8, Static] := "";
    constant smooth100Hex: Span[Nat8, Static] := "";
    constant smooth100Pixels: Span[Nat8, Static] := "";
    constant odd75Hex: Span[Nat8, Static] := "";
    constant odd75Pixels: Span[Nat8, Static] := "";
    constant grey75Hex: Span[Nat8, Static] := "";
    constant grey75Pixels: Span[Nat8, Static] := "";
    constant prog75Hex: Span[Nat8, Static] := "";
    constant prog75Pixels: Span[Nat8, Static] := "";
    constant progOddHex: Span[Nat8, Static] := "";
    constant progOddPixels: Span[Nat8, Static] := "";
    constant orient6Hex: Span[Nat8, Static] := "";
    constant orient6Pixels: Span[Nat8, Static] := "";
    constant orient3Hex: Span[Nat8, Static] := "";
    constant orient3Pixels: Span[Nat8, Static] := "";
    constant orient5Hex: Span[Nat8, Static] := "";
    constant orient5Pixels: Span[Nat8, Static] := "";

    function bytesOf(hex: Span[Nat8, Static]): String is
        case hexToBytes(hex) of
            when Some(value as bytes: String) do
                return bytes;
            when None do
                assertTrue(false, "the fixture is hex");
                return bytesOf("00");
        end case;
    end;

    function wide(byte: Nat8): Index is
        case toIndex(byte) of
            when Some(value as n: Index) do
                return n;
            when None do
                return 0;
        end case;
    end;

    -- How far pixels lie from reference, sample by sample.
    generic [P: Region, R: Region]
    function distance(pixels: Span[Nat8, P], reference: Span[Nat8, R]): Distance is
        var most: Index := 0;
        var far: Index := 0;
        var i: Index := 0;
        while i < spanLength(reference) do
            let a: Index := wide(pixels[i]);
            let b: Index := wide(reference[i]);
            var d: Index := 0;
            if a > b then
                d := a - b;
            else
                d := b - a;
            end if;
            if d > most then
                most := d;
            end if;
            if d > 2 then
                far := far + 1;
            end if;
            i := i + 1;
        end while;
        return Distance(most => most, far => far);
    end;

    -- How far the pixels of the JPEG lie from those of ImageIO: the
    -- greatest difference of a sample, and how many samples are more than 2
    -- apart (both 100000 when it does not read to width by height).
    generic [D: Region, R: Region]
    function measured(data: Span[Nat8, D], reference: Span[Nat8, R], width: Index, height: Index): Distance is
        case readJpeg(data, 16000000) of
            when Right(right as picture: JpegPicture) do
                var result: Distance := Distance(most => 100000, far => 100000);
                if ((jpegWidth(&picture) = width) and (jpegHeight(&picture) = height)) and (spanLength(reference) = ((width * height) * 3)) then
                    result := distance(jpegPixels(&picture), reference);
                end if;
                destroyJpeg(picture);
                return result;
            when Left(left as error: JpegError) do
                return Distance(most => 100000, far => 100000);
        end case;
    end;

    record Distance: Free is
        most: Index;
        far: Index;
    end;

    -- Whether the JPEG reads to width by height pixels no sample of which
    -- lies more than most from ImageIO's, and at most far more than 2.
    generic [D: Region, R: Region]
    function near(data: Span[Nat8, D], reference: Span[Nat8, R], width: Index, height: Index, most: Index,
                  far: Index): Bool is
        let d: Distance := measured(data, reference, width, height);
        return (d.most <= most) and (d.far <= far);
    end;

    -- The bounds are what Wolly.Jpeg gives against ImageIO: the IDCT and
    -- the colours within 3 levels (4:4:4, grey); chroma of half the
    -- resolution is upsampled as libjpeg does, and ImageIO's own filter
    -- differs from it at sharp colour edges (odd75).  Upsampling with the
    -- nearest sample would give 5 and 1092 (smooth75), 89 and 1746 (odd75).
    function testImageIO(): Unit is
        let smooth: String := bytesOf(smooth75Hex);
        let reference: String := bytesOf(smooth75Pixels);
        assertTrue(near(asSpan(&smooth), asSpan(&reference), 64, 48, 4, 71), "smooth75: 4:2:0, restarts every 4 units");
        assertFalse(near(asSpan(&smooth), asSpan(&reference), 64, 48, 4, 70), "smooth75 has 71 samples more than 2 off: the bound is tight");
        destroyString(smooth);
        destroyString(reference);
        let full: String := bytesOf(smooth100Hex);
        let fullReference: String := bytesOf(smooth100Pixels);
        assertTrue(near(asSpan(&full), asSpan(&fullReference), 64, 48, 3, 1), "smooth100: 4:4:4 within 3 levels");
        destroyString(full);
        destroyString(fullReference);
        let odd: String := bytesOf(odd75Hex);
        let oddReference: String := bytesOf(odd75Pixels);
        assertTrue(near(asSpan(&odd), asSpan(&oddReference), 37, 23, 48, 292), "odd75: 37 by 23, units cut, sharp edges");
        assertFalse(near(asSpan(&odd), asSpan(&oddReference), 37, 23, 47, 292), "odd75 is 48 off somewhere: the bound is tight");
        destroyString(odd);
        destroyString(oddReference);
        let grey: String := bytesOf(grey75Hex);
        let greyReference: String := bytesOf(grey75Pixels);
        assertTrue(near(asSpan(&grey), asSpan(&greyReference), 29, 17, 1, 0), "grey75: one component within 1 level");
        destroyString(grey);
        destroyString(greyReference);
        return nil;
    end;

    generic [D: Region]
    function byteAt(data: Span[Nat8, D], at: Index): Nat8 is
        return data[at];
    end;

    generic [D: Region]
    function errorOf(data: Span[Nat8, D], maxPixels: Index): Index is
        case readJpeg(data, maxPixels) of
            when Right(right as picture: JpegPicture) do
                destroyJpeg(picture);
                return 0;
            when Left(left as error: JpegError) do
                case error of
                    when NotJpeg do
                        return 1;
                    when JpegTooLarge do
                        return 2;
                    when Unsupported do
                        return 3;
                    when JpegBroken do
                        return 4;
                end case;
        end case;
    end;

    -- smooth75 with the byte at at set to value, when it was was; else an
    -- empty string, which no test takes for a JPEG.
    function changed(at: Index, was: Nat8, value: Nat8): String is
        let smooth: String := bytesOf(smooth75Hex);
        var out: StringBuilder := makeStringBuilder();
        if byteAt(asSpan(&smooth), at) = was then
            writeString(&!out, substring(asSpan(&smooth), 0, at));
            writeByte(&!out, value);
            writeString(&!out, substring(asSpan(&smooth), at + 1, length(&smooth)));
        end if;
        destroyString(smooth);
        return finalize(out);
    end;

    -- Whether smooth75 changed at at from was to value reads to the error
    -- code expected.
    function changedTo(at: Index, was: Nat8, value: Nat8, expected: Index): Bool is
        let bytes: String := changed(at, was, value);
        let right: Bool := (length(&bytes) > 0) and (errorOf(asSpan(&bytes), 16000000) = expected);
        destroyString(bytes);
        return right;
    end;

    function testRefused(): Unit is
        let smooth: String := bytesOf(smooth75Hex);
        assertTrue(errorOf(asSpan(&smooth), 16000000) = 0, "smooth75 reads");
        assertTrue(errorOf("GIF89a..........", 100) = 1, "a GIF is no JPEG");
        assertTrue(errorOf("", 100) = 1, "no bytes are no JPEG");
        assertTrue(errorOf(substring(asSpan(&smooth), 0, 3), 100) = 1, "three bytes are no JPEG");
        assertTrue(errorOf(asSpan(&smooth), 64 * 48) = 0, "exactly maxPixels pixels are read");
        assertTrue(errorOf(asSpan(&smooth), (64 * 48) - 1) = 2, "one pixel more than maxPixels");
        assertTrue(errorOf(substring(asSpan(&smooth), 0, 600), 16000000) = 4, "a file that ends in its tables");
        assertTrue(errorOf(substring(asSpan(&smooth), 0, 1000), 16000000) = 4, "a file that ends in its scan");
        destroyString(smooth);
        -- SOF0 at 156: marker C0 at 157, precision at 160, height at 161,
        -- the factors of the first component at 167.
        assertTrue(changedTo(157, 192, 194, 4), "a baseline scan in a progressive frame (SOF2) is Broken");
        assertTrue(changedTo(157, 192, 201, 3), "arithmetic (SOF9) is Unsupported");
        assertTrue(changedTo(157, 192, 193, 0), "extended sequential (SOF1) reads");
        assertTrue(changedTo(160, 8, 12, 3), "12-bit samples are Unsupported");
        assertTrue(changedTo(167, 34, 50, 3), "a factor of 3 is Unsupported");
        assertTrue(changedTo(167, 34, 2, 4), "a factor of 0 is Broken");
        assertTrue(changedTo(162, 48, 0, 3), "the height 0 (DNL) is Unsupported");
        -- DRI at 745: the interval at 749 and 750.
        assertTrue(changedTo(750, 4, 5, 4), "a restart marker where the interval does not say is Broken");
        assertTrue(changedTo(1, 216, 217, 1), "FF D9 at the start is no JPEG");
        return nil;
    end;

    -- No bytes make the reader fail other than with an error: every prefix
    -- of smooth75, and smooth75 with each byte inverted.
    function testRobust(): Unit is
        let smooth: String := bytesOf(smooth75Hex);
        let size: Index := length(&smooth);
        var refused: Index := 0;
        var cut: Index := 0;
        while cut < (size - 2) do
            if errorOf(substring(asSpan(&smooth), 0, cut), 16000000) /= 0 then
                refused := refused + 1;
            end if;
            cut := cut + 1;
        end while;
        assertTrue(refused = (size - 2), "every prefix short of the EOI marker is refused");
        assertTrue(errorOf(substring(asSpan(&smooth), 0, size - 2), 16000000) = 0, "without EOI the picture reads");
        var tried: Index := 0;
        var read: Index := 0;
        var at: Index := 0;
        while at < size do
            let was: Nat8 := byteAt(asSpan(&smooth), at);
            let bytes: String := changed(at, was, bitwiseXor(was, (255 : Nat8)));
            if errorOf(asSpan(&bytes), 16000000) = 0 then
                read := read + 1;
            end if;
            tried := tried + 1;
            destroyString(bytes);
            at := at + 1;
        end while;
        assertTrue(tried = size, "each byte inverted once");
        assertTrue((read > 0) and (read < tried), "some inverted bytes are refused, some (in APP segments) read");
        destroyString(smooth);
        return nil;
    end;

    -- Progressive: the same pictures, the same distance from ImageIO as
    -- their baseline files.
    function testProgressive(): Unit is
        let smooth: String := bytesOf(prog75Hex);
        let reference: String := bytesOf(prog75Pixels);
        assertTrue(near(asSpan(&smooth), asSpan(&reference), 64, 48, 4, 71), "prog75: ten scans, DC and AC, first and refinement");
        destroyString(smooth);
        destroyString(reference);
        let odd: String := bytesOf(progOddHex);
        let oddReference: String := bytesOf(progOddPixels);
        assertTrue(near(asSpan(&odd), asSpan(&oddReference), 37, 23, 48, 292), "progOdd: 37 by 23, bands of one component");
        destroyString(odd);
        destroyString(oddReference);
        return nil;
    end;

    -- The EXIF orientation turns the pixels as ImageIO turns them.
    function testOrientation(): Unit is
        let six: String := bytesOf(orient6Hex);
        let sixReference: String := bytesOf(orient6Pixels);
        assertTrue(near(asSpan(&six), asSpan(&sixReference), 23, 37, 48, 292), "orientation 6: turned 90 degrees clockwise, 23 by 37");
        destroyString(six);
        destroyString(sixReference);
        let five: String := bytesOf(orient5Hex);
        let fiveReference: String := bytesOf(orient5Pixels);
        assertTrue(near(asSpan(&five), asSpan(&fiveReference), 23, 37, 48, 292), "orientation 5: transposed, 23 by 37");
        destroyString(five);
        destroyString(fiveReference);
        let three: String := bytesOf(orient3Hex);
        let threeReference: String := bytesOf(orient3Pixels);
        let unturned: String := bytesOf(odd75Pixels);
        assertTrue(near(asSpan(&three), asSpan(&threeReference), 37, 23, 48, 292), "orientation 3: turned 180 degrees");
        assertFalse(near(asSpan(&three), asSpan(&unturned), 37, 23, 48, 292), "orientation 3 is not the picture as stored");
        destroyString(three);
        destroyString(threeReference);
        destroyString(unturned);
        return nil;
    end;

    -- No prefix and no inverted byte of prog75 makes the reader fail other
    -- than with an error.  A prefix reads only when it ends where a segment
    -- begins (or one FF into its marker) after the first scan, which ends at
    -- 885: ten scans and two DHT segments between them, 22 prefixes, as a
    -- progressive picture cut between scans shows what it has.
    function testProgressiveRobust(): Unit is
        let prog: String := bytesOf(prog75Hex);
        let size: Index := length(&prog);
        var early: Index := 0;
        var late: Index := 0;
        var cut: Index := 0;
        while cut < size do
            if errorOf(substring(asSpan(&prog), 0, cut), 16000000) = 0 then
                if cut < 885 then
                    early := early + 1;
                else
                    late := late + 1;
                end if;
            end if;
            cut := cut + 1;
        end while;
        assertTrue(early = 0, "no prefix short of the first scan reads");
        assertTrue(late = 22, "a prefix reads only at the 12 boundaries after the first scan, or one FF past those of the 10 scans");
        var tried: Index := 0;
        var read: Index := 0;
        var at: Index := 0;
        while at < size do
            let bytes: String := changedOf(asSpan(&prog), at);
            if errorOf(asSpan(&bytes), 16000000) = 0 then
                read := read + 1;
            end if;
            tried := tried + 1;
            destroyString(bytes);
            at := at + 1;
        end while;
        assertTrue(tried = size, "each byte of prog75 inverted once");
        assertTrue((read > 0) and (read < tried), "some inverted bytes are refused, some read");
        destroyString(prog);
        return nil;
    end;

    -- data with the byte at at inverted.
    generic [D: Region]
    function changedOf(data: Span[Nat8, D], at: Index): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, substring(data, 0, at));
        writeByte(&!out, bitwiseXor(data[at], (255 : Nat8)));
        writeString(&!out, substring(data, at + 1, spanLength(data)));
        return finalize(out);
    end;
end module body.
