--
-- Part of Wolly, a web framework in Hilde.
--
-- SPDX-FileCopyrightText: 2026 Heiko Zimmermann
-- SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
--
-- The GIFs here were written by macOS's ImageIO (sips) from pictures made
-- for the test, and decoded by ImageIO again; the SHA-256 of each is that of
-- ImageIO's pixels, red, green and blue row by row from the top.  The
-- interlaced one was written by a script of the test (literal LZW codes, the
-- rows in the order of the four passes) and ImageIO decodes it to the same
-- pixels as the small one.
import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.String (
    String,
    destroyString,
    asSpan,
    length
);
import Standard.Text (
    hexToBytes,
    bytesToHex,
    startsWith,
    substring,
    equal
);
import Standard.Libcrypto (
    sha256
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Wolly.Gif (
    GifError,
    NotGif,
    GifTooLarge,
    Broken,
    GifPicture,
    gifSideMost,
    readGif,
    gifWidth,
    gifHeight,
    gifPixels,
    destroyGif
);

module body Wolly.Gif.Test is
    constant smallHex: Span[Nat8, Static] := "";
    constant wideHex: Span[Nat8, Static] := "";
    constant dotHex: Span[Nat8, Static] := "474946383761010001009100000000000cc822ffffff00000021f90404000000002c00000000010001000002024c01003b";
    constant interHex: Span[Nat8, Static] := "";

    function bytesOf(hex: Span[Nat8, Static]): String is
        case hexToBytes(hex) of
            when Some(value as bytes: String) do
                return bytes;
            when None do
                assertTrue(false, "the fixture is hex");
                return bytesOf("00");
        end case;
    end;

    -- Whether the GIF reads to width by height pixels whose SHA-256 is digest.
    generic [D: Region]
    function readsTo(data: Span[Nat8, D], width: Index, height: Index, digest: Span[Nat8, Static]): Bool is
        case readGif(data, 16000000) of
            when Right(right as picture: GifPicture) do
                var good: Bool := (gifWidth(&picture) = width) and (gifHeight(&picture) = height);
                case sha256(gifPixels(&picture)) of
                    when Some(value as sum: String) do
                        let hex: String := bytesToHex(asSpan(&sum));
                        good := good and equal(asSpan(&hex), digest);
                        destroyString(hex);
                        destroyString(sum);
                    when None do
                        good := false;
                end case;
                destroyGif(picture);
                return good;
            when Left(left as error: GifError) do
                return false;
        end case;
    end;

    function testImageIO(): Unit is
        let small: String := bytesOf(smallHex);
        assertTrue(readsTo(asSpan(&small), 37, 23, "f51da2c0eda6aa8e8e0343fa30ba4df72fb65665d033abf2aba3766fbd094b3d"), "37 by 23, 8 colours, codes from 4 bits");
        destroyString(small);
        let wideGif: String := bytesOf(wideHex);
        assertTrue(readsTo(asSpan(&wideGif), 300, 200, "80d43381f82a4416bb3b5ec8e0b1b21e97e15ceca68b5650df8910c0de0731ae"), "300 by 200, 256 colours, codes to 12 bits and cleared");
        destroyString(wideGif);
        let dot: String := bytesOf(dotHex);
        assertTrue(readsTo(asSpan(&dot), 1, 1, "686950ce23060a7589ff63505d5b0a1767e5e52c112003cd852ab6fcb42fe1d4"), "one pixel, codes from 3 bits");
        destroyString(dot);
        let inter: String := bytesOf(interHex);
        assertTrue(readsTo(asSpan(&inter), 37, 23, "f51da2c0eda6aa8e8e0343fa30ba4df72fb65665d033abf2aba3766fbd094b3d"), "interlaced: the rows back in order, the small picture again");
        destroyString(inter);
        assertTrue(gifSideMost() = 16000, "16000 a side");
        return nil;
    end;

    generic [D: Region]
    function errorOf(data: Span[Nat8, D], maxPixels: Index): Index is
        case readGif(data, maxPixels) of
            when Right(right as picture: GifPicture) do
                destroyGif(picture);
                return 0;
            when Left(left as error: GifError) do
                case error of
                    when NotGif do
                        return 1;
                    when GifTooLarge do
                        return 2;
                    when Broken do
                        return 3;
                end case;
        end case;
    end;

    -- The small GIF with the byte at at set to value.
    function changed(at: Index, value: Nat8): String is
        let small: String := bytesOf(smallHex);
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, substring(asSpan(&small), 0, at));
        writeByte(&!out, value);
        writeString(&!out, substring(asSpan(&small), at + 1, length(&small)));
        destroyString(small);
        return finalize(out);
    end;

    function testRefused(): Unit is
        let small: String := bytesOf(smallHex);
        assertTrue(errorOf("PNG IHDR xxxxxxxxxx", 100) = 1, "a PNG is no GIF");
        assertTrue(errorOf("GIF8", 100) = 1, "four bytes are no GIF");
        assertTrue(errorOf("GIF88a.........", 100) = 1, "GIF88a is no version");
        assertTrue(errorOf(asSpan(&small), 37 * 23) = 0, "exactly maxPixels pixels are read");
        assertTrue(errorOf(asSpan(&small), (37 * 23) - 1) = 2, "one pixel more than maxPixels");
        assertTrue(errorOf(substring(asSpan(&small), 0, 20), 16000000) = 3, "a file that ends in its colour table");
        destroyString(small);
        -- The screen 0 wide; 16001 wide.
        let zero: String := changed(6, (0 : Nat8));
        assertTrue(errorOf(asSpan(&zero), 16000000) = 3, "a screen 37 - 37 = 0 wide");
        destroyString(zero);
        return nil;
    end;
end module body.
