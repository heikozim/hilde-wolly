--
-- SQL of its own over Standard.Database, as Wolly.Auth: every statement is a
-- constant, every value is bound, the table is strict.
import Standard.String (
    String
);
import Standard.Database (
    Database,
    Writing,
    DbError,
    Cursor,
    Transaction,
    noValues,
    withInt64,
    withText,
    begin,
    commit,
    rollback,
    start,
    execute,
    advance,
    columnInt64,
    finish
);
import Wolly.Dialect (
    pick
);
import Wolly.Response (
    makeResponse,
    addNumberHeader,
    finish as finishResponse
);

module body Wolly.Limit is
    constant makeTable: Span[Nat8, Static] := "CREATE TABLE IF NOT EXISTS wolly_hits (scope TEXT NOT NULL, key TEXT NOT NULL, at INTEGER NOT NULL) STRICT";
    constant makeTablePg: Span[Nat8, Static] := "CREATE TABLE IF NOT EXISTS wolly_hits (scope TEXT NOT NULL, key TEXT NOT NULL, at BIGINT NOT NULL)";
    constant makeIndex: Span[Nat8, Static] := "CREATE INDEX IF NOT EXISTS wolly_hits_scope ON wolly_hits (scope, key, at)";
    constant dropOld: Span[Nat8, Static] := "DELETE FROM wolly_hits WHERE scope = ? AND at <= ?";
    constant countKey: Span[Nat8, Static] := "SELECT count(*), coalesce(min(at), 0) FROM wolly_hits WHERE scope = ? AND key = ?";
    constant addHit: Span[Nat8, Static] := "INSERT INTO wolly_hits (scope, key, at) VALUES (?, ?, ?)";

    -- Runs one statement without values that returns no rows.
    generic [R: Region]
    function run(db: &![Database[Writing], R], sql: Span[Nat8, Static]): Option[DbError] is
        case execute(&~db, sql, noValues()) of
            when Right(right as changed: Nat64) do
                return None();
            when Left(left as error: DbError) do
                return Some(value => error);
        end case;
    end;

    generic [R: Region]
    function prepareLimits(db: &![Database[Writing], R]): Option[DbError] is
        let table: Span[Nat8, Static] := pick(&db, makeTable, makeTablePg);
        case run(&~db, table) of
            when Some(value as error: DbError) do
                return Some(value => error);
            when None do
                return run(&~db, makeIndex);
        end case;
    end;

    -- The calls of key in scope that are still in the window, and the
    -- time of the oldest of them, 0 when there is none.
    generic [R: Region, S: Region, K: Region]
    function counted(db: &![Database[Writing], R], scope: Span[Nat8, S], key: Span[Nat8, K]): Either[DbError, Int64] is
        var cursor: Cursor := start(&~db, countKey, withText(withText(noValues(), scope), key));
        var count: Int64 := 0;
        if advance(&!cursor) then
            count := columnInt64(&cursor, 0);
        end if;
        case finish(&~db, cursor) of
            when Some(value as error: DbError) do
                return Left(left => error);
            when None do
                return Right(right => count);
        end case;
    end;

    generic [R: Region, S: Region, K: Region]
    function oldest(db: &![Database[Writing], R], scope: Span[Nat8, S], key: Span[Nat8, K]): Either[DbError, Int64] is
        var cursor: Cursor := start(&~db, countKey, withText(withText(noValues(), scope), key));
        var at: Int64 := 0;
        if advance(&!cursor) then
            at := columnInt64(&cursor, 1);
        end if;
        case finish(&~db, cursor) of
            when Some(value as error: DbError) do
                return Left(left => error);
            when None do
                return Right(right => at);
        end case;
    end;

    -- The work of hit inside its transaction.
    generic [R: Region, S: Region, K: Region]
    function decide(db: &![Database[Writing], R], scope: Span[Nat8, S], key: Span[Nat8, K], now: Int64,
                    limit: Int64, window: Int64): Either[DbError, Verdict] is
        case execute(&~db, dropOld, withInt64(withText(noValues(), scope), now - window)) of
            when Left(left as error: DbError) do
                return Left(left => error);
            when Right(right as dropped: Nat64) do
                skip;
        end case;
        case counted(&~db, scope, key) of
            when Left(left as error: DbError) do
                return Left(left => error);
            when Right(right as count: Int64) do
                if count >= limit then
                    case oldest(&~db, scope, key) of
                        when Left(left as error: DbError) do
                            return Left(left => error);
                        when Right(right as first: Int64) do
                            -- At least 1: the calls at or before now - window
                            -- were removed above, so first + window > now.
                            let wait: Int64 := (first + window) - now;
                            let limited: Verdict := Limited(retryAfter => wait);
                            return Right(right => limited);
                    end case;
                else
                    case execute(&~db, addHit, withInt64(withText(withText(noValues(), scope), key), now)) of
                        when Left(left as error: DbError) do
                            return Left(left => error);
                        when Right(right as added: Nat64) do
                            let allowed: Verdict := Allowed();
                            return Right(right => allowed);
                    end case;
                end if;
        end case;
    end;

    generic [R: Region, S: Region, K: Region]
    function hit(db: &![Database[Writing], R], scope: Span[Nat8, S], key: Span[Nat8, K], now: Int64,
                 limit: Int64, window: Int64): Either[DbError, Verdict] is
        case begin(&~db) of
            when Left(left as error: DbError) do
                return Left(left => error);
            when Right(right as open: Transaction) do
                case decide(&~db, scope, key, now, limit, window) of
                    when Left(left as error: DbError) do
                        rollback(&~db, open);
                        return Left(left => error);
                    when Right(right as verdict: Verdict) do
                        case commit(&~db, open) of
                            when Left(left as error: DbError) do
                                return Left(left => error);
                            when Right(right as done: Unit) do
                                return Right(right => verdict);
                        end case;
                end case;
        end case;
    end;

    function tooManyRequests(retryAfter: Int64): String is
        return finishResponse(addNumberHeader(makeResponse(429, "text/plain; charset=utf-8"), "Retry-After", retryAfter),
                              "too many requests\n");
    end;
end module body.
