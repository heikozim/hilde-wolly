--
-- SQL of its own over Standard.Database, as Wolly.Auth: every statement is a
-- constant, every value is bound, the table is strict.
import Standard.String (
    String,
    fromSpan,
    destroyString,
    asSpan
);
import Standard.Text (
    constantTimeEqual
);
import Standard.Database (
    Database,
    Writing,
    DbError,
    Cursor,
    Values,
    noValues,
    withInt64,
    withText,
    withBytes,
    start,
    execute,
    advance,
    columnInt64,
    columnBytes,
    finish
);
import Standard.Libcrypto (
    randomBytes
);
import Standard.Base32 (
    encodeBase32Unpadded
);
import Standard.Otp (
    OtpHash,
    OtpSha256,
    hotp,
    otpauthUri
);
import Wolly.Seal (
    sealValue,
    openValue
);
import Wolly.Dialect (
    pick
);

module body Wolly.Totp is
    constant purpose: Span[Nat8, Static] := "wolly-totp-seed";
    constant seedBytes: Index := 20;
    constant digits: Nat8 := 6;
    constant noStep: Int64 := 0;
    constant makeTable: Span[Nat8, Static] := "CREATE TABLE IF NOT EXISTS wolly_totp (name TEXT PRIMARY KEY NOT NULL, seed BLOB NOT NULL, enabled INTEGER NOT NULL, last_step INTEGER NOT NULL) STRICT";
    constant makeTablePg: Span[Nat8, Static] := "CREATE TABLE IF NOT EXISTS wolly_totp (name TEXT PRIMARY KEY NOT NULL, seed BYTEA NOT NULL, enabled BIGINT NOT NULL, last_step BIGINT NOT NULL)";
    -- A start replaces a seed that is not on, never one that is.
    constant addSeed: Span[Nat8, Static] := "INSERT INTO wolly_totp (name, seed, enabled, last_step) VALUES (?, ?, 0, 0) ON CONFLICT (name) DO UPDATE SET seed = excluded.seed, last_step = 0 WHERE wolly_totp.enabled = 0";
    constant readSeed: Span[Nat8, Static] := "SELECT seed FROM wolly_totp WHERE name = ? AND enabled = ?";
    constant countOn: Span[Nat8, Static] := "SELECT count(*) FROM wolly_totp WHERE name = ? AND enabled = 1";
    -- The step only moves forward: of two requests with the same code at
    -- once, one changes the row.
    constant takeStep: Span[Nat8, Static] := "UPDATE wolly_totp SET enabled = 1, last_step = ? WHERE name = ? AND enabled = ? AND last_step < ?";
    constant dropSeed: Span[Nat8, Static] := "DELETE FROM wolly_totp WHERE name = ?";

    function stepSeconds(): Int64 is
        return 30;
    end;

    function codeDigits(): Index is
        return 6;
    end;

    generic [R: Region]
    function prepareTotp(db: &![Database[Writing], R]): Option[DbError] is
        let makeTableSql: Span[Nat8, Static] := pick(&db, makeTable, makeTablePg);
        case execute(&~db, makeTableSql, noValues()) of
            when Right(right as changed: Nat64) do
                return None();
            when Left(left as error: DbError) do
                return Some(value => error);
        end case;
    end;

    generic [R: Region, N: Region]
    function totpEnabled(db: &![Database[Writing], R], name: Span[Nat8, N]): Either[DbError, Bool] is
        var cursor: Cursor := start(&~db, countOn, withText(noValues(), name));
        var count: Int64 := 0;
        if advance(&!cursor) then
            count := columnInt64(&cursor, 0);
        end if;
        case finish(&~db, cursor) of
            when Some(value as error: DbError) do
                return Left(left => error);
            when None do
                let on: Bool := count > 0;
                return Right(right => on);
        end case;
    end;

    generic [R: Region, K: Region, N: Region]
    function startEnrolment(db: &![Database[Writing], R], key: Span[Nat8, K], name: Span[Nat8, N]): Either[DbError, Option[String]] is
        case randomBytes(seedBytes) of
            when Some(value as seed: String) do
                case sealValue(key, purpose, asSpan(&seed), name) of
                    when Some(value as sealed: String) do
                        let stored: Either[DbError, Nat64] := execute(&~db, addSeed, withBytes(withText(noValues(), name), asSpan(&sealed)));
                        destroyString(sealed);
                        case stored of
                            when Right(right as changed: Nat64) do
                                if changed = 1 then
                                    let secret: String := encodeBase32Unpadded(asSpan(&seed));
                                    destroyString(seed);
                                    let given: Option[String] := Some(value => secret);
                                    return Right(right => given);
                                else
                                    destroyString(seed);
                                    return Right(right => None());
                                end if;
                            when Left(left as error: DbError) do
                                destroyString(seed);
                                return Left(left => error);
                        end case;
                    when None do
                        destroyString(seed);
                        return Right(right => None());
                end case;
            when None do
                return Right(right => None());
        end case;
    end;

    -- Whether code has the form of a code: codeDigits decimal digits.
    generic [C: Region]
    function isCode(code: Span[Nat8, C]): Bool is
        if spanLength(code) /= codeDigits() then
            return false;
        end if;
        var i: Index := 0;
        while i < spanLength(code) do
            if (code[i] < '0') or (code[i] > '9') then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    -- Whether code is the code of seed at the step counter.
    generic [S: Region, C: Region]
    function codeAt(seed: Span[Nat8, S], code: Span[Nat8, C], counter: Int64, hash: OtpHash): Bool is
        if counter < 0 then
            return false;
        end if;
        case toNat64(counter) of
            when Some(value as unsigned: Nat64) do
                case hotp(seed, unsigned, digits, hash) of
                    when Some(value as made: String) do
                        let fits: Bool := constantTimeEqual(asSpan(&made), code);
                        destroyString(made);
                        return fits;
                    when None do
                        return false;
                end case;
            when None do
                return false;
        end case;
    end;

    -- The step of now, the one before or the one after, whose code is code;
    -- 0 for none, since a step taken is above 0.  All three are computed
    -- whatever matches, so the time of an answer does not tell which did.
    -- Whether the step is later than the one taken last is not asked here
    -- but by takeStep, in the statement that writes it: so two processes
    -- cannot both take one step.
    generic [S: Region, C: Region]
    function matchedStep(seed: Span[Nat8, S], code: Span[Nat8, C], now: Int64, hash: OtpHash): Int64 is
        if not isCode(code) then
            return 0;
        end if;
        let step: Int64 := now / stepSeconds();
        let before: Bool := codeAt(seed, code, step - 1, hash);
        let current: Bool := codeAt(seed, code, step, hash);
        let after: Bool := codeAt(seed, code, step + 1, hash);
        var found: Int64 := 0;
        if before then
            found := step - 1;
        end if;
        if current then
            found := step;
        end if;
        if after then
            found := step + 1;
        end if;
        return found;
    end;

    -- The step code takes for name among the rows of enabled (0 or 1), 0
    -- when it takes none.
    generic [R: Region, K: Region, N: Region, C: Region]
    function stepFor(db: &![Database[Writing], R], key: Span[Nat8, K], name: Span[Nat8, N], code: Span[Nat8, C],
        now: Int64, enabled: Int64, hash: OtpHash): Either[DbError, Int64] is
        var cursor: Cursor := start(&~db, readSeed, withInt64(withText(noValues(), name), enabled));
        var sealed: String := fromSpan("");
        var found: Bool := false;
        if advance(&!cursor) then
            destroyString(sealed);
            sealed := fromSpan(columnBytes(&cursor, 0));
            found := true;
        end if;
        let failed: Option[DbError] := finish(&~db, cursor);
        -- Without a row the sealed value is empty, opens nothing, and the
        -- answer is no step.
        let opened: Option[String] := openValue(key, purpose, asSpan(&sealed), name);
        destroyString(sealed);
        case failed of
            when Some(value as error: DbError) do
                case opened of
                    when Some(value as unused: String) do
                        destroyString(unused);
                    when None do
                        skip;
                end case;
                return Left(left => error);
            when None do
                case opened of
                    when Some(value as seed: String) do
                        var step: Int64 := noStep;
                        if found then
                            step := matchedStep(asSpan(&seed), code, now, hash);
                        end if;
                        destroyString(seed);
                        return Right(right => step);
                    when None do
                        return Right(right => noStep);
                end case;
        end case;
    end;

    -- Takes the step code fits for name among the rows of enabled, and
    -- turns the factor on; Right true when a row changed.
    generic [R: Region, K: Region, N: Region, C: Region]
    function take(db: &![Database[Writing], R], key: Span[Nat8, K], name: Span[Nat8, N], code: Span[Nat8, C],
        now: Int64, enabled: Int64, hash: OtpHash): Either[DbError, Bool] is
        case stepFor(&~db, key, name, code, now, enabled, hash) of
            when Left(left as error: DbError) do
                return Left(left => error);
            when Right(right as step: Int64) do
                if step = 0 then
                    return Right(right => false);
                end if;
                let values: Values := withInt64(withInt64(withText(withInt64(noValues(), step), name), enabled), step);
                case execute(&~db, takeStep, values) of
                    when Right(right as changed: Nat64) do
                        let taken: Bool := changed = 1;
                        return Right(right => taken);
                    when Left(left as error: DbError) do
                        return Left(left => error);
                end case;
        end case;
    end;

    generic [R: Region, K: Region, N: Region, C: Region]
    function confirmEnrolment(db: &![Database[Writing], R], key: Span[Nat8, K], name: Span[Nat8, N],
        code: Span[Nat8, C], now: Int64): Either[DbError, Bool] is
        return take(&~db, key, name, code, now, 0, OtpSha256());
    end;

    generic [R: Region, K: Region, N: Region, C: Region]
    function checkCode(db: &![Database[Writing], R], key: Span[Nat8, K], name: Span[Nat8, N], code: Span[Nat8, C],
        now: Int64): Either[DbError, Bool] is
        return take(&~db, key, name, code, now, 1, OtpSha256());
    end;

    generic [R: Region, K: Region, N: Region, C: Region]
    function confirmEnrolmentWith(db: &![Database[Writing], R], key: Span[Nat8, K], name: Span[Nat8, N],
        code: Span[Nat8, C], now: Int64, hash: OtpHash): Either[DbError, Bool] is
        return take(&~db, key, name, code, now, 0, hash);
    end;

    generic [R: Region, K: Region, N: Region, C: Region]
    function checkCodeWith(db: &![Database[Writing], R], key: Span[Nat8, K], name: Span[Nat8, N], code: Span[Nat8, C],
        now: Int64, hash: OtpHash): Either[DbError, Bool] is
        return take(&~db, key, name, code, now, 1, hash);
    end;

    generic [R: Region, N: Region]
    function removeTotp(db: &![Database[Writing], R], name: Span[Nat8, N]): Either[DbError, Bool] is
        case execute(&~db, dropSeed, withText(noValues(), name)) of
            when Right(right as changed: Nat64) do
                let removed: Bool := changed > 0;
                return Right(right => removed);
            when Left(left as error: DbError) do
                return Left(left => error);
        end case;
    end;

    generic [I: Region, N: Region, S: Region]
    function otpauthFor(issuer: Span[Nat8, I], name: Span[Nat8, N], secret: Span[Nat8, S]): String is
        let step: Nat32 := 30;
        return otpauthUri(issuer, name, secret, OtpSha256(), digits, step);
    end;

    generic [I: Region, N: Region, S: Region]
    function otpauthWith(issuer: Span[Nat8, I], name: Span[Nat8, N], secret: Span[Nat8, S], hash: OtpHash): String is
        let step: Nat32 := 30;
        return otpauthUri(issuer, name, secret, hash, digits, step);
    end;
end module body.
