--
-- Part of Wolly, a web framework in Hilde.
--
-- SPDX-FileCopyrightText: 2026 Heiko Zimmermann
-- SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
--
-- The lossy WebPs here and the golden YUV planes their digests come from
-- are golang.org/x/image's testdata (Copyright 2009 The Go Authors,
-- BSD-3-Clause), written and decoded by libwebp; the RGB digests are those
-- of macOS's ImageIO decoding the same files.  The c- frames were written
-- by cwebp 1.6.0 from pictures made for the test (sharpness, simple filter,
-- one segment, quality 5 and 100, the skip flag), their planes and RGB
-- dwebp's (-yuv, -pam).
import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.String (
    String,
    destroyString,
    asSpan,
    length
);
import Standard.Text (
    hexToBytes,
    bytesToHex,
    startsWith,
    substring,
    equal
);
import Standard.Libcrypto (
    sha256
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Wolly.Vp8 (
    Vp8Picture,
    readVp8,
    vp8Width,
    vp8Height,
    vp8Pixels,
    vp8Luma,
    vp8Blue,
    vp8Red,
    destroyVp8
);

module body Wolly.Vp8Part2.Test is
    constant bluePurplePinkLossyHex: Span[Nat8, Static] := "";

    function bytesOf(hex: Span[Nat8, Static]): String is
        case hexToBytes(hex) of
            when Some(value as bytes: String) do
                return bytes;
            when None do
                assertTrue(false, "the fixture is hex");
                return bytesOf("00");
        end case;
    end;

    function wide(byte: Nat8): Index is
        case toIndex(byte) of
            when Some(value as n: Index) do
                return n;
            when None do
                return 0;
        end case;
    end;

    -- The payload of the first chunk of a plain WebP file (its VP8 chunk).
    generic [D: Region]
    function chunkOf(data: Span[Nat8, D]): Span[Nat8, D] is
        let size: Index := ((wide(data[16]) + (wide(data[17]) * 256)) + (wide(data[18]) * 65536)) + (wide(data[19]) * 16777216);
        return substring(data, 20, size + 20);
    end;

    -- 0 when the frame reads, else the code readVp8 answers.
    generic [D: Region]
    function codeOf(data: Span[Nat8, D], maxPixels: Index): Index is
        case readVp8(data, maxPixels) of
            when Right(right as picture: Vp8Picture) do
                destroyVp8(picture);
                return 0;
            when Left(left as code: Index) do
                return code;
        end case;
    end;

    -- The chunk of blue-purple-pink with the byte at at set to value, when
    -- it was was; else no bytes.
    function changed(at: Index, was: Nat8, value: Nat8): String is
        let data: String := bytesOf(bluePurplePinkLossyHex);
        var out: StringBuilder := makeStringBuilder();
        if byteAt(chunkOf(asSpan(&data)), at) = was then
            writeString(&!out, substring(chunkOf(asSpan(&data)), 0, at));
            writeByte(&!out, value);
            writeString(&!out, substring(chunkOf(asSpan(&data)), at + 1, spanLength(chunkOf(asSpan(&data)))));
        end if;
        destroyString(data);
        return finalize(out);
    end;

    generic [D: Region]
    function byteAt(data: Span[Nat8, D], at: Index): Nat8 is
        return data[at];
    end;

    function changedCode(at: Index, was: Nat8, value: Nat8, maxPixels: Index): Index is
        let bytes: String := changed(at, was, value);
        var code: Index := 99;
        if length(&bytes) > 0 then
            code := codeOf(asSpan(&bytes), maxPixels);
        end if;
        destroyString(bytes);
        return code;
    end;

    -- No prefix and no inverted byte of the frame of blue-purple-pink makes
    -- the reader fail other than with a code; measured: 2428

    -- of 2430 prefixes refused, 1452 of 2430 inverted bytes read.  In 16
    -- parts, part k the offsets k, k + 16, k + 32 and so on, so that each
    -- stays under the 1800 s hilde test gives a test under valgrind (the
    -- whole took longer); the 16 together are every offset.
    constant robustParts: Index := 16;

    function robustPart(part: Index): Unit is
        let data: String := bytesOf(bluePurplePinkLossyHex);
        let size: Index := spanLength(chunkOf(asSpan(&data)));
        var wrong: Index := 0;
        var cut: Index := part;
        while cut < size do
            let refused: Bool := codeOf(substring(chunkOf(asSpan(&data)), 0, cut), 16000000) /= 0;
            let needed: Bool := cut < (size - 2);
            if refused /= needed then
                wrong := wrong + 1;
            end if;
            cut := cut + robustParts;
        end while;
        assertTrue(wrong = 0, "every prefix refused but the two that leave out bytes the decoder never needs");
        var read: Index := 0;
        var tried: Index := 0;
        var at: Index := part;
        while at < size do
            let was: Nat8 := byteAt(chunkOf(asSpan(&data)), at);
            if changedCode(at, was, bitwiseXor(was, (255 : Nat8)), 16000000) = 0 then
                read := read + 1;
            end if;
            tried := tried + 1;
            at := at + robustParts;
        end while;
        assertTrue(read < tried, "each byte inverted: some of this part refused");
        destroyString(data);
        return nil;
    end;

    function testRobust04(): Unit is
        robustPart(4);
        return nil;
    end;

    function testRobust05(): Unit is
        robustPart(5);
        return nil;
    end;
end module body.
