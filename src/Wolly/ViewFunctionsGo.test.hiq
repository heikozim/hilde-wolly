-- SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
--
-- Checks: ViewFunctions
--
-- The functions of Wolly.ViewFunctions against the Go template functions
-- they replace: every case is a line of a table that the Go view engine
-- of an application rendered with its own
-- function map (Go 1.27.3).  The arguments are the same, and the
-- result must be the same text.  Where Wolly gives another on purpose, the
-- case says what Go gives.  Written from the table by a script.
import Standard.Testing (
    assertTrue
);
import Standard.String (
    String,
    asSpan,
    destroyString
);
import Standard.Text (
    equal
);
import Wolly.ViewData (
    ViewData,
    makeListData,
    destroyViewData,
    rootNode,
    addText,
    addInteger,
    isTextual,
    isBool,
    isInteger,
    textOf,
    integerOf,
    boolOf
);
import Standard.Template (
    Render,
    display
);
import Wolly.ViewFunctions (
    barHeight,
    readableNumber,
    centToEur,
    formatPrice,
    formatSize,
    formatHour,
    formatDate,
    formatDay,
    formatFullDate,
    isWeekend,
    prevDate,
    nextDate,
    add,
    subtract,
    multiply,
    mulPrice,
    hasPrefix,
    upper,
    lower
);

module body Wolly.ViewFunctionsGo.Test is
    generic [R: Region, T: Region]
    function pushText(call: &![ViewData, R], text: Span[Nat8, T]): Unit is
        let made: Index := addText(&~call, rootNode(), text);
        return nil;
    end;

    generic [R: Region]
    function pushInteger(call: &![ViewData, R], value: Int64): Unit is
        let made: Index := addInteger(&~call, rootNode(), value);
        return nil;
    end;

    -- The function called with call must give the text expected; a new
    -- empty list comes back for the next case.
    function givesText(call: ViewData, callee: Fn[ViewData, Either[String, ViewData]], expected: Span[Nat8, Static],
        message: Span[Nat8, Static]): Unit is
        case callee(call) of
            when Left(left as failure: String) do
                printLn(asSpan(&failure));
                destroyString(failure);
                assertTrue(false, message);
            when Right(right as result: ViewData) do
                var same: Bool := false;
                if isTextual(&result, rootNode()) then
                    same := equal(textOf(&result, rootNode()), expected);
                    if not same then
                        printLn(textOf(&result, rootNode()));
                    end if;
                else if isInteger(&result, rootNode()) then
                    let number: Int64 := integerOf(&result, rootNode());
                    let digits: String := display(&number);
                    same := equal(asSpan(&digits), expected);
                    destroyString(digits);
                end if;
                destroyViewData(result);
                assertTrue(same, message);
        end case;
        return nil;
    end;

    function givesBool(call: ViewData, callee: Fn[ViewData, Either[String, ViewData]], expected: Bool,
        message: Span[Nat8, Static]): Unit is
        case callee(call) of
            when Left(left as failure: String) do
                printLn(asSpan(&failure));
                destroyString(failure);
                assertTrue(false, message);
            when Right(right as result: ViewData) do
                var same: Bool := false;
                if isBool(&result, rootNode()) then
                    same := boolOf(&result, rootNode()) = expected;
                end if;
                destroyViewData(result);
                assertTrue(same, message);
        end case;
        return nil;
    end;

    function testBarHeight(): Unit is
        var case1: ViewData := makeListData();
        pushInteger(&!case1, 1);
        pushInteger(&!case1, 3);
        givesText(case1, barHeight, "33.33333333333333", "barHeight(1, 3) gives 33.33333333333333");
        var case2: ViewData := makeListData();
        pushInteger(&!case2, 2);
        pushInteger(&!case2, 3);
        givesText(case2, barHeight, "66.66666666666666", "barHeight(2, 3) gives 66.66666666666666");
        var case3: ViewData := makeListData();
