    function testFormatPrice(): Unit is
        var case395: ViewData := makeListData();
        pushInteger(&!case395, 0);
        givesText(case395, formatPrice, "0,00 EUR", "formatPrice(0) gives 0,00 EUR");
        var case396: ViewData := makeListData();
        pushInteger(&!case396, 1);
        givesText(case396, formatPrice, "0,01 EUR", "formatPrice(1) gives 0,01 EUR");
        var case397: ViewData := makeListData();
        pushInteger(&!case397, -1);
        givesText(case397, formatPrice, "0,01 EUR", "formatPrice(-1) gives 0,01 EUR");
        var case398: ViewData := makeListData();
        pushInteger(&!case398, -5);
        givesText(case398, formatPrice, "0,05 EUR", "formatPrice(-5) gives 0,05 EUR");
        var case399: ViewData := makeListData();
        pushInteger(&!case399, -50);
        givesText(case399, formatPrice, "0,50 EUR", "formatPrice(-50) gives 0,50 EUR");
        var case400: ViewData := makeListData();
        pushInteger(&!case400, -150);
        givesText(case400, formatPrice, "-1,50 EUR", "formatPrice(-150) gives -1,50 EUR");
        var case401: ViewData := makeListData();
        pushInteger(&!case401, 1999);
        givesText(case401, formatPrice, "19,99 EUR", "formatPrice(1999) gives 19,99 EUR");
        var case402: ViewData := makeListData();
        pushInteger(&!case402, 100);
        givesText(case402, formatPrice, "1,00 EUR", "formatPrice(100) gives 1,00 EUR");
        var case403: ViewData := makeListData();
        pushInteger(&!case403, 123456789);
        givesText(case403, formatPrice, "1234567,89 EUR", "formatPrice(123456789) gives 1234567,89 EUR");
        return nil;
    end;

