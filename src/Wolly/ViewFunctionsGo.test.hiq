    function testUpper(): Unit is
        var case499: ViewData := makeListData();
        pushText(&!case499, "abc");
        givesText(case499, upper, "ABC", "upper(abc) gives ABC");
        var case500: ViewData := makeListData();
        pushText(&!case500, "Gr\u{fc}\u{df}e");
        givesText(case500, upper, "GR\u{dc}SSE", "upper(Gr\u{fc}\u{df}e) gives GR\u{dc}SSE (Go: GR\u{dc}\u{df}E)");
        var case501: ViewData := makeListData();
        pushText(&!case501, "\u{e0}\u{e9}");
        givesText(case501, upper, "\u{c0}\u{c9}", "upper(\u{e0}\u{e9}) gives \u{c0}\u{c9}");
        return nil;
    end;

