    function testFormatDate(): Unit is
        var case421: ViewData := makeListData();
        pushText(&!case421, "2026-10-23 12:34:56");
        givesText(case421, formatDate, "23.10.2026 12:34", "formatDate(2026-10-23 12:34:56) gives 23.10.2026 12:34");
        var case422: ViewData := makeListData();
        pushText(&!case422, "2026-02-29 00:00:00");
        givesText(case422, formatDate, "2026-02-29 00:00:00", "formatDate(2026-02-29 00:00:00) gives 2026-02-29 00:00:00");
