import Standard.String (
    String,
    fromSpan,
    destroyString,
    asSpan,
    length
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    removeFirst,
    nthRef,
    length as bufferLength,
    destroyEmpty
);
import Standard.Text (
    equal,
    startsWith,
    toLower,
    trim,
    indexOfByte,
    substring
);
import Standard.Database (
    Database,
    Writing,
    DbError
);
import Standard.FcgiServer (
    Request,
    requestParam,
    requestBody
);
import Standard.Log (
    Log,
    Entry,
    Info,
    makeEntry,
    addText,
    writeEntry
);
import Wolly.Request (
    cookie
);
import Wolly.Response (
    Response,
    makeResponse,
    addHeader,
    finish,
    decimalText
);
import Wolly.OpClient (
    Limits
);
import Wolly.OpUrl (
    UrlParts,
    QueryPair,
    destroyUrlParts,
    parseUrl,
    parseQuery,
    destroyPairs
);
import Wolly.OpKey (
    KeyFamily,
    MlDsa
);
import Wolly.OpStore (
    OpSession,
    destroySession,
    isAlive,
    sessionByToken
);
import Wolly.Dbsc (
    bindingFresh
);
import Wolly.Account (
    Account,
    destroyAccount,
    accountById
);

module body Wolly.OpBase is
    constant form_bytes: Index := 16384;

    generic [I: Region, N: Region, C: Region]
    function makeSettings(issuer: Span[Nat8, I], name: Span[Nat8, N], cookie_name: Span[Nat8, C], allow_http: Bool,
        idle: Int64, max: Int64): Option[OpSettings] is
        if (idle <= 0) or (max <= 0) or (idle > max) then
            let none: Option[OpSettings] := None();
            return none;
        end if;
        if not issuerHolds(issuer, allow_http) then
            let none: Option[OpSettings] := None();
            return none;
        end if;
        return Some(value => OpSettings(issuer => fromSpan(issuer), name => fromSpan(name), cookieName => fromSpan(cookie_name),
            allowHttp => allow_http, session => Limits(idle => idle, max => max, refresh => idle), accessTtl => 600,
            idTokenTtl => 600, codeTtl => 60, requestTtl => 600, keyRotation => 7776000, leeway => 120,
            loginPath => fromSpan("/login"), logoutPath => fromSpan("/login/logout"), defaultFamily => MlDsa()));
    end;

    function withDefaultFamily(settings: OpSettings, family: KeyFamily): OpSettings is
        let { issuer: String, name: String, cookieName as cookie_name: String, allowHttp as allow_http: Bool, session: Limits, accessTtl as access_ttl: Int64,
            idTokenTtl as id_token_ttl: Int64, codeTtl as code_ttl: Int64, requestTtl as request_ttl: Int64, keyRotation as key_rotation: Int64, leeway: Int64, loginPath as login_path: String,
            logoutPath as logout_path: String, defaultFamily as default_family: KeyFamily } := settings;
        return OpSettings(issuer => issuer, name => name, cookieName => cookie_name, allowHttp => allow_http,
            session => session, accessTtl => access_ttl, idTokenTtl => id_token_ttl, codeTtl => code_ttl,
            requestTtl => request_ttl, keyRotation => key_rotation, leeway => leeway, loginPath => login_path,
            logoutPath => logout_path, defaultFamily => family);
    end;

    -- Whether issuer is scheme://host with nothing after it, https unless
    -- allowHttp.
    generic [I: Region]
    function issuerHolds(issuer: Span[Nat8, I], allow_http: Bool): Bool is
        case parseUrl(issuer) of
            when Some(value as parts: UrlParts) do
                let holds: Bool := partsHold(&parts, allow_http);
                destroyUrlParts(parts);
                return holds;
            when None do
                return false;
        end case;
    end;

    generic [P: Region]
    function partsHold(parts: &[UrlParts, P], allow_http: Bool): Bool is
        let scheme: Span[Nat8, P] := asSpan(&(parts->scheme));
        let scheme_fits: Bool := equal(scheme, "https") or (allow_http and equal(scheme, "http"));
        return scheme_fits and parts->hasAuthority and (length(&(parts->host)) > 0) and (not parts->hasUser) and
            (length(&(parts->path)) = 0) and (not parts->hasQuery) and (not parts->hasFragment);
    end;

    function destroySettings(settings: OpSettings): Unit is
        let { issuer: String, name: String, cookieName as cookie_name: String, allowHttp as allow_http: Bool, session: Limits, accessTtl as access_ttl: Int64,
            idTokenTtl as id_token_ttl: Int64, codeTtl as code_ttl: Int64, requestTtl as request_ttl: Int64, keyRotation as key_rotation: Int64, leeway: Int64, loginPath as login_path: String,
            logoutPath as logout_path: String, defaultFamily as default_family: KeyFamily } := settings;
        destroyString(issuer);
        destroyString(name);
        destroyString(cookie_name);
        destroyString(login_path);
        destroyString(logout_path);
        return nil;
    end;

    generic [S: Region]
    function keyKeep(settings: &[OpSettings, S]): Int64 is
        let longest: Int64 := if settings->accessTtl > settings->idTokenTtl then settings->accessTtl else settings->idTokenTtl;
        let keep: Int64 := longest + settings->leeway;
        if keep <= 0 then
            return 1;
        end if;
        return keep;
    end;

    function mostFormBytes(): Index is
        return form_bytes;
    end;

    generic [R: Region]
    function isPost(request: &[Request, R]): Bool is
        case requestParam(request, "REQUEST_METHOD") of
            when Some(value as verb: String) do
                let post: Bool := equal(asSpan(&verb), "POST");
                destroyString(verb);
                return post;
            when None do
                return false;
        end case;
    end;

    -- Whether the content type of request is a form.
    generic [R: Region]
    function isForm(request: &[Request, R]): Bool is
        case requestParam(request, "CONTENT_TYPE") of
            when Some(value as content_type: String) do
                let lower: String := toLower(asSpan(&content_type));
                destroyString(content_type);
                let main: Span[Nat8, Static] := "application/x-www-form-urlencoded";
                var fits: Bool := false;
                borrow l: &[String, L] := &lower do
                    let text: Span[Nat8, L] := asSpan(l);
                    case indexOfByte(text, ';') of
                        when Some(value as semicolon: Index) do
                            fits := equal(trim(substring(text, 0, semicolon)), main);
                        when None do
                            fits := equal(trim(text), main);
                    end case;
                end borrow;
                destroyString(lower);
                return fits;
            when None do
                return false;
        end case;
    end;

    generic [R: Region]
    function bodyOf(request: &[Request, R]): Option[Buffer[QueryPair]] is
        let raw: Span[Nat8, R] := requestBody(request);
        if spanLength(raw) > form_bytes then
            let none: Option[Buffer[QueryPair]] := None();
            return none;
        end if;
        if isPost(request) and isForm(request) then
            return parseQuery(raw);
        end if;
        let empty: Buffer[QueryPair] := allocateEmpty();
        return Some(value => empty);
    end;

    generic [R: Region]
    function formOf(request: &[Request, R]): Option[Buffer[QueryPair]] is
        case bodyOf(request) of
            when Some(value as from_body: Buffer[QueryPair]) do
                var pairs: Buffer[QueryPair] := from_body;
                case requestParam(request, "QUERY_STRING") of
                    when Some(value as query: String) do
                        let parsed: Option[Buffer[QueryPair]] := parseQuery(asSpan(&query));
                        destroyString(query);
                        case parsed of
                            when Some(value as found: Buffer[QueryPair]) do
                                var rest: Buffer[QueryPair] := found;
                                while bufferLength(&rest) > 0 do
                                    insertBack(&!pairs, removeFirst(&!rest));
                                end while;
                                destroyEmpty(rest);
                            when None do
                                destroyPairs(pairs);
                                let none: Option[Buffer[QueryPair]] := None();
                                return none;
                        end case;
                    when None do
                        skip;
                end case;
                return Some(value => pairs);
            when None do
                let none: Option[Buffer[QueryPair]] := None();
                return none;
        end case;
    end;

    generic [P: Region, N: Region]
    function valueOf(pairs: &[Buffer[QueryPair], P], name: Span[Nat8, N]): String is
        var i: Index := 0;
        while i < bufferLength(pairs) do
            let pair: &[QueryPair, P] := nthRef(pairs, i);
            if equal(asSpan(&(pair->name)), name) then
                return fromSpan(asSpan(&(pair->value)));
            end if;
            i := i + 1;
        end while;
        return fromSpan("");
    end;

    generic [P: Region, N: Region]
    function hasValue(pairs: &[Buffer[QueryPair], P], name: Span[Nat8, N]): Bool is
        var i: Index := 0;
        while i < bufferLength(pairs) do
            let pair: &[QueryPair, P] := nthRef(pairs, i);
            if equal(asSpan(&(pair->name)), name) then
                return true;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    generic [R: Region, N: Region]
    function cookieOf(request: &[Request, R], name: Span[Nat8, N]): String is
        case cookie(request, name) of
            when Some(value as found: String) do
                return found;
            when None do
                return fromSpan("");
        end case;
    end;

    generic [S: Region]
    function flowCookieName(settings: &[OpSettings, S]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, asSpan(&(settings->cookieName)));
        writeString(&!out, "-flow");
        return finalize(out);
    end;

    generic [N: Region, V: Region]
    function cookieHeader(name: Span[Nat8, N], value: Span[Nat8, V], max_age: Int64): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, name);
        writeByte(&!out, '=');
        if max_age >= 0 then
            writeString(&!out, value);
        end if;
        writeString(&!out, "; Path=/");
        if max_age > 0 then
            writeString(&!out, "; Max-Age=");
            let digits: String := decimalText(max_age);
            writeString(&!out, asSpan(&digits));
            destroyString(digits);
        else if max_age < 0 then
            writeString(&!out, "; Max-Age=0");
        end if;
        writeString(&!out, "; HttpOnly; Secure; SameSite=Strict");
        return finalize(out);
    end;

    generic [S: Region]
    function errorPage(settings: &[OpSettings, S], message: Span[Nat8, Static]): String is
        var page: StringBuilder := makeStringBuilder();
        writeString(&!page, asSpan(&(settings->name)));
        writeString(&!page, ": ");
        writeString(&!page, message);
        writeByte(&!page, 10);
        let text: String := finalize(page);
        let response: Response := addHeader(makeResponse(400, "text/plain; charset=utf-8"), "Cache-Control", "no-store");
        let output: String := finish(response, asSpan(&text));
        destroyString(text);
        return output;
    end;

    generic [L: Region, C: Region]
    function redirectTo(status: Nat16, location: Span[Nat8, L], cookies: &[Buffer[String], C]): String is
        var response: Response := addHeader(makeResponse(status, "text/html; charset=utf-8"), "Location", location);
        response := addHeader(response, "Cache-Control", "no-store");
        var i: Index := 0;
        while i < bufferLength(cookies) do
            response := addHeader(response, "Set-Cookie", asSpan(nthRef(cookies, i)));
            i := i + 1;
        end while;
        let escaped: String := htmlEscape(location);
        var page: StringBuilder := makeStringBuilder();
        writeString(&!page, "<a href=\"");
        writeString(&!page, asSpan(&escaped));
        writeString(&!page, "\">Found</a>.\n");
        destroyString(escaped);
        let text: String := finalize(page);
        let output: String := finish(response, asSpan(&text));
        destroyString(text);
        return output;
    end;

    generic [B: Region, C: Region]
    function jsonOutput(status: Nat16, content_type: Span[Nat8, Static], content: Span[Nat8, B],
        cache_control: Span[Nat8, C]): String is
        var response: Response := makeResponse(status, content_type);
        if spanLength(cache_control) > 0 then
            response := addHeader(response, "Cache-Control", cache_control);
        end if;
        return finish(response, content);
    end;

    function destroySubject(subject: Subject): Unit is
        let { email: String, name: String } := subject;
        destroyString(email);
        destroyString(name);
        return nil;
    end;

    generic [R: Region, I: Region]
    function activeSubject(db: &![Database[Writing], R], id: Span[Nat8, I]): Either[DbError, Option[Subject]] is
        case accountById(&~db, id) of
            when Left(left as error: DbError) do
                return Left(left => error);
            when Right(right as found: Option[Account]) do
                case found of
                    when Some(value as account: Account) do
                        let { id as account_id: String, email: String, name: String, locked: Bool, lockedAt as locked_at: Int64,
                            mustChangePassword as must_change_password: Bool, hasPassword as has_password: Bool, hasTotp as has_totp: Bool, createdAt as created_at: Int64,
                            updatedAt as updated_at: Int64 } := account;
                        destroyString(account_id);
                        if locked then
                            destroyString(email);
                            destroyString(name);
                            let none: Option[Subject] := None();
                            return Right(right => none);
                        end if;
                        return Right(right => Some(value => Subject(email => email, name => name)));
                    when None do
                        let none: Option[Subject] := None();
                        return Right(right => none);
                end case;
        end case;
    end;

    generic [Q: Region, R: Region, S: Region]
    function cookieSession(request: &[Request, Q], db: &![Database[Writing], R], settings: &[OpSettings, S],
        now: Int64): Either[DbError, Option[OpSession]] is
        let token: String := cookieOf(request, asSpan(&(settings->cookieName)));
        let found: Either[DbError, Option[OpSession]] := sessionByToken(&~db, asSpan(&token));
        destroyString(token);
        case found of
            when Left(left as error: DbError) do
                return Left(left => error);
            when Right(right as maybe: Option[OpSession]) do
                case maybe of
                    when Some(value as session: OpSession) do
                        let limits: Limits := settings->session;
                        if not isAlive(&session, now, limits.idle, limits.max) then
                            destroySession(session);
                            let none: Option[OpSession] := None();
                            return Right(right => none);
                        end if;
                        -- A bound session counts only while its cookie
                        -- is fresh: a copy taken off the device dies with it.
                        let owner: String := ownerOfSession(&session);
                        let fresh: Either[DbError, Option[Bool]] := bindingFresh(&~db, asSpan(&owner), now);
                        destroyString(owner);
                        case fresh of
                            when Left(left as error: DbError) do
                                destroySession(session);
                                return Left(left => error);
                            when Right(right as bound: Option[Bool]) do
                                case bound of
                                    when Some(value as alive: Bool) do
                                        if not alive then
                                            destroySession(session);
                                            let none: Option[OpSession] := None();
                                            return Right(right => none);
                                        end if;
                                    when None do
                                        skip;
                                end case;
                        end case;
                        let subject: String := subjectCopy(&session);
                        let active: Either[DbError, Option[Subject]] := activeSubject(&~db, asSpan(&subject));
                        destroyString(subject);
                        case active of
                            when Left(left as error: DbError) do
                                destroySession(session);
                                return Left(left => error);
                            when Right(right as who: Option[Subject]) do
                                case who of
                                    when Some(value as s: Subject) do
                                        destroySubject(s);
                                        return Right(right => Some(value => session));
                                    when None do
                                        destroySession(session);
                                        let none: Option[OpSession] := None();
                                        return Right(right => none);
                                end case;
                        end case;
                    when None do
                        let none: Option[OpSession] := None();
                        return Right(right => none);
                end case;
        end case;
    end;

    generic [I: Region]
    function bindingOwner(id: Span[Nat8, I]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "op:");
        writeString(&!out, id);
        return finalize(out);
    end;

    generic [S: Region]
    function ownerOfSession(session: &[OpSession, S]): String is
        return bindingOwner(asSpan(&(session->id)));
    end;

    generic [S: Region]
    function subjectCopy(session: &[OpSession, S]): String is
        return fromSpan(asSpan(&(session->subject)));
    end;

    generic [L: Region, C: Region, U: Region, I: Region, E: Region, A: Region]
    function audit(log: &![Log, L], event: Span[Nat8, Static], client: Span[Nat8, C], subject: Span[Nat8, U],
        sid: Span[Nat8, I], reason: Span[Nat8, E], result: Span[Nat8, Static], addr: Span[Nat8, A]): Unit is
        var entry: Entry := addText(makeEntry(Info(), "audit"), "event", event);
        if spanLength(client) > 0 then
            entry := addText(entry, "client", client);
        end if;
        if spanLength(subject) > 0 then
            entry := addText(entry, "subject", subject);
        end if;
        if spanLength(sid) > 0 then
            entry := addText(entry, "sid", sid);
        end if;
        if spanLength(reason) > 0 then
            entry := addText(entry, "reason", reason);
        end if;
        entry := addText(entry, "result", result);
        if spanLength(addr) > 0 then
            entry := addText(entry, "addr", addr);
        end if;
        let written: Bool := writeEntry(&~log, entry);
        return nil;
    end;

    generic [T: Region]
    function htmlEscape(text: Span[Nat8, T]): String is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < spanLength(text) do
            let c: Nat8 := text[i];
            if c = '&' then
                writeString(&!out, "&amp;");
            else if c = '<' then
                writeString(&!out, "&lt;");
            else if c = '>' then
                writeString(&!out, "&gt;");
            else if c = '"' then
                writeString(&!out, "&#34;");
            else if c = '\'' then
                writeString(&!out, "&#39;");
            else
                writeByte(&!out, c);
            end if;
            i := i + 1;
        end while;
        return finalize(out);
    end;
end module body.
