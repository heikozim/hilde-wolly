import Standard.Buffer (
    Buffer,
    allocateEmpty,
    length,
    nth,
    insertBack,
    destroyFree
);
import Standard.Grapheme (
    clusterEnd
);
import Standard.Utf8 (
    Decoded,
    decodeAt,
    decodedPoint,
    codePointValue
);
import Standard.UnicodeProperties (
    generalCategory
);

module body Wolly.TextLayout is
    -- No code point: what pointOf gives where no well-formed UTF-8 begins.
    constant no_point: Index := 1114112;

    -- One line of a layout: the bytes start to stop of the text, its width,
    -- the line of the text it comes from and whether a hard break ends it.
    record Line: Free is
        start: Index;
        stop: Index;
        width: Index;
        source: Index;
        hard: Bool;
    end;

    record Layout: Linear is
        lines: Buffer[Line];
        invariant length(&lines) >= 1;
    end;

    function mostTabSize(): Index is
        return 64;
    end;

    function mostLineWidth(): Index is
        return 65536;
    end;

    -- Whether point is of the class W or F of East-Asian-Width, or an emoji
    -- of Emoji_Presentation: the ranges in order, generated once from
    -- go-lea width.go, emoji-data.txt of Unicode 17.0.0 and the CJK, Kana
    -- and Tangut blocks of the planes 1 to 3.
    function isWidePoint(point: Index): Bool is
        if point < #x1100 then
            return false;
        end if;
        if point <= #x115F then
            return true;
        end if;
        if point < #x231A then
            return false;
        end if;
        if point <= #x231B then
            return true;
        end if;
        if point < #x2329 then
            return false;
        end if;
        if point <= #x232A then
