--
-- Part of Wolly, a web framework in Hilde.
--
-- SPDX-FileCopyrightText: 2026 Heiko Zimmermann
-- SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
--
-- The WebPs here were written for the test by a VP8L writer of its own
-- (two Python scripts), one feature

-- switched on at a time, and macOS's ImageIO decodes each to the source
-- pixels, alpha and colour under it included; each digest is the SHA-256
-- of the source's red, green and blue, or of its alpha, row by row.  The
-- gopher-doc files were written by libwebp (golang.org/x/image testdata,
-- Copyright 2009 The Go Authors, BSD-3-Clause), as are blue-purple-pink and
-- yellow_rose, their digests those of ImageIO's decoding.  The c- files
-- were written by cwebp 1.6.0, their digests those of

-- dwebp's decoding (-pam); for the lossless ones that is the source.
import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.String (
    String,
    destroyString,
    asSpan,
    length
);
import Standard.Text (
    hexToBytes,
    bytesToHex,
    startsWith,
    substring,
    equal
);
import Standard.Libcrypto (
    sha256
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Wolly.Webp (
    WebpError,
    NotWebp,
    WebpTooLarge,
    WebpUnsupported,
    WebpBroken,
    WebpPicture,
    readWebp,
    webpWidth,
    webpHeight,
    webpPixels,
    webpAlpha,
    destroyWebp
);

module body Wolly.Webp.Test is
    constant plainHex: Span[Nat8, Static] := "";
    constant lzCacheHex: Span[Nat8, Static] := "";
    constant farHex: Span[Nat8, Static] := "";
    constant predictHex: Span[Nat8, Static] := "";
    constant predictOddHex: Span[Nat8, Static] := "";
    constant selectTiesHex: Span[Nat8, Static] := "";
    constant palette2Hex: Span[Nat8, Static] := "524946462a000000574542505650384c1e0000002f0c8001100f305b53320dff030c3c080988ae9be6a4c511fd8fc9c9c901";
    constant palette4Hex: Span[Nat8, Static] := "5249464638000000574542505650384c2b0000002f0a8001101f305b53320d028124f3470ffcee401660f22591424f5ec92531c688fec796bf20db5bfe820000";
    constant palette16Hex: Span[Nat8, Static] := "524946465e000000574542505650384c510000002f088001107f305b53320d4603c1b8a51585a4283f72603f77f77bdfddff75770f5453a05a9dede3f1b1294ca1ab90c25852482185b1a490420a8144f43f60f59626ff13b0eaa4c95302b69d34db95c00000";
    constant palette200Hex: Span[Nat8, Static] := "";
    constant alphaHex: Span[Nat8, Static] := "";
    constant simpleHex: Span[Nat8, Static] := "524946461a000000574542505650384c0e0000002f02400000f80172133ad0ffa800";
    constant extendedHex: Span[Nat8, Static] := "";
    constant alphaLeftHex: Span[Nat8, Static] := "";
    constant alphaAboveHex: Span[Nat8, Static] := "";
    constant alphaGradientHex: Span[Nat8, Static] := "";
    constant alphaRawHex: Span[Nat8, Static] := "";
    constant cutHex: Span[Nat8, Static] := "";
    constant lossyHex: Span[Nat8, Static] := "524946461600000057454250565038200a00000000000000000000000000";
    constant animHex: Span[Nat8, Static] := "";
    constant gopherDoc1BppHex: Span[Nat8, Static] := "";
    constant gopherDoc2BppHex: Span[Nat8, Static] := "";
    constant gopherDoc4BppHex: Span[Nat8, Static] := "";
    constant gopherDoc8BppHex: Span[Nat8, Static] := "";
    constant gopherDocSkipHgroupHex: Span[Nat8, Static] := "";
    constant gopherDocWithAlphaHex: Span[Nat8, Static] := "";
    constant bluePurplePinkHex: Span[Nat8, Static] := "";
    constant yellow_RoseHex: Span[Nat8, Static] := "";
    constant cSharp7Hex: Span[Nat8, Static] := "";
    constant cSharp3Hex: Span[Nat8, Static] := "";
    constant cSimpleHex: Span[Nat8, Static] := "";
    constant cSeg1Hex: Span[Nat8, Static] := "";
    constant cQ5Hex: Span[Nat8, Static] := "";
    constant cQ100Hex: Span[Nat8, Static] := "";
    constant cAlphaNoneHex: Span[Nat8, Static] := "";
    constant cAlphaBestHex: Span[Nat8, Static] := "";
    constant cAlphaRawHex: Span[Nat8, Static] := "";
    constant cLosslessHex: Span[Nat8, Static] := "";
    constant cLosslessOddHex: Span[Nat8, Static] := "5249464658000000574542505650384c4b0000002f24800500cd6544ff63011084ff700d31e0fd0f0106b56d2429936fff0d1f3c633607440316cb32ffbfa6cb7aa86ddb86b1d796f2054c8c9ceb989e09e447823468bba5f22341f4bd9f2600";
    constant cLosslessExactHex: Span[Nat8, Static] := "";

    function bytesOf(hex: Span[Nat8, Static]): String is
        case hexToBytes(hex) of
            when Some(value as bytes: String) do
                return bytes;
            when None do
                assertTrue(false, "the fixture is hex");
                return bytesOf("00");
        end case;
    end;

    -- Whether the SHA-256 of bytes is digest.
    generic [P: Region]
    function digestIs(bytes: Span[Nat8, P], digest: Span[Nat8, Static]): Bool is
        case sha256(bytes) of
            when Some(value as sum: String) do
                let hex: String := bytesToHex(asSpan(&sum));
                let good: Bool := equal(asSpan(&hex), digest);
                destroyString(hex);
                destroyString(sum);
                return good;
            when None do
                return false;
        end case;
    end;

    -- Whether the WebP in hex reads to width by height pixels and alpha of
    -- those digests.
    function readsTo(hex: Span[Nat8, Static], width: Index, height: Index, pixels: Span[Nat8, Static],
                     alpha: Span[Nat8, Static]): Bool is
        let data: String := bytesOf(hex);
        var good: Bool := false;
        case readWebp(asSpan(&data), 16000000) of
            when Right(right as picture: WebpPicture) do
                good := (webpWidth(&picture) = width) and (webpHeight(&picture) = height);
                good := good and digestIs(webpPixels(&picture), pixels);
                good := good and digestIs(webpAlpha(&picture), alpha);
                destroyWebp(picture);
            when Left(left as error: WebpError) do
                good := false;
        end case;
        destroyString(data);
        return good;
    end;

    generic [D: Region]
    function errorOf(data: Span[Nat8, D], maxPixels: Index): Index is
        case readWebp(data, maxPixels) of
            when Right(right as picture: WebpPicture) do
                destroyWebp(picture);
                return 0;
            when Left(left as error: WebpError) do
                case error of
                    when NotWebp do
                        return 1;
                    when WebpTooLarge do
                        return 2;
                    when WebpUnsupported do
                        return 3;
                    when WebpBroken do
                        return 4;
                end case;
        end case;
    end;

    function hexError(hex: Span[Nat8, Static], maxPixels: Index): Index is
        let data: String := bytesOf(hex);
        let code: Index := errorOf(asSpan(&data), maxPixels);
        destroyString(data);
        return code;
    end;

    function testFeatures(): Unit is
        assertTrue(readsTo(plainHex, 37, 23, "2e47fda45576cff046a6536507a7cde94e2508559cfe42290f02acee6c0f75af",
                           "bddcc7683f74308b0d347947ff40761d6c68439aa4ae0fbb768f7f0a47ec0a0d"), "plain: 37 by 23, literals only, normal codes");
        assertTrue(readsTo(lzCacheHex, 48, 40, "d379a4e760da3d806e3c3e7f6ac01aee06e4d18b76050ef0cf41fa47e47332c4",
                           "a97445652c91c7b12838cdbe8545cdd1891a8eda7af5f1e8247c7592ae158401"), "lz-cache: backward references with plane distances, colour cache of 6 bits, 3 groups, max_symbol");
        assertTrue(readsTo(farHex, 48, 40, "d379a4e760da3d806e3c3e7f6ac01aee06e4d18b76050ef0cf41fa47e47332c4",
                           "a97445652c91c7b12838cdbe8545cdd1891a8eda7af5f1e8247c7592ae158401"), "far: backward references with distances past the plane table");
        assertTrue(readsTo(predictHex, 64, 48, "8783592b6435dc1c02e179615318843a36dbffa487f8ae6d80191bf801db191d",
                           "1a7493ff2f2bde5f78405d46eb01abfeaea9b0a95fa5b6cec211b05faa0cf1d3"), "predict: subtract green, predictor of all 14 modes, colour transform with negative factors");
        assertTrue(readsTo(predictOddHex, 37, 23, "2e47fda45576cff046a6536507a7cde94e2508559cfe42290f02acee6c0f75af",
                           "bddcc7683f74308b0d347947ff40761d6c68439aa4ae0fbb768f7f0a47ec0a0d"), "predict-odd: predictor in blocks cut at the edges, modes 14 and 15, references");
        assertTrue(readsTo(selectTiesHex, 16, 16, "c88e5cc26fd7e449a4b0d778558003b3876a4cd133179659eca840520602ecb9",
                           "3d6876a0146de8576eb2395a858de1213d1b92c65b779df3a331cfd5a4584546"), "select-ties: predictor mode 11 where left and top are equally far: top, as libwebp takes it");
        assertTrue(readsTo(palette2Hex, 13, 7, "22583a6a81eed3da3f639ce4a50a74157b24f3e1cfb9e4d80b8f0ed69eb8f524",
                           "93ffae48393313592855c1e10434fe34584c28c6d0e3300ff5b90fd44066431a"), "palette-2: 2 colours, 8 pixels a byte, 13 wide");
        assertTrue(readsTo(palette4Hex, 11, 7, "aef1f72d124761d1aad4eac6f404d4854d9f90d1d370892486c3e1a77c6d9f36",
                           "08e99b9f0632e4cc97b6094ac63da7d6b6cfcddc3728ee34eb63891ae81a871f"), "palette-4: 4 colours, 4 pixels a byte, 11 wide");
        assertTrue(readsTo(palette16Hex, 9, 7, "394f3af8df95ce564c9334c803f3025b3da26f1ed6af5a9e425eb60504fa18e4",
                           "3c66b2162d9a1d3603bd9066c8b5ff714d1e445734178dbae97fbe12f4ebb8ad"), "palette-16: 16 colours, 2 pixels a byte, 9 wide");
        assertTrue(readsTo(palette200Hex, 21, 7, "4dd1ab1366ee18f8b7a328d217dc168c0a81850ca29254862792512d63545eb4",
                           "cfa5689042b046fa8277690eee92bac2124d772e01078a1019249bef7e7d2a9c"), "palette-200: 200 colours with alpha, a pixel a byte");
        assertTrue(readsTo(alphaHex, 23, 19, "c65673d8bdd484c28388a4bebfc9d875d590b4f80e7fa7719fc4d5f0495b0ff2",
                           "2b6e0a074a034f01dfcafa0ffb96bffc316ab1ad752d7e600b7ecf2e5769deb2"), "alpha: alpha of every value");
        assertTrue(readsTo(simpleHex, 3, 2, "4920a8d1259fb92da24f11c548f25ac2fa13b5807f7bd94126da94bb371dfe32",
                           "ce8bee525d6736e9825261b19a9b51719f9dc4bb728e95cf7067a2142b03b362"), "simple: simple codes of one and two symbols");
        assertTrue(readsTo(extendedHex, 37, 23, "2e47fda45576cff046a6536507a7cde94e2508559cfe42290f02acee6c0f75af",
                           "bddcc7683f74308b0d347947ff40761d6c68439aa4ae0fbb768f7f0a47ec0a0d"), "extended: VP8X with an XMP chunk of odd length before VP8L");
        assertTrue(readsTo(alphaLeftHex, 150, 100, "0a1e13a4ddbbe50ffb09dc9e8860d6336df0ab6a490a9a12b14dc5660c0ed396",
                           "dfbedf6e0ea02856bbcfae9a311a8295d0b58967e8d4809631c4a3a80e062910"), "alpha-left: lossy with ALPH filtered from the left, coded as an image stream");
        assertTrue(readsTo(alphaAboveHex, 150, 100, "0a1e13a4ddbbe50ffb09dc9e8860d6336df0ab6a490a9a12b14dc5660c0ed396",
                           "dfbedf6e0ea02856bbcfae9a311a8295d0b58967e8d4809631c4a3a80e062910"), "alpha-above: lossy with ALPH filtered from above");
        assertTrue(readsTo(alphaGradientHex, 150, 100, "0a1e13a4ddbbe50ffb09dc9e8860d6336df0ab6a490a9a12b14dc5660c0ed396",
                           "dfbedf6e0ea02856bbcfae9a311a8295d0b58967e8d4809631c4a3a80e062910"), "alpha-gradient: lossy with ALPH filtered by the gradient");
        assertTrue(readsTo(alphaRawHex, 150, 100, "0a1e13a4ddbbe50ffb09dc9e8860d6336df0ab6a490a9a12b14dc5660c0ed396",
                           "dfbedf6e0ea02856bbcfae9a311a8295d0b58967e8d4809631c4a3a80e062910"), "alpha-raw: lossy with ALPH raw, gradient-filtered");
        assertTrue(readsTo(gopherDoc1BppHex, 75, 100, "20a85b5bea81d053717f3fb07e33d4774b635dc7e4ce996eda5f153fbab5b352",
                           "5eac86f44466f48c6adf58ab4ed2d4b3c49f7ed7420f3082d6afdc882c0939a5"), "gopher-doc.1bpp.lossless.webp: libwebp: 2 colours bundled 8 a byte");
        assertTrue(readsTo(gopherDoc2BppHex, 75, 100, "5ec82cf45bbaf6c9fdd592cadf84739e518a5295bff6351e4988f0e864b8cb48",
                           "5eac86f44466f48c6adf58ab4ed2d4b3c49f7ed7420f3082d6afdc882c0939a5"), "gopher-doc.2bpp.lossless.webp: libwebp: 4 colours bundled 4 a byte");
        assertTrue(readsTo(gopherDoc4BppHex, 75, 100, "3072740a4c6ab61addce77c2314b0c214b069618a7ac94f7c4545d5584c95e48",
                           "5eac86f44466f48c6adf58ab4ed2d4b3c49f7ed7420f3082d6afdc882c0939a5"), "gopher-doc.4bpp.lossless.webp: libwebp: 16 colours bundled 2 a byte");
        assertTrue(readsTo(gopherDoc8BppHex, 75, 100, "4a99be556f452c425ffa164738520511f30088b59086e898f7d0a91c360cfced",
                           "5eac86f44466f48c6adf58ab4ed2d4b3c49f7ed7420f3082d6afdc882c0939a5"), "gopher-doc.8bpp.lossless.webp: libwebp: a palette of 256 colours");
        assertTrue(readsTo(gopherDocSkipHgroupHex, 75, 100, "4a99be556f452c425ffa164738520511f30088b59086e898f7d0a91c360cfced",
                           "5eac86f44466f48c6adf58ab4ed2d4b3c49f7ed7420f3082d6afdc882c0939a5"), "gopher-doc.skip-hgroup.lossless.webp: libwebp: groups of prefix codes some of which no pixel uses");
        assertTrue(readsTo(gopherDocWithAlphaHex, 75, 100, "3ad5ca8cf4341294fb0e77c6324fcd4fcb5af2846e0e5a7d5a45d0e0d3537a8a",
                           "1ad214a779498715faad2b85ba54ebc8cb27a2b27027bb086a49677dbfd78697"), "gopher-doc.with-alpha.lossless.webp: libwebp: alpha below 255 on 4119 pixels");
        assertTrue(readsTo(bluePurplePinkHex, 150, 100, "0a1e13a4ddbbe50ffb09dc9e8860d6336df0ab6a490a9a12b14dc5660c0ed396",
                           "bfc5b164e72195f43728bf37b07bce2be21f37d3169c62437c342ce397a9826f"), "blue-purple-pink.lossy.webp: libwebp lossy (VP8): RGB as ImageIO converts it, opaque");
        assertTrue(readsTo(yellow_RoseHex, 400, 301, "111f3b9133f497a127f99104bda7b34d187a6bac0b57d4adac92f0cd36294b62",
                           "be4cafd4af958ee23f5338fd2e4445b69e438c75b166d4e09b9a8c3c54b5c499"), "yellow_rose.lossy-with-alpha.webp: libwebp lossy with ALPH: alpha as libwebp's golden plane, below 255 on 2061 pixels");
        assertTrue(readsTo(cSharp7Hex, 37, 23, "a518f762f557ba424142a3fff183ca06934ff37e25b572460afc37a254a296d5",
                           "bddcc7683f74308b0d347947ff40761d6c68439aa4ae0fbb768f7f0a47ec0a0d"), "c-sharp7: cwebp: normal filter of strength 80, sharpness 7 (dwebp's RGB)");
        assertTrue(readsTo(cSharp3Hex, 51, 45, "5a6539256276b34506d938574737dfd0a0538ff384d4ddaece1ef8812b5fd3f1",
                           "d41bbfdd49bd2c7f1975afc208865708926736db67984349e094986e911862c5"), "c-sharp3: cwebp: normal filter, sharpness 3");
        assertTrue(readsTo(cSimpleHex, 51, 45, "f717b48be2127a62b955fa7f729857a54c516b555ad84a8f209d85bf2ebd7a6e",
                           "d41bbfdd49bd2c7f1975afc208865708926736db67984349e094986e911862c5"), "c-simple: cwebp: simple filter");
        assertTrue(readsTo(cSeg1Hex, 64, 48, "f4e84cd06d4ec90ca0e026d65a77ec115ae5031e2573597cf2fb15e30ba3f7a8",
                           "1a7493ff2f2bde5f78405d46eb01abfeaea9b0a95fa5b6cec211b05faa0cf1d3"), "c-seg1: cwebp: one segment");
        assertTrue(readsTo(cQ5Hex, 51, 45, "6c76a43a3520dbc441618a76b62d671098ff1c51591d6434e8c16f141424bb9c",
                           "d41bbfdd49bd2c7f1975afc208865708926736db67984349e094986e911862c5"), "c-q5: cwebp: quality 5, the largest quantisers");
        assertTrue(readsTo(cQ100Hex, 37, 23, "c1e6bf5d2bdd13b7d8d76e373949622670a493037a75e9971e001b0db23a1bf8",
                           "bddcc7683f74308b0d347947ff40761d6c68439aa4ae0fbb768f7f0a47ec0a0d"), "c-q100: cwebp: quality 100, the smallest quantisers");
        assertTrue(readsTo(cAlphaNoneHex, 40, 30, "f617f7c99d75ec9edd04dfc6c8b5dc6fa4660d2fd808d1559fd020aa6f3f2c16",
                           "33c0094d3b921543f3b6262407d9c7c95427542b6097fb856107dd1e7755b730"), "c-alpha-none: cwebp: lossy with alpha, no alpha filter");
        assertTrue(readsTo(cAlphaBestHex, 40, 30, "f617f7c99d75ec9edd04dfc6c8b5dc6fa4660d2fd808d1559fd020aa6f3f2c16",
                           "33c0094d3b921543f3b6262407d9c7c95427542b6097fb856107dd1e7755b730"), "c-alpha-best: cwebp: lossy with alpha, the best alpha filter");
        assertTrue(readsTo(cAlphaRawHex, 40, 30, "f617f7c99d75ec9edd04dfc6c8b5dc6fa4660d2fd808d1559fd020aa6f3f2c16",
                           "33c0094d3b921543f3b6262407d9c7c95427542b6097fb856107dd1e7755b730"), "c-alpha-raw: cwebp: lossy with raw alpha (method 0)");
        assertTrue(readsTo(cLosslessHex, 51, 45, "db8743b95eb262c0e140c0079d975ab654cb8524ea59cfb52e4fb957ae57db17",
                           "d41bbfdd49bd2c7f1975afc208865708926736db67984349e094986e911862c5"), "c-lossless: cwebp: lossless at -z 9, the source pixels");
        assertTrue(readsTo(cLosslessOddHex, 37, 23, "2e47fda45576cff046a6536507a7cde94e2508559cfe42290f02acee6c0f75af",
                           "bddcc7683f74308b0d347947ff40761d6c68439aa4ae0fbb768f7f0a47ec0a0d"), "c-lossless-odd: cwebp: lossless at -z 6, 37 by 23");
        assertTrue(readsTo(cLosslessExactHex, 40, 30, "784d1f7440d57001b4f4ec44a4d6956e72a9cec28daa7d25d5e64eb2e948dad9",
                           "33c0094d3b921543f3b6262407d9c7c95427542b6097fb856107dd1e7755b730"), "c-lossless-exact: cwebp: lossless -exact, colour under alpha 0 kept");
        return nil;
    end;

    function testRefused(): Unit is
        assertTrue(errorOf("GIF89a..........", 100) = 1, "a GIF is no WebP");
        assertTrue(errorOf("RIFF....WAVEfmt ", 100) = 1, "a WAVE is no WebP");
        assertTrue(errorOf("RIFF", 100) = 1, "four bytes are no WebP");
        assertTrue(errorOf("RIFF....WEBP", 100) = 4, "a WebP without chunks is Broken");
        assertTrue(hexError(plainHex, 37 * 23) = 0, "exactly maxPixels pixels are read");
        assertTrue(hexError(plainHex, (37 * 23) - 1) = 2, "one pixel more than maxPixels");
        assertTrue(hexError(lossyHex, 100) = 3, "a VP8 frame that is not shown (its show bit 0) is Unsupported");
        assertTrue(hexError(animHex, 16000000) = 3, "an animation is Unsupported");
        assertTrue(hexError(cutHex, 16000000) = 4, "a bitstream cut in half inside lengths that fit is Broken");
        let plain: String := bytesOf(plainHex);
        assertTrue(errorOf(substring(asSpan(&plain), 0, 100), 16000000) = 4, "a chunk longer than the file is Broken");
        destroyString(plain);
        return nil;
    end;

    -- data with the byte at at inverted.
    generic [D: Region]
    function changedOf(data: Span[Nat8, D], at: Index): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, substring(data, 0, at));
        writeByte(&!out, bitwiseXor(data[at], (255 : Nat8)));
        writeString(&!out, substring(data, at + 1, spanLength(data)));
        return finalize(out);
    end;

    -- Part part of four: the files with the byte at part, part + 4 and so
    -- on of hex inverted; none fails other than with an error, and some
    -- of them are refused.
    function invertedPart(hex: Span[Nat8, Static], part: Index, message: Span[Nat8, Static]): Unit is
        let data: String := bytesOf(hex);
        var read: Index := 0;
        var tried: Index := 0;
        var at: Index := part;
        while at < length(&data) do
            let bytes: String := changedOf(asSpan(&data), at);
            if errorOf(asSpan(&bytes), 16000000) = 0 then
                read := read + 1;
            end if;
            destroyString(bytes);
            tried := tried + 1;
            at := at + 4;
        end while;
        destroyString(data);
        assertTrue(read < tried, message);
        return nil;
    end;

    function testRobustCache0(): Unit is
        invertedPart(lzCacheHex, 0, "lz-cache: each byte inverted, not all read");
        return nil;
    end;

    function testRobustCache1(): Unit is
        invertedPart(lzCacheHex, 1, "lz-cache: each byte inverted, not all read");
        return nil;
    end;

    function testRobustCache2(): Unit is
        invertedPart(lzCacheHex, 2, "lz-cache: each byte inverted, not all read");
        return nil;
    end;

    function testRobustCache3(): Unit is
        invertedPart(lzCacheHex, 3, "lz-cache: each byte inverted, not all read");
        return nil;
    end;

    function testRobustPalette0(): Unit is
        invertedPart(palette200Hex, 0, "palette-200: each byte inverted, not all read");
        return nil;
    end;

    function testRobustPalette1(): Unit is
        invertedPart(palette200Hex, 1, "palette-200: each byte inverted, not all read");
        return nil;
    end;

    function testRobustPalette2(): Unit is
        invertedPart(palette200Hex, 2, "palette-200: each byte inverted, not all read");
        return nil;
    end;

    function testRobustPalette3(): Unit is
        invertedPart(palette200Hex, 3, "palette-200: each byte inverted, not all read");
        return nil;
    end;
end module body.
