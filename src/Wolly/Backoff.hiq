--
-- SQL of its own over Standard.Database, as Wolly.Limit: every statement is
-- a constant, every value is bound.  A failure is one upsert, so two
-- requests at once both count.
import Standard.Database (
    Database,
    Writing,
    DbError,
    Cursor,
    noValues,
    withInt64,
    withText,
    start,
    execute,
    advance,
    columnInt64,
    finish
);
import Wolly.Dialect (
    pick
);

module body Wolly.Backoff is
    constant makeTable: Span[Nat8, Static] := "CREATE TABLE IF NOT EXISTS wolly_backoff (key TEXT PRIMARY KEY, failures INTEGER NOT NULL, latest INTEGER NOT NULL) STRICT";
    constant makeTablePg: Span[Nat8, Static] := "CREATE TABLE IF NOT EXISTS wolly_backoff (key TEXT PRIMARY KEY, failures BIGINT NOT NULL, latest BIGINT NOT NULL)";
    constant readKey: Span[Nat8, Static] := "SELECT failures, latest FROM wolly_backoff WHERE key = ?";
    constant failKey: Span[Nat8, Static] := "INSERT INTO wolly_backoff (key, failures, latest) VALUES (?, 1, ?) ON CONFLICT (key) DO UPDATE SET failures = CASE WHEN ? - wolly_backoff.latest > ? THEN 1 ELSE wolly_backoff.failures + 1 END, latest = ?";
    constant dropKey: Span[Nat8, Static] := "DELETE FROM wolly_backoff WHERE key = ?";
    constant dropOld: Span[Nat8, Static] := "DELETE FROM wolly_backoff WHERE latest < ?";

    function defaultRule(): BackoffRule is
        return BackoffRule(free => 3, base => 1, max => 900, forget => 86400);
    end;

    function delayAfter(rule: BackoffRule, failures: Int64): Int64 is
        if failures < rule.free then
            return 0;
        end if;
        var delay: Int64 := rule.base;
        var over: Int64 := failures - rule.free;
        while over > 0 do
            if delay >= (rule.max - delay) then
                return rule.max;
            end if;
            delay := delay * 2;
            over := over - 1;
        end while;
        if delay > rule.max then
            return rule.max;
        end if;
        return delay;
    end;

    generic [R: Region]
    function prepareBackoff(db: &![Database[Writing], R]): Option[DbError] is
        let table: Span[Nat8, Static] := pick(&db, makeTable, makeTablePg);
        case execute(&~db, table, noValues()) of
            when Right(right as changed: Nat64) do
                return None();
            when Left(left as error: DbError) do
                return Some(value => error);
        end case;
    end;

    -- The failures of key and the time of its last one; both 0 when it is
    -- not known.
    record Entry: Free is
        failures: Int64;
        last: Int64;
    end;

    generic [M: Free, R: Region, K: Region]
    function entryOf(db: &![Database[M], R], key: Span[Nat8, K]): Either[DbError, Entry] is
        var cursor: Cursor := start(&~db, readKey, withText(noValues(), key));
        var failures: Int64 := 0;
        var last: Int64 := 0;
        if advance(&!cursor) then
            failures := columnInt64(&cursor, 0);
            last := columnInt64(&cursor, 1);
        end if;
        case finish(&~db, cursor) of
            when Some(value as error: DbError) do
                return Left(left => error);
            when None do
                return Right(right => Entry(failures => failures, last => last));
        end case;
    end;

    generic [R: Region, K: Region]
    function backoffWait(db: &![Database[Writing], R], key: Span[Nat8, K], rule: BackoffRule,
        now: Int64): Either[DbError, Int64] is
        case entryOf(&~db, key) of
            when Left(left as error: DbError) do
                return Left(left => error);
            when Right(right as entry: Entry) do
                if entry.failures = 0 then
                    return Right(right => (0 : Int64));
                end if;
                if (now - entry.last) > rule.forget then
                    case backoffReset(&~db, key) of
                        when Some(value as error: DbError) do
                            return Left(left => error);
                        when None do
                            return Right(right => (0 : Int64));
                    end case;
                end if;
                let left: Int64 := (entry.last + delayAfter(rule, entry.failures)) - now;
                if left > 0 then
                    return Right(right => left);
                end if;
                return Right(right => (0 : Int64));
        end case;
    end;

    generic [R: Region, K: Region]
    function backoffFail(db: &![Database[Writing], R], key: Span[Nat8, K], rule: BackoffRule,
        now: Int64): Option[DbError] is
        case execute(&~db, failKey, withInt64(withInt64(withInt64(withInt64(withText(noValues(), key), now), now), rule.forget),
            now)) of
            when Right(right as changed: Nat64) do
                return None();
            when Left(left as error: DbError) do
                return Some(value => error);
        end case;
    end;

    generic [M: Free, R: Region, K: Region]
    function backoffFailures(db: &![Database[M], R], key: Span[Nat8, K], rule: BackoffRule,
        now: Int64): Either[DbError, Int64] is
        case entryOf(&~db, key) of
            when Left(left as error: DbError) do
                return Left(left => error);
            when Right(right as entry: Entry) do
                if (entry.failures = 0) or ((now - entry.last) > rule.forget) then
                    return Right(right => (0 : Int64));
                end if;
                return Right(right => entry.failures);
        end case;
    end;

    generic [R: Region, K: Region]
    function backoffReset(db: &![Database[Writing], R], key: Span[Nat8, K]): Option[DbError] is
        case execute(&~db, dropKey, withText(noValues(), key)) of
            when Right(right as changed: Nat64) do
                return None();
            when Left(left as error: DbError) do
                return Some(value => error);
        end case;
    end;

    generic [R: Region]
    function pruneBackoff(db: &![Database[Writing], R], rule: BackoffRule, now: Int64): Either[DbError, Int64] is
        case execute(&~db, dropOld, withInt64(noValues(), now - rule.forget)) of
            when Right(right as changed: Nat64) do
                case toInt64(changed) of
                    when Some(value as n: Int64) do
                        return Right(right => n);
                    when None do
                        return Right(right => (0 : Int64));
                end case;
            when Left(left as error: DbError) do
                return Left(left => error);
        end case;
    end;
end module body.
