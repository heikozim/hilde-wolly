import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.String (
    String,
    destroyString,
    fromSpan,
    asSpan,
    length
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    nthRef,
    length as bufferLength,
    removeLast,
    destroyEmpty
);
import Standard.Text (
    equal,
    contains,
    startsWith,
    indexOf,
    substring,
    bytesToHex
);
import Standard.Libcrypto (
    randomBytes
);
import Standard.Jws (
    base64UrlDecode,
    base64UrlEncode
);
import Standard.File (
    removeFileIfThere
);
import Standard.Vault (
    Vault,
    VaultError,
    createPepper,
    createKey,
    openVault,
    closeVault,
    setSecret,
    getSecret
);
import Wolly.OpKey (
    KeyFamily,
    MlDsa,
    Composite,
    RingKey,
    Verified,
    algorithmOf,
    familyOf,
    makeRingKey,
    newRingKey,
    destroyRingKey,
    keyEntry,
    readKeyEntry,
    entryName,
    signToken,
    publicJwk,
    activeKey,
    hasFamily,
    isDue,
    rotate,
    prune,
    keySet,
    destroyRing,
    destroyVerified,
    verify,
    loadRing,
    saveRing
);

module body Wolly.OpKey.Test is
    -- RFC 9964, Appendix A.1: the thumbprint and the start of the public key
    -- of ML-DSA-44 for the all-zero seed.
    constant rfcKid: Span[Nat8, Static] := "T4xl70S7MT6Zeq6r9V9fPJGVn76wfnXJ21-gyo0Gu6o";
    constant rfcPubStart: Span[Nat8, Static] := "unH59k4RuutY-pxvu24U5h8YZD2rSVtHU5qRZsoBmBMcRPgmu9VuNOVdteXi1zNI";
    constant zeroSeed: Span[Nat8, Static] := "\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}\u{0}";
    -- The vault value an earlier provider written in Go writes for that key.
    constant goEntry: Span[Nat8, Static] := "{\"alg\":\"ML-DSA-44\",\"seed\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"created\":1700000000}";
    constant goRetired: Span[Nat8, Static] := "{\"alg\":\"ML-DSA-44\",\"seed\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"created\":1700000000,\"retired\":1700000100}";
    constant prefix: Span[Nat8, Static] := "RAMBO_SIGNING_KEY_";
    constant day: Int64 := 86400;

    function zeroKey(): RingKey is
        case makeRingKey(MlDsa(), zeroSeed, 1700000000, 0) of
            when Some(value as key: RingKey) do
                return key;
            when None do
                abort("the key of the zero seed is not made");
        end case;
    end;

    generic [K: Region]
    function kidOf(key: &[RingKey, K]): Span[Nat8, K] is
        return asSpan(&(key->kid));
    end;

    generic [K: Region]
    function retiredOf(key: &[RingKey, K]): Int64 is
        return key->retired;
    end;

    function testRfcVector(): Unit is
        let key: RingKey := zeroKey();
        assertTrue(equal(kidOf(&key), rfcKid), "the kid is the thumbprint of RFC 9964");
        let jwk: String := publicJwk(&key);
        assertTrue(startsWith(asSpan(&jwk), "{\"kty\":\"AKP\",\"alg\":\"ML-DSA-44\",\"kid\":\"T4xl70S7MT6Zeq6r9V9fPJGVn76wfnXJ21-gyo0Gu6o\",\"use\":\"sig\",\"pub\":\""),
            "the JWK has kty, alg, kid, use and pub in this order");
        assertTrue(contains(asSpan(&jwk), rfcPubStart), "the JWK holds the public key of RFC 9964");
        destroyString(jwk);
        let name: String := entryName(prefix, rfcKid);
        assertTrue(length(&name) = 34, "the vault name is the prefix and 16 hex digits");
        assertTrue(startsWith(asSpan(&name), prefix), "the vault name begins with the prefix");
        destroyString(name);
        destroyRingKey(key);
        return nil;
    end;

    function testFamilies(): Unit is
        assertTrue(equal(algorithmOf(MlDsa()), "ML-DSA-44"), "ML-DSA-44");
        case familyOf("ML-DSA-65") of
            when Some(value as f: KeyFamily) do
                assertTrue(false, "ML-DSA-65 is no family of the ring");
            when None do
                skip;
        end case;
        case familyOf("RS256") of
            when Some(value as f: KeyFamily) do
                assertTrue(false, "RS256 is no family");
            when None do
                skip;
        end case;
        case makeRingKey(MlDsa(), "short", 1, 0) of
            when Some(value as key: RingKey) do
                assertTrue(false, "a seed of 5 bytes is refused");
                destroyRingKey(key);
            when None do
                skip;
        end case;
        return nil;
    end;

    function testGoEntry(): Unit is
        case readKeyEntry(goEntry) of
            when Some(value as key: RingKey) do
                assertTrue(equal(kidOf(&key), rfcKid), "the value of the Go provider gives the key of RFC 9964");
                let back: String := keyEntry(&key);
                assertTrue(equal(asSpan(&back), goEntry), "the value is written back byte for byte");
                destroyString(back);
                destroyRingKey(key);
            when None do
                assertTrue(false, "the value of the Go provider is read");
        end case;
        case readKeyEntry(goRetired) of
            when Some(value as key: RingKey) do
                assertTrue(retiredOf(&key) = 1700000100, "retired is read");
                let back: String := keyEntry(&key);
                assertTrue(equal(asSpan(&back), goRetired), "retired is written when it is not 0");
                destroyString(back);
                destroyRingKey(key);
            when None do
                assertTrue(false, "a retired value is read");
        end case;
        case readKeyEntry("{\"alg\":\"ML-DSA-44\",\"seed\":\"AAAA\",\"created\":1700000000}") of
            when Some(value as key: RingKey) do
                assertTrue(false, "a seed of 3 bytes is refused");
                destroyRingKey(key);
            when None do
                skip;
        end case;
        case readKeyEntry("{\"alg\":\"ML-DSA-44\",\"seed\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"}") of
            when Some(value as key: RingKey) do
                assertTrue(false, "a value without created is refused");
                destroyRingKey(key);
            when None do
                skip;
        end case;
        case readKeyEntry("{\"alg\":\"ES256\",\"seed\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"created\":1}") of
            when Some(value as key: RingKey) do
                assertTrue(false, "another algorithm is refused");
                destroyRingKey(key);
            when None do
                skip;
        end case;
        return nil;
    end;

    -- The header of a compact token, decoded.
    generic [T: Region]
    function headerOf(token: Span[Nat8, T]): String is
        case indexOf(token, ".") of
            when Some(value as dot: Index) do
                case base64UrlDecode(substring(token, 0, dot)) of
                    when Some(value as header: String) do
                        return header;
                    when None do
                        return fromSpan("");
                end case;
            when None do
                return fromSpan("");
        end case;
    end;

    -- The token with its last byte changed.
    generic [T: Region]
    function tampered(token: Span[Nat8, T]): String is
        var out: StringBuilder := makeStringBuilder();
        let last: Index := spanLength(token) - 1;
        writeString(&!out, substring(token, 0, last));
        if token[last] = 'A' then
            writeByte(&!out, 'B');
        else
            writeByte(&!out, 'A');
        end if;
        return finalize(out);
    end;

    generic [V: Region]
    function typOf(found: &[Verified, V]): Span[Nat8, V] is
        return asSpan(&(found->typ));
    end;

    generic [V: Region]
    function payloadOf(found: &[Verified, V]): Span[Nat8, V] is
        return asSpan(&(found->payload));
    end;

    generic [T: Region, R: Region]
    function verifies(token: Span[Nat8, T], ring: &[Buffer[RingKey], R], typ: Span[Nat8, Static],
        payload: Span[Nat8, Static]): Bool is
        case verify(token, ring) of
            when Some(value as found: Verified) do
                let fits: Bool := equal(typOf(&found), typ) and equal(payloadOf(&found), payload);
                destroyVerified(found);
                return fits;
            when None do
                return false;
        end case;
    end;

    -- token with its header written anew as alg, kid of the old header and
    -- the typ of an ID token; the payload and the signature stay.
    generic [T: Region]
    function withAlg(token: Span[Nat8, T], alg: Span[Nat8, Static]): String is
        case indexOf(token, ".") of
            when Some(value as dot: Index) do
                var header: StringBuilder := makeStringBuilder();
                writeString(&!header, "{\"alg\":\"");
                writeString(&!header, alg);
                writeString(&!header, "\",\"kid\":\"");
                writeString(&!header, rfcKid);
                writeString(&!header, "\",\"typ\":\"JWT\"}");
                let text: String := finalize(header);
                let encoded: String := base64UrlEncode(asSpan(&text));
                destroyString(text);
                var out: StringBuilder := makeStringBuilder();
                writeString(&!out, asSpan(&encoded));
                destroyString(encoded);
                writeString(&!out, substring(token, dot, spanLength(token)));
                return finalize(out);
            when None do
                return fromSpan("");
        end case;
    end;

    generic [R: Region]
    function signFirst(ring: &[Buffer[RingKey], R], typ: Span[Nat8, Static], payload: Span[Nat8, Static]): String is
        let key: &[RingKey, R] := nthRef(ring, 0);
        case signToken(key, typ, payload) of
            when Some(value as token: String) do
                return token;
            when None do
                abort("a token is not signed");
        end case;
    end;

    function testSignAndVerify(): Unit is
        var ring: Buffer[RingKey] := allocateEmpty();
        insertBack(&!ring, zeroKey());
        let payload: Span[Nat8, Static] := "{\"iss\":\"https://auth.example.com\",\"sub\":\"a\"}";
        let token: String := signFirst(&ring, "JWT", payload);
        let header: String := headerOf(asSpan(&token));
        assertTrue(equal(asSpan(&header), "{\"alg\":\"ML-DSA-44\",\"kid\":\"T4xl70S7MT6Zeq6r9V9fPJGVn76wfnXJ21-gyo0Gu6o\",\"typ\":\"JWT\"}"),
            "the header is alg, kid and typ");
        destroyString(header);
        assertTrue(verifies(asSpan(&token), &ring, "JWT", payload), "the token verifies under its key");
        let bad: String := tampered(asSpan(&token));
        assertFalse(verifies(asSpan(&bad), &ring, "JWT", payload), "a changed signature is refused");
        destroyString(bad);
        destroyString(token);
        let access: String := signFirst(&ring, "at+jwt", payload);
        assertTrue(verifies(asSpan(&access), &ring, "at+jwt", payload), "the typ of an access token is given back");
        destroyString(access);
        -- The header of the token with alg RS256 and the same kid: refused.
        let signedRs: String := signFirst(&ring, "JWT", payload);
        let rsToken: String := withAlg(asSpan(&signedRs), "RS256");
        assertFalse(verifies(asSpan(&rsToken), &ring, "JWT", payload), "RS256 is refused");
        let mlToken: String := withAlg(asSpan(&signedRs), "ML-DSA-44");
        assertTrue(verifies(asSpan(&mlToken), &ring, "JWT", payload), "the control: the same header rewritten as it was verifies");
        destroyString(mlToken);
        destroyString(rsToken);
        destroyString(signedRs);
        assertFalse(verifies("a.b", &ring, "JWT", payload), "two parts are no token");
        assertFalse(verifies("a.b.c.d", &ring, "JWT", payload), "four parts are no token");
        destroyRing(ring);
        return nil;
    end;

    function testRing(): Unit is
        var ring: Buffer[RingKey] := allocateEmpty();
        let start: Int64 := 1700000000;
        assertTrue(isDue(&ring, MlDsa(), start, 90 * day), "an empty ring is due");
        case activeKey(&ring, MlDsa()) of
            when Some(value as i: Index) do
                assertTrue(false, "an empty ring has no active key");
            when None do
                skip;
        end case;
        var firstKid: String := fromSpan("");
        case rotate(&!ring, MlDsa(), start) of
            when Some(value as kid: String) do
                destroyString(firstKid);
                firstKid := kid;
            when None do
                assertTrue(false, "the first key is made");
        end case;
        assertTrue(bufferLength(&ring) = 1, "one key");
        assertFalse(isDue(&ring, MlDsa(), start + (89 * day), 90 * day), "not due after 89 days");
        assertTrue(isDue(&ring, MlDsa(), start + (90 * day), 90 * day), "due after 90 days");
        let later: Int64 := start + (90 * day);
        case rotate(&!ring, MlDsa(), later) of
            when Some(value as kid: String) do
                assertFalse(equal(asSpan(&kid), asSpan(&firstKid)), "the new key has a kid of its own");
                destroyString(kid);
            when None do
                assertTrue(false, "the second key is made");
        end case;
        assertTrue(bufferLength(&ring) = 2, "two keys");
        assertTrue(retiredOf(nthRef(&ring, 0)) = later, "the first key is retired at the rotation");
        assertTrue(retiredOf(nthRef(&ring, 1)) = 0, "the second key signs");
        case activeKey(&ring, MlDsa()) of
            when Some(value as i: Index) do
                assertTrue(i = 1, "the active key is the new one");
            when None do
                assertTrue(false, "there is an active key");
        end case;
        let keys: String := keySet(&ring);
        assertTrue(startsWith(asSpan(&keys), "{\"keys\":[{\"kty\":\"AKP\""), "the key set lists AKP keys");
        let a: Option[Index] := indexOf(asSpan(&keys), kidOf(nthRef(&ring, 0)));
        let b: Option[Index] := indexOf(asSpan(&keys), kidOf(nthRef(&ring, 1)));
        assertTrue(sortedBy(a, b, kidOf(nthRef(&ring, 0)), kidOf(nthRef(&ring, 1))), "the key set is sorted by kid");
        destroyString(keys);
        var gone: Buffer[String] := prune(&!ring, later + 1200, 1200);
        assertTrue(bufferLength(&gone) = 0, "a key retired 1200 seconds ago stays");
        destroyNames(gone);
        var pruned: Buffer[String] := prune(&!ring, later + 1201, 1200);
        assertTrue(bufferLength(&pruned) = 1, "a key retired longer ago goes");
        if bufferLength(&pruned) = 1 then
            assertTrue(equal(asSpan(nthRef(&pruned, 0)), asSpan(&firstKid)), "the old key goes");
        end if;
        destroyNames(pruned);
        assertTrue(bufferLength(&ring) = 1, "one key is left");
        destroyString(firstKid);
        destroyRing(ring);
        return nil;
    end;

    -- Whether the two kids stand in the key set in the order they sort.
    generic [X: Region, Y: Region]
    function sortedBy(a: Option[Index], b: Option[Index], x: Span[Nat8, X], y: Span[Nat8, Y]): Bool is
        case a of
            when Some(value as i: Index) do
                case b of
                    when Some(value as j: Index) do
                        return (i < j) = before(x, y);
                    when None do
                        return false;
                end case;
            when None do
                return false;
        end case;
    end;

    generic [X: Region, Y: Region]
    function before(x: Span[Nat8, X], y: Span[Nat8, Y]): Bool is
        var i: Index := 0;
        while (i < spanLength(x)) and (i < spanLength(y)) do
            if x[i] /= y[i] then
                return x[i] < y[i];
            end if;
            i := i + 1;
        end while;
        return spanLength(x) < spanLength(y);
    end;

    function destroyNames(names: Buffer[String]): Unit is
        var n: Buffer[String] := names;
        while bufferLength(&n) > 0 do
            destroyString(removeLast(&!n));
        end while;
        destroyEmpty(n);
        return nil;
    end;

    function tempPath(suffix: Span[Nat8, Static]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "/tmp/wolly-opkey-");
        case randomBytes(8) of
            when Some(value as raw: String) do
                let hex: String := bytesToHex(asSpan(&raw));
                writeString(&!out, asSpan(&hex));
                destroyString(hex);
                destroyString(raw);
            when None do
                abort("no random bytes");
        end case;
        writeString(&!out, "-");
        writeString(&!out, suffix);
        return finalize(out);
    end;

    function testVault(): Unit is
        let env: String := tempPath("env");
        let pepper: String := tempPath("pepper");
        assertTrue(isRight(createPepper(asSpan(&pepper))), "a pepper is made");
        assertTrue(isRight(createKey(asSpan(&env), asSpan(&pepper), "RAMBO_FERNET_KEY")), "a key is made");
        case openVault(asSpan(&env), asSpan(&pepper), "RAMBO_FERNET_KEY") of
            when Right(right as opened: Vault) do
                var vault: Vault := opened;
                assertTrue(isRight(setSecret(&!vault, "RAMBO_TOTP_KEY", "other")), "another secret is kept");
                var ring: Buffer[RingKey] := allocateEmpty();
                insertBack(&!ring, zeroKey());
                case rotate(&!ring, MlDsa(), 1800000000) of
                    when Some(value as kid: String) do
                        destroyString(kid);
                    when None do
                        assertTrue(false, "a second key is made");
                end case;
                assertTrue(isRight(saveRing(&!vault, prefix, &ring)), "the ring is saved");
                case loadRing(&vault, prefix) of
                    when Right(right as back: Buffer[RingKey]) do
                        assertTrue(bufferLength(&back) = 2, "two keys come back");
                        if bufferLength(&back) = 2 then
                            assertTrue(equal(kidOf(nthRef(&back, 0)), rfcKid), "the older key first");
                            assertTrue(retiredOf(nthRef(&back, 0)) = 1800000000, "its retirement is kept");
                        end if;
                        destroyRing(back);
                    when Left(left as error: VaultError) do
                        assertTrue(false, "the ring is loaded");
                end case;
                var gone: Buffer[String] := prune(&!ring, 1900000000, 1200);
                destroyNames(gone);
                assertTrue(isRight(saveRing(&!vault, prefix, &ring)), "the pruned ring is saved");
                case loadRing(&vault, prefix) of
                    when Right(right as back: Buffer[RingKey]) do
                        assertTrue(bufferLength(&back) = 1, "the pruned key is gone from the vault");
                        destroyRing(back);
                    when Left(left as error: VaultError) do
                        assertTrue(false, "the pruned ring is loaded");
                end case;
                assertTrue(isRight(setSecret(&!vault, "RAMBO_SIGNING_KEY_1111111111111111", "{\"alg\":\"RS256\",\"der\":\"AAAA\",\"created\":1}")),
                    "an RSA key of an older provider is in the vault");
                case loadRing(&vault, prefix) of
                    when Right(right as back: Buffer[RingKey]) do
                        assertTrue(bufferLength(&back) = 1, "it is passed over");
                        destroyRing(back);
                    when Left(left as error: VaultError) do
                        assertTrue(false, "it does not stop the load");
                end case;
                assertTrue(isRight(saveRing(&!vault, prefix, &ring)), "the ring is saved again");
                case getSecret(&vault, "RAMBO_SIGNING_KEY_1111111111111111") of
                    when Right(right as kept: String) do
                        assertTrue(contains(asSpan(&kept), "RS256"), "and the RSA key stays in the vault");
                        destroyString(kept);
                    when Left(left as error: VaultError) do
                        assertTrue(false, "and the RSA key stays in the vault");
                end case;
                assertTrue(isRight(setSecret(&!vault, "RAMBO_SIGNING_KEY_0000000000000000", "no key")), "a damaged value is kept");
                case loadRing(&vault, prefix) of
                    when Right(right as back: Buffer[RingKey]) do
                        assertTrue(false, "a damaged value stops the load");
                        destroyRing(back);
                    when Left(left as error: VaultError) do
                        skip;
                end case;
                destroyRing(ring);
                closeVault(vault);
            when Left(left as error: VaultError) do
                assertTrue(false, "the vault opens");
        end case;
        assertTrue(removeFileIfThere(asSpan(&env)), "the vault is removed");
        assertTrue(removeFileIfThere(asSpan(&pepper)), "the pepper is removed");
        destroyString(env);
        destroyString(pepper);
        return nil;
    end;

    -- The vectors of ML-DSA-44 with Ed25519 of a Go library: the composite
    -- key of the seed 0x00 to 0x3f, the pure key of 0x40 to 0x5f, and thirteen
    -- tokens, two that hold and eleven that are refused.
    constant compositeSeed: Span[Nat8, Static] := "\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{9}\u{a}\u{b}\u{c}\u{d}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f}\u{20}\u{21}\u{22}\u{23}\u{24}\u{25}\u{26}\u{27}\u{28}\u{29}\u{2a}\u{2b}\u{2c}\u{2d}\u{2e}\u{2f}\u{30}\u{31}\u{32}\u{33}\u{34}\u{35}\u{36}\u{37}\u{38}\u{39}\u{3a}\u{3b}\u{3c}\u{3d}\u{3e}\u{3f}";
