    function compositeKey(): RingKey is
        case makeRingKey(Composite(), compositeSeed, 1767225600, 0) of
            when Some(value as key: RingKey) do
                return key;
            when None do
                abort("the composite key of the vector seed is not made");
        end case;
    end;

    function pureKey(): RingKey is
        case makeRingKey(MlDsa(), pureSeed, 1767225600, 0) of
            when Some(value as key: RingKey) do
                return key;
            when None do
                abort("the pure key of the vector seed is not made");
        end case;
    end;

    function testCompositeVector(): Unit is
        let key: RingKey := compositeKey();
        assertTrue(equal(kidOf(&key), compositeKid), "the kid of the composite key is the vector's");
        let jwk: String := publicJwk(&key);
        assertTrue(equal(asSpan(&jwk), compositeJwk), "the JWK of the composite key is the vector's, byte for byte");
        destroyString(jwk);
        let entry: String := keyEntry(&key);
        assertTrue(equal(asSpan(&entry), compositeEntry), "the vault value is the vector's, byte for byte");
        destroyString(entry);
        case readKeyEntry(compositeEntry) of
            when Some(value as back: RingKey) do
                assertTrue(equal(kidOf(&back), compositeKid), "the vault value reads back to the same key");
                destroyRingKey(back);
            when None do
                assertTrue(false, "the vault value of the vector reads");
        end case;
        assertTrue(equal(algorithmOf(Composite()), "ML-DSA-44-Ed25519"), "the name of the composite");
        case makeRingKey(Composite(), zeroSeed, 1, 0) of
            when Some(value as short: RingKey) do
                assertTrue(false, "a seed of 32 bytes is no composite key");
                destroyRingKey(short);
            when None do
                skip;
        end case;
        destroyRingKey(key);
        return nil;
    end;

    generic [R: Region]
    function holds(token: Span[Nat8, Static], ring: &[Buffer[RingKey], R]): Bool is
        case verify(token, ring) of
            when Some(value as v: Verified) do
                destroyVerified(v);
                return true;
            when None do
                return false;
        end case;
    end;

    function testCompositeCases(): Unit is
        var ring: Buffer[RingKey] := allocateEmpty();
        insertBack(&!ring, compositeKey());
        insertBack(&!ring, pureKey());
        assertTrue(holds(case0, &ring), "composite holds");
        assertTrue(holds(case1, &ring), "pure ML-DSA-44 holds");
        assertFalse(holds(case2, &ring), "ml-dsa half broken is refused");
        assertFalse(holds(case3, &ring), "ed25519 half broken is refused");
        assertFalse(holds(case4, &ring), "halves swapped is refused");
        assertFalse(holds(case5, &ring), "wrong label is refused");
        assertFalse(holds(case6, &ring), "ml-dsa without context is refused");
        assertFalse(holds(case7, &ring), "base64url of M' is refused");
        assertFalse(holds(case8, &ring), "ml-dsa half only is refused");
        assertFalse(holds(case9, &ring), "one byte more is refused");
        assertFalse(holds(case10, &ring), "composite key under ML-DSA-44 header is refused");
        assertFalse(holds(case11, &ring), "pure signature under composite header is refused");
        assertFalse(holds(case12, &ring), "payload changed is refused");
        destroyRing(ring);
        return nil;
    end;

    function testCompositeSignAndVerify(): Unit is
        var ring: Buffer[RingKey] := allocateEmpty();
        insertBack(&!ring, compositeKey());
        let payload: Span[Nat8, Static] := "{\"iss\":\"https://auth.example.com\",\"sub\":\"a\"}";
        let token: String := signFirst(&ring, "JWT", payload);
        let header: String := headerOf(asSpan(&token));
        assertTrue(equal(asSpan(&header), "{\"alg\":\"ML-DSA-44-Ed25519\",\"kid\":\"pZLOwL6GEBBTjuCJLgOfmTwSK4DXjuAJ2jkwAKOLIa4\",\"typ\":\"JWT\"}"),
            "the header of a composite token is alg, kid and typ");
        destroyString(header);
        assertTrue(verifies(asSpan(&token), &ring, "JWT", payload), "a composite token verifies under its key");
        let bad: String := tampered(asSpan(&token));
        assertFalse(verifies(asSpan(&bad), &ring, "JWT", payload), "a changed composite signature is refused");
        destroyString(bad);
        let pure: String := withAlg(asSpan(&token), "ML-DSA-44");
        assertFalse(verifies(asSpan(&pure), &ring, "JWT", payload), "a composite token under the header ML-DSA-44 is refused");
        destroyString(pure);
        destroyString(token);
        destroyRing(ring);
        return nil;
    end;

    function isRight(result: Either[VaultError, Unit]): Bool is
        case result of
            when Right(right as done: Unit) do
                return true;
            when Left(left as error: VaultError) do
                return false;
        end case;
    end;
end module body.
