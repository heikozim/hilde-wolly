import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Text (
    contains,
    equal
);
import Wolly.Feed (
    beginFeed,
    writeEntry,
    endFeed,
    feedType
);

module body Wolly.Feed.Test is
    constant wanted: Span[Nat8, Static] := "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<feed xmlns=\"http://www.w3.org/2005/Atom\">\n<id>https://example.com/</id>\n<title>News &amp; more</title>\n<link href=\"https://example.com/\"/>\n<updated>2025-10-14T12:00:00Z</updated>\n<entry>\n<id>https://example.com/1</id>\n<title>&lt;script&gt;alert(&apos;x&apos;)&lt;/script&gt;</title>\n<link href=\"https://example.com/1?a=1&amp;b=2\"/>\n<updated>1970-01-01T00:00:00Z</updated>\n<summary>&quot;quoted&quot;</summary>\n</entry>\n<entry>\n<id>tag:example.com,2026:2</id>\n<title>no link</title>\n<updated>2025-10-14T12:00:00Z</updated>\n<summary></summary>\n</entry>\n</feed>\n";

    function testFeed(): Unit is
        var out: StringBuilder := makeStringBuilder();
        beginFeed(&!out, "https://example.com/", "News & more", "https://example.com/", 1760443200);
        writeEntry(&!out, "https://example.com/1", "<script>alert('x')</script>", "https://example.com/1?a=1&b=2", 0, "\"quoted\"");
        writeEntry(&!out, "tag:example.com,2026:2", "no link", "javascript:alert(1)", 1760443200, "");
        endFeed(&!out);
        let feed: String := finalize(out);
        assertTrue(equal(asSpan(&feed), wanted), "the feed, byte for byte");
        assertFalse(contains(asSpan(&feed), "<script"), "no tag of a title");
        assertFalse(contains(asSpan(&feed), "javascript"), "an unsafe link is left out");
        destroyString(feed);
        assertTrue(contains(feedType(), "application/atom+xml"), "the media type");
        return nil;
    end;
end module body.
