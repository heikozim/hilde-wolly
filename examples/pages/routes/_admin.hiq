import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeString,
    finalize
);

module body Wolly.Example.Pages.Site.Admin is
    function layout(content: String): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "<main class=\"admin\">\n");
        writeString(&!out, asSpan(&content));
        writeString(&!out, "</main>\n");
        destroyString(content);
        return finalize(out);
    end;
end module body.
