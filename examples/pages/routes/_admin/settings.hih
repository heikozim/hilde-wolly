import Standard.FcgiServer (
    Request
);
import Wolly.Tree (
    Page,
    isWrapped
);

module Wolly.Example.Pages.Site.Admin.Settings is
    """
    GET /settings: the settings, inside the layout of the admin pages.
    """
    function get(request: Request): Page
        ensures isWrapped(&result);

    """
    POST /settings: a redirect to GET /settings, finished, so that no
    layout wraps it.
    """
    function post(request: Request): Page
        ensures not isWrapped(&result);
end module.
