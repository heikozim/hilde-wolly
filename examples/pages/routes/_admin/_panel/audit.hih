import Standard.FcgiServer (
    Request
);
import Wolly.Tree (
    Page,
    isWrapped
);

module Wolly.Example.Pages.Site.Admin.Panel.Audit is
    """
    GET /audit: the audit, inside the panel inside the admin layout.
    """
    function get(request: Request): Page
        ensures isWrapped(&result);
end module.
