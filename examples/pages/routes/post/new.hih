import Standard.FcgiServer (
    Request
);
import Wolly.Tree (
    Page,
    isWrapped
);

module Wolly.Example.Pages.Site.Post.New is
    """
    GET /post/new: the form of a new post, found before the parameter of /post/:id.
    """
    function get(request: Request): Page
        ensures isWrapped(&result);
end module.
