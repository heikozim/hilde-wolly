import Standard.FcgiServer (
    Request
);
import Wolly.Tree (
    Page,
    isWrapped
);

module Wolly.Example.Pages.Site.Docs.Intro is
    """
    GET /docs/intro: a page two segments deep.
    """
    function get(request: Request): Page
        ensures isWrapped(&result);
end module.
