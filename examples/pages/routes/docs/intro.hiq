import Standard.String (
    fromSpan
);
import Standard.FcgiServer (
    Request,
    destroyRequest
);
import Wolly.Response (
    makeResponse
);
import Wolly.Tree (
    Page,
    page
);

module body Wolly.Example.Pages.Site.Docs.Intro is
    function get(request: Request): Page is
        destroyRequest(request);
        return page(makeResponse(200, "text/html; charset=utf-8"), fromSpan("<h1>Intro</h1>\n"));
    end;
end module body.
