"""
One asset of an application, for the check that a missing file does not
compile.
"""
import Wolly.Bundle (
    Asset
);

module Wolly.BundleProbe is
    """
    The style sheet of the application.  No contract: the asset is the
    one Wolly.Bundle.asset gives.
    """
    function appCss(): Asset;
end module.
